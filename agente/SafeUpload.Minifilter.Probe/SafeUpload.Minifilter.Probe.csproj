<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Sonda do driver, nao o agente.

    Existe para a bateria de testes do minifiltro: conecta na porta, empurra
    uma politica conhecida, responde vereditos por uma regra trivial e imprime
    o que viu. Deliberadamente burra - quem decide de verdade e o
    InspectionService do Core, e misturar as duas coisas tiraria da bateria a
    propriedade que a torna util, que e testar o driver contra um cliente cujo
    comportamento e inteiramente previsivel.

    PublishAot e escolha de implantacao, nao de desempenho: a VM alvo nao tem
    runtime .NET e nao vai ter. Um binario dependente de framework morre la no
    loader sem imprimir nada - a mesma falha que o inspetor em C teve com
    VCRUNTIME140D.dll. AOT produz um .exe unico cujas importacoes sao so DLLs
    do proprio Windows.

    O linker do MSVC que o AOT invoca chama vswhere.exe, que NAO esta no PATH
    por padrao nem com o Visual Studio instalado. Publish-SafeUpload.ps1 cuida
    disso; num shell, prefixe:

      %ProgramFiles(x86)%\Microsoft Visual Studio\Installer
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <AssemblyName>SafeUpload.Probe</AssemblyName>
    <RootNamespace>SafeUpload.Minifilter.Probe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpload.Agent.Minifilter\SafeUpload.Agent.Minifilter.csproj" />
  </ItemGroup>

</Project>
