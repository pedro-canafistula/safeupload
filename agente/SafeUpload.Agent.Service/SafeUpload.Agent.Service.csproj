<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!--
      net10.0-windows, e nao net10.0: este e um servico do Windows e usa APIs
      que so existem nele — a lista de controle de acesso do named pipe, acima
      de tudo. Declarar a plataforma no projeto e o que faz o compilador
      verificar essas chamadas em vez de emitir CA1416 em cada uma delas.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-SafeUpload.Agent.Service-9d76323d-d865-49fb-9428-18e206dcb852</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpload.Agent.Core\SafeUpload.Agent.Core.csproj" />
  </ItemGroup>
</Project>
