{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Interception": {
    "StageSpace": {
      "Enabled": false,
      "FloorOnly": true,
      "ParserMemoryBytes": 268435456
    }
  },

  "CentroAdministracao": {
    "BaseUrl": "http://127.0.0.1:8080/agent/",
    "DispatchIntervalSeconds": 30,
    "TimeoutSeconds": 5
  },

  "InspecaoTls": {
    "Habilitada": false,
    "Porta": 8877,
    "DesviarNavegadores": true
  }
}
