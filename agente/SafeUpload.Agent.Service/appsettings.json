{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "SafeUpload": "Information"
      }
    }
  },

  "Interception": {
    "Mode": "Drive"
  },

  "Drive": {
    "Letters": "S,T,U,V,W,X,Y,Z"
  },

  "CentroAdministracao": {
    "DispatchIntervalSeconds": 30,
    "TimeoutSeconds": 5
  },

  "InspecaoTls": {
    "Habilitada": false,
    "Porta": 8877,
    "DesviarNavegadores": true,
    "Excecoes": {
      "Categorias": {
        "bancos": true,
        "saude": true,
        "governo": true
      },
      "Dominios": [],
      "DetectarPinning": true
    }
  }
}
