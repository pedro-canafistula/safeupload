<Project Sdk="Microsoft.NET.Sdk">

  <!-- SafeUpload drive: a WinFsp file system in front of a protected destination.
       Writes stay in a private stage; only inspected, clean versions reach the destination. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SafeUpload.Agent.Drive</AssemblyName>
    <RootNamespace>SafeUpload.Agent.Drive</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="winfsp.net" Version="2.1.24051" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpload.Agent.Core\SafeUpload.Agent.Core.csproj" />
  </ItemGroup>

</Project>
