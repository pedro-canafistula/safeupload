<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0-windows para poder testar tambem o projeto do servico, que e
      Windows por natureza. A suite ja dependia do Windows de qualquer forma:
      ela exercita %ProgramData%, caminhos com barra invertida e o
      FileSystemWatcher.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <DefineConstants Condition="'$(SafeUploadAdmissionEvidence)' == 'true'">$(DefineConstants);SAFEUPLOAD_ADMISSION_EVIDENCE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure presentation logic; no WPF runtime or reference to the interactive app. -->
    <Compile Include="..\SafeUpload.Agent.App\Mvvm\ObservableObject.cs" Link="Presentation\ObservableObject.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\CommunicationViewModel.cs" Link="Presentation\CommunicationViewModel.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\AgentViewModel.cs" Link="Presentation\AgentViewModel.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\StatusViewModel.cs" Link="Presentation\StatusViewModel.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\HistoryViewModel.cs" Link="Presentation\HistoryViewModel.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\ActivityRowViewModel.cs" Link="Presentation\ActivityRowViewModel.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\QueueRowViewModel.cs" Link="Presentation\QueueRowViewModel.cs" />
    <Compile Include="..\SafeUpload.Agent.App\ViewModels\AuditSubject.cs" Link="Presentation\AuditSubject.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpload.Agent.Core\SafeUpload.Agent.Core.csproj" />
    <ProjectReference Include="..\SafeUpload.Agent.Network\SafeUpload.Agent.Network.csproj" />
    <ProjectReference Include="..\SafeUpload.Agent.Service\SafeUpload.Agent.Service.csproj" />
  </ItemGroup>

</Project>
