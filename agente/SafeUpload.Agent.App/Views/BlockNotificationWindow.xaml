<Window x:Class="SafeUpload.Agent.App.Views.BlockNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SafeUpload.Agent.App.ViewModels"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Envio bloqueado pelo SafeUpload"
        Width="380"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        ResizeMode="NoResize">

    <!--
        ShowActivated="False", e em nenhum lugar do codigo se chama Activate():
        a notificacao aparece por cima sem tomar o foco do teclado. Um bloqueio
        acontece enquanto a pessoa esta trabalhando em outro programa, e roubar
        o foco faria as proximas teclas irem para esta janela — no melhor caso
        perdendo o que estava sendo digitado, no pior acionando o botao.

        A justificativa aparece apenas quando a política permite exceção. O
        botão submete o motivo ao serviço para uma nova tentativa; não altera
        o veredito da operação que já foi recusada.
    -->

    <Border Background="{StaticResource Surface}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.22" Color="#0F172A" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Faixa de identidade, na cor de perigo da paleta -->
            <Border Grid.Row="0"
                    Background="{StaticResource Danger}"
                    CornerRadius="9,9,0,0"
                    Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Envio bloqueado pelo SafeUpload"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="SummaryText"
                               FontFamily="{StaticResource UiFont}"
                               FontSize="12"
                               Foreground="#FEE2E2"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,14,16,16">

                <TextBlock Text="O que foi encontrado" Style="{StaticResource SectionText}" />

                <!--
                    Só trechos mascarados chegam aqui. O mascaramento acontece no
                    domínio, no momento da varredura: esta janela não recebe o
                    valor original, então não teria como exibi-lo nem por engano.
                -->
                <ItemsControl x:Name="FindingsList" Margin="0,0,0,14">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                            <Border Background="{StaticResource DangerBg}"
                                    CornerRadius="6"
                                    Padding="10,7"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Category}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerText}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding MaskedSnippet}"
                                               Style="{StaticResource SnippetText}"
                                               Foreground="{StaticResource DangerText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource BodyText}"
                           Foreground="{StaticResource TextMuted}"
                           Text="Revise o arquivo, remova ou anonimize as informações e tente novamente."
                           Margin="0,0,0,10" />

                <!--
                    O arquivo saiu da pasta monitorada. Dizer para onde ele foi
                    não afrouxa o bloqueio: continua não havendo como liberá-lo
                    daqui. Omitir isso é que transformaria um bloqueio explicado
                    num arquivo perdido.
                -->
                <TextBlock x:Name="QuarantineText"
                           Style="{StaticResource MutedText}"
                           Text="O arquivo foi retirado da pasta monitorada e guardado em SafeUpload\_bloqueados na sua pasta de usuário."
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <StackPanel x:Name="JustificationPanel"
                            Visibility="Collapsed"
                            Margin="0,0,0,14">
                    <TextBlock x:Name="JustificationTargetText"
                               Style="{StaticResource SectionText}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Informe o motivo de negócio para tentar novamente."
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="JustificationInput"
                             MaxLength="1000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="68"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="JustificationInput_TextChanged" />
                    <TextBlock x:Name="JustificationStatusText"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0" />
                    <Button x:Name="SubmitJustificationButton"
                            Content="Enviar justificativa"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            HorizontalAlignment="Right"
                            Margin="0,9,0,0"
                            Click="SubmitJustification_Click" />
                </StackPanel>

                <Button x:Name="AcknowledgeButton"
                        Content="Entendi"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        MinWidth="110"
                        Click="Acknowledge_Click"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
