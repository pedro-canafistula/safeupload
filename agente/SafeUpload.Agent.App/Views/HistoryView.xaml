<UserControl x:Class="SafeUpload.Agent.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SafeUpload.Agent.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             FontFamily="{StaticResource UiFont}">

    <!--
        Só leitura: sem filtro, sem ordenação, sem botão. A trilha é o registro
        do que o agente decidiu, e dar ao usuário meios de recortá-la sugeriria
        que ele tem influência sobre ela.
    -->

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Histórico de auditoria"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Text}" />
            <TextBlock Text="Todas as operações registradas neste endpoint, da mais recente para a mais antiga."
                       Style="{StaticResource MutedText}"
                       Margin="0,3,0,0" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{StaticResource Border}"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">
            <Grid>
                <DataGrid ItemsSource="{Binding Events}"
                          Style="{StaticResource QueueGrid}"
                          BorderThickness="0"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Data e hora" Binding="{Binding OccurredAt}" Width="140" />
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="150" />
                        <DataGridTextColumn Header="Ext." Binding="{Binding Extension}" Width="56" />
                        <DataGridTextColumn Header="Tamanho" Binding="{Binding Size}" Width="80" />
                        <DataGridTextColumn Header="Destino" Binding="{Binding Destination}" Width="150" />
                        <DataGridTextColumn Header="Processo" Binding="{Binding Process}" Width="110" />

                        <!-- A mesma pílula do status, para o resultado ser reconhecível nas duas telas. -->
                        <DataGridTemplateColumn Header="Resultado" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
                                    <Border Background="{Binding Status.BackgroundKey, Converter={StaticResource BrushLookup}}"
                                            CornerRadius="999"
                                            Padding="10,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status.Text}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status.ForegroundKey, Converter={StaticResource BrushLookup}}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Categorias" Binding="{Binding Categories}" Width="160" />

                        <!--
                            Trechos mascarados, em monoespaçada para os
                            marcadores alinharem. Nunca o valor real: o que
                            chega aqui já saiu mascarado do domínio (RN-007).
                        -->
                        <DataGridTextColumn Header="Trechos mascarados"
                                            Binding="{Binding MaskedSnippets}"
                                            Width="170"
                                            FontFamily="{StaticResource MonoFont}" />

                        <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*" MinWidth="180" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Nenhuma operação registrada até agora"
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
