<Window x:Class="SafeUpload.Agent.App.Views.SimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SafeUpload.Agent.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SimulatorViewModel}"
        Title="SafeUpload — simulador do agente"
        Width="1060"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Simulador do agente SafeUpload" Style="{StaticResource TitleText}" />
            <TextBlock Style="{StaticResource MutedText}"
                       Margin="0,4,0,0"
                       Text="Monte uma operação de arquivo e veja a decisão do agente. Nenhum arquivo sai desta máquina: o conteúdo é lido para memória, varrido e descartado." />
        </StackPanel>

        <!-- Regiões 1 e 2: zona de arrastar e contexto da operação -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- 1. Zona de arrastar e soltar -->
            <Border Grid.Column="0"
                    x:Name="DropZone"
                    AllowDrop="True"
                    Drop="DropZone_Drop"
                    DragOver="DropZone_DragOver"
                    DragLeave="DropZone_DragLeave"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="20"
                    MinHeight="230">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Arraste um arquivo aqui"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Primary}"
                               HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               Text="txt · csv · docx · xlsx" />

                    <TextBlock Text="{Binding SelectedFileLabel}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="420"
                               Margin="0,16,0,0" />

                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="460"
                               Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="Selecionar arquivo"
                                Style="{StaticResource PrimaryButton}"
                                Click="SelectFile_Click"
                                Margin="0,0,8,0" />
                        <Button Content="Gerar arquivos de exemplo"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CreateSamplesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2. Contexto da operação -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CONTEXTO DA OPERAÇÃO" Style="{StaticResource SectionText}" />

                    <TextBlock Text="Destino" Style="{StaticResource LabelText}" />
                    <ComboBox Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding Destinations}"
                              SelectedItem="{Binding Destination}"
                              DisplayMemberPath="Label"
                              Margin="0,0,0,12" />

                    <TextBlock Text="Processo de origem" Style="{StaticResource LabelText}" />
                    <TextBox Style="{StaticResource FieldBox}"
                             Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,12" />

                    <CheckBox Style="{StaticResource FieldCheck}"
                              Content="Simular travamento do serviço"
                              IsChecked="{Binding SimulateStall}" />
                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="24,4,0,12"
                               Text="Injeta 8 s de atraso na extração. O prazo da política corta em 5 s e a operação é liberada sem inspeção." />

                    <Border Background="{StaticResource Bg}" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="ESCOPO MONITORADO" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding MonitoredExtensions}" Style="{StaticResource SnippetText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding MonitoredPaths}" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ActiveCategories}" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding PolicySummary}" Style="{StaticResource MutedText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Regiões 3 e 4: resultado e fila -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 3. Cartão de resultado -->
            <Border Grid.Row="0"
                    Style="{StaticResource Card}"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MinWidth="240">
                        <TextBlock Text="RESULTADO" Style="{StaticResource SectionText}" />

                        <!-- O veredito é colorido pelo token correspondente. -->
                        <Border Background="{Binding VerdictBrush}"
                                CornerRadius="6"
                                Padding="14,9"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{Binding VerdictText}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="White" />
                        </Border>

                        <TextBlock Text="{Binding ResultFileName}"
                                   Style="{StaticResource BodyText}"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Border Background="{StaticResource Bg}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{Binding ResultElapsed}" Style="{StaticResource MutedText}" />
                            </Border>

                            <Border Background="{StaticResource Bg}"
                                    BorderBrush="{StaticResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,0,6,0">
                                <TextBlock Text="{Binding ResultPolicyVersion}" Style="{StaticResource MutedText}" />
                            </Border>

                            <!-- Selo de cache: só aparece quando a decisão foi reaproveitada. -->
                            <Border Background="{StaticResource WarningBg}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Visibility="{Binding ResultFromCache, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="cache"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningText}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding ResultReason}"
                                   Style="{StaticResource MutedText}"
                                   MaxWidth="240"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="CATEGORIAS ENCONTRADAS" Style="{StaticResource SectionText}" />

                        <ItemsControl ItemsSource="{Binding Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FindingViewModel}">
                                    <Border Background="{StaticResource DangerBg}"
                                            CornerRadius="6"
                                            Padding="10,7"
                                            Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource DangerText}"
                                                       MinWidth="150"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MaskedSnippet}"
                                                       Style="{StaticResource SnippetText}"
                                                       Foreground="{StaticResource DangerText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource MutedText}"
                                   Text="Nenhum dado sensível encontrado neste arquivo."
                                   Visibility="{Binding Findings.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Fila de eventos -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="FILA DE AUDITORIA (queue.jsonl)"
                                   Style="{StaticResource SectionText}"
                                   Margin="0"
                                   VerticalAlignment="Center" />
                        <Button Content="Atualizar"
                                Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Right"
                                Command="{Binding RefreshQueueCommand}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              Style="{StaticResource QueueGrid}"
                              ItemsSource="{Binding Queue}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Quando" Binding="{Binding OccurredAt}" Width="110" />
                            <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="150" />
                            <DataGridTextColumn Header="Veredito" Binding="{Binding Verdict}" Width="150" />
                            <DataGridTextColumn Header="Categorias" Binding="{Binding Categories}" Width="160" />
                            <DataGridTextColumn Header="Trechos mascarados" Binding="{Binding MaskedSnippets}" Width="180"
                                                FontFamily="Consolas" />
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="130" />
                            <DataGridTextColumn Header="Processo" Binding="{Binding Process}" Width="110" />
                            <DataGridTextColumn Header="ms" Binding="{Binding ElapsedMs}" Width="60" />
                            <DataGridTextColumn Header="Política" Binding="{Binding PolicyVersion}" Width="60" />
                            <DataGridTextColumn Header="Despachado" Binding="{Binding Dispatched}" Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Style="{StaticResource MutedText}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap">
                        <Run Text="Todo evento nasce com despachado igual a Não: o envio ao Centro de Administração (HU-10) ainda não foi implementado. Arquivo:" />
                        <Run Text="{Binding QueuePath, Mode=OneWay}" FontFamily="Consolas" />
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
