<Window x:Class="SafeUpload.Agent.App.Views.AgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SafeUpload.Agent.App.ViewModels"
        xmlns:views="clr-namespace:SafeUpload.Agent.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AgentViewModel}"
        Title="SafeUpload Endpoint Agent"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}"
        FontFamily="{StaticResource UiFont}">

    <!--
        Janela normal, com a barra de título do Windows. O agente não tem por
        que desenhar a própria moldura: é um utilitário do sistema, e parecer
        uma janela comum é o que o faz parecer parte do sistema.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Marca e versão -->
            <StackPanel Grid.Row="0" Margin="24,26,24,22">
                <TextBlock Text="Safeupload"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Primary}" />
                <TextBlock Text="{Binding VersionLabel, Mode=OneTime}"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           Margin="0,3,0,0" />
            </StackPanel>

            <!--
                Navegação. Um ListBox porque a seleção é o próprio estado da
                navegação: o controle já garante que exatamente um item esteja
                escolhido, e não é preciso sincronizar botões à mão.
            -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}"
                     Background="Transparent"
                     BorderThickness="0"
                     Margin="14,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <!-- Pílula sólida quando selecionado, nada quando solto. -->
                                    <Border x:Name="Pilula"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <Path x:Name="Icone"
                                                  Style="{StaticResource IconPath}"
                                                  Data="{Binding IconKey, Converter={StaticResource IconLookup}}"
                                                  Stroke="{StaticResource TextMuted}"
                                                  VerticalAlignment="Center" />
                                            <TextBlock x:Name="Rotulo"
                                                       Text="{Binding Label}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource TextMuted}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Pilula" Property="Background" Value="{StaticResource Primary}" />
                                            <Setter TargetName="Icone" Property="Stroke" Value="White" />
                                            <Setter TargetName="Rotulo" Property="Foreground" Value="White" />
                                            <Setter TargetName="Rotulo" Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True" />
                                                <Condition Property="IsSelected" Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Pilula" Property="Background" Value="#E1EAF5" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- Usuário da sessão -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="24,0,24,24">
                <Grid Width="32" Height="32">
                    <Ellipse Fill="{StaticResource Primary}" />
                    <TextBlock Text="{Binding UserInitials, Mode=OneTime}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Usuário Atual"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Área de conteúdo -->
        <Grid Grid.Column="1" Background="{StaticResource Surface}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1"
                    Padding="28,20">
                <Grid>
                    <TextBlock Text="SafeUpload Endpoint Agent"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"
                               VerticalAlignment="Center" />
                    <Path Style="{StaticResource IconPath}"
                          Data="{StaticResource IconBell}"
                          Stroke="{StaticResource TextMuted}"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--
                Troca entre as duas telas pelo tipo do modelo de visão
                selecionado. É o que mantém a navegação sem código de mudança
                de tela em lugar nenhum.
            -->
            <ContentControl Grid.Row="1" Content="{Binding SelectedSection.Content}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:StatusViewModel}">
                        <views:StatusView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</Window>
