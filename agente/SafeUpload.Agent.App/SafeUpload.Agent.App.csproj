<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (bandeja do sistema) vem de System.Windows.Forms. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms injeta "global using System.Windows.Forms", que colide com
      System.Windows (Application, MessageBox, etc.) numa app WPF. Removemos o
      using implicito: o namespace do WinForms e citado explicitamente onde
      realmente e usado (NotifyIcon).
    -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpload.Agent.Core\SafeUpload.Agent.Core.csproj" />
  </ItemGroup>

</Project>
