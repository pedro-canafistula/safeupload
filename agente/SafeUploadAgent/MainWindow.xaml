<Window x:Class="SafeUploadAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SafeUpload Endpoint Agent"
        Height="680" Width="1040"
        MinHeight="520" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                             ResizeBorderThickness="6"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- Botões da barra de título (minimizar/maximizar/fechar) -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botões de navegação do menu lateral -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card padrão -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Texto de legenda pequena em maiúsculas -->
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>

    </Window.Resources>

    <Border Background="White" BorderBrush="#D9D9D9" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== BARRA DE TÍTULO ===================== -->
            <Border Grid.Row="0" Background="White" BorderBrush="#EFEFEF" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🛡" FontSize="16" Foreground="#2563EB" VerticalAlignment="Center"/>
                        <TextBlock Text="SafeUpload Endpoint Agent" Margin="8,0,0,0"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButtonStyle}"
                                Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Click="Minimize_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButtonStyle}"
                                Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Click="MaximizeRestore_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================== CORPO ===================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- MENU LATERAL -->
                <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#EFEFEF" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="20,24,20,20">
                            <TextBlock Text="Safeupload" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                            <TextBlock Text="Endpoint Utility v4.1" FontSize="11" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="12,0">
                            <Button x:Name="NavStatusButton" Style="{StaticResource NavButtonStyle}"
                                    Background="#2563EB" Foreground="White" Click="NavStatus_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Status" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavHistoricoButton" Style="{StaticResource NavButtonStyle}"
                                    Margin="0,4,0,0" Click="NavHistorico_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕓" FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="Histórico" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,0,20,20">
                            <Border Width="32" Height="32" CornerRadius="16" Background="#E5E7EB">
                                <TextBlock Text="👤" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Usuário Atual" Margin="10,0,0,0" FontSize="13"
                                       Foreground="#374151" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- CONTEÚDO PRINCIPAL -->
                <Grid Grid.Column="1" Background="#F5F7FA">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                        <StackPanel Margin="32,26,32,26">

                            <!-- Cabeçalho -->
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SafeUpload Endpoint Agent" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                                <TextBlock Grid.Column="1" Text="🔔" FontSize="18" Foreground="#374151"/>
                            </Grid>

                            <!-- Linha de 3 cards -->
                            <Grid Margin="0,0,0,22">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Status de Segurança -->
                                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF">
                                                <TextBlock Text="🛡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Status de Segurança" Margin="8,0,0,0" FontSize="13"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Protegido" FontSize="28" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,8"/>
                                        <TextBlock Text="DISPOSITIVO SEGURO" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Política Ativa -->
                                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF">
                                                <TextBlock Text="🗂" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Política Ativa" Margin="8,0,0,0" FontSize="13"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Enterprise" FontSize="28" FontWeight="Bold" Foreground="#111827"
                                                    Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="PROTEÇÃO DE DADOS" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Monitoramento -->
                                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <Border Width="28" Height="28" CornerRadius="6" Background="#EFF6FF">
                                                <TextBlock Text="📊" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Monitoramento" Margin="8,0,0,0" FontSize="13"
                                                       Foreground="#374151" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Background="#DCFCE7" CornerRadius="12" Padding="10,5"
                                                HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center"/>
                                                <TextBlock Text="INTERCEPTANDO" Margin="6,0,0,0" FontSize="11"
                                                           FontWeight="Bold" Foreground="#16A34A"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="OPERAÇÕES EM SEGUNDO PLANO" Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Card: Monitoramento de Atividade -->
                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <StackPanel Margin="24,22,24,18">
                                        <TextBlock Text="Monitoramento de Atividade" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                                        <TextBlock Text="Intercepções e operações recentes" FontSize="12.5"
                                                   Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Cabeçalho da tabela -->
                                    <Border Background="#F9FAFB" BorderBrush="#EEEEEE" BorderThickness="0,1,0,1" Padding="24,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="OPERAÇÃO DE ARQUIVO" Style="{StaticResource CaptionTextStyle}"/>
                                            <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource CaptionTextStyle}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Linha 1: LOGGED -->
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="24,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="6" Background="#F1F5F9">
                                                    <TextBlock Text="💾" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Arquivo Salvo: report_q3.pdf" Margin="10,0,0,0"
                                                           FontSize="13.5" Foreground="#1F2937" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="10" Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center"/>
                                                    <TextBlock Text="LOGGED" Margin="5,0,0,0" FontSize="10.5"
                                                               FontWeight="Bold" Foreground="#16A34A"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Linha 2: ENCRYPTED -->
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="24,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="6" Background="#EFF6FF">
                                                    <TextBlock Text="🔗" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Arquivo Compartilhado: team_specs.docx" Margin="10,0,0,0"
                                                           FontSize="13.5" Foreground="#1F2937" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#DBEAFE" CornerRadius="10" Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔒" FontSize="9" VerticalAlignment="Center"/>
                                                    <TextBlock Text="ENCRYPTED" Margin="5,0,0,0" FontSize="10.5"
                                                               FontWeight="Bold" Foreground="#2563EB"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Linha 3: BLOCKED -->
                                    <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="24,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="6" Background="#FEECEC">
                                                    <TextBlock Text="🚫" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Upload Bloqueado: sensitive_data.xlsx" Margin="10,0,0,0"
                                                           FontSize="13.5" Foreground="#1F2937" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="10" Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#DC2626" VerticalAlignment="Center"/>
                                                    <TextBlock Text="BLOCKED" Margin="5,0,0,0" FontSize="10.5"
                                                               FontWeight="Bold" Foreground="#DC2626"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Linha 4: SCANNED -->
                                    <Border Padding="24,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="30" Height="30" CornerRadius="6" Background="#F1F5F9">
                                                    <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="Download Analisado: update_v2.zip" Margin="10,0,0,0"
                                                           FontSize="13.5" Foreground="#1F2937" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#DCFCE7" CornerRadius="10" Padding="9,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center"/>
                                                    <TextBlock Text="SCANNED" Margin="5,0,0,0" FontSize="10.5"
                                                               FontWeight="Bold" Foreground="#16A34A"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
