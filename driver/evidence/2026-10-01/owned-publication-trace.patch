 #define STAGE_TAG 'sUpS'
 #define STAGE_LIMIT 128
 #define STAGE_MAX_BYTES (16 * 1024 * 1024)
+
+#if SAFEUPLOAD_STAGE_DIAGNOSTICS
+/* Opt-in VM diagnostic. No user bytes: phase/status and the path suffix only. */
+static VOID StageTrace(ULONG Code, NTSTATUS Status, PUNICODE_STRING Name)
+{
+    PIO_ERROR_LOG_PACKET packet = IoAllocateErrorLogEntry(SafeUploadData.DriverObject,
+        (UCHAR)(sizeof(IO_ERROR_LOG_PACKET) + 144));
+    USHORT bytes = Name == NULL ? 0 : min(Name->Length, 128);
+    if (packet == NULL) return;
+    RtlZeroMemory(packet, sizeof(IO_ERROR_LOG_PACKET) + 144);
+    packet->ErrorCode = (NTSTATUS)0xC0040001;
+    packet->UniqueErrorValue = Code;
+    packet->FinalStatus = Status;
+    packet->DumpDataSize = 144;
+    packet->DumpData[0] = Code;
+    packet->DumpData[1] = HandleToULong(PsGetCurrentProcessId());
+    packet->DumpData[2] = (ULONG)Status;
+    packet->DumpData[3] = bytes;
+    if (bytes != 0) RtlCopyMemory(packet->DumpData + 4,
+        (PUCHAR)Name->Buffer + Name->Length - bytes, bytes);
+    IoWriteErrorLogEntry(packet);
+}
+#else
+#define StageTrace(Code, Status, Name) ((void)0)
+#endif
 
 typedef struct _STAGE_STREAM {
     FSRTL_ADVANCED_FCB_HEADER Header;
