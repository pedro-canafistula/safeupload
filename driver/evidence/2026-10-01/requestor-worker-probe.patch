+/* TEST ONLY: force request authorization to execute on a SYSTEM worker. */
+static VOID StageRenameWorker(PFLT_DEFERRED_IO_WORKITEM Item,
+    PFLT_CALLBACK_DATA Data, PVOID Context)
+{
+    /* Abort the test unless it really left the caller's thread/process. */
+    if (PsGetCurrentThread() == Data->Thread || PsGetCurrentProcessId() != ULongToHandle(4))
+        Data->IoStatus.Status = STATUS_UNSUCCESSFUL;
+    else if (FltIsIoCanceled(Data)) Data->IoStatus.Status = STATUS_CANCELLED;
+    else Data->IoStatus.Status = StageRename(Data, Context);
+    Data->IoStatus.Information = 0;
+    FltFreeDeferredIoWorkItem(Item);
+    FltCompletePendedPreOperation(Data, FLT_PREOP_COMPLETE, NULL);
+}
+
+static FLT_PREOP_CALLBACK_STATUS StageQueueRename(PFLT_CALLBACK_DATA Data, PSTAGE_STREAM Stream)
+{
+    NTSTATUS status;
+    PFLT_DEFERRED_IO_WORKITEM item = FltAllocateDeferredIoWorkItem();
+    if (item == NULL) status = STATUS_INSUFFICIENT_RESOURCES;
+    else {
+        status = FltQueueDeferredIoWorkItem(item, Data, StageRenameWorker, DelayedWorkQueue, Stream);
+        if (NT_SUCCESS(status)) return FLT_PREOP_PENDING;
+        FltFreeDeferredIoWorkItem(item);
+    }
+    Data->IoStatus.Status = status;
+    Data->IoStatus.Information = 0;
+    return FLT_PREOP_COMPLETE;
+}
