+function Invoke-R18ControlExpectedFailure([string]$RunToken, [string]$ControlPath,
+    [string]$PowerShellPath, [IntPtr]$FixtureJobHandle, [uint32]$SupervisorPid, [long]$SupervisorStart,
+    [string]$CasePrefix, [string]$ModeName, [string]$FailureTag, [string]$ExpectedErrorSubstring) {
+    $arguments = @(
+        '-NoProfile', '-NonInteractive', '-OutputFormat', 'Text', '-ExecutionPolicy', 'Bypass',
+        '-File', $ControlPath,
+        '-Mode', $ModeName, '-DestinationPath', $DestinationPath, '-RunToken', $RunToken,
+        '-ExpectedManifestSha256', $ExpectedManifestSha256,
+        '-ExpectedRunnerSha256', $ExpectedRunnerSha256,
+        '-ExpectedWorkerSha256', $ExpectedWorkerSha256,
+        '-ExpectedKeeperSha256', $ExpectedKeeperSha256,
+        '-ExpectedFixtureSha256', $ExpectedFixtureSha256,
+        '-ExpectedControlSha256', $ExpectedControlSha256,
+        '-ExpectedProtocolSha256', $ExpectedProtocolSha256,
+        '-ExpectedProcessId', [string]$SupervisorPid,
+        '-ExpectedStartFiletime', [string]$SupervisorStart
+    )
+    $stdoutPath = $CasePrefix + '.' + $FailureTag + '.stdout.bin'
+    $stderrPath = $CasePrefix + '.' + $FailureTag + '.stderr.bin'
+    if ((Test-Path -LiteralPath $stdoutPath) -or (Test-Path -LiteralPath $stderrPath)) {
+        throw ('Negative control evidence path is already occupied: ' + $FailureTag)
+    }
+    $control = [SafeUpload.HarnessGate.Native]::StartSuspendedInJob(
+        $FixtureJobHandle, $PowerShellPath, [string[]]$arguments, $env:USERPROFILE, $stdoutPath, $stderrPath)
+    try {
+        [void][SafeUpload.HarnessGate.Native]::ResumeChild($control)
+        $watch = [Diagnostics.Stopwatch]::StartNew()
+        $terminal = $false
+        while ($watch.Elapsed.TotalSeconds -lt 60) {
+            $wait = [SafeUpload.HarnessGate.Native]::Wait($control, [uint32]100)
+            if ($wait -eq 0) { $terminal = $true; break }
+            if ($wait -ne 258) { throw ('Negative control process wait returned unexpected result ' + [string]$wait) }
+        }
+        if (-not $terminal) {
+            if (-not [SafeUpload.HarnessGate.Native]::TerminateAndWait($control, [uint32]0xE5F7, [uint32]20000)) {
+                throw 'Negative control process did not become terminal through its exact handle.'
+            }
+            throw 'Negative control exceeded its monotonic deadline.'
+        }
+        $exitCode = [uint32][SafeUpload.HarnessGate.Native]::ExitCode($control)
+        $stdoutText = Read-R18BoundedText $stdoutPath 65536
+        $stderrText = Read-R18BoundedText $stderrPath 65536
+        if ($exitCode -eq 0 -or $stdoutText.Length -ne 0 -or
+            -not $stderrText.Contains($ExpectedErrorSubstring)) {
+            throw ('Negative control did not fail at its pinned identity guard: ' + $FailureTag)
+        }
+        return [pscustomobject]@{ ExitCode = $exitCode; Stdout = $stdoutText; Stderr = $stderrText }
+    } finally {
+        [SafeUpload.HarnessGate.Native]::CloseChild($control)
+    }
+}
