+        [long]$State.keeperStartFiletime -ne $OriginalKeeperStartFiletime) {
+        throw 'Pre-resume CANCEL no longer matches its original durable keeper PID and creation FILETIME.'
+    }
+    if ([uint32]$State.workerPid -ne 0 -or [long]$State.workerStartFiletime -ne 0 -or
+        $MainSnapshot.Active -ne 0 -or $MainSnapshot.Ids.Length -ne 0) {
+        throw 'Pre-ready CANCEL requires no published worker and an exactly empty main job.'
+    }
+    if ($null -eq $KeeperProcess -or $KeeperProcess.ProcessHandle -eq [IntPtr]::Zero -or
+        [uint32]$KeeperProcess.ProcessId -eq 0 -or [long]$KeeperProcess.StartFileTime -le 0 -or
+        [uint32]$State.keeperPid -ne [uint32]$KeeperProcess.ProcessId -or
+        [long]$State.keeperStartFiletime -ne [long]$KeeperProcess.StartFileTime -or
