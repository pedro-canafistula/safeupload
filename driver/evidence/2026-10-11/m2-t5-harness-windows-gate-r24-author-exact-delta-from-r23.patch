+function Assert-PreReadyCancelKeeperIdentity($State, [string]$OriginalPhase,
+    [uint32]$OriginalKeeperPid, [long]$OriginalKeeperStartFiletime,
+    $MainSnapshot, $KeeperSnapshot, $KeeperProcess,
+    [IntPtr]$MainJobHandle, [IntPtr]$KeeperJobHandle, [string]$KeeperPath) {
+    if ($Mode -cne 'CANCEL') { throw 'Pre-ready keeper recovery is available only to CANCEL.' }
+    if ($MainJobHandle -eq [IntPtr]::Zero -or $KeeperJobHandle -eq [IntPtr]::Zero) {
+        throw 'Pre-ready CANCEL requires both exact held named job handles.'
+    }
+    [void][SafeUpload.HarnessGate.Native]::VerifyKillOnCloseJob($MainJobHandle)
+    [void][SafeUpload.HarnessGate.Native]::VerifyKillOnCloseJob($KeeperJobHandle)
+    if ($State.schema -cne 'safeupload-harness-gate-run-v2' -or
+        $State.runToken -cne $RunToken -or $State.status -cne 'RUNNING' -or
+        $State.jobName -cne (Get-HarnessGateJobName $RunToken) -or
+        $State.keeperJobName -cne (Get-HarnessGateKeeperJobName $RunToken) -or
+        [string]::Equals([string]$State.keeperPath, $KeeperPath, [StringComparison]::OrdinalIgnoreCase) -eq $false) {
+        throw 'Pre-ready CANCEL state does not bind this exact run token, two named jobs, and keeper path.'
+    }
+    $expectedPostOpenPhase = if ($OriginalPhase -ceq 'JOBS_CREATED') {
+        'CANCEL_RECOVERED_KEEPER_IDENTITY'
+    } elseif ($OriginalPhase -ceq 'KEEPER_IDENTITY_DURABLE') {
+        'KEEPER_IDENTITY_DURABLE'
+    } else {
+        throw 'Pre-ready CANCEL original phase is not one of the two exact keeper startup barriers.'
+    }
+    if ([string]$State.phase -cne $expectedPostOpenPhase -or
+        [string]$State.keeperReadyPath -cne (Get-HarnessGateKeeperReadyPath $RunToken) -or
+        $null -eq $State.PSObject.Properties['keeperReadySha256'] -or
+        $null -eq $State.keeperReadySha256 -or
+        [string]$State.keeperReadySha256 -cne '' -or
+        (Test-Path -LiteralPath ([string]$State.keeperReadyPath) -ErrorAction Stop)) {
+        throw 'Pre-ready CANCEL state or absent-readiness evidence is not exact.'
+    }
+    if ($OriginalPhase -ceq 'JOBS_CREATED') {
+        if ($OriginalKeeperPid -ne 0 -or $OriginalKeeperStartFiletime -ne 0 -or
+            [uint32]$State.keeperPid -eq 0 -or [long]$State.keeperStartFiletime -le 0) {
+            throw 'Pre-publication CANCEL did not recover one exact keeper from an originally empty identity.'
+        }
+    } elseif ($OriginalKeeperPid -eq 0 -or $OriginalKeeperStartFiletime -le 0 -or
