+function Start-R18AmbiguousKeeperChild([IntPtr]$KeeperJobHandle, [IntPtr]$FixtureJobHandle,
+    [string]$PowerShellPath, [string]$CasePrefix) {
+    $stdoutPath = $CasePrefix + '.ambiguous-keeper.stdout.bin'
+    $stderrPath = $CasePrefix + '.ambiguous-keeper.stderr.bin'
+    if ((Test-Path -LiteralPath $stdoutPath) -or (Test-Path -LiteralPath $stderrPath)) {
+        throw 'Ambiguous keeper test evidence path is already occupied.'
+    }
+    $scriptText = 'while ($true) { [System.Threading.Thread]::Sleep(1000) }'
+    $encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($scriptText))
+    $arguments = @('-NoProfile', '-NonInteractive', '-OutputFormat', 'Text',
+        '-ExecutionPolicy', 'Bypass', '-EncodedCommand', $encoded)
+    $child = [SafeUpload.HarnessGate.Native]::StartSuspendedInJob(
+        $KeeperJobHandle, $PowerShellPath, [string[]]$arguments, $env:USERPROFILE, $stdoutPath, $stderrPath)
+    try {
+        if ([uint32]$child.ProcessId -eq 0 -or [long]$child.StartFileTime -le 0 -or
+            -not [SafeUpload.HarnessGate.Native]::IsProcessHandleInJob($child.ProcessHandle, $KeeperJobHandle) -or
+            -not [SafeUpload.HarnessGate.Native]::IsProcessHandleInJob($child.ProcessHandle, $FixtureJobHandle)) {
+            throw 'Ambiguous keeper negative-control process has no exact identity or is outside its held jobs.'
+        }
+        [void][SafeUpload.HarnessGate.Native]::ResumeChild($child)
+        $wait = [SafeUpload.HarnessGate.Native]::WaitHandle($child.ProcessHandle, [uint32]0)
+        if ($wait -ne 258) { throw 'Ambiguous keeper negative-control process did not remain active on its exact handle.' }
+        return $child
+    } catch {
+        try { [void][SafeUpload.HarnessGate.Native]::TerminateAndWait($child, [uint32]0xE5F8, [uint32]20000) } catch { }
+        [SafeUpload.HarnessGate.Native]::CloseChild($child)
+        throw
+    }
+}
