+    def test_selected_nvram_only_hashes_reports_exact_file_and_ignores_bad_sibling(self):
+        target = '/tmp/t5-source/nvram'
+        selected = FakeVolume('win10-debug3_VARS.fd', target + '/win10-debug3_VARS.fd', b'firmware')
+        selected.xml = volume_xml(selected._name, selected._path, owner='958', group='958',
+                                  capacity=len(selected.content), physical=len(selected.content),
+                                  allocation=len(selected.content))
+        sibling = FakeVolume('other-domain_VARS.fd', target + '/other-domain_VARS.fd',
+                             b'not a valid firmware volume')
+        sibling.xml = '<malformed sibling volume XML'
+        conn = FakeConnection([sibling, selected])
+        preserve = inventory._preserve_module()
+        expected = {'sha256': hashlib.sha256(selected.content).hexdigest(), 'bytes': len(selected.content),
+                    'virtual_capacity': len(selected.content), 'allocation': len(selected.content),
+                    'physical_bytes': len(selected.content)}
+        hashed = []
+
+        def hash_only_selected(_conn, volume):
+            hashed.append(volume.name())
+            if volume is not selected:
+                raise AssertionError('unrelated NVRAM sibling was streamed')
+            return expected
+
+        with mock.patch.object(preserve, 'volume_sha256', side_effect=hash_only_selected):
+            result = inventory.inspect_directory(conn, 'CheckTag', 'nvram', target,
+                                                 target + '/win10-debug3_VARS.fd')
+        self.assertEqual(hashed, ['win10-debug3_VARS.fd'])
+        self.assertEqual([row['Path'] for row in result['Files']],
+                         [target + '/win10-debug3_VARS.fd'])
+        self.assertNotIn('other-domain_VARS.fd', repr(result))
+        self.assertEqual(sibling.xml_reads, 0)
+        self.assertEqual(sibling.info_reads, 0)
+        self.assertEqual(selected.xml_reads, 2)
+        self.assertEqual(conn.pools, [])
+        self.assertTrue(result['SiblingNamesEnumerated'])
+
+        duplicate_a = FakeVolume('win10-debug3_VARS.fd', target + '/win10-debug3_VARS.fd', b'a')
+        duplicate_b = FakeVolume('win10-debug3_VARS.fd', target + '/win10-debug3_VARS.fd', b'b')
+        duplicate_a.xml = volume_xml(duplicate_a._name, duplicate_a._path, owner='958', group='958',
+                                     capacity=1, physical=1, allocation=1)
+        duplicate_b.xml = volume_xml(duplicate_b._name, duplicate_b._path, owner='958', group='958',
+                                     capacity=1, physical=1, allocation=1)
+        conn = FakeConnection([duplicate_a, duplicate_b])
+        with mock.patch.object(preserve, 'volume_sha256') as hash_volume:
+            with self.assertRaisesRegex(inventory.InventoryError, 'exactly once'):
+                inventory.inspect_directory(conn, 'CheckTag', 'nvram', target,
+                                            target + '/win10-debug3_VARS.fd')
+            hash_volume.assert_not_called()
+        self.assertEqual(duplicate_a.xml_reads, 0)
+        self.assertEqual(duplicate_b.xml_reads, 0)
+        self.assertEqual(conn.pools, [])
+
+    def _run_inventory_with_after_snapshot(self, after_snapshot, fresh_nvram_metadata=None,
+                                          observed_pools=None):
+        preserve = inventory._preserve_module()
+        repo_root = HELPER_PATH.parents[3]
+        baseline = preserve.load_pinned_receipts(repo_root)[0]['InactiveXML']
+        metadata_by_key = {
+            'NVRAMMetadata': {'Path': inventory.NVRAM_PATH, 'PinnedIdentity': 'nvram'},
+            'SwtpmRootMetadata': {'Path': inventory.SWTPM_ROOT, 'PinnedIdentity': 'swtpm-root'},
+            'SwtpmDomainMetadata': {'Path': str(Path(inventory.SWTPM_ROOT) / inventory.DOMAIN_UUID),
+                                    'PinnedIdentity': 'swtpm-domain'},
+            'TPMMetadata': {'Path': inventory.TPM_STATE_DIRECTORY, 'PinnedIdentity': 'tpm-state'},
+        }
+        path_pins = dict(metadata_by_key)
+        path_pins['Pinned'] = True
+        metadata_calls = {}
+        before_snapshot = {'state': 5, 'reason': 0, 'state_name': 'shutoff',
+                           'active': False, 'inactive_xml': baseline}
+        events = []
+        conn = FakeConnection([])
+        libvirt = SimpleNamespace(VIR_DOMAIN_SHUTOFF=5)
+        args = SimpleNamespace(tag='CheckTag', repo_root=str(repo_root), state_dir=None,
+                               lifecycle_lock_fd=9, owner_pid=1234)
+        with tempfile.TemporaryDirectory(prefix='t5-inventory-endpoints-') as temporary:
+            args.state_dir = temporary
+
+            def snapshot(_conn, _libvirt):
+                events.append('snapshot')
+                if events.count('snapshot') == 1:
+                    return before_snapshot
+                return after_snapshot
+
+            def inspect(_conn, _tag, kind, _target, _selected_path=None):
+                events.append(kind)
+                if observed_pools is not None:
+                    observed_pools.append(kind)
+                return {'PoolName': 't5-inventory-CheckTag-' + kind,
+                        'Selected': {'SHA256': 'a' * 64, 'StreamBytes': 540672}}
+
+            def metadata(path, _expect_directory):
+                key = next(key for key, value in metadata_by_key.items() if value['Path'] == path)
+                count = metadata_calls.get(key, 0)
+                metadata_calls[key] = count + 1
+                if key == 'NVRAMMetadata' and count == 0 and fresh_nvram_metadata is not None:
+                    return fresh_nvram_metadata
+                return metadata_by_key[key]
+
+            with mock.patch.object(preserve, 'require_lifecycle_lock', return_value={'Held': True}), \
+                    mock.patch.object(preserve, 'open_connection', return_value=(libvirt, conn)), \
+                    mock.patch.object(preserve, 'domain_snapshot', side_effect=snapshot), \
+                    mock.patch.object(inventory, 'validate_pinned_paths', return_value=path_pins), \
+                    mock.patch.object(inventory, '_verify_runtime_version', return_value={'Pinned': True}), \
+                    mock.patch.object(inventory, 'inspect_directory', side_effect=inspect), \
+                    mock.patch.object(inventory, 'object_metadata', side_effect=metadata):
+                result = inventory.inventory(args)
+        return result, events, conn
+
+    def test_final_domain_endpoint_is_after_pools_and_marks_partial_nonatomic_result(self):
+        preserve = inventory._preserve_module()
+        repo_root = HELPER_PATH.parents[3]
+        baseline = preserve.load_pinned_receipts(repo_root)[0]['InactiveXML']
+        after = {'state': 5, 'reason': 0, 'state_name': 'shutoff',
+                 'active': False, 'inactive_xml': baseline}
+        result, events, conn = self._run_inventory_with_after_snapshot(after)
+        self.assertEqual(events, ['snapshot', 'nvram', 'tpm', 'snapshot'])
+        self.assertTrue(conn.closed)
+        self.assertEqual(result['Status'], 'PARTIAL_READONLY_OBSERVATION_NOT_ATOMIC')
+        self.assertTrue(result['NoHelperSourceMutations'])
+        self.assertFalse(result['SourceByteStabilityProven'])
+        self.assertFalse(result['AtomicSnapshotProven'])
+        self.assertFalse(result['ConcurrentStartExclusionProven'])
+        self.assertFalse(result['StartStopBetweenEndpointsExcluded'])
+        self.assertNotIn('SourceStateUnchangedDuringInventory', result)
+        self.assertNotIn('SourceVolumesChanged', result)
+        self.assertTrue(result['DomainEndpointObservation']['EndpointsMatch'])
+
+    def test_fresh_source_metadata_drift_fails_before_any_pool_creation(self):
+        preserve = inventory._preserve_module()
+        repo_root = HELPER_PATH.parents[3]
+        baseline = preserve.load_pinned_receipts(repo_root)[0]['InactiveXML']
+        after = {'state': 5, 'reason': 0, 'state_name': 'shutoff',
+                 'active': False, 'inactive_xml': baseline}
+        observed_pools = []
