--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/debuggees.txt
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/debuggees.txt
@@ -0,0 +1,8 @@
+# The only debuggee VMs harness scripts may target: libvirt domain, guest address.
+# Select one with SAFEUPLOAD_DEBUGGEE=<domain> (default win10-debug). All are clones of
+# the same clean 19045.2965 disk with the same memory size; see driver/MVP-PLAN.md. Their SMBIOS
+# UUIDs are pinned in Get-StagedBaseline.ps1 and Test-StagedInvariantSuite.ps1 (Assert-Platform).
+win10-debug 192.168.122.51
+win10-debug2 192.168.122.52
+win10-debug3 192.168.122.53
+win10-debug4 192.168.122.54
===== driver/scripts/image-store.sh (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/image-store.sh
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/image-store.sh
@@ -0,0 +1,19 @@
+# Sourced by the harness scripts (needs $V = "virsh -c qemu:///system").
+# VM overlays are created next to the domain's current disk (see run-disk.sh: each run's overlay is deleted when the run ends).
+# The main disk may hold them (the owner allows it when it is faster) but nothing may pile up: a directory whose filesystem has
+# less than SAFEUPLOAD_MIN_FREE_GB (default 20) free is refused.
+image_dir_of_domain() {  # $1 domain -> directory of its current top disk
+    dirname "$($V dumpxml "$1" | grep -o "source file='[^']*'" | head -1 | cut -d"'" -f2)"
+}
+image_pool_of() {  # $1 directory -> libvirt pool whose target path it is
+    local p
+    for p in $($V pool-list --name); do
+        [ "$($V pool-dumpxml "$p" | sed -n 's:.*<path>\(.*\)</path>.*:\1:p' | head -1)" = "$1" ] && { echo "$p"; return 0; }
+    done
+    return 1
+}
+image_dir_check() {  # $1 directory
+    local free min=${SAFEUPLOAD_MIN_FREE_GB:-20}
+    free=$(df --output=avail -BG "$1" | tail -1 | tr -dc '0-9')
+    [ "${free:-0}" -ge "$min" ] || { echo "REFUSED: $1 has ${free} GB free, need $min (delete finished run files first)" >&2; return 1; }
+}
===== driver/scripts/remote_ps.py (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/remote_ps.py
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/remote_ps.py
@@ -0,0 +1,44 @@
+#!/usr/bin/env python3
+"""Run a stdin PowerShell script on the two recorded disposable test VMs."""
+import base64
+import subprocess
+import sys
+
+import pathlib
+# Snapshotted tool copies (exact agent matrix) carry no debuggees.txt: then only the builder is reachable.
+_list = pathlib.Path(__file__).resolve().parent / "debuggees.txt"
+DEBUGGEES = {line.split()[1] for line in (_list.read_text().splitlines() if _list.is_file() else [])
+             if line.strip() and not line.startswith("#")}
+if len(sys.argv) != 2 or sys.argv[1] not in DEBUGGEES | {"192.168.122.210"}:
+    raise SystemExit("Expected a recorded SafeUpload debuggee (debuggees.txt) or the builder address")
+# A PowerShell source file may carry a UTF-8 BOM. Remove its leading marker
+# before prepending our progress preference, so it cannot become an interior token.
+script = sys.stdin.read().removeprefix("\ufeff")
+if not script.strip():
+    raise SystemExit("No PowerShell input")
+script = "$global:ProgressPreference = 'SilentlyContinue'\n" + script
+# Suppress module progress globally and request text when OpenSSH invokes a PowerShell shell,
+# keeping serialized progress records from interleaving with stdout evidence.
+SSH = ["-F", "/dev/null", "-i", "/home/victor/.ssh/id_ed25519",
+       "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", "-o", "LogLevel=ERROR", "-o", "StrictHostKeyChecking=yes"]
+PREFIX = "powershell.exe -NoProfile -NonInteractive -OutputFormat Text -ExecutionPolicy Bypass "
+command = PREFIX + "-EncodedCommand " + base64.b64encode(script.encode("utf-16le")).decode()
+if len(command) > 7000:
+    # Windows OpenSSH runs the command through cmd.exe, which caps a command line at 8,191 characters, and -EncodedCommand
+    # inflates the script ~2.7x ("The command line is too long": S00 attempt 2, the guest cleanup script). Larger scripts go up as a UTF-8 BOM file (PowerShell 5.1 reads
+    # BOM-less files as ANSI), run with -File, and are removed; the script's exit code is passed through.
+    import os, tempfile, uuid
+    name = "remote_ps_" + uuid.uuid4().hex + ".ps1"
+    with tempfile.NamedTemporaryFile("w", encoding="utf-8-sig", suffix=".ps1", delete=False) as handle:
+        handle.write(script)
+        local = handle.name
+    try:
+        if subprocess.call(["scp"] + SSH + [local, "vika@" + sys.argv[1] + ":C:/Users/vika/AppData/Local/Temp/" + name]) != 0:
+            raise SystemExit("Could not stage the long script on the guest")
+    finally:
+        os.unlink(local)
+    remote = "C:\\Users\\vika\\AppData\\Local\\Temp\\" + name
+    runner = ("$p='" + remote + "'; try { & powershell.exe -NoProfile -NonInteractive -OutputFormat Text -ExecutionPolicy Bypass "
+              "-File $p; $code = $LASTEXITCODE } finally { Remove-Item -LiteralPath $p -Force -ErrorAction SilentlyContinue }; exit $code")
+    command = PREFIX + "-EncodedCommand " + base64.b64encode(runner.encode("utf-16le")).decode()
+raise SystemExit(subprocess.call(["ssh"] + SSH + ["vika@" + sys.argv[1], command]))
===== driver/scripts/run-disk.sh (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/run-disk.sh
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/run-disk.sh
@@ -0,0 +1,312 @@
+# Sourced by the harness runners (needs $V = "virsh -c qemu:///system" and image-store.sh).
+# Disposable run disks. A debuggee idles SHUT OFF on its base disk, and no run ever writes the base. run_disk_begin creates a fresh qcow2
+# overlay on the base, points the domain at it and starts the guest. run_disk_end normally powers the guest off, points the domain back at
+# the base and deletes every file the run stacked above the base (the run overlay and any live checkpoint taken during the run). T5's
+# incomplete-evidence preservation path leaves a retention marker and blocks both shared functions until its archive and restoration checks
+# finish. The evidence of a complete run is copied off the guest over SSH before run_disk_end.
+# State: $RUN_DISK_STATE/<domain> names the base, the run overlay, the tag and the base's mtime and size (checked unchanged at the end).
+# Overlays go next to the base unless SAFEUPLOAD_RUN_DISK_DIR names another libvirt pool directory; SAFEUPLOAD_MIN_FREE_GB (default 20)
+# is the free space the overlay's filesystem must have before a run starts.
+RUN_DISK_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/safeupload/run-disks"
+
+_rd_log() { printf '%s run-disk %s\n' "$(date -u +%FT%TZ)" "$*"; }
+_rd_lock_path() { printf '%s/%s.lifecycle.lock' "$RUN_DISK_STATE" "$1"; }
+_rd_lock_is_held() {
+    if [ "$1" = win10-debug3 ] && [ "${RUN_DISK_LOCK_KIND:-}" = root-supervisor ]; then
+        [ "${RUN_DISK_LOCK_HELD:-}" = yes ] &&
+            [ "${RUN_DISK_LOCK_DOMAIN:-}" = "$1" ] &&
+            [[ "${T5_LIFECYCLE_LEASE_FD:-}" =~ ^[0-9]+$ ]] || return 1
+        local code_root=${T5_LIFECYCLE_CODE_ROOT:-}
+        [ -n "$code_root" ] || return 1
+        /usr/bin/python3.14 -I -S -B \
+            "$code_root/driver/scripts/t5/T5WritableStateLifecycle.py" \
+            validate-child --lease-fd "$T5_LIFECYCLE_LEASE_FD" \
+            --tag "${RUN_DISK_LOCK_TAG:-invalid}" >/dev/null 2>&1
+        return $?
+    fi
+    [ "${RUN_DISK_LOCK_HELD:-}" = yes ] && [ "${RUN_DISK_LOCK_DOMAIN:-}" = "$1" ] &&
+        [[ "${RUN_DISK_LOCK_FD:-}" =~ ^[0-9]+$ ]]
+}
+_rd_lock_acquire() {  # held by this shell until _rd_lock_release; T5 spans its whole lifecycle
+    local dom=$1 path fd mode owner
+    if _rd_lock_is_held "$dom"; then return 0; fi
+    if [ "${RUN_DISK_LOCK_HELD:-}" = yes ]; then
+        _rd_log "$dom: this shell already holds the run-disk lock for ${RUN_DISK_LOCK_DOMAIN:-unknown}"
+        return 1
+    fi
+    if [ "$dom" = win10-debug3 ]; then
+        [[ "${T5_LIFECYCLE_LEASE_FD:-}" =~ ^[0-9]+$ ]] || {
+            _rd_log 'selected T5 run-disk mutation requires the root supervisor lease'; return 1;
+        }
+        local code_root=${T5_LIFECYCLE_CODE_ROOT:-}
+        [ -n "$code_root" ] || { _rd_log 'selected T5 immutable code root is absent'; return 1; }
+        /usr/bin/python3.14 -I -S -B \
+            "$code_root/driver/scripts/t5/T5WritableStateLifecycle.py" \
+            validate-child --lease-fd "$T5_LIFECYCLE_LEASE_FD" --tag "$2" \
+            >/dev/null 2>&1 || {
+            _rd_log 'selected T5 root lifecycle lease validation failed'; return 1;
+        }
+        mkdir -p "$RUN_DISK_STATE" || return 1
+        path=$(_rd_lock_path "$dom")
+        if [ -e "$path" ] || [ -L "$path" ]; then
+            _rd_log "$dom: legacy user lifecycle lock exists; refusing split lock domains"
+            return 1
+        fi
+        RUN_DISK_LOCK_FD=root-supervisor
+        RUN_DISK_LOCK_DOMAIN=$dom
+        RUN_DISK_LOCK_TAG=$2
+        RUN_DISK_LOCK_KIND=root-supervisor
+        RUN_DISK_LOCK_HELD=yes
+        return 0
+    fi
+    mkdir -p "$RUN_DISK_STATE" || return 1
+    [ ! -L "$RUN_DISK_STATE" ] || { _rd_log "run-disk state directory is a symlink"; return 1; }
+    path=$(_rd_lock_path "$dom")
+    [ ! -L "$path" ] || { _rd_log "$dom: lifecycle lock path is a symlink"; return 1; }
+    (umask 077; : >> "$path") || return 1
+    [ -f "$path" ] && [ ! -L "$path" ] || { _rd_log "$dom: lifecycle lock is not a regular file"; return 1; }
+    mode=$(stat -c '%a' "$path") || return 1
+    owner=$(stat -c '%u' "$path") || return 1
+    [ "$mode" = 600 ] && [ "$owner" = "$(id -u)" ] || {
+        _rd_log "$dom: lifecycle lock must be owned by this user with mode 0600"; return 1;
+    }
+    exec {fd}>>"$path" || return 1
+    if ! flock -n -x "$fd"; then
+        eval "exec ${fd}>&-"
+        _rd_log "$dom: another run-disk lifecycle holds the per-domain lock"
+        return 1
+    fi
+    RUN_DISK_LOCK_FD=$fd
+    RUN_DISK_LOCK_DOMAIN=$dom
+    RUN_DISK_LOCK_HELD=yes
+}
+_rd_lock_release() {
+    local fd=${RUN_DISK_LOCK_FD:-}
+    [ "${RUN_DISK_LOCK_HELD:-}" = yes ] || return 0
+    if [ "${RUN_DISK_LOCK_KIND:-}" = root-supervisor ]; then
+        _rd_lock_is_held "${RUN_DISK_LOCK_DOMAIN:-}" || return 1
+        unset RUN_DISK_LOCK_FD RUN_DISK_LOCK_DOMAIN RUN_DISK_LOCK_TAG \
+            RUN_DISK_LOCK_KIND RUN_DISK_LOCK_HELD
+        return 0
+    fi
+    [[ "$fd" =~ ^[0-9]+$ ]] || return 1
+    flock -u "$fd" || return 1
+    eval "exec ${fd}>&-"
+    unset RUN_DISK_LOCK_FD RUN_DISK_LOCK_DOMAIN RUN_DISK_LOCK_HELD
+}
+_rd_owned_progress_guard() {  # domain/tag: accept only this shell's exact durable T5 guard token
+    local dom=$1 tag=$2 token=${RUN_DISK_T5_GUARD_TOKEN:-} marker="$RUN_DISK_STATE/$1.t5-inprogress"
+    [ "${RUN_DISK_T5_GUARD_ACTIVE:-}" = yes ] && [ "${RUN_DISK_T5_GUARD_DOMAIN:-}" = "$dom" ] &&
+        [ "${RUN_DISK_T5_GUARD_TAG:-}" = "$tag" ] && [[ "$token" =~ ^[A-Fa-f0-9]{32}$ ]] || return 1
+    python3 -I - "$marker" "$dom" "$tag" "$token" "$$" <<'PY'
+import json, os, stat, sys
+path, domain, tag, token, pid = sys.argv[1:]
+try:
+    st = os.lstat(path)
+    if not stat.S_ISREG(st.st_mode) or stat.S_IMODE(st.st_mode) != 0o600 or st.st_uid != os.getuid():
+        raise ValueError('unsafe progress marker metadata')
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result: raise ValueError('duplicate key')
+            result[key] = value
+        return result
+    with open(path, encoding='utf-8') as stream: row = json.load(stream, object_pairs_hook=unique)
+    ok = (row.get('Schema') == 'T5InProgressV1' and row.get('Domain') == domain and
+          row.get('RunTag') == tag and row.get('Token') == token and row.get('PID') == int(pid))
+    raise SystemExit(0 if ok else 1)
+except Exception:
+    raise SystemExit(1)
+PY
+}
+_rd_mutation_guard() {  # domain/tag -> block active preservation or another process's in-progress T5 run
+    local dom=$1 tag=$2 retention progress
+    retention="$RUN_DISK_STATE/$dom.t5-retention"
+    progress="$RUN_DISK_STATE/$dom.t5-inprogress"
+    if [ -e "$retention" ] || [ -L "$retention" ]; then
+        _rd_log "$dom: retained-state marker is active at $retention; run-disk begin/end is blocked"
+        return 1
+    fi
+    if [ -e "$progress" ] || [ -L "$progress" ]; then
+        _rd_owned_progress_guard "$dom" "$tag" && return 0
+        _rd_log "$dom: durable T5 in-progress marker is active at $progress; run-disk begin/end is blocked"
+        return 1
+    fi
+}
+_rd_vda() {  # $1 domain, $2 "--inactive" or "" -> file of the vda disk
+    $V dumpxml $2 "$1" | python3 -I -c '
+import sys, xml.etree.ElementTree as ET
+for d in ET.fromstring(sys.stdin.read()).iter("disk"):
+    t = d.find("target"); s = d.find("source")
+    if d.get("device") == "disk" and t is not None and t.get("dev") == "vda":
+        print(s.get("file", "") if s is not None else ""); break'
+}
+_rd_vol() {  # $1 path, $2 field (backing | format | capacity) -> value from the volume's libvirt description
+    local pool; pool=$(image_pool_of "$(dirname "$1")") || { echo "no libvirt pool for $(dirname "$1")" >&2; return 1; }
+    $V pool-refresh "$pool" >/dev/null && $V vol-dumpxml --pool "$pool" "$(basename "$1")" | python3 -I -c '
+import sys, xml.etree.ElementTree as ET
+r = ET.fromstring(sys.stdin.read()); f = sys.argv[1]
+if f == "backing":
+    p = r.find("backingStore/path"); print(p.text if p is not None and p.text else "")
+elif f == "format":
+    print(r.find("target/format").get("type"))
+else:
+    print(r.find("capacity").text)' "$2"
+}
+_rd_repoint() {  # $1 domain, $2 file: the persistent definition's vda now names $2 (the domain must be shut off)
+    local xml rc; xml=$(mktemp)
+    $V dumpxml --inactive "$1" > "$xml"
+    python3 -I - "$2" "$xml" <<'PY'
+import sys, xml.etree.ElementTree as ET
+t = ET.parse(sys.argv[2]); n = 0
+for d in t.getroot().iter('disk'):
+    tg = d.find('target')
+    if d.get('device') == 'disk' and tg is not None and tg.get('dev') == 'vda':
+        d.find('source').set('file', sys.argv[1]); bs = d.find('backingStore')
+        if bs is not None: d.remove(bs)
+        n += 1
+if n != 1: raise SystemExit('expected exactly one vda disk, found %d' % n)
+t.write(sys.argv[2])
+PY
+    rc=$?; [ $rc -eq 0 ] && { $V define "$xml" >/dev/null; rc=$?; }
+    rm -f "$xml"; [ $rc -eq 0 ] && [ "$(_rd_vda "$1" --inactive)" = "$2" ]
+}
+_rd_named_elsewhere() {  # $1 domain, $2 file -> success if any OTHER domain's definition names the file
+    local d
+    for d in $($V list --all --name); do
+        [ "$d" = "$1" ] && continue
+        { $V dumpxml "$d"; $V dumpxml --inactive "$d"; } 2>/dev/null | grep -qF "'$2'" && return 0
+    done
+    return 1
+}
+_rd_shutdown() {  # $1 domain, running on its base: shut Windows down from inside, so the base stays a clean shutdown
+    local host; host=$(awk -v d="$1" '$1==d{print $2}' driver/scripts/debuggees.txt)
+    [ -n "$host" ] && python3 driver/scripts/remote_ps.py "$host" <<<'Stop-Computer -Force' >/dev/null 2>&1
+    for _ in $(seq 1 60); do [ "$($V domstate "$1")" = "shut off" ] && return 0; sleep 5; done
+    $V shutdown "$1" >/dev/null 2>&1
+    for _ in $(seq 1 60); do [ "$($V domstate "$1")" = "shut off" ] && return 0; sleep 5; done
+    _rd_log "$1 did not shut down; refusing to power off a guest that runs on its base"; return 1
+}
+
+_run_disk_begin_locked() {  # called only while the per-domain lock is held
+    local dom=$1 tag=$2 state base dir pool fmt cap ov xml free min
+    mkdir -p "$RUN_DISK_STATE"; state="$RUN_DISK_STATE/$dom"
+    if [ -e "$state" ] || [ -L "$state" ]; then
+        _rd_log "$dom: stale or active run state exists; refusing automatic discard (inspect and recover it explicitly)"
+        return 1
+    fi
+    if [ "$dom" = win10-debug3 ] && [ "${RUN_DISK_LOCK_KIND:-}" = root-supervisor ]; then
+        local lease_fd=${T5_LIFECYCLE_LEASE_FD:-} gate_fd=${T5_RUN_BINDING_GATE_FD:-}
+        local code_root=${T5_LIFECYCLE_CODE_ROOT:-} response
+        [[ "$lease_fd" =~ ^[0-9]+$ && "$gate_fd" =~ ^[0-9]+$ && -n "$code_root" ]] || {
+            _rd_log 'selected T5 root supervisor lease or control channel is absent'; return 1;
+        }
+        response=$(/usr/bin/python3.14 -I -S -B \
+            "$code_root/driver/scripts/t5/T5WritableStateRunBinding.py" begin \
+            --lease-fd "$lease_fd" --gate-fd "$gate_fd" --tag "$tag") || return 1
+        IFS=$'\t' read -r base ov stat0 < <(/usr/bin/python3.14 -I -S -B -c '
+import json, re, sys
+try:
+ row=json.loads(sys.stdin.read())
+ assert row.get("Schema")=="T5RunControlResponseV1" and row.get("Command")=="BEGIN" and row.get("Status")=="PASS"
+ assert all(isinstance(row.get(k),str) and "\n" not in row[k] and "\r" not in row[k] for k in ("BasePath","OverlayPath","BaseStat"))
+ assert re.fullmatch(r"[0-9]+ [0-9]+",row["BaseStat"])
+ print(row["BasePath"]+"\t"+row["OverlayPath"]+"\t"+row["BaseStat"])
+except Exception: raise SystemExit(1)
+' <<<"$response") || { _rd_log 'root BEGIN response failed strict field validation'; return 1; }
+        [ -n "$base" ] && [ -n "$ov" ] || return 1
+        (umask 077; printf 'base=%s\noverlay=%s\ntag=%s\nbasestat=%s\n' \
+            "$base" "$ov" "$tag" "$stat0" > "$state") || return 1
+        /usr/bin/python3.14 -I -S -B \
+            "$code_root/driver/scripts/t5/T5WritableStateRunBinding.py" prestart \
+            --lease-fd "$lease_fd" --gate-fd "$gate_fd" --tag "$tag" || return 1
+        _rd_log "$dom: root supervisor created and started run $tag on $ov (base $base)"
+        return 0
+    fi
+    [ "$($V domstate "$dom")" = "shut off" ] || _rd_shutdown "$dom" || return 1
+    base=$(_rd_vda "$dom" --inactive)
+    case "$(basename "$base")" in *.safeupload-run-*|*.safeupload-pre-*)
+        _rd_log "$dom: its disk $base is a run file with no run state; end that run by hand first"; return 1;; esac
+    [ -e "$base" ] || { _rd_log "$dom: base $base does not exist"; return 1; }
+    dir=${SAFEUPLOAD_RUN_DISK_DIR:-$(dirname "$base")}
+    pool=$(image_pool_of "$dir") || { _rd_log "no libvirt pool for $dir"; return 1; }
+    free=$(df --output=avail -BG "$dir" | tail -1 | tr -dc '0-9'); min=${SAFEUPLOAD_MIN_FREE_GB:-20}
+    [ "${free:-0}" -ge "$min" ] || { _rd_log "$dir has ${free} GB free, need $min"; return 1; }
+    fmt=$(_rd_vol "$base" format) && cap=$(_rd_vol "$base" capacity) || return 1
+    ov="$dom.safeupload-run-$tag.qcow2"
+    [ -e "$dir/$ov" ] && { _rd_log "$dir/$ov already exists"; return 1; }
+    xml=$(mktemp)
+    printf "<volume><name>%s</name><capacity unit='bytes'>%s</capacity><target><format type='qcow2'/></target><backingStore><path>%s</path><format type='%s'/></backingStore></volume>\n" \
+        "$ov" "$cap" "$base" "$fmt" > "$xml"
+    $V vol-create "$pool" "$xml" >/dev/null; local rc=$?; rm -f "$xml"; [ $rc -eq 0 ] || return 1
+    printf 'base=%s\noverlay=%s\ntag=%s\nbasestat=%s\n' "$base" "$dir/$ov" "$tag" "$(stat -c '%Y %s' "$base")" > "$state"
+    _rd_repoint "$dom" "$dir/$ov" || { _rd_log "$dom: could not point the domain at $dir/$ov"; return 1; }
+    $V start "$dom" >/dev/null || return 1
+    _rd_log "$dom: run $tag on $dir/$ov (base $base)"
+}
+
+_run_disk_end_locked() {  # called only while the per-domain lock is held
+    local dom=$1 tag=$2 state base ov stat0 top cur n f p files=()
+    state="$RUN_DISK_STATE/$dom"; [ -f "$state" ] || { _rd_log "$dom: no run state"; return 1; }
+    base=$(sed -n 's/^base=//p' "$state"); ov=$(sed -n 's/^overlay=//p' "$state"); stat0=$(sed -n 's/^basestat=//p' "$state")
+    [ "$(sed -n 's/^tag=//p' "$state")" = "$tag" ] || { _rd_log "$dom: the open run is $(sed -n 's/^tag=//p' "$state"), not $tag"; return 1; }
+    if [ "$dom" = win10-debug3 ] && [ "${RUN_DISK_LOCK_KIND:-}" = root-supervisor ]; then
+        local lease_fd=${T5_LIFECYCLE_LEASE_FD:-} gate_fd=${T5_RUN_BINDING_GATE_FD:-}
+        local code_root=${T5_LIFECYCLE_CODE_ROOT:-}
+        [[ "$lease_fd" =~ ^[0-9]+$ && "$gate_fd" =~ ^[0-9]+$ && -n "$code_root" ]] || {
+            _rd_log 'selected T5 root supervisor lease or control channel is absent'; return 1;
+        }
+        /usr/bin/python3.14 -I -S -B \
+            "$code_root/driver/scripts/t5/T5WritableStateRunBinding.py" end \
+            --lease-fd "$lease_fd" --gate-fd "$gate_fd" --tag "$tag" || return 1
+        rm -- "$state" || return 1
+        printf 'RunDiskBaseUntouched=True\n'
+        _rd_log "$dom: root supervisor ended run $tag; private-state restore is still required"
+        return 0
+    fi
+    local tops; tops=$(_rd_vda "$dom" ""; _rd_vda "$dom" --inactive)
+    [ "$($V domstate "$dom")" = "shut off" ] || $V destroy "$dom" >/dev/null || return 1
+    # Every file between each current top and the base belongs to this run: it must sit in the overlay's directory, carry this
+    # domain's run-file name and be at most two levels above the base; anything else stops the cleanup with the files kept.
+    for top in $tops; do
+        cur=$top; n=0
+        while [ "$cur" != "$base" ]; do
+            n=$((n + 1)); [ $n -le 2 ] || { _rd_log "$dom: $top does not reach the base within two files; nothing deleted"; return 1; }
+            case "$cur" in "$(dirname "$ov")/$dom".safeupload-run-*|"$(dirname "$ov")/$dom".safeupload-pre-*) ;;
+                *) _rd_log "$dom: $cur above the base is not a run file of $dom; nothing deleted"; return 1;; esac
+            [[ " ${files[*]} " == *" $cur "* ]] || files+=("$cur")
+            cur=$(_rd_vol "$cur" backing) || return 1
+            [ -n "$cur" ] || { _rd_log "$dom: the chain from $top ends before the base; nothing deleted"; return 1; }
+        done
+    done
+    [[ " ${files[*]} " == *" $ov "* ]] || { [ -e "$ov" ] && [ "$(_rd_vol "$ov" backing)" = "$base" ] && files+=("$ov"); }
+    _rd_repoint "$dom" "$base" || { _rd_log "$dom: could not point the domain back at $base; nothing deleted"; return 1; }
+    for f in "${files[@]}"; do
+        _rd_named_elsewhere "$dom" "$f" && { _rd_log "$dom: another domain names $f; nothing deleted"; return 1; }
+    done
+    for f in "${files[@]}"; do
+        p=$(image_pool_of "$(dirname "$f")") && $V vol-delete --pool "$p" "$(basename "$f")" >/dev/null || { _rd_log "could not delete $f"; return 1; }
+        _rd_log "$dom: deleted $f"
+    done
+    rm -f "$state"
+    if [ "$(stat -c '%Y %s' "$base")" = "$stat0" ]; then echo "RunDiskBaseUntouched=True"; else echo "RunDiskBaseUntouched=False base $base changed during run $tag"; return 1; fi
+    _rd_log "$dom: run $tag ended; the domain is shut off on $base"
+}
+
+run_disk_begin() {  # $1 domain, $2 tag -> serialized, fresh overlay begin; stale state is never auto-deleted
+    local dom=$1 tag=$2 acquired=no rc
+    if ! _rd_lock_is_held "$dom"; then _rd_lock_acquire "$dom" || return 1; acquired=yes; fi
+    _rd_mutation_guard "$dom" "$tag" || { rc=$?; [ "$acquired" = yes ] && _rd_lock_release; return "$rc"; }
+    _run_disk_begin_locked "$dom" "$tag"; rc=$?
+    if [ "$acquired" = yes ]; then _rd_lock_release || return 1; fi
+    return "$rc"
+}
+
+run_disk_end() {  # $1 domain, $2 tag -> serialized cleanup; never enters a T5 guarded lifecycle externally
+    local dom=$1 tag=$2 acquired=no rc
+    if ! _rd_lock_is_held "$dom"; then _rd_lock_acquire "$dom" || return 1; acquired=yes; fi
+    _rd_mutation_guard "$dom" "$tag" || { rc=$?; [ "$acquired" = yes ] && _rd_lock_release; return "$rc"; }
+    _run_disk_end_locked "$dom" "$tag"; rc=$?
+    if [ "$acquired" = yes ]; then _rd_lock_release || return 1; fi
+    return "$rc"
+}
===== driver/scripts/t5/Inventory-T5WritableState.SelfCheck.py (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/Inventory-T5WritableState.SelfCheck.py
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/Inventory-T5WritableState.SelfCheck.py
@@ -0,0 +1,879 @@
+#!/usr/bin/env python3
+"""Offline controls for the T5 writable-state inventory helper."""
+import contextlib
+import hashlib
+import importlib.util
+import inspect
+import io
+import json
+from pathlib import Path
+import tempfile
+from types import SimpleNamespace
+import unittest
+from unittest import mock
+import uuid
+import xml.etree.ElementTree as ET
+import libvirt
+
+
+HELPER_PATH = Path(__file__).with_name('Inventory-T5WritableState.py')
+R7_HOST_OBSERVATION_RECEIPT = 'driver/evidence/2026-10-11/m2-t5-state-inventory-r7-host-observation-root.json'
+R7_HOST_OBSERVATION_RECEIPT_SHA256 = 'cdef8ed0800c63286f70b12a4b4bfb812f5bed5cb8aadc4cc6acbbc8509c8542'
+R7_VOLUME_METADATA_RECEIPT = 'driver/evidence/2026-10-11/m2-t5-state-inventory-r7-actual-volume-metadata-root.json'
+R7_VOLUME_METADATA_RECEIPT_SHA256 = 'edfac54414cbbeecd9af25991f24f0e20ad32d3bc269a7143d1327cde8f498c4'
+SPEC = importlib.util.spec_from_file_location('t5_writable_inventory_selfcheck', HELPER_PATH)
+inventory = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(inventory)
+
+
+def volume_xml(name, path, owner='972', group='972', mode='0600', capacity=5,
+               physical=5, allocation=5, fmt='raw'):
+    return ('<volume><name>%s</name><capacity>%d</capacity><allocation>%d</allocation>'
+            '<physical>%d</physical><target><path>%s</path><format type="%s"/>'
+            '<permissions><mode>%s</mode><owner>%s</owner><group>%s</group></permissions>'
+            '</target></volume>') % (name, capacity, allocation, physical, path, fmt, mode, owner, group)
+
+
+class FakeVolume:
+    def __init__(self, name, path, content=b'file!', info_result=None, info_result_after=None,
+                 xml_after=None):
+        self._name = name
+        self._path = path
+        self.content = content
+        self.info_result = info_result
+        self.info_result_after = info_result_after
+        self.xml_after = xml_after
+        self.xml = volume_xml(name, path, capacity=len(content), physical=len(content),
+                              allocation=len(content))
+        self.stream_reads = 0
+        self.xml_reads = 0
+        self.info_reads = 0
+        self.download_calls = []
+        self.forbidden_mutations = 0
+
+    def name(self):
+        return self._name
+
+    def XMLDesc(self, _flags):
+        self.xml_reads += 1
+        if self.xml_reads > 1 and self.xml_after is not None:
+            return self.xml_after
+        return self.xml
+
+    def info(self):
+        self.info_reads += 1
+        if self.info_reads > 1 and self.info_result_after is not None:
+            return self.info_result_after
+        if self.info_result is not None:
+            return self.info_result
+        # Standard virStorageVolInfo ABI: (type, capacity, allocation).
+        return (0, len(self.content), len(self.content))
+
+    def download(self, stream, offset, length, flags):
+        self.download_calls.append((offset, length, flags))
+        if (offset, length, flags) != (0, 0, 0):
+            raise AssertionError('source volume full-stream read must use zero offset/length/flags')
+        stream.data = self.content
+        return 0
+
+    def upload(self, *_args):
+        self.forbidden_mutations += 1
+        raise AssertionError('source volume upload is forbidden')
+
+    def delete(self, *_args):
+        self.forbidden_mutations += 1
+        raise AssertionError('source volume deletion is forbidden')
+
+
+class FakePool:
+    def __init__(self, conn, name, target, volumes, persistent=0, active=1, xml_target=None,
+                 xml_override=None, pool_uuid=None):
+        self.conn = conn
+        self._name = name
+        self.target = target if xml_target is None else xml_target
+        self.volumes = volumes
+        self.persistent = persistent
+        self.active = active
+        self.pool_uuid = pool_uuid or str(uuid.uuid5(uuid.NAMESPACE_DNS, name))
+        self.xml_override = xml_override
+        self.refreshes = 0
+        self.destroyed = 0
+
+    def name(self):
+        return self._name
+
+    def isPersistent(self):
+        return self.persistent
+
+    def isActive(self):
+        return self.active
+
+    def UUIDString(self):
+        return self.pool_uuid
+
+    def XMLDesc(self, _flags):
+        if self.xml_override is not None:
+            return self.xml_override
+        return ("<pool type='dir'><name>%s</name><uuid>%s</uuid><capacity unit='bytes'>0</capacity>"
+                "<allocation unit='bytes'>0</allocation><available unit='bytes'>0</available>"
+                "<source>\n  </source><target><path>%s</path><permissions>"
+                "<mode>0700</mode><owner>972</owner><group>972</group></permissions></target></pool>" %
+                (self._name, self.pool_uuid, self.target))
+
+    def refresh(self, flags):
+        if flags != 0:
+            raise AssertionError('pool refresh flags must be zero')
+        self.refreshes += 1
+        return 0
+
+    def listAllVolumes(self, flags):
+        if flags != 0:
+            raise AssertionError('volume enumeration flags must be zero')
+        return list(self.volumes)
+
+    def destroy(self):
+        self.destroyed += 1
+        if self.conn.destroy_error is not None:
+            raise RuntimeError(self.conn.destroy_error)
+        self.active = 0
+        self.conn.pools.remove(self)
+        return 0
+
+    def build(self, *_args):
+        raise AssertionError('inventory must never build a source pool')
+
+    def createXML(self, *_args):
+        raise AssertionError('inventory must never create a source volume')
+
+
+class FakeStream:
+    def __init__(self):
+        self.data = b''
+        self.finished = False
+        self.aborted = False
+
+    def recvAll(self, handler, opaque):
+        if self.data:
+            handler(self, self.data, opaque)
+
+    def finish(self):
+        self.finished = True
+        return 0
+
+    def abort(self):
+        self.aborted = True
+        return 0
+
+
+class FakeConnection:
+    def __init__(self, volumes=None, persistent=0, active=1, xml_target=None,
+                 xml_override=None, destroy_error=None, pool_uuid=None):
+        self.pools = []
+        self.volumes = list(volumes or [])
+        self.persistent = persistent
+        self.active = active
+        self.xml_target = xml_target
+        self.xml_override = xml_override
+        self.destroy_error = destroy_error
+        self.pool_uuid = pool_uuid
+        self.transient_mutations = []
+        self.closed = False
+        self.streams = []
+
+    def listAllStoragePools(self, flags):
+        if flags != 0:
+            raise AssertionError('pool enumeration flags must be zero')
+        return list(self.pools)
+
+    def storagePoolCreateXML(self, xml, flags):
+        if flags != 0:
+            raise AssertionError('transient pool creation flags must be zero')
+        self.transient_mutations.append(('storagePoolCreateXML', flags))
+        root = ET.fromstring(xml)
+        name = root.findtext('name')
+        target = root.findtext('./target/path')
+        pool = FakePool(self, name, target, self.volumes, self.persistent, self.active,
+                        xml_target=self.xml_target, xml_override=self.xml_override,
+                        pool_uuid=self.pool_uuid)
+        self.pools.append(pool)
+        return pool
+
+    def newStream(self, flags):
+        if flags != 0:
+            raise AssertionError('source stream flags must be zero')
+        stream = FakeStream()
+        self.streams.append(stream)
+        return stream
+
+    def close(self):
+        self.closed = True
+
+
+def pinned_tpm_lock_fixture():
+    repo_root = HELPER_PATH.parents[3]
+    receipt_path = repo_root / R7_VOLUME_METADATA_RECEIPT
+    if inventory.sha256_file(receipt_path) != R7_VOLUME_METADATA_RECEIPT_SHA256:
+        raise AssertionError('pinned R7 TPM lock metadata fixture hash changed')
+    receipt = inventory.parse_json_unique(receipt_path)
+    xml = receipt['Diagnostic']['RawVolumeXML']
+    lock = FakeVolume('.lock', inventory.TPM_STATE_DIRECTORY + '/.lock', content=b'',
+                      info_result=[0, 0, 0])
+    lock.xml = xml
+    return lock, xml
+
+
+class WritableInventorySelfCheck(unittest.TestCase):
+    def test_installed_libvirt_python_method_signatures_match_used_call_surface(self):
+        actual = {
+            'libvirt.open': (libvirt, 'open'),
+            'libvirt.getVersion': (libvirt, 'getVersion'),
+            'virConnect.getLibVersion': (libvirt.virConnect, 'getLibVersion'),
+            'virConnect.listAllStoragePools': (libvirt.virConnect, 'listAllStoragePools'),
+            'virConnect.storagePoolCreateXML': (libvirt.virConnect, 'storagePoolCreateXML'),
+            'virConnect.newStream': (libvirt.virConnect, 'newStream'),
+            'virConnect.lookupByName': (libvirt.virConnect, 'lookupByName'),
+            'virConnect.close': (libvirt.virConnect, 'close'),
+            'virStoragePool.name': (libvirt.virStoragePool, 'name'),
+            'virStoragePool.UUIDString': (libvirt.virStoragePool, 'UUIDString'),
+            'virStoragePool.isPersistent': (libvirt.virStoragePool, 'isPersistent'),
+            'virStoragePool.isActive': (libvirt.virStoragePool, 'isActive'),
+            'virStoragePool.XMLDesc': (libvirt.virStoragePool, 'XMLDesc'),
+            'virStoragePool.refresh': (libvirt.virStoragePool, 'refresh'),
+            'virStoragePool.listAllVolumes': (libvirt.virStoragePool, 'listAllVolumes'),
+            'virStoragePool.destroy': (libvirt.virStoragePool, 'destroy'),
+            'virStorageVol.name': (libvirt.virStorageVol, 'name'),
+            'virStorageVol.XMLDesc': (libvirt.virStorageVol, 'XMLDesc'),
+            'virStorageVol.info': (libvirt.virStorageVol, 'info'),
+            'virStorageVol.download': (libvirt.virStorageVol, 'download'),
+            'virStream.recvAll': (libvirt.virStream, 'recvAll'),
+            'virStream.finish': (libvirt.virStream, 'finish'),
+            'virStream.abort': (libvirt.virStream, 'abort'),
+            'virDomain.UUIDString': (libvirt.virDomain, 'UUIDString'),
+            'virDomain.state': (libvirt.virDomain, 'state'),
+            'virDomain.isActive': (libvirt.virDomain, 'isActive'),
+            'virDomain.XMLDesc': (libvirt.virDomain, 'XMLDesc'),
+        }
+        expected = {
+            'libvirt.open': "(name: 'Optional[str]' = None) -> 'virConnect'",
+            'libvirt.getVersion': '(name: str | None = None) -> int',
+            'virConnect.getLibVersion': "(self) -> 'int'",
+            'virConnect.listAllStoragePools': "(self, flags: int | None = 0) -> list['virStoragePool']",
+            'virConnect.storagePoolCreateXML': "(self, xmlDesc: 'str', flags: 'Optional[int]' = 0) -> 'virStoragePool'",
+            'virConnect.newStream': "(self, flags: 'Optional[int]' = 0) -> 'virStream'",
+            'virConnect.lookupByName': "(self, name: 'str') -> 'virDomain'",
+            'virConnect.close': "(self) -> 'int'",
+            'virStoragePool.name': "(self) -> 'str'",
+            'virStoragePool.UUIDString': "(self) -> 'str'",
+            'virStoragePool.isPersistent': "(self) -> 'int'",
+            'virStoragePool.isActive': "(self) -> 'int'",
+            'virStoragePool.XMLDesc': "(self, flags: 'Optional[int]' = 0) -> 'str'",
+            'virStoragePool.refresh': "(self, flags: 'Optional[int]' = 0) -> 'int'",
+            'virStoragePool.listAllVolumes': "(self, flags: int | None = 0) -> list['virStorageVol']",
+            'virStoragePool.destroy': "(self) -> 'int'",
+            'virStorageVol.name': "(self) -> 'str'",
+            'virStorageVol.XMLDesc': "(self, flags: 'Optional[int]' = 0) -> 'str'",
+            'virStorageVol.info': "(self) -> 'str'",
+            'virStorageVol.download': "(self, stream: 'virStream', offset: 'int', length: 'int', flags: 'Optional[int]' = 0) -> 'int'",
+            'virStream.recvAll': "(self, handler: Callable[[ForwardRef('virStream'), bytes, ~_T], int], opaque: ~_T) -> None",
+            'virStream.finish': "(self) -> 'int'",
+            'virStream.abort': "(self) -> 'int'",
+            'virDomain.UUIDString': "(self) -> 'str'",
+            'virDomain.state': "(self, flags: 'Optional[int]' = 0) -> 'str'",
+            'virDomain.isActive': "(self) -> 'int'",
+            'virDomain.XMLDesc': "(self, flags: 'Optional[int]' = 0) -> 'str'",
+        }
+        self.assertEqual(set(actual), set(expected))
+        for label, (owner, name) in actual.items():
+            with self.subTest(method=label):
+                self.assertEqual(str(inspect.signature(getattr(owner, name))), expected[label])
+        destroy_source = inspect.getsource(libvirt.virStoragePool.destroy)
+        self.assertIn('libvirtmod.virStoragePoolDestroy(self._o)', destroy_source)
+        self.assertNotIn('flags', inspect.signature(libvirt.virStoragePool.destroy).parameters)
+
+    def test_volume_info_uses_standard_type_capacity_allocation_order(self):
+        preserve = inventory._preserve_module()
+        good = FakeVolume('file.bin', '/tmp/tpm2/file.bin')
+        self.assertEqual(preserve.storage_volume_info(good, 'fixture'),
+                         {'type': 0, 'capacity': 5, 'allocation': 5})
+
+        class WrongOrder(FakeVolume):
+            def info(self):
+                return (5, 5, 0)
+
+        with self.assertRaises(preserve.RetentionError):
+            preserve.storage_volume_info(WrongOrder('file.bin', '/tmp/tpm2/file.bin'), 'wrong ABI')
+
+    def test_transient_dir_pool_inventory_hashes_only_and_destroys_pool(self):
+        target = inventory.TPM_STATE_DIRECTORY
+        source = FakeVolume('tpm2-00.permall', target + '/tpm2-00.permall', b'permanent')
+        lock, _lock_xml = pinned_tpm_lock_fixture()
+        conn = FakeConnection([source, lock])
+        preserve = inventory._preserve_module()
+        expected = {'sha256': hashlib.sha256(source.content).hexdigest(), 'bytes': len(source.content),
+                    'virtual_capacity': len(source.content), 'allocation': len(source.content),
+                    'physical_bytes': len(source.content)}
+        with mock.patch.object(preserve, 'volume_sha256', return_value=expected):
+            result = inventory.inspect_directory(conn, 'CheckTag', 'tpm', target)
+        by_name = {row['Name']: row for row in result['Files']}
+        self.assertEqual(set(by_name), {'.lock', 'tpm2-00.permall'})
+        self.assertEqual(by_name['tpm2-00.permall']['SHA256'], expected['sha256'])
+        self.assertEqual(by_name['.lock']['SHA256'], hashlib.sha256(b'').hexdigest())
+        self.assertEqual(by_name['.lock']['StreamBytes'], 0)
+        self.assertEqual(lock.download_calls, [(0, 0, 0)])
+        self.assertEqual(lock.info_reads, 2)
+        self.assertEqual(lock.xml_reads, 2)
+        self.assertFalse(result['PersistentPool'])
+        self.assertFalse(result['DirectoryEntriesComplete'])
+        self.assertTrue(result['PoolDestroyVerified'])
+        self.assertEqual(conn.transient_mutations, [('storagePoolCreateXML', 0)])
+        self.assertEqual(source.forbidden_mutations, 0)
+        self.assertEqual(conn.pools, [])
+
+    def test_pinned_tpm_requires_exactly_one_dot_lock_name_before_volume_reads(self):
+        target = inventory.TPM_STATE_DIRECTORY
+        missing = FakeVolume('tpm2-00.permall', target + '/tpm2-00.permall', b'permanent')
+        conn = FakeConnection([missing])
+        with self.assertRaisesRegex(inventory.InventoryError, r'exactly one swtpm \.lock'):
+            inventory.inspect_directory(conn, 'CheckTag', 'tpm', target)
+        self.assertEqual(missing.xml_reads, 0)
+        self.assertEqual(missing.info_reads, 0)
+        self.assertEqual(missing.download_calls, [])
+        self.assertEqual(conn.streams, [])
+        self.assertEqual(conn.pools, [])
+
+        duplicate_a, _xml = pinned_tpm_lock_fixture()
+        duplicate_b, _xml = pinned_tpm_lock_fixture()
+        conn = FakeConnection([duplicate_a, duplicate_b])
+        with self.assertRaisesRegex(inventory.InventoryError, r'exactly one swtpm \.lock'):
+            inventory.inspect_directory(conn, 'CheckTag', 'tpm', target)
+        for duplicate in (duplicate_a, duplicate_b):
+            self.assertEqual(duplicate.xml_reads, 0)
+            self.assertEqual(duplicate.info_reads, 0)
+            self.assertEqual(duplicate.download_calls, [])
+        self.assertEqual(conn.streams, [])
+        self.assertEqual(conn.pools, [])
+
+    def test_pinned_swtpm_dot_lock_is_inventoried_as_empty_private_lock_not_tpm_state(self):
+        repo_root = HELPER_PATH.parents[3]
+        volume_receipt_path = repo_root / R7_VOLUME_METADATA_RECEIPT
+        host_receipt_path = repo_root / R7_HOST_OBSERVATION_RECEIPT
+        self.assertEqual(inventory.sha256_file(volume_receipt_path), R7_VOLUME_METADATA_RECEIPT_SHA256)
+        self.assertEqual(inventory.sha256_file(host_receipt_path), R7_HOST_OBSERVATION_RECEIPT_SHA256)
+        volume_receipt = inventory.parse_json_unique(volume_receipt_path)
+        self.assertEqual(volume_receipt['SourceHostReceiptSHA256'], R7_HOST_OBSERVATION_RECEIPT_SHA256)
+        diagnostic = volume_receipt['Diagnostic']
+        xml = diagnostic['RawVolumeXML']
+        self.assertEqual(hashlib.sha256(xml.encode('utf-8')).hexdigest(),
+                         volume_receipt['RawVolumeXMLSHA256'])
+        self.assertEqual(diagnostic['VolumeName'], '.lock')
+        self.assertEqual(diagnostic['TargetDirectory'], inventory.TPM_STATE_DIRECTORY)
+        self.assertEqual(diagnostic['RawStorageVolumeInfo'], {
+            'Available': True, 'PythonType': 'list', 'Repr': '[0, 0, 0]'})
+
+        lock, pinned_xml = pinned_tpm_lock_fixture()
+        self.assertEqual(pinned_xml, xml)
+        conn = FakeConnection([lock])
+        result = inventory.inspect_directory(conn, 'CheckTag', 'tpm', inventory.TPM_STATE_DIRECTORY)
+        record = result['Files'][0]
+        self.assertEqual(record['Name'], '.lock')
+        self.assertEqual(record['Path'], inventory.TPM_STATE_DIRECTORY + '/.lock')
+        self.assertEqual(record['VolumeType'], 0)
+        self.assertEqual(record['CapacityBytes'], 0)
+        self.assertEqual(record['AllocationBytes'], 0)
+        self.assertEqual(record['PhysicalBytes'], 0)
+        self.assertEqual(record['OwnerUID'], 972)
+        self.assertEqual(record['GroupGID'], 972)
+        self.assertEqual(record['Mode'], '0640')
+        self.assertEqual(record['StreamBytes'], 0)
+        self.assertEqual(record['SHA256'], hashlib.sha256(b'').hexdigest())
+        self.assertEqual(lock.download_calls, [(0, 0, 0)])
+        self.assertEqual(lock.info_reads, 2)
+        self.assertEqual(lock.xml_reads, 2)
+        self.assertTrue(conn.streams[0].finished)
+        self.assertFalse(conn.streams[0].aborted)
+        self.assertEqual(conn.pools, [])
+        self.assertFalse(result['DirectoryEntriesComplete'])
+
+        preserve = inventory._preserve_module()
+        with self.assertRaises(preserve.RetentionError):
+            preserve.parse_volume_xml(xml, 'shared retention parser lock negative')
+        with self.assertRaises(preserve.RetentionError):
+            preserve.storage_volume_info(lock, 'shared retention parser lock negative')
+
+    def test_swtpm_dot_lock_wrong_identity_mode_or_size_fails_before_stream(self):
+        repo_root = HELPER_PATH.parents[3]
+        receipt = inventory.parse_json_unique(repo_root / R7_VOLUME_METADATA_RECEIPT)
+        xml = receipt['Diagnostic']['RawVolumeXML']
+        cases = (
+            ('name', xml.replace('<name>.lock</name>', '<name>.other</name>')),
+            ('key path', xml.replace('/tpm2/.lock</key>', '/tpm2/other</key>')),
+            ('target path', xml.replace('/tpm2/.lock</path>', '/tpm2/other</path>')),
+            ('file type', xml.replace("type='file'", "type='block'")),
+            ('format', xml.replace("type='raw'", "type='qcow2'")),
+            ('mode wider than pinned', xml.replace('<mode>0640</mode>', '<mode>0660</mode>')),
+            ('owner', xml.replace('<owner>972</owner>', '<owner>0</owner>')),
+            ('group', xml.replace('<group>972</group>', '<group>0</group>')),
+            ('nonzero capacity', xml.replace('<capacity unit=\'bytes\'>0</capacity>',
+                                             '<capacity unit=\'bytes\'>1</capacity>')),
+            ('nonzero allocation', xml.replace('<allocation unit=\'bytes\'>0</allocation>',
+                                               '<allocation unit=\'bytes\'>1</allocation>')),
+            ('unexpected physical metadata', xml.replace('<allocation unit=\'bytes\'>0</allocation>',
+                                                        '<allocation unit=\'bytes\'>0</allocation>\n'
+                                                        '  <physical>0</physical>')),
+        )
+        for label, malformed_xml in cases:
+            with self.subTest(case=label):
+                lock = FakeVolume('.lock', inventory.TPM_STATE_DIRECTORY + '/.lock', content=b'',
+                                  info_result=[0, 0, 0])
+                lock.xml = malformed_xml
+                conn = FakeConnection([lock])
+                with self.assertRaises(inventory.InventoryError):
+                    inventory.inspect_directory(conn, 'CheckTag', 'tpm', inventory.TPM_STATE_DIRECTORY)
+                self.assertEqual(lock.download_calls, [])
+                self.assertEqual(conn.pools, [])
+
+        hidden = FakeVolume('.lock-backup', inventory.TPM_STATE_DIRECTORY + '/.lock-backup', content=b'')
+        valid_lock, _xml = pinned_tpm_lock_fixture()
+        conn = FakeConnection([hidden, valid_lock])
+        with self.assertRaisesRegex(inventory.InventoryError, 'unsafe or unrecognized basename'):
+            inventory.inspect_directory(conn, 'CheckTag', 'tpm', inventory.TPM_STATE_DIRECTORY)
+        self.assertEqual(hidden.xml_reads, 0)
+        self.assertEqual(hidden.info_reads, 0)
+        self.assertEqual(valid_lock.xml_reads, 0)
+        self.assertEqual(valid_lock.info_reads, 0)
+        self.assertEqual(conn.pools, [])
+
