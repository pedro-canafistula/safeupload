@@ -0,0 +1,123 @@
+#!/usr/bin/env python3
+"""Offline controls for the fixed qemu hook XML gate."""
+from __future__ import annotations
+
+import importlib.util
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location(
+    't5_qemu_hook_under_test', HERE / 'T5WritableStateQemuHook.py')
+if SPEC is None or SPEC.loader is None:
+    raise RuntimeError('cannot load qemu hook helper')
+HOOK = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = HOOK
+SPEC.loader.exec_module(HOOK)
+
+
+def xml(name='other', uuid='00000000-0000-0000-0000-000000000001', source=''):
+    source_xml = ('<disk><source file="' + source + '"/></disk>' if source else '')
+    return (f'<domain type="kvm"><name>{name}</name><uuid>{uuid}</uuid><devices>{source_xml}'
+            '</devices></domain>').encode()
+
+
+class QemuHookControls(unittest.TestCase):
+    def test_shared_probe_observes_idle_and_held_root_style_exclusive_lock(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'lock'
+            path.write_bytes(b'')
+            path.chmod(0o600)
+            holder = os.open(path, os.O_RDWR | os.O_CLOEXEC)
+            observer = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
+            try:
+                HOOK.fcntl.flock(holder, HOOK.fcntl.LOCK_EX | HOOK.fcntl.LOCK_NB)
+                self.assertTrue(HOOK._shared_lock_busy_probe(observer))
+                HOOK.fcntl.flock(holder, HOOK.fcntl.LOCK_UN)
+                self.assertFalse(HOOK._shared_lock_busy_probe(observer))
+            finally:
+                os.close(observer)
+                os.close(holder)
+
+    def test_other_guest_is_unchanged_outside_protected_paths(self):
+        self.assertEqual(HOOK.evaluate('other', 'prepare', 'begin', '-', xml()), 0)
+
+    def test_selected_domain_requires_exact_name_uuid_and_start_release(self):
+        selected = xml(HOOK.DOMAIN, HOOK.UUID)
+        with mock.patch.object(HOOK, '_selected_start_allowed') as allowed:
+            self.assertEqual(HOOK.evaluate(HOOK.DOMAIN, 'prepare', 'begin', '-', selected), 0)
+            allowed.assert_called_once_with()
+        for args, body in (
+            ((HOOK.DOMAIN, 'prepare', 'begin', '-'),
+             xml(HOOK.DOMAIN, '00000000-0000-0000-0000-000000000001')),
+            (('alias', 'prepare', 'begin', '-'), xml('alias', HOOK.UUID)),
+            ((HOOK.DOMAIN, 'prepare', 'begin', '-'), selected),
+        ):
+            with self.subTest(args=args, body=body), mock.patch.object(
+                    HOOK, '_selected_start_allowed', side_effect=AssertionError('must not authorize')):
+                if args[0] == HOOK.DOMAIN and body == selected:
+                    # The valid identity reaches the exact-release check.
+                    with self.assertRaises(AssertionError):
+                        HOOK.evaluate(*args, body)
+                else:
+                    with self.assertRaises(HOOK.HookError):
+                        HOOK.evaluate(*args, body)
+
+    def test_selected_external_paths_are_denied_but_stop_notifications_never_veto(self):
+        selected = xml(HOOK.DOMAIN, HOOK.UUID)
+        for operation in ('attach', 'migrate', 'restore'):
+            with self.subTest(operation=operation), self.assertRaises(HOOK.HookError):
+                HOOK.evaluate(HOOK.DOMAIN, operation, 'begin', '-', selected)
+        self.assertEqual(HOOK.evaluate(HOOK.DOMAIN, 'stopped', 'end', '-', b'bad'), 0)
+        self.assertEqual(HOOK.evaluate(HOOK.DOMAIN, 'release', 'end', 'crashed', b'bad'), 0)
+
+    def test_cross_domain_source_reference_is_always_denied(self):
+        for source in (HOOK.SOURCE_DISK, HOOK.SOURCE_BACKING):
+            body = xml(source=source)
+            with self.subTest(source=source), mock.patch.object(
+                    HOOK, '_lock_is_busy', return_value=True):
+                with self.assertRaises(HOOK.HookError):
+                    HOOK.evaluate('other', 'prepare', 'begin', '-', body)
+            with self.subTest(source=source), mock.patch.object(
+                    HOOK, '_lock_is_busy', return_value=False):
+                with self.assertRaises(HOOK.HookError):
+                    HOOK.evaluate('other', 'prepare', 'begin', '-', body)
+
+    def test_other_guest_behavior_remains_unchanged_for_unprotected_state(self):
+        body = xml(source='/var/lib/libvirt/images/unrelated.qcow2')
+        with mock.patch.object(HOOK, '_lock_is_busy', return_value=False):
+            self.assertEqual(HOOK.evaluate('other', 'prepare', 'begin', '-', body), 0)
+
+    def test_private_attach_and_symlink_alias_are_denied(self):
+        body = xml(source=HOOK.PRIVATE_ROOTS[0] + '/run/overlay.qcow2')
+        with self.assertRaises(HOOK.HookError):
+            HOOK.evaluate('other', 'attach', 'begin', '-', body)
+        with mock.patch.object(HOOK.os.path, 'realpath', return_value=HOOK.SOURCE_DISK):
+            self.assertTrue(HOOK._protected_reference({'/tmp/untrusted-link'}))
+
+    def test_malformed_xml_and_arguments_fail_closed(self):
+        with self.assertRaises(HOOK.HookError):
+            HOOK.evaluate('other', 'prepare', 'begin', '-', b'<domain>')
+        with self.assertRaises(HOOK.HookError):
+            HOOK.evaluate('other', 'prepare', 'begin', '-', b'x' * (HOOK.MAX_XML + 1))
+        self.assertEqual(HOOK.main(['only-three', 'args', 'here']), 1)
+
+    def test_shell_adapters_have_exact_syntax_and_noop_main(self):
+        for path in (HERE / 'T5WritableStateQemuHook.sh',
+                     HERE / 'T5WritableStateQemuMainHook.sh'):
+            result = subprocess.run(['/usr/bin/bash', '-n', str(path)],
+                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                    check=False)
+            self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+        result = subprocess.run(['/usr/bin/bash', str(HERE / 'T5WritableStateQemuMainHook.sh'),
+                                 'unrelated', 'prepare', 'begin', '-'], check=False)
+        self.assertEqual(result.returncode, 0)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
===== driver/scripts/t5/T5WritableStateQemuHook.py (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/T5WritableStateQemuHook.py
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/T5WritableStateQemuHook.py
@@ -0,0 +1,217 @@
+#!/usr/bin/python3.14
+"""Strict, read-only XML gate for libvirt's qemu driver hook.
+
+The hook receives the complete domain XML on stdin. It never calls libvirt and
+never emits XML, so the driver's filter pipeline receives the unchanged input.
+"""
+from __future__ import annotations
+
+import fcntl
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+import xml.etree.ElementTree as ET
+
+DOMAIN = 'win10-debug3'
+UUID = 'ffcb9530-146b-43b1-8af7-2b5cc8ede2e3'
+LOCK_PATH = '/run/safeupload-t5/win10-debug3.lifecycle.lock'
+LIFECYCLE = '/usr/local/libexec/safeupload-t5-copy-r2/driver/scripts/t5/T5WritableStateLifecycle.py'
+MAX_XML = 4 * 1024 * 1024
+SOURCE_DISK = '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2'
+SOURCE_BACKING = '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2'
+SOURCE_NVRAM = '/var/lib/libvirt/qemu/nvram/win10-debug3_VARS.fd'
+SOURCE_TPM = '/var/lib/libvirt/swtpm/' + UUID + '/tpm2'
+PRIVATE_ROOTS = (
+    '/var/lib/libvirt/images/safeupload-t5/m2-t5-cp1011-r2',
+    '/var/lib/libvirt/safeupload-t5/m2-t5-cp1011-r2',
+)
+FIXED_SOURCES = (SOURCE_DISK, SOURCE_BACKING, SOURCE_NVRAM, SOURCE_TPM)
+TAG_RE = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}\Z')
+
+
+class HookError(RuntimeError):
+    pass
+
+
+def _xml_document(raw: bytes) -> tuple[str, str, set[str]]:
+    if not raw or len(raw) > MAX_XML:
+        raise HookError('hook XML is empty or exceeds the fixed bound')
+    upper = raw.upper()
+    if b'<!DOCTYPE' in upper or b'<!ENTITY' in upper:
+        raise HookError('hook XML document types and entities are forbidden')
+    try:
+        root = ET.fromstring(raw)
+    except ET.ParseError as exc:
+        raise HookError('hook XML is malformed') from exc
+    if (root.tag != 'domain' or set(root.attrib) - {'type', 'id'}
+            or root.get('type') not in ('kvm', 'qemu')
+            or ('id' in root.attrib and not re.fullmatch(r'[0-9]+', root.get('id', '')))):
+        raise HookError('hook XML root is not the exact domain shape')
+    names = root.findall('name')
+    uuids = root.findall('uuid')
+    if len(names) != 1 or len(uuids) != 1 or list(names[0]) or list(uuids[0]):
+        raise HookError('hook XML name/UUID cardinality differs')
+    name = names[0].text or ''
+    uuid = uuids[0].text or ''
+    if (not name or len(name) > 128 or not uuid or len(uuid) > 64):
+        raise HookError('hook XML name/UUID is malformed')
+    paths: set[str] = set()
+    for disk in root.findall('./devices/disk'):
+        for source in disk.findall('source'):
+            for attr in ('file', 'dev', 'name', 'dir', 'volume', 'pool'):
+                value = source.get(attr)
+                if value:
+                    if value.startswith('/'):
+                        paths.add(os.path.normpath(value))
+                    elif attr == 'volume':
+                        paths.add('pool-volume:' + (source.get('pool') or '') + '/' + value)
+        for backing in disk.iter('backingStore'):
+            for node in backing.iter():
+                for attr in ('path', 'file', 'dev', 'name'):
+                    value = node.get(attr)
+                    if value and value.startswith('/'):
+                        paths.add(os.path.normpath(value))
+                if node.tag == 'path' and node.text and node.text.strip().startswith('/'):
+                    paths.add(os.path.normpath(node.text.strip()))
+    os_node = root.find('os')
+    if os_node is not None:
+        for node in list(os_node.findall('nvram')) + list(os_node.findall('varstore')):
+            if node.text and node.text.strip().startswith('/'):
+                paths.add(os.path.normpath(node.text.strip()))
+    for backend in root.findall('./devices/tpm/backend'):
+        for node in backend.iter():
+            for attr in ('path', 'dir', 'file'):
+                value = node.get(attr)
+                if value and value.startswith('/'):
+                    paths.add(os.path.normpath(value))
+    for source in root.findall('./memoryBacking/source'):
+        path = source.get('path')
+        if path and path.startswith('/'):
+            paths.add(os.path.normpath(path))
+    return name, uuid.lower(), paths
+
+
+def _under(path: str, root: str) -> bool:
+    normalized_root = root.rstrip('/')
+    return path == normalized_root or path.startswith(normalized_root + '/')
+
+
+def _protected_reference(paths: set[str]) -> bool:
+    for path in paths:
+        if path in FIXED_SOURCES or any(_under(path, root) for root in PRIVATE_ROOTS):
+            return True
+        # Resolve existing symlink aliases from metadata only. The later
+        # invocation still rechecks the exact object identities before use.
+        if path.startswith('/'):
+            try:
+                resolved = os.path.realpath(path, strict=False)
+            except (OSError, TypeError):
+                continue
+            if resolved in FIXED_SOURCES or any(_under(resolved, root) for root in PRIVATE_ROOTS):
+                return True
+    return False
+
+
+def _shared_lock_busy_probe(fd: int) -> bool:
+    """Observe the root exclusive lease without an exclusive observer lock."""
+    try:
+        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
+    except BlockingIOError:
+        return True
+    else:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        return False
+
+
+def _lock_is_busy() -> bool:
+    fd = -1
+    try:
+        fd = os.open(LOCK_PATH, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+        row = os.fstat(fd)
+        path_row = os.stat(LOCK_PATH, follow_symlinks=False)
+        if (not stat.S_ISREG(row.st_mode) or row.st_uid != 0 or row.st_gid != 0
+                or stat.S_IMODE(row.st_mode) != 0o444 or row.st_nlink != 1
+                or (row.st_dev, row.st_ino) != (path_row.st_dev, path_row.st_ino)):
+            raise HookError('canonical lifecycle lock identity differs')
+        # The root supervisor owns LOCK_EX. A qemu hook observes it with a
+        # shared probe so multiple observers do not exclude one another.
+        return _shared_lock_busy_probe(fd)
+    except FileNotFoundError:
+        return False
+    finally:
+        if fd >= 0:
+            os.close(fd)
+
+
+def _selected_start_allowed() -> None:
+    import subprocess
+    result = subprocess.run(
+        ['/usr/bin/python3.14', '-I', '-S', '-B', LIFECYCLE,
+         'verify-start', '--domain', DOMAIN],
+        stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+        close_fds=True, timeout=5, check=False,
+        env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'})
+    if result.returncode != 0:
+        raise HookError('selected domain lacks the exact live root start release')
+
+
+def evaluate(domain: str, operation: str, suboperation: str, extra: str,
+             raw_xml: bytes) -> int:
+    if (not all(isinstance(value, str) and len(value) <= 256
+                for value in (domain, operation, suboperation, extra))):
+        raise HookError('hook argument is malformed')
+    if operation in ('stopped', 'release'):
+        # These notifications arrive after stop can no longer be vetoed.
+        # They must not hold up cleanup or claim to control shutdown.
+        return 0
+    name, uuid, paths = _xml_document(raw_xml)
+    protected = _protected_reference(paths)
+    selected_name = domain == DOMAIN or name == DOMAIN
+    selected_uuid = uuid == UUID
+    if selected_name != (name == DOMAIN) or selected_uuid != (domain == DOMAIN):
+        raise HookError('hook argv does not bind the XML domain name and UUID')
+    if operation not in ('prepare', 'start', 'reconnect', 'attach', 'migrate', 'restore'):
+        if selected_name or selected_uuid or protected:
+            raise HookError('unsupported lifecycle hook operation for protected state')
+        return 0
+    if selected_name or selected_uuid:
+        if name != DOMAIN or domain != DOMAIN or uuid != UUID:
+            raise HookError('selected T5 UUID/name alias is denied')
+        if operation in ('prepare', 'start', 'reconnect'):
+            if suboperation != 'begin' or extra != '-':
+                raise HookError('selected start hook phase differs from fixed contract')
+            _selected_start_allowed()
+            return 0
+        raise HookError('selected domain external attach/migration/restore is denied')
+    if protected:
+        # A stopped selected guest does not make its source safe to attach to
+        # another UUID.  The path gate is permanent; the lease gate below is
+        # an additional guard for aliases and for the interval in which a
+        # root supervisor is constructing private objects.
+        raise HookError('cross-domain references to selected or private state are denied')
+    if _lock_is_busy() and operation in ('attach', 'migrate', 'restore'):
+        # No unrelated storage mutation may race the all-domain policy window.
+        # libvirt polkit denies these API calls too; this hook is defense in
+        # depth for a transition already carrying selected objects in XML.
+        raise HookError('external state mutation is denied during an active lease')
+    return 0
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = sys.argv[1:] if argv is None else argv
+    if len(args) != 4:
+        return 1
+    try:
+        raw = sys.stdin.buffer.read(MAX_XML + 1)
+        if len(raw) > MAX_XML:
+            raise HookError('hook XML exceeds fixed bound')
+        return evaluate(args[0], args[1], args[2], args[3], raw)
+    except BaseException as exc:
+        print('safeupload-t5 qemu hook denied: ' + str(exc), file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
===== driver/scripts/t5/T5WritableStateQemuHook.sh (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/T5WritableStateQemuHook.sh
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/T5WritableStateQemuHook.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/bash
+# Fixed libvirt qemu.d adapter. The helper consumes (but never rewrites) the
+# hook XML and emits no stdout, which libvirt treats as the unchanged document.
+set -eu
+[ "$#" -eq 4 ] || exit 1
+exec /usr/bin/python3.14 -I -S -B \
+    /usr/local/libexec/safeupload-t5-copy-r2/driver/scripts/t5/T5WritableStateQemuHook.py \
+    "$1" "$2" "$3" "$4"
===== driver/scripts/t5/T5WritableStateQemuMainHook.sh (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/T5WritableStateQemuMainHook.sh
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/T5WritableStateQemuMainHook.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/bash
+# Fixed no-op main hook required for libvirt's qemu.d directory dispatch.
+# The separately installed qemu.d gate is called after this script.
+set -eu
+[ "$#" -eq 4 ] || exit 1
+exit 0
