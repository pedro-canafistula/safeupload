+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_run_definition(active_text, prebegin, overlay,
+                                           'inactive XML must remain strict')
+
+        negative = (
+            active_text.replace('dev="vnet17"', 'dev="tap0"'),
+            active_text.replace('vnet17', 'vnet17x'),
+            active_text.replace('52:54:00:aa:dd:13', '52:54:00:aa:dd:99'),
+            active_text.replace('id="17"', 'id="x17"'),
+            active_text.replace('name="net0"', 'name="ua-user-net"'),
+            active_text.replace('name="net0"', 'name="net0/evil"'),
