+def _handle_run_control(request: dict[str, Any], lease: Any,
+                        copy_module: Any, lifecycle: Any,
+                        run_binding: Any, libvirt_module: Any,
+                        context: dict[str, Any]) -> dict[str, Any]:
+    """Execute one state-machine operation in the retained root supervisor."""
+    _ensure_control_lease(request, lease)
+    source_guard = context.get('SourceGuard')
+    if source_guard is None:
+        raise InvocationError('run-control request lacks the held source lease set')
+    source_guard.verify_held()
+    command = request['Command']
+    phase = context.get('Phase')
+    expected_phase = {'BEGIN': 'COPIES_READY', 'PRESTART': 'RUN_BOUND',
+                      'END': 'RUNNING'}.get(command)
+    if expected_phase is None or phase != expected_phase:
+        raise InvocationError('run-control command is not the next exact lifecycle state')
+    connection = context['Connection']
+    domain = _domain_for(connection)
+    prepared = context['Prepared']
+    original_xml = context['OriginalXML']
+    run_tag = request['RunTag']
+    run_nvram = prepared['RunNVRAMPath']
+    run_tpm = prepared['RunTPMDirectory']
+    run_disk = prepared['RunDiskPath']
+
+    if command == 'BEGIN':
+        current_enforcement = _verify_active_lifecycle_enforcement()
+        if current_enforcement['ReceiptSHA256'] != context['HostEnforcementReceiptSHA256']:
+            raise InvocationError('active lifecycle enforcement receipt changed during the run')
+        private_xml = context['PrivateStateXML']
+        current_private = _require_domain_inactive_xml(
+            domain, libvirt_module, private_xml, 'run BEGIN private-state precondition')
+        try:
+            run_binding.verify_private_state_xml(
+                original_xml, current_private, run_nvram_path=run_nvram,
+                run_tpm_path=run_tpm)
+        except Exception as exc:
+            raise InvocationError('run BEGIN private-state XML is not the exact typed binding') from exc
+        run_xml = run_binding.expected_bound_xml(
+            original_xml, run_disk_path=run_disk, run_nvram_path=run_nvram,
+            run_tpm_path=run_tpm, run_tag=run_tag)
+        run_xml_receipt_path, run_xml_receipt_sha = _persist_recovery_xml(
+            RootFilesystem, EVIDENCE_DIRECTORY + '/' + run_tag, run_tag,
+            'run-bound-inactive', run_xml)
+        overlay = _create_run_overlay(connection, prepared, run_binding, run_tag)
+        if overlay['Path'] != run_disk:
+            raise InvocationError('created run overlay path differs from the prepared copy binding')
+        try:
+            source_guard.verify_held()
+            defined = connection.defineXML(run_xml)
+        except Exception as exc:
+            raise InvocationError('libvirt could not define the exact three-source run XML') from exc
+        if defined is None:
+            raise InvocationError('libvirt refused the exact three-source run XML')
+        try:
+            actual = domain.XMLDesc(libvirt_module.VIR_DOMAIN_XML_INACTIVE)
+            run_binding.verify_bound_xml(
+                original_xml, actual, run_disk_path=run_disk,
+                run_nvram_path=run_nvram, run_tpm_path=run_tpm, run_tag=run_tag)
+            objects = run_binding.observe_private_objects(
+                run_disk_path=run_disk, run_nvram_path=run_nvram,
+                run_tpm_path=run_tpm, run_tpm_names=prepared['CopiedTPMNames'],
+                run_tag=run_tag)
+        except Exception as exc:
+            raise InvocationError('post-BEGIN XML or private-object identity differs') from exc
+        initial = context['InitialPrivateObjects']
