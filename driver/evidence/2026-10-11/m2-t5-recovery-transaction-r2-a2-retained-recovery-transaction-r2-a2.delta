+                active = bool(domain.isActive())
+                state, _reason = domain.state(0)
+            except Exception as exc:
+                raise InvocationError('selected guest start state could not be verified') from exc
+            if active and int(state) == int(libvirt_module.VIR_DOMAIN_RUNNING):
