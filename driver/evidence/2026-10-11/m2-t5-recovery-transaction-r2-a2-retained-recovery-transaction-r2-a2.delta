+        if volume_by_path(conn, overlay_path, libvirt) is None:
+            raise RetentionError('Retained run overlay disappeared before releasing the T5 preservation guard')
+        verify_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+        append_attempt(evidence, args.tag,
+                       'T5_RETENTION=PASS; archive=' + str(target) +
+                       '; retained_overlay=' + overlay_path + '; ram=' + ram_record['Status'])
+        marker.unlink()
+        fsync_directory(marker.parent)
+        remove_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+        print('T5_RETENTION=PASS archive=' + str(target) + ' overlay=' + overlay_path)
+        return 0
+    except Exception as exc:
+        append_attempt(evidence, args.tag, 'T5_RETENTION=FAIL; marker=' + str(marker) + '; error=' + str(exc))
+        raise
+    finally:
+        conn.close()
