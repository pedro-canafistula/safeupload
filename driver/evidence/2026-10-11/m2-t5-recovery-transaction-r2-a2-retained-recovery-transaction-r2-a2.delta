+                    'untrusted generated disk security sibling')
+
+        root_wrapper = ET.fromstring(active_text)
+        generated_root_label = root_wrapper.find('seclabel')
+        ET.SubElement(generated_root_label, 'label').text = 'UNPINNED-SECURITY-LABEL'
+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_active_run_definition(
+                ET.tostring(root_wrapper, encoding='unicode'), prebegin, overlay,
+                'untrusted generated top-level security sibling')
+
+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_active_run_definition(
+                active_text.replace('model="dac" relabel="no"',
+                                    'model="dac" relabel="no" custom="unexpected"'),
+                prebegin, overlay, 'generated disk security wrapper extra attribute')
+
+        configured = prebegin.replace(
+            '<devices>', '<seclabel type="dynamic" model="selinux"><label>pinned-label</label></seclabel><devices>')
+        configured = configured.replace(
+            '<interface type="network">',
+            '<interface type="network"><alias name="ua-pinned-nic"/>')
+        configured_run = preserve.expected_run_definition_root(configured, overlay, 'configured XML test')
+        configured_active = ET.fromstring(ET.tostring(configured_run, encoding='unicode'))
+        label = ET.SubElement(configured_active.find('seclabel'), 'imagelabel')
+        label.text = 'runtime-label'
+        preserve.verify_active_run_definition(ET.tostring(configured_active, encoding='unicode'),
+                                              configured, overlay, 'pinned top-level seclabel')
+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_active_run_definition(
+                ET.tostring(configured_active, encoding='unicode').replace('pinned-label', 'changed-label'),
+                configured, overlay, 'persistent security setting changed')
+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_active_run_definition(
+                ET.tostring(configured_active, encoding='unicode').replace('ua-pinned-nic', 'ua-changed-nic'),
+                configured, overlay, 'user alias remains pinned')
+
+        # Runtime allowlists apply only when the pinned inactive device omitted
+        # the generated field; configured fields remain exact persistent XML.
+        pinned_runtime = prebegin.replace(
+            '<interface type="network">',
+            '<interface type="network"><target dev="vnet8"/>')
+        pinned_runtime = pinned_runtime.replace(
+            '<console type="pty">',
+            '<console type="pty" tty="/dev/pts/4"><source path="/dev/pts/4"/>')
+        pinned_active = preserve.expected_run_definition_root(
+            pinned_runtime, overlay, 'pinned runtime-shaped values')
+        pinned_text = ET.tostring(pinned_active, encoding='unicode')
+        preserve.verify_active_run_definition(pinned_text, pinned_runtime, overlay,
+                                              'pinned source and target stay strict')
+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_active_run_definition(
+                pinned_text.replace('dev="vnet8"', 'dev="vnet9"'), pinned_runtime, overlay,
+                'pinned target mutation')
+        with self.assertRaises(preserve.RetentionError):
+            preserve.verify_active_run_definition(
+                pinned_text.replace('/dev/pts/4', '/dev/pts/5'), pinned_runtime, overlay,
+                'pinned pty source mutation')
+
+    def test_progress_guard_is_unique_bound_and_removed_only_by_exact_owner(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            state = Path(temp) / 'state'
+            token = preserve.create_progress_guard(state, 'SelfCheckI9', os.getpid())
+            self.assertRegex(token, r'^[A-Fa-f0-9]{32}$')
+            marker = preserve.inprogress_path(state)
+            self.assertEqual(stat.S_IMODE(marker.stat().st_mode), 0o600)
+            self.assertEqual(preserve.verify_progress_guard(state, 'SelfCheckI9', token,
+                                                            os.getpid())['RunTag'], 'SelfCheckI9')
+            with self.assertRaises(preserve.RetentionError):
+                preserve.verify_progress_guard(state, 'SelfCheckI9', '0' * 32, os.getpid())
+            with self.assertRaises(preserve.RetentionError):
+                preserve.create_progress_guard(state, 'SelfCheckOther', os.getpid())
+            preserve.remove_progress_guard(state, 'SelfCheckI9', token, os.getpid())
+            self.assertFalse(marker.exists())
+
+    def test_qemu_ram_map_parser_matches_installed_output_shape_and_fails_closed(self):
+        flat_path = (ROOT / 'driver' / 'evidence' / '2026-10-11' /
+                     'm2-t5-builder-mtree-flat-owner-readonly-root.txt')
+        tree_path = (ROOT / 'driver' / 'evidence' / '2026-10-11' /
+                     'm2-t5-builder-mtree-raw-owner-readonly-root.txt')
+        flat_raw = flat_path.read_bytes()
+        tree_raw = tree_path.read_bytes()
+        self.assertEqual(len(flat_raw), 46208)
+        self.assertEqual(hashlib.sha256(flat_raw).hexdigest(),
+                         '3ef3e4e74c81fb6c69fdcbb6899dcaba55b957e6f32e95fd410873437051ae8d')
+        self.assertEqual(len(tree_raw), 82796)
+        self.assertEqual(hashlib.sha256(tree_raw).hexdigest(),
+                         '137f73d4d2a452fc68999a3951a4cf615d4a8ddc9414c64b6059fe39cafddaba')
+        parsed_builder = preserve.parse_qemu_ram_map(
+            flat_raw.decode('utf-8', 'strict'), tree_raw.decode('utf-8', 'strict'), 4 * preserve.GIB)
+        self.assertEqual(parsed_builder['AddressSpace'], 'memory')
+        self.assertEqual(parsed_builder['Root'], 'system')
+        self.assertGreater(parsed_builder['DumpableRAMBytes'], 0)
+        self.assertTrue(any(row['RawMemoryRegionKind'] == 'ramd' for row in parsed_builder['Entries']))
+        self.assertTrue(all(not any(row['start'] < end and start < row['end']
+                                    for start, end in parsed_builder['Ranges'])
+                            for row in parsed_builder['Entries']
+                            if row['RawMemoryRegionKind'] == 'ramd'))
+        self.assertTrue(any(row['kind'] == 'rom' and row['RawMemoryRegionKind'] == 'rom'
+                            for row in parsed_builder['Entries']))
+        readonly_ram = [row for row in parsed_builder['Entries']
+                        if row['RawMemoryRegionKind'] == 'rom']
+        self.assertTrue(readonly_ram)
+        self.assertTrue(any(any(start < row['end'] and row['start'] < end
+                                for start, end in parsed_builder['Ranges'])
+                            for row in readonly_ram),
+                        'read-only MR_RAM visible in the system FlatView must remain dumpable')
+        romd = [row for row in parsed_builder['Entries']
+                if row['RawMemoryRegionKind'] == 'romd']
+        self.assertTrue(romd)
+        self.assertTrue(any(row['kind'] in ('rom', 'romd') for row in romd))
+        self.assertTrue(any(row['kind'] == 'rom' for row in romd),
+                        'the selected builder has a read-only FlatView alias of a non-RAM ROMD')
+        for row in romd:
+            self.assertFalse(any(row['start'] < end and start < row['end']
+                                 for start, end in parsed_builder['Ranges']))
+
+        flatview = (
+            'FlatView #0\n'
+            ' AS "memory", root: system\n'
+            ' AS "cpu-memory-0", root: system\n'
+            ' Root memory region: system\n'
+            '  0000000000000000-0000000000000fff (prio 0, ram): pc.ram owner:{dev id=pc}\n'
+            '  0000000000001000-0000000000001fff (prio 0, rom): readonly-ram parent:{obj path=/machine/unattached}\n'
+            '  0000000100000000-0000000100000fff (prio 0, ram): pc.ram @0000000000002000 owner:{dev id=pc}\n'
+            '  0000000200000000-0000000200000fff (prio 0, rom): pflash owner:{dev id=flash0}\n'
+            '  0000000300000000-0000000300000fff (prio 0, rom): readonly-mmio owner:{dev id=mmio0}\n'
+            '  0000000400000000-0000000400000fff (prio 0, ramd): device-ram owner:{dev id=ramd0}\n'
+            '  0000000500000000-0000000500000fff (prio 0, nv-ram): persistent-ram owner:{dev id=nv0}\n')
+        region_tree = (
+            'address-space: memory\n'
+            '  0000000000000000-0000000000000fff (prio 0, ram): pc.ram owner:{dev id=pc}\n'
+            '  0000000000001000-0000000000001fff (prio 0, rom): readonly-ram parent:{obj path=/machine/unattached}\n'
+            '  0000000100000000-0000000100000fff (prio 0, ram): pc.ram owner:{dev id=pc}\n'
+            '  0000000200000000-0000000200000fff (prio 0, romd): pflash owner:{dev id=flash0}\n'
+            '  0000000300000000-0000000300000fff (prio 0, i/o): readonly-mmio owner:{dev id=mmio0}\n'
+            '  0000000400000000-0000000400000fff (prio 0, ramd): device-ram owner:{dev id=ramd0}\n'
+            '  0000000500000000-0000000500000fff (prio 0, nv-ram): persistent-ram owner:{dev id=nv0}\n')
+        # Dumpable effective RAM is 12 KiB although nominal configured RAM is
+        # 20 KiB. Exact effective-map coverage, not a nominal floor, governs.
+        expected_ranges = [[0, 0x2000], [0x100000000, 0x100001000]]
+        parsed = preserve.parse_qemu_ram_map(flatview, region_tree, 0x5000)
+        self.assertEqual(parsed['Ranges'], expected_ranges)
+        self.assertEqual(parsed['DumpableRAMBytes'], 0x3000)
+        self.assertEqual(parsed['ConfiguredGuestMemoryBytes'], 0x5000)
+        readonly_ram_rows = [row for row in parsed['Entries']
+                             if row['kind'] == 'rom' and row['RawMemoryRegionKind'] == 'rom']
+        self.assertTrue(readonly_ram_rows)
+        self.assertTrue(any(start < row['end'] and row['start'] < end
+                            for row in readonly_ram_rows for start, end in parsed['Ranges']))
+        romd_rows = [row for row in parsed['Entries'] if row['RawMemoryRegionKind'] == 'romd']
+        self.assertTrue(any(row['kind'] == 'rom' for row in romd_rows))
+        self.assertTrue(all(not (row['start'] < end and start < row['end'])
+                            for row in romd_rows for start, end in parsed['Ranges']))
+        nonram_rom_rows = [row for row in parsed['Entries']
+                           if row['kind'] == 'rom' and row['RawMemoryRegionKind'] == 'i/o']
+        self.assertTrue(nonram_rom_rows)
+        self.assertTrue(all(not (row['start'] < end and start < row['end'])
+                            for row in nonram_rom_rows for start, end in parsed['Ranges']))
+        nonvolatile_rows = [row for row in parsed['Entries'] if row['RawMemoryRegionNonvolatile']]
+        self.assertTrue(nonvolatile_rows)
+        self.assertTrue(all(not (row['start'] < end and start < row['end'])
+                            for row in nonvolatile_rows for start, end in parsed['Ranges']))
+        with self.assertRaises(preserve.RetentionError):
+            preserve.parse_qemu_ram_map(flatview.replace(' AS "memory", root: system\n',
+                                                         ' AS "memory", root: changed\n'),
+                                        region_tree, 0x5000)
+        with self.assertRaises(preserve.RetentionError):
+            preserve.parse_qemu_ram_map(flatview.replace('  0000000100000000-0000000100000fff',
+                                                         '  0000000000001800-0000000000002800'),
+                                        region_tree, 0x5000)
+        with self.assertRaises(preserve.RetentionError):
+            preserve.parse_qemu_ram_map(flatview +
+                                        'FlatView #1\n AS "memory", root: system\n'
+                                        ' Root memory region: system\n'
+                                        '  0000000000000000-000000000000000f (prio 0, ram): duplicate\n',
+                                        region_tree, 0x5000)
+        with self.assertRaises(preserve.RetentionError):
+            preserve.parse_qemu_ram_map(flatview, region_tree.replace('readonly-ram parent:',
+                                                                      'unlisted-ram parent:'), 0x5000)
+        duplicate_type = region_tree + (
+            '  0000000600000000-0000000600000fff (prio 0, romd): readonly-ram parent:{obj path=/machine/unattached}\n')
+        with self.assertRaises(preserve.RetentionError):
+            preserve.parse_qemu_ram_map(flatview, duplicate_type, 0x5000)
+
+    def test_elf64_exact_discontiguous_ram_coverage_and_rejects_ranges_or_file_gaps(self):
+        guest = 0x3000
+        logical_capacity = guest + preserve.GIB
+        expected = [[0, 0x2000], [0x100000000, 0x100001000]]
+        positive = make_elf_core([(0, b'A' * 0x2000), (0x100000000, b'B' * 0x1000)])
+        info = preserve.elf_validate(positive[:4096], len(positive), guest,
+                                     logical_capacity, expected)
+        self.assertEqual(info['PTLoadBytes'], guest)
+        self.assertEqual(info['ObservedPTLoadRanges'], expected)
+        # Firmware/device reservations can make the exact effective map and ELF
+        # smaller than the configured guest memory; the captured map is the
+        # authority, never a nominal-memory floor.
+        below_nominal = preserve.elf_validate(positive[:4096], len(positive), 0x5000,
+                                              logical_capacity, expected)
+        self.assertEqual(below_nominal['GuestMemoryBytes'], 0x5000)
+        self.assertEqual(below_nominal['PTLoadBytes'], 0x3000)
+
+        invalid_cores = {
+            'duplicate physical interval': make_elf_core([
+                (0, b'A' * 0x2000), (0, b'B' * 0x1000)]),
+            'overlapping physical intervals': make_elf_core([
+                (0, b'A' * 0x2000), (0x1000, b'B' * 0x1000),
+                (0x100000000, b'C' * 0x1000)]),
+            'shifted physical intervals': make_elf_core([
+                (0x1000, b'A' * 0x2000), (0x100001000, b'B' * 0x1000)]),
+            'physical hole': make_elf_core([
+                (0, b'A' * 0x1000), (0x1000, b'B' * 0x1000),
+                (0x100002000, b'C' * 0x1000)]),
+            'file overlap': make_elf_core([
+                (0, b'A' * 0x2000), (0x100000000, b'B' * 0x1000)],
+                file_offsets=[4096, 4096]),
+            'truncated backing': make_elf_core([
+                (0, b'A' * 0x2000), (0x100000000, b'B' * 0x1000)],
+                file_sizes=[0x1fff, 0x1000]),
+            'zero-backed segment': make_elf_core([
+                (0, b'A' * 0x2000), (0x100000000, b'B' * 0x1000)],
+                file_sizes=[0x2000, 0]),
+            'missing expected range': positive,
+        }
+        expected_by_case = {name: expected for name in invalid_cores}
+        expected_by_case['missing expected range'] = [[0, 0x2000]]
+        for label, core in invalid_cores.items():
+            with self.subTest(case=label), self.assertRaises(preserve.RetentionError):
+                preserve.elf_validate(core[:4096], len(core), guest, logical_capacity,
+                                      expected_by_case[label])
+
+    def test_elf64_core_bounds_and_padding_controls(self):
+        guest = 4 * preserve.GIB
+        logical_capacity = guest + preserve.GIB
+        prefix = bytearray(64 + 56)
+        prefix[:16] = b'\x7fELF' + bytes((2, 1, 1)) + b'\0' * 9
+        struct.pack_into('<H', prefix, 16, 4)       # ET_CORE
+        struct.pack_into('<H', prefix, 18, 62)      # EM_X86_64
+        struct.pack_into('<I', prefix, 20, 1)       # EV_CURRENT
+        struct.pack_into('<Q', prefix, 32, 64)      # e_phoff
+        struct.pack_into('<HHH', prefix, 52, 64, 56, 1)
+        struct.pack_into('<IIQQQQQQ', prefix, 64, 1, 0, 4096, 0, 0, guest, guest, 4096)
+        size = 4096 + guest
+        ranges = [[0, guest]]
+        info = preserve.elf_validate(bytes(prefix), size, guest, logical_capacity, ranges)
+        self.assertEqual(info['PTLoadBytes'], guest)
+        self.assertEqual(info['TrailingPaddingBytes'], 0)
+
+        out_of_bounds = bytearray(prefix)
+        struct.pack_into('<Q', out_of_bounds, 72, logical_capacity)
+        with self.assertRaises(preserve.RetentionError):
+            preserve.elf_validate(bytes(out_of_bounds), size, guest, logical_capacity, ranges)
+
+        with self.assertRaises(preserve.RetentionError):
+            preserve.elf_validate(bytes(prefix), logical_capacity, guest, logical_capacity, ranges)
+
+        short_prefix = bytearray(prefix)
+        struct.pack_into('<Q', short_prefix, 32, preserve.MIB)
+        with self.assertRaises(preserve.RetentionError):
+            preserve.elf_validate(bytes(short_prefix), size, guest, logical_capacity, ranges)
+
+    def test_ram_stream_hashes_file_length_and_binds_discontiguous_map(self):
+        guest, logical_capacity = 0x3000, 0x5000
+        expected = [[0, 0x2000], [0x100000000, 0x100001000]]
+        core = make_elf_core([(0, b'A' * 0x2000),
+                              (0x100000000, b'B' * 0x1000)])
+        capacity = len(core)
+
+        class Stream:
+            def recvAll(self, callback, opaque):
+                self.count = callback(self, bytes(core), opaque)
+
+            def finish(self):
+                pass
+
+            def abort(self):
+                pass
+
+        class Connection:
+            def newStream(self, _flags):
+                return Stream()
+
+        class Volume:
+            def __init__(self, reported_capacity):
+                self.reported_capacity = reported_capacity
+
+            def info(self):
+                # Raw test volumes report the real ABI ordering and are fully allocated.
+                return 0, self.reported_capacity, self.reported_capacity
+
+            def download(self, _stream, offset, length, _flags):
+                if offset != 0 or length != capacity:
+                    raise AssertionError('unexpected RAM stream range')
+
+        result = preserve.hash_and_validate_ram(Connection(), Volume(capacity), guest,
+                                                logical_capacity, expected)
+        self.assertEqual(result['bytes'], capacity)
+        self.assertEqual(result['elf']['PTLoadBytes'], guest)
+        with self.assertRaises(preserve.RetentionError):
+            preserve.hash_and_validate_ram(Connection(), Volume(logical_capacity + 1), guest,
+                                           logical_capacity, expected)
+
+    def test_dump_state_postcondition_requires_exact_libvirt_state_and_reason_pair(self):
+        class Libvirt:
+            VIR_DOMAIN_RUNNING = 1
+            VIR_DOMAIN_PAUSED = 3
+            VIR_DOMAIN_PAUSED_USER = 1
+            VIR_DOMAIN_PAUSED_DUMP = 4
+            VIR_DOMAIN_SHUTOFF = 5
+            VIR_DOMAIN_SHUTOFF_CRASHED = 3
+            VIR_DOMAIN_CRASHED = 6
+
+        stopped = {'active': False, 'state': Libvirt.VIR_DOMAIN_SHUTOFF,
+                   'reason': Libvirt.VIR_DOMAIN_SHUTOFF_CRASHED,
+                   'live_xml': None, 'state_name': 'shutoff'}
+        result = preserve.require_dump_shutdown(stopped, Libvirt)
+        self.assertEqual(result['DomainStateName'], 'shutoff')
+        self.assertEqual(result['DomainStateReasonName'], 'SHUTOFF_CRASHED')
+        self.assertEqual(result['DomainStateReasonCode'], 3)
+
+        for bad in (
+                dict(stopped, reason=0),
+                dict(stopped, state=Libvirt.VIR_DOMAIN_CRASHED, reason=0),
+                dict(stopped, active=True),
+                dict(stopped, live_xml='<domain/>')):
+            with self.subTest(state=bad['state'], reason=bad['reason'], active=bad['active']), \
+                    self.assertRaises(preserve.RetentionError):
+                preserve.require_dump_shutdown(bad, Libvirt)
+
+        paused = {'active': True, 'state': Libvirt.VIR_DOMAIN_PAUSED,
+                  'reason': Libvirt.VIR_DOMAIN_PAUSED_USER, 'live_xml': '<domain/>',
+                  'state_name': 'paused'}
+        pause_result = preserve.require_paused_by_t5(paused, Libvirt, 'self-check pause')
+        self.assertEqual(pause_result['DomainStateReasonName'], 'PAUSED_USER')
+        for bad in (dict(paused, reason=Libvirt.VIR_DOMAIN_PAUSED_DUMP),
+                    dict(paused, state=Libvirt.VIR_DOMAIN_RUNNING),
+                    dict(paused, active=False), dict(paused, live_xml=None)):
+            with self.subTest(paused_state=bad['state'], reason=bad['reason'], active=bad['active']), \
+                    self.assertRaises(preserve.RetentionError):
+                preserve.require_paused_by_t5(bad, Libvirt, 'self-check pause')
+
+    def test_qemu_ram_map_must_remain_byte_identical_until_dump(self):
+        def capture(name, text):
+            raw = text.encode('utf-8')
+            return {'Command': ['virsh', 'qemu-monitor-command', preserve.DOMAIN_UUID, name],
+                    'Text': text, 'Bytes': len(raw), 'SHA256': hashlib.sha256(raw).hexdigest()}
+
+        base = {'FlatView': capture('flat', 'FlatView #0\n'),
+                'RegionTree': capture('tree', 'address-space: memory\n'),
+                'Parsed': {'Ranges': [[0, 4096]]}}
+        preserve.require_stable_qemu_ram_map(base, dict(base))
+        for name, field, value in (
+                ('FlatView', 'Command', ['virsh', 'qemu-monitor-command', 'other-domain']),
+                ('FlatView', 'Text', 'FlatView #1\n'),
+                ('FlatView', 'Bytes', 14),
+                ('FlatView', 'SHA256', 'B' * 64),
+                ('RegionTree', 'Text', 'address-space: changed\n')):
+            changed = {'FlatView': dict(base['FlatView']),
+                       'RegionTree': dict(base['RegionTree']), 'Parsed': dict(base['Parsed'])}
+            changed[name][field] = value
+            with self.subTest(map_name=name, changed_field=field), \
+                    self.assertRaises(preserve.RetentionError):
+                preserve.require_stable_qemu_ram_map(base, changed)
+        changed_parsed = {'FlatView': dict(base['FlatView']),
+                          'RegionTree': dict(base['RegionTree']),
+                          'Parsed': {'Ranges': [[0, 2048], [3072, 4096]]}}
+        with self.assertRaises(preserve.RetentionError):
+            preserve.require_stable_qemu_ram_map(base, changed_parsed)
+
+    def test_pinned_qemu_volume_permissions_and_unique_marker(self):
+        baseline_path = ROOT / preserve.BASELINE_RECEIPT
+        baseline = preserve.parse_json_unique(baseline_path)
+        identity = preserve.private_identity_from_pinned_base(baseline)
+        self.assertEqual(identity, {'owner': 958, 'group': 958, 'mode': 0o600, 'owner_name': 'libvirt-qemu'})
+        volume_xml = preserve.make_memory_volume_xml('selfcheck-memory.raw', preserve.GIB, identity)
+        volume_root = ET.fromstring(volume_xml)
+        details = {'mode': volume_root.findtext('target/permissions/mode'),
+                   'owner': volume_root.findtext('target/permissions/owner'),
+                   'group': volume_root.findtext('target/permissions/group')}
+        permissions = preserve.verify_private_volume(details, identity, 'self-check memory volume')
+        self.assertEqual(permissions['Mode'], '0600')
+        self.assertEqual(permissions['OwnerUID'], 958)
+        self.assertEqual(permissions['GroupGID'], 958)
+
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            state_dir = Path(temp) / 'state'
+            evidence = Path(temp) / 'evidence'
+            evidence.mkdir()
+            prebegin = evidence / 'SelfCheckD4-prebegin.json'
+            prebegin.write_text('{"pinned":true}\n', encoding='utf-8')
+            marker = preserve.exact_write_marker(state_dir, 'SelfCheckD4', prebegin)
+            self.assertEqual(stat.S_IMODE(marker.stat().st_mode), 0o600)
+            record = preserve.parse_json_unique(marker)
+            self.assertEqual(record['PrebeginSHA256'], hashlib.sha256(prebegin.read_bytes()).hexdigest())
+            with self.assertRaises(preserve.RetentionError):
+                preserve.exact_write_marker(state_dir, 'SelfCheckD4', prebegin)
+
+    def test_preserve_validation_failure_leaves_marker_without_opening_libvirt(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            root = Path(temp)
+            evidence = root / 'evidence'
+            state = root / 'state'
+            evidence.mkdir()
+            tag = 'SelfCheckF6'
+            (evidence / (tag + '-prebegin.json')).write_text('{malformed\n', encoding='utf-8')
+            args = [
+                'preserve', '--repo-root', str(ROOT), '--evidence-dir', str(evidence),
+                '--state-dir', str(state), '--domain', preserve.DOMAIN,
+                '--expected-uuid', preserve.DOMAIN_UUID, '--tag', tag, '--mode', 'ordinary',
+                '--run-dir', preserve.POOL_PATH, '--driver-sha', 'A' * 64,
+                '--zip-sha', 'B' * 64, '--service-sha', 'C' * 64,
+                '--lifecycle-lease-fd', '3',
+                '--reason', 'self-check malformed prebegin',
+            ]
+            stdout, stderr = io.StringIO(), io.StringIO()
+            with mock.patch.object(preserve, 'open_connection', side_effect=AssertionError(
+                    'validation failure must not connect to libvirt')) as open_connection, \
+                    mock.patch.object(preserve, 'require_lifecycle_lock'):
+                with unittest.mock.patch('sys.stdout', stdout), unittest.mock.patch('sys.stderr', stderr):
+                    result = preserve.main(args)
+                open_connection.assert_not_called()
+            self.assertEqual(result, 20)
+            marker = preserve.marker_path(state)
+            self.assertTrue(marker.is_file())
+            attempts = (evidence / (tag + '-retention-attempt.txt')).read_text(encoding='utf-8')
+            self.assertIn('RETENTION_MARKER_CREATED=', attempts)
+            self.assertIn('T5_RETENTION=FAIL;', attempts)
+
+    def test_full_successful_retention_restores_and_removes_state_before_releasing_guards(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            root = Path(temp)
+            evidence = root / 'evidence'
+            state_dir = root / 'state'
+            pool_path = root / 'pool'
+            evidence.mkdir()
+            state_dir.mkdir()
+            pool_path.mkdir()
+            tag = 'SelfCheckP15'
+            base_path = str(root / 'base.qcow2')
+            backing_path = str(root / 'backing.qcow2')
+            overlay_path = str(pool_path / (preserve.DOMAIN + '.safeupload-run-' + tag + '.qcow2'))
+            base_payload = b'qcow-base-test-bytes'
+            backing_payload = b'flat-backing-test-bytes'
+            overlay_payload = b'qcow-overlay-test'
+            identity = {'owner': 958, 'group': 958, 'mode': 0o600, 'owner_name': 'libvirt-qemu'}
+            base_sha = hashlib.sha256(base_payload).hexdigest()
+            backing_sha = hashlib.sha256(backing_payload).hexdigest()
+            capacity = 64 * 1024
+
+            baseline_xml = (
+                '<domain type="kvm"><name>' + preserve.DOMAIN + '</name><uuid>' +
+                preserve.DOMAIN_UUID + '</uuid><memory unit="bytes">64</memory>'
+                '<currentMemory unit="bytes">64</currentMemory><os><type>hvm</type>'
+                '<nvram template="/usr/share/OVMF/OVMF_VARS.fd">' +
+                preserve.ORIGINAL_NVRAM_PATH + '</nvram></os><devices>'
+                '<disk type="file" device="disk"><driver type="qcow2"/>'
+                '<source file="' + base_path + '"/><target dev="vda" bus="virtio"/>'
+                '<address type="pci" slot="0x04"/></disk>'
+                '<interface type="network"><mac address="52:54:00:aa:dd:13"/>'
+                '<source network="default"/><model type="e1000e"/></interface>'
+                '<tpm model="tpm-crb"><backend type="emulator" version="2.0">'
+                '<profile name="default-v1"/></backend></tpm>'
+                '</devices></domain>')
+            private_xml = preserve.expected_private_state_xml(baseline_xml, tag)
+            run_root = preserve.expected_run_definition_root(private_xml, overlay_path, 'self-check')
+            run_xml = ET.tostring(run_root, encoding='unicode')
+            live_root = ET.fromstring(run_xml)
+            ET.SubElement(live_root.find('./devices/interface'), 'target', {'dev': 'vnet19'})
+            live_xml = ET.tostring(live_root, encoding='unicode')
+
+            def volume_xml(name, path, fmt, virtual_capacity, allocation, physical,
+                           payload, backing=None, owner=None, group=None, mode=None):
+                volume = ET.Element('volume')
+                ET.SubElement(volume, 'name').text = name
+                ET.SubElement(volume, 'key').text = path
+                ET.SubElement(volume, 'capacity', {'unit': 'bytes'}).text = str(virtual_capacity)
+                ET.SubElement(volume, 'allocation', {'unit': 'bytes'}).text = str(allocation)
+                ET.SubElement(volume, 'physical', {'unit': 'bytes'}).text = str(physical)
+                target = ET.SubElement(volume, 'target')
+                ET.SubElement(target, 'path').text = path
+                ET.SubElement(target, 'format', {'type': fmt})
+                if owner is not None:
+                    permissions = ET.SubElement(target, 'permissions')
+                    ET.SubElement(permissions, 'mode').text = format(mode, '04o')
+                    ET.SubElement(permissions, 'owner').text = str(owner)
+                    ET.SubElement(permissions, 'group').text = str(group)
+                if backing:
+                    backing_node = ET.SubElement(volume, 'backingStore')
+                    ET.SubElement(backing_node, 'path').text = backing
+                    ET.SubElement(backing_node, 'format', {'type': 'qcow2'})
+                return ET.tostring(volume, encoding='unicode')
+
+            base_xml = volume_xml(Path(base_path).name, base_path, 'qcow2', capacity,
+                                  len(base_payload), len(base_payload), base_payload,
+                                  backing_path, identity['owner'], identity['group'], identity['mode'])
+            backing_xml = volume_xml(Path(backing_path).name, backing_path, 'qcow2', capacity,
+                                     len(backing_payload), len(backing_payload), backing_payload)
+            baseline = {'Domain': preserve.DOMAIN, 'UUID': preserve.DOMAIN_UUID,
+                        'InactiveXML': baseline_xml, 'BasePath': base_path,
+                        'BackingPath': backing_path, 'BaseVolumeXML': base_xml,
+                        'BackingVolumeXML': backing_xml}
+            input_pins = preserve.expected_input_fields(tag, 'ordinary', 'A' * 64, 'B' * 64, 'C' * 64)
+            (evidence / (tag + '-input-hashes.txt')).write_text(
+                '\n'.join(key + '=' + value for key, value in input_pins.items()) + '\n', encoding='utf-8')
+            prebegin_xml = evidence / (tag + '-prebegin-inactive.xml')
+            prebegin_xml.write_text(private_xml, encoding='utf-8')
+            prebegin = {
+                'Schema': 'T5PrebeginPinV1', 'RunTag': tag, 'Mode': 'ordinary',
+                'Domain': preserve.DOMAIN, 'UUID': preserve.DOMAIN_UUID,
+                'BaselineReceiptSHA256': preserve.BASELINE_SHA256,
+                'PreflightReceiptSHA256': preserve.PREFLIGHT_SHA256,
+                'InactiveXMLPath': str(prebegin_xml),
+                'InactiveXMLSHA256': hashlib.sha256(private_xml.encode('utf-8')).hexdigest(),
+                'OriginalInactiveXMLSHA256': hashlib.sha256(baseline_xml.encode('utf-8')).hexdigest(),
+                'BasePath': base_path, 'BackingPath': backing_path,
+                'BaseSHA256': base_sha, 'BackingSHA256': backing_sha,
+                'BaseBytes': len(base_payload), 'BackingBytes': len(backing_payload),
+                'BaseVolumeXML': base_xml, 'BackingVolumeXML': backing_xml,
+                'RunPoolPath': str(pool_path), 'RunPoolName': 'selfcheck-pool',
+                'InputPins': input_pins,
+            }
+            preserve.atomic_json(evidence / (tag + '-prebegin.json'), prebegin)
+            state_bytes = ('base=' + base_path + '\noverlay=' + overlay_path + '\ntag=' + tag +
+                           '\nbasestat=123 456\n').encode('utf-8')
+            (state_dir / preserve.DOMAIN).write_bytes(state_bytes)
+            owner_pid = os.getpid()
+            token = preserve.create_progress_guard(state_dir, tag, owner_pid)
+
+            class Stream:
+                def recvAll(self, callback, opaque):
+                    callback(self, self.data, opaque)
+
+                def finish(self):
+                    pass
+
+                def abort(self):
+                    pass
+
+            class StorageVolume:
+                def __init__(self, name, path, fmt, virtual_capacity, payload,
+                             allocation=None, backing=None, private=None):
+                    self.name = name
+                    self.path = path
+                    self.fmt = fmt
+                    self.capacity = virtual_capacity
+                    self.payload = payload
+                    self.allocation = len(payload) if allocation is None else allocation
+                    self.backing = backing
+                    self.private = private
+
+                def XMLDesc(self, _flags):
+                    private_fields = self.private or {}
+                    return volume_xml(self.name, self.path, self.fmt, self.capacity,
+                                      self.allocation, len(self.payload), self.payload,
+                                      self.backing, private_fields.get('owner'),
+                                      private_fields.get('group'), private_fields.get('mode'))
+
+                def info(self):
+                    return 0, self.capacity, self.allocation
+
+                def download(self, stream, offset, length, _flags):
+                    stream.data = self.payload if length == 0 else self.payload[offset:offset + length]
+
+            base_volume = StorageVolume(Path(base_path).name, base_path, 'qcow2', capacity,
+                                        base_payload, backing=backing_path,
+                                        private=identity)
+            backing_volume = StorageVolume(Path(backing_path).name, backing_path, 'qcow2', capacity,
+                                           backing_payload)
+            overlay_volume = StorageVolume(Path(overlay_path).name, overlay_path, 'qcow2', capacity,
+                                           overlay_payload, backing=base_path, private=identity)
+
+            class Domain:
+                def __init__(self):
+                    self.inactive_xml = run_xml
+                    self.live_xml = live_xml
+                    self.active = True
+                    self.current_state = 1
+                    self.current_reason = 5
+
+                def UUIDString(self):
+                    return preserve.DOMAIN_UUID
+
+                def state(self, _flags):
+                    return self.current_state, self.current_reason
+
+                def isActive(self):
+                    return self.active
+
+                def XMLDesc(self, flags):
+                    if flags == 2:
+                        return self.inactive_xml
+                    return self.live_xml
+
+                def suspend(self):
+                    self.current_state = Libvirt.VIR_DOMAIN_PAUSED
+                    self.current_reason = Libvirt.VIR_DOMAIN_PAUSED_USER
+                    return 0
+
+            domain = Domain()
+
+            class LibvirtError(Exception):
+                def __init__(self, message='missing volume', code=404):
+                    super().__init__(message)
+                    self.code = code
+
+                def get_error_code(self):
+                    return self.code
+
+            class Libvirt:
+                VIR_STORAGE_POOL_RUNNING = 2
+                VIR_DOMAIN_XML_INACTIVE = 2
+                VIR_DOMAIN_RUNNING = 1
+                VIR_DOMAIN_PAUSED = 3
+                VIR_DOMAIN_PAUSED_USER = 1
+                VIR_DOMAIN_SHUTOFF = 5
+                VIR_DOMAIN_SHUTOFF_CRASHED = 3
+                VIR_DOMAIN_CRASHED = 6
+                VIR_ERR_NO_STORAGE_VOL = 404
+                libvirtError = LibvirtError
+
+            class Pool:
+                def __init__(self):
+                    self.volumes = {vol.name: vol for vol in (base_volume, backing_volume, overlay_volume)}
+
+                def XMLDesc(self, _flags):
+                    return '<pool><name>selfcheck-pool</name><target><path>' + str(pool_path) + \
+                           '</path></target></pool>'
+
+                def name(self):
+                    return 'selfcheck-pool'
+
+                def info(self):
+                    return (Libvirt.VIR_STORAGE_POOL_RUNNING, 16 * preserve.GIB,
+                            1 * preserve.GIB, 8 * preserve.GIB)
+
+                def refresh(self, _flags):
+                    return 0
+
+                def storageVolLookupByName(self, name):
+                    if name not in self.volumes:
+                        raise LibvirtError()
+                    return self.volumes[name]
+
+                def createXML(self, xml_text, _flags):
+                    spec = ET.fromstring(xml_text)
+                    name = spec.findtext('name')
+                    cap = int(spec.findtext('capacity'))
+                    permissions = spec.find('target/permissions')
+                    private = {'owner': int(permissions.findtext('owner')),
+                               'group': int(permissions.findtext('group')),
+                               'mode': int(permissions.findtext('mode'), 8)}
+                    volume = StorageVolume(name, str(pool_path / name), 'raw', cap, b'',
+                                           allocation=0, private=private)
+                    self.volumes[name] = volume
+                    return volume
+
+            pool = Pool()
+
+            class Connection:
+                def listAllStoragePools(self, _flags):
+                    return [pool]
+
+                def lookupByName(self, name):
+                    if name != preserve.DOMAIN:
+                        raise AssertionError('unexpected domain lookup')
+                    return domain
+
+                def storageVolLookupByPath(self, path):
+                    for volume in pool.volumes.values():
+                        if volume.path == path:
+                            return volume
+                    raise LibvirtError()
+
+                def newStream(self, _flags):
+                    return Stream()
+
+                def defineXML(self, xml_text):
+                    domain.inactive_xml = xml_text
+                    domain.live_xml = None
+                    domain.active = False
+                    domain.current_state = Libvirt.VIR_DOMAIN_SHUTOFF
+                    return domain
+
+                def close(self):
+                    pass
+
+            connection = Connection()
+
+            guest_memory = 64
+            core = make_elf_core([(0, b'R' * guest_memory)])
+            map_text = ('FlatView #0\n AS "memory", root: system\n'
+                        ' Root memory region: system\n'
+                        '  0000000000000000-000000000000003f (prio 0, ram): selfcheck.ram\n')
+            tree_text = ('address-space: memory\n'
+                         '  0000000000000000-000000000000003f (prio 0, ram): '
+                         'selfcheck.ram owner:{dev id=selfcheck}\n')
+
+            def map_capture(command, text):
+                raw = text.encode('utf-8')
+                return {'Command': command, 'Text': text,
+                        'SHA256': hashlib.sha256(raw).hexdigest(), 'Bytes': len(raw)}
+
+            ram_region_map = {
+                'FlatView': map_capture(preserve.QEMU_MTREE_FLATVIEW_COMMAND, map_text),
+                'RegionTree': map_capture(preserve.QEMU_MTREE_REGION_TREE_COMMAND, tree_text),
+                'Parsed': {'Ranges': [[0, guest_memory]], 'DumpableRAMBytes': guest_memory},
+            }
+
+            def fake_dump(command, **_kwargs):
+                self.assertEqual(domain.current_state, Libvirt.VIR_DOMAIN_PAUSED)
+                self.assertEqual(domain.current_reason, Libvirt.VIR_DOMAIN_PAUSED_USER)
+                self.assertEqual(command, ['virsh', '-c', preserve.LIBVIRT_URI, 'dump',
+                                           preserve.DOMAIN_UUID, str(pool_path / preserve.memory_volume_name(tag)),
+                                           '--crash', '--memory-only', '--format', 'elf'])
+                ram = pool.volumes[preserve.memory_volume_name(tag)]
+                ram.payload = bytes(core)
+                ram.capacity = len(core)
+                ram.allocation = len(core)
+                domain.active = False
+                domain.live_xml = None
+                domain.current_state = Libvirt.VIR_DOMAIN_SHUTOFF
+                domain.current_reason = Libvirt.VIR_DOMAIN_SHUTOFF_CRASHED
+                return subprocess.CompletedProcess(command, 0, stdout=b'', stderr=b'')
+
+            def fake_map_capture(configured_memory):
+                self.assertEqual(configured_memory, guest_memory)
+                self.assertEqual(domain.current_state, Libvirt.VIR_DOMAIN_PAUSED)
+                self.assertEqual(domain.current_reason, Libvirt.VIR_DOMAIN_PAUSED_USER)
+                return ram_region_map
+
+            args = type('Args', (), {
+                'repo_root': str(ROOT), 'evidence_dir': str(evidence), 'state_dir': str(state_dir),
+                'tag': tag, 'mode': 'ordinary', 'driver_sha': 'A' * 64, 'zip_sha': 'B' * 64,
+                'service_sha': 'C' * 64, 'guard_token': token, 'owner_pid': owner_pid,
+                'reason': 'self-check full successful preservation',
+            })()
+
+            # The actual preservation branch must refuse both base and backing
+            # byte mismatches before invoking the crash dump.  Failed attempts
+            # keep the guest, state, overlay, and both guards intact.
+            for bad_base, bad_backing in (('0' * 64, backing_sha),
+                                           (base_sha, '0' * 64)):
+                dump_spy = mock.Mock(side_effect=fake_dump)
+                with mock.patch.object(preserve, 'POOL_PATH', str(pool_path)), \
+                        mock.patch.object(preserve, 'BASE_VOLUME_SHA256', bad_base), \
+                        mock.patch.object(preserve, 'BACKING_VOLUME_SHA256', bad_backing), \
+                        mock.patch.object(preserve, 'load_pinned_receipts', return_value=(baseline, {})), \
+                        mock.patch.object(preserve, 'private_identity_from_pinned_base', return_value=identity), \
+                        mock.patch.object(preserve, 'open_connection', return_value=(Libvirt, connection)), \
+                        mock.patch.dict(sys.modules, {'libvirt': Libvirt}), \
+                        mock.patch.object(preserve, 'capture_qemu_ram_region_map',
+                                          side_effect=fake_map_capture), \
+                        mock.patch.object(preserve.subprocess, 'run', dump_spy), \
+                        mock.patch('sys.stdout', io.StringIO()):
+                    with self.assertRaises(preserve.RetentionError):
+                        preserve.durable_retention(args)
+                dump_spy.assert_not_called()
+                self.assertTrue(domain.active)
+                self.assertEqual(domain.inactive_xml, run_xml)
+                self.assertEqual((state_dir / preserve.DOMAIN).read_bytes(), state_bytes)
+                self.assertTrue(preserve.marker_path(state_dir).is_file())
+                self.assertTrue(preserve.inprogress_path(state_dir).is_file())
+                self.assertIn(overlay_path, [volume.path for volume in pool.volumes.values()])
+                preserve.marker_path(state_dir).unlink()
+                preserve.fsync_directory(state_dir)
+
+            dump_spy = mock.Mock(side_effect=fake_dump)
+            map_spy = mock.Mock(side_effect=fake_map_capture)
+            with mock.patch.object(preserve, 'POOL_PATH', str(pool_path)), \
+                    mock.patch.object(preserve, 'BASE_VOLUME_SHA256', base_sha), \
+                    mock.patch.object(preserve, 'BACKING_VOLUME_SHA256', backing_sha), \
+                    mock.patch.object(preserve, 'load_pinned_receipts', return_value=(baseline, {})), \
+                    mock.patch.object(preserve, 'private_identity_from_pinned_base', return_value=identity), \
+                    mock.patch.object(preserve, 'open_connection', return_value=(Libvirt, connection)), \
+                    mock.patch.dict(sys.modules, {'libvirt': Libvirt}), \
+                    mock.patch.object(preserve, 'capture_qemu_ram_region_map', map_spy), \
+                    mock.patch.object(preserve.subprocess, 'run', dump_spy), \
+                    mock.patch('sys.stdout', io.StringIO()):
+                result = preserve.durable_retention(args)
+            self.assertEqual(dump_spy.call_count, 1)
+            self.assertEqual(map_spy.call_count, 2)
+
+            archive = evidence / (tag + '-retention')
+            self.assertEqual(result, 0)
+            self.assertTrue(archive.is_dir())
+            self.assertEqual((archive / 'run-disk-state.txt').read_bytes(), state_bytes)
+            restore = preserve.parse_json_unique(archive / 'post-restore-verification.json')
+            self.assertIs(restore['RunDiskStateRemovedFromActiveState'], True)
+            self.assertFalse((state_dir / preserve.DOMAIN).exists())
+            self.assertFalse(preserve.marker_path(state_dir).exists())
+            self.assertFalse(preserve.inprogress_path(state_dir).exists())
+            self.assertEqual(domain.inactive_xml, private_xml)
+            self.assertIn(overlay_path, [volume.path for volume in pool.volumes.values()])
+            record = preserve.parse_json_unique(archive / 'receipt.json')
+            self.assertEqual(record['PreDumpBaseSHA256'], base_sha)
+            self.assertEqual(record['PreDumpBackingSHA256'], backing_sha)
+            self.assertEqual(record['RAM']['Status'], 'CAPTURED')
+            self.assertEqual(record['RAM']['ExpectedRAMRegions'], [[0, guest_memory]])
+            self.assertEqual(record['RAM']['PauseState']['DomainStateReasonName'], 'PAUSED_USER')
+            self.assertEqual(record['RAM']['DumpPostState']['DomainStateReasonName'], 'SHUTOFF_CRASHED')
+            self.assertEqual((archive / 'ram-region-flatview.txt').read_text(encoding='utf-8'), map_text)
+            self.assertEqual((archive / 'ram-region-tree.txt').read_text(encoding='utf-8'), tree_text)
+            self.assertEqual(set(record['RAM']['RegionMapCaptures']), {'FlatView', 'RegionTree'})
+            attempts = (evidence / (tag + '-retention-attempt.txt')).read_text(encoding='utf-8')
+            self.assertIn('T5_RETENTION=PASS;', attempts)
+
+    def test_cli_requires_supervisor_lease_fd_and_not_a_lock_fd(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            root = Path(temp)
+            evidence = root / 'evidence'
+            state = root / 'state'
+            evidence.mkdir()
+            state.mkdir()
+            tag = 'SelfCheckN14'
+            common = [
+                'not-started', '--repo-root', str(ROOT), '--evidence-dir', str(evidence),
+                '--state-dir', str(state), '--domain', preserve.DOMAIN,
+                '--expected-uuid', preserve.DOMAIN_UUID, '--tag', tag, '--mode', 'ordinary',
+                '--run-dir', preserve.POOL_PATH, '--driver-sha', 'A' * 64,
+                '--zip-sha', 'B' * 64, '--service-sha', 'C' * 64,
+                '--reason', 'self-check lease proof',
+            ]
+            with self.assertRaises(SystemExit) as missing:
+                preserve.parse_args(common)
+            self.assertEqual(missing.exception.code, 2)
+            self.assertFalse((evidence / (tag + '-run-begin.txt')).exists())
+
+            legacy_lock_argument = common + ['--lifecycle-lock-fd', '3']
+            with self.assertRaises(SystemExit) as legacy:
+                preserve.parse_args(legacy_lock_argument)
+            self.assertEqual(legacy.exception.code, 2)
+
+            lease_args = common + ['--lifecycle-lease-fd', '3']
+            parsed = preserve.parse_args(lease_args)
+            self.assertEqual(parsed.lifecycle_lease_fd, 3)
+            with mock.patch.object(preserve, 'require_lifecycle_lock', side_effect=
+                                   preserve.RetentionError('self-check rejects invalid lease')):
+                self.assertEqual(preserve.main(lease_args), 20)
+            self.assertFalse((evidence / (tag + '-run-begin.txt')).exists())
+
+            with mock.patch.object(preserve, 'require_lifecycle_lock', return_value={
+                    'Path': '/run/safeupload-t5/win10-debug3.lifecycle.lock',
+                    'SupervisorPID': os.getpid(), 'LockDevice': 1, 'LockInode': 2,
+                    'RunTag': tag, 'PreparedReceiptSHA256': 'A' * 64,
+                    'PrivateStateBindingReceiptSHA256': 'B' * 64}):
+                self.assertEqual(preserve.main(lease_args), 0)
+            self.assertEqual((evidence / (tag + '-run-begin.txt')).read_text(encoding='utf-8'),
+                             'T5RunDiskMutation=NOT_STARTED\nReason=self-check lease proof\n')
+
+    def test_shared_run_disk_begin_end_refuse_file_and_symlink_markers(self):
+        for marker_kind in ('retention-regular', 'retention-symlink',
+                            'progress-regular', 'progress-symlink'):
+            with self.subTest(marker_kind=marker_kind), tempfile.TemporaryDirectory(
+                    prefix='t5-preserve-selfcheck-') as temp:
+                state_home = Path(temp)
+                state_dir = state_home / 'safeupload' / 'run-disks'
+                state_dir.mkdir(parents=True)
+                suffix = (preserve.RETENTION_SUFFIX if marker_kind.startswith('retention')
+                          else preserve.INPROGRESS_SUFFIX)
+                marker = state_dir / ('fixture-domain' + suffix)
+                if marker_kind.endswith('regular'):
+                    marker.write_text('{"active":true}\n', encoding='utf-8')
+                else:
+                    target = state_home / 'marker-target'
+                    target.write_text('active', encoding='utf-8')
+                    marker.symlink_to(target)
+                begin_output = state_home / 'begin.out'
+                end_output = state_home / 'end.out'
+                blocked_reason = ('retained-state marker is active' if marker_kind.startswith('retention')
+                                  else 'durable T5 in-progress marker is active')
+                command = (
+                    'source ' + shlex.quote(str(RUN_DISK)) + '; '
+                    'run_disk_begin fixture-domain SelfCheckE5 > ' + shlex.quote(str(begin_output)) + ' 2>&1; b=$?; '
+                    'run_disk_end fixture-domain SelfCheckE5 > ' + shlex.quote(str(end_output)) + ' 2>&1; e=$?; '
+                    'test "$b" -eq 1 -a "$e" -eq 1 && '
+                'grep -q ' + shlex.quote(blocked_reason) + ' ' + shlex.quote(str(begin_output)) + ' && '
+                'grep -q ' + shlex.quote(blocked_reason) + ' ' + shlex.quote(str(end_output))
+                )
+                env = dict(os.environ, XDG_STATE_HOME=str(state_home))
+                result = subprocess.run(['bash', '-c', command], cwd=ROOT, env=env,
+                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+                self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+
+    def test_stale_run_state_begin_refuses_automatic_discard_before_libvirt(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            state_home = Path(temp)
+            state_dir = state_home / 'safeupload' / 'run-disks'
+            state_dir.mkdir(parents=True)
+            (state_dir / 'fixture-domain').write_text(
+                'base=/pinned/base.qcow2\noverlay=/run/tag.qcow2\ntag=stale\nbasestat=1 2\n',
+                encoding='utf-8')
+            command = (
+                'source ' + shlex.quote(str(RUN_DISK)) + '; '
+                'run_disk_begin fixture-domain SelfCheckJ10'
+            )
+            env = dict(os.environ, XDG_STATE_HOME=str(state_home))
+            result = subprocess.run(['bash', '-c', command], cwd=ROOT, env=env,
+                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            self.assertEqual(result.returncode, 1)
+            self.assertIn(b'refusing automatic discard', result.stdout)
+
+    def test_per_domain_lifecycle_lock_serializes_begin_and_end_callers(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            state_home = Path(temp)
+            signal = state_home / 'lock-held'
+            source = 'source ' + shlex.quote(str(RUN_DISK)) + '; '
+            holder = source + '_rd_lock_acquire fixture-domain || exit 2; '
+            holder += 'touch ' + shlex.quote(str(signal)) + '; sleep 5'
+            env = dict(os.environ, XDG_STATE_HOME=str(state_home))
+            process = subprocess.Popen(['bash', '-c', holder], cwd=ROOT, env=env,
+                                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+            try:
+                deadline = time.monotonic() + 3
+                while not signal.exists() and time.monotonic() < deadline:
+                    time.sleep(0.01)
+                self.assertTrue(signal.exists(), 'lock holder did not acquire the domain lock')
+                begin_output = state_home / 'begin.out'
+                end_output = state_home / 'end.out'
+                command = source + (
+                    'run_disk_begin fixture-domain SelfCheckK11 > ' + shlex.quote(str(begin_output)) + ' 2>&1; b=$?; '
+                    'run_disk_end fixture-domain SelfCheckK11 > ' + shlex.quote(str(end_output)) + ' 2>&1; e=$?; '
+                    'test "$b" -eq 1 -a "$e" -eq 1 && '
+                    'grep -q "another run-disk lifecycle holds" ' + shlex.quote(str(begin_output)) + ' && '
+                    'grep -q "another run-disk lifecycle holds" ' + shlex.quote(str(end_output))
+                )
+                result = subprocess.run(['bash', '-c', command], cwd=ROOT, env=env,
+                                        stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+                self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+            finally:
+                process.terminate()
+                try:
+                    process.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=2)
+
+    def test_t5_held_lifecycle_lock_accepts_only_its_exact_progress_token(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            state_home = Path(temp)
+            state_dir = state_home / 'safeupload' / 'run-disks'
+            state_dir.mkdir(parents=True)
+            (state_dir / 'fixture-domain').write_text(
+                'base=/pinned/base.qcow2\noverlay=/run/tag.qcow2\ntag=SelfCheckL12\nbasestat=1 2\n',
+                encoding='utf-8')
+            command = (
+                'source ' + shlex.quote(str(RUN_DISK)) + '; '
+                '_rd_lock_acquire fixture-domain || exit 2; '
+                'python3 - "$RUN_DISK_STATE/fixture-domain.t5-inprogress" "$$" <<\'PY\'\n'
+                'import json, os, sys\n'
+                'with open(sys.argv[1], "x", encoding="utf-8") as f:\n'
+                ' json.dump({"Schema":"T5InProgressV1","Domain":"fixture-domain",'
+                '"RunTag":"SelfCheckL12","PID":int(sys.argv[2]),"Token":"'
+                '0123456789abcdef0123456789abcdef"}, f)\n'
+                'os.chmod(sys.argv[1], 0o600)\n'
+                'PY\n'
+                'RUN_DISK_T5_GUARD_ACTIVE=yes RUN_DISK_T5_GUARD_DOMAIN=fixture-domain '
+                'RUN_DISK_T5_GUARD_TAG=SelfCheckL12 '
+                'RUN_DISK_T5_GUARD_TOKEN=0123456789abcdef0123456789abcdef '
+                'run_disk_begin fixture-domain SelfCheckL12 > "$RUN_DISK_STATE/out" 2>&1; rc=$?; '
+                'grep -q "refusing automatic discard" "$RUN_DISK_STATE/out" || exit 3; '
+                'test "$rc" -eq 1 || exit 4; _rd_lock_release'
+            )
+            env = dict(os.environ, XDG_STATE_HOME=str(state_home))
+            result = subprocess.run(['bash', '-c', command], cwd=ROOT, env=env,
+                                    stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            self.assertEqual(result.returncode, 0, result.stderr.decode('utf-8', 'replace'))
+
