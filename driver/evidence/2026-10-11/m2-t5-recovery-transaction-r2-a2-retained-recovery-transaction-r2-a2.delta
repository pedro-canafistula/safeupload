+    def test_full_qcow_volume_hash_uses_physical_stream_not_virtual_capacity(self):
+        payload = b'raw-qcow-file-bytes'
+        virtual_capacity = 120 * preserve.GIB
+        allocation = 17
+
+        def volume_xml(physical):
+            return ('<volume><name>base.qcow2</name><key>/pool/base.qcow2</key>'
+                    '<capacity unit="bytes">%d</capacity><allocation unit="bytes">%d</allocation>'
+                    '<physical unit="bytes">%d</physical><target><path>/pool/base.qcow2</path>'
+                    '<format type="qcow2"/></target></volume>' %
+                    (virtual_capacity, allocation, physical))
+
+        class Stream:
+            def __init__(self):
+                self.data = b''
+
+            def recvAll(self, callback, opaque):
+                callback(self, self.data, opaque)
+
+            def finish(self):
+                pass
+
+            def abort(self):
+                pass
+
+        class Connection:
+            def newStream(self, _flags):
+                return Stream()
+
+        class Volume:
+            def __init__(self, physical=None):
+                self.physical = len(payload) if physical is None else physical
+                self.calls = []
+
+            def XMLDesc(self, _flags):
+                return volume_xml(self.physical)
+
+            def info(self):
+                # libvirt StorageVol.info() is (type, capacity, allocation).
+                return 0, virtual_capacity, allocation
+
+            def download(self, stream, offset, length, flags):
+                self.calls.append((offset, length, flags))
+                if (offset, length, flags) != (0, 0, 0):
+                    raise AssertionError('full raw file request must use offset=0, length=0')
+                stream.data = payload
+
+        volume = Volume()
+        result = preserve.volume_sha256(Connection(), volume)
+        self.assertEqual(volume.calls, [(0, 0, 0)])
+        self.assertEqual(result['bytes'], len(payload))
+        self.assertEqual(result['physical_bytes'], len(payload))
+        self.assertEqual(result['virtual_capacity'], virtual_capacity)
+        self.assertEqual(result['sha256'], hashlib.sha256(payload).hexdigest())
+        with self.assertRaises(preserve.RetentionError):
+            preserve.volume_sha256(Connection(), Volume(physical=len(payload) + 1))
+
+    def test_dump_space_and_exact_run_definition_guards(self):
+        required = 5 * preserve.GIB + preserve.GIB
