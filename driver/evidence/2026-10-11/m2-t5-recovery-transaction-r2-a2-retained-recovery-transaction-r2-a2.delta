             os.close(parent)
 
     @classmethod
+    def list_exact_tree(cls, path: str, files: set[str], directories: set[str]) -> None:
+        """Reject unreviewed files, links, and empty directories below install root."""
+        root_fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                          os.O_NOFOLLOW)
+        actual_files: set[str] = set()
+        actual_directories: set[str] = set()
+
+        def visit(fd: int, prefix: str) -> None:
+            for name in os.listdir(fd):
+                if name in ('', '.', '..') or '/' in name or '\x00' in name:
+                    raise InvocationError('immutable install tree contains an invalid name')
+                relative = prefix + name
+                st = os.stat(name, dir_fd=fd, follow_symlinks=False)
+                if stat.S_ISDIR(st.st_mode):
+                    actual_directories.add(relative)
+                    child = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                                    os.O_NOFOLLOW, dir_fd=fd)
+                    try:
+                        visit(child, relative + '/')
+                    finally:
+                        os.close(child)
+                elif stat.S_ISREG(st.st_mode):
+                    actual_files.add(relative)
+                else:
+                    raise InvocationError('immutable install tree contains a link or special file')
+
+        try:
+            visit(root_fd, '')
+            if actual_files != files or actual_directories != directories:
+                raise InvocationError('immutable install tree membership differs')
+        finally:
+            os.close(root_fd)
+
