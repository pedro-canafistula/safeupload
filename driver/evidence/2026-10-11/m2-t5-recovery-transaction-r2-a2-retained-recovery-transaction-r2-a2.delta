+def host_preflight(args):
+    """Exercise private logical-capacity volume creation and short stream I/O, not QEMU dump access."""
+    libvirt, conn = open_connection()
+    pool = None
+    volume = None
+    volume_created = False
+    capacity = None
+    name = DOMAIN + '.safeupload-t5-' + args.tag + '-memory-probe.raw'
+    try:
+        if not re.fullmatch(r'[A-Za-z0-9]{3,30}', args.tag):
+            raise RetentionError('Invalid T5 host-preflight tag')
+        pool = pool_for_exact_path(conn, POOL_PATH)
+        if pool_lookup_volume(pool, name, libvirt) is not None:
+            raise RetentionError('Host preflight volume name already exists: ' + name)
+        baseline, _preflight = load_pinned_receipts(Path(args.repo_root).resolve())
+        private_identity = private_identity_from_pinned_base(baseline)
+        memory_root = ET.fromstring(baseline['InactiveXML'])
+        guest_memory = quantity_bytes(memory_root.find('memory'), 'maximum')
+        capacity = guest_memory + max(GIB, guest_memory // 4)
+        xml = make_memory_volume_xml(name, capacity, private_identity)
+        volume = pool.createXML(xml, 0)
+        volume_created = True
+        pool.refresh(0)
+        volume = pool_lookup_volume(pool, name, libvirt)
+        if volume is None:
+            raise RetentionError('Host preflight volume disappeared after create')
+        details = check_volume_identity(volume, str(Path(POOL_PATH) / name), 'raw',
+                                        'host-preflight volume', expected_name=name)
+        permissions = verify_private_volume(details, private_identity, 'host-preflight volume')
+        if (details['capacity'] != capacity
+                or storage_volume_info(volume, 'host-preflight volume')['capacity'] != capacity):
+            raise RetentionError('Host preflight could not create the exact guest-memory-plus-header logical capacity')
+        marker = b'SAFEUPLOAD_T5_LIBVIRT_VOLUME_STREAM_PROBE_V1'
+        stream = conn.newStream(0)
+        finished = False
+        try:
+            volume.upload(stream, 0, len(marker), 0)
+            sent = [0]
+            def send(_stream, requested, _opaque):
+                block = marker[sent[0]:sent[0] + requested]
+                sent[0] += len(block)
+                return block
+            stream.sendAll(send, None)
+            stream.finish()
+            finished = True
+        finally:
+            if not finished:
+                try:
+                    stream.abort()
+                except Exception:
+                    pass
+        pool.refresh(0)
+        volume = pool_lookup_volume(pool, name, libvirt)
+        if volume is None:
+            raise RetentionError('Host preflight volume disappeared after upload')
+        after_upload = check_volume_identity(volume, str(Path(POOL_PATH) / name), 'raw',
+                                             'host-preflight volume after upload', expected_name=name)
+        permissions_after = verify_private_volume(after_upload, private_identity,
+                                                  'host-preflight volume after upload')
+        if (after_upload['capacity'] != capacity
+                or storage_volume_info(volume, 'host-preflight volume after upload')['capacity'] != capacity
+                or permissions_after != permissions):
+            raise RetentionError('Host preflight volume metadata changed after stream upload')
+        downloaded = volume_read_range(conn, volume, 0, len(marker))
+        if sent[0] != len(marker) or downloaded != marker:
+            raise RetentionError('Host preflight volume upload/download bytes differ')
+        volume.delete(0)
+        volume = None
+        volume_created = False
+        pool.refresh(0)
+        if pool_lookup_volume(pool, name, libvirt) is not None:
+            raise RetentionError('Host preflight volume was not deleted')
+        print('T5_LIBVIRT_VOLUME_PREFLIGHT=PASS pool=' + pool.name() + ' path=' + POOL_PATH +
+              ' uid=' + str(permissions['OwnerUID']) + ' gid=' + str(permissions['GroupGID']) +
+              ' mode=' + permissions['Mode'] + ' logical_capacity_bytes=' + str(capacity) +
+              ' qemu_dump_write_assumption=volume-owned-by-libvirt-qemu')
+        return 0
+    except Exception as exc:
+        if pool is not None and volume_created:
+            try:
+                stale = pool_lookup_volume(pool, name, libvirt)
+                if stale is not None:
+                    stale.delete(0)
+                    pool.refresh(0)
+                    if pool_lookup_volume(pool, name, libvirt) is not None:
+                        raise RetentionError('Host preflight could not remove its uniquely named probe volume')
+            except Exception as cleanup_exc:
+                raise RetentionError('Host preflight failed and could not verify removal of its probe volume: '
+                                     + str(cleanup_exc)) from exc
+        raise
+    finally:
+        conn.close()
+
+
+def emit_no_mutation(args, reason):
+    path = Path(args.evidence_dir) / (args.tag + '-run-begin.txt')
+    text = ('T5RunDiskMutation=NOT_STARTED\nReason=' + reason.replace('\n', ' ') + '\n')
+    atomic_write(path, text.encode('utf-8'))
+    print(text, end='')
+
+
+def emit_not_started(args, reason):
+    emit_no_mutation(args, reason)
+
+
+def parse_args(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    sub = parser.add_subparsers(dest='command', required=True)
+    common = argparse.ArgumentParser(add_help=False)
+    common.add_argument('--repo-root', default='.')
+    common.add_argument('--evidence-dir', required=True)
+    common.add_argument('--state-dir', required=True)
+    common.add_argument('--domain', required=True)
+    common.add_argument('--expected-uuid', required=True)
+    common.add_argument('--tag', required=True)
+    common.add_argument('--mode', required=True)
+    common.add_argument('--run-dir', default=POOL_PATH)
+    common.add_argument('--driver-sha', required=True)
+    common.add_argument('--zip-sha', required=True)
+    common.add_argument('--service-sha', required=True)
+    common.add_argument('--guard-token')
+    common.add_argument('--owner-pid', type=int, default=os.getppid())
+    common.add_argument('--lifecycle-lease-fd', type=int, required=True,
+                        help='inherited read-only root lifecycle lease; root lock FD is private')
+    sub.add_parser('preflight', parents=[common])
+    sub.add_parser('arm', parents=[common])
+    sub.add_parser('mutation', parents=[common])
+    not_started = sub.add_parser('not-started', parents=[common])
+    not_started.add_argument('--reason', required=True)
+    cancel = sub.add_parser('cancel-progress', parents=[common])
+    cancel.add_argument('--reason', required=True)
+    decision = sub.add_parser('decide', parents=[common])
+    decision.add_argument('--alive', required=True, choices=('yes', 'no'))
+    decision.add_argument('--result-saved', required=True, choices=('yes', 'no'))
+    decision.add_argument('--raw-saved', required=True, choices=('yes', 'no'))
+    preserve = sub.add_parser('preserve', parents=[common])
+    preserve.add_argument('--reason', required=True)
+    sub.add_parser('pre-cleanup', parents=[common])
+    sub.add_parser('verify-cleanup', parents=[common])
+    host = sub.add_parser('host-preflight', parents=[common])
+    return parser.parse_args(argv)
+
+
+def main(argv=None):
+    args = parse_args(argv)
+    try:
+        require_lifecycle_lock(args)
+        if args.command == 'preflight':
+            record = live_preflight(args)
+            print('T5_PREBEGIN=PASS uuid=' + record['UUID'] +
+                  ' base_sha256=' + record['BaseSHA256'] +
+                  ' backing_sha256=' + record['BackingSHA256'] +
+                  ' xml_sha256=' + record['InactiveXMLSHA256'])
+            return 0
+        if args.command == 'arm':
+            return arm_progress(args)
+        if args.command == 'mutation':
+            result = inspect_mutation(args)
+            print(json.dumps(result, sort_keys=True))
+            return 10 if not result['Mutation'] else 0
+        if args.command == 'not-started':
+            emit_not_started(args, args.reason)
+            return 0
+        if args.command == 'cancel-progress':
+            return cancel_progress(args)
+        if args.command == 'decide':
+            complete, reasons = capture_completeness(
+                args.evidence_dir, args.tag, args.mode, args.driver_sha, args.zip_sha,
+                args.service_sha, args.alive, args.result_saved, args.raw_saved)
+            print('T5_CAPTURE_COMPLETENESS=' + ('COMPLETE' if complete else 'INCOMPLETE') +
+                  (' reason=' + '; '.join(reasons) if reasons else ''))
+            return 0 if complete else 10
+        if args.command == 'preserve':
+            return durable_retention(args)
+        if args.command == 'pre-cleanup':
+            return t5_pre_cleanup(args)
+        if args.command == 'verify-cleanup':
+            return t5_verify_cleanup(args)
+        if args.command == 'host-preflight':
+            return host_preflight(args)
+        raise RetentionError('Unknown helper command')
+    except Exception as exc:
+        if args.command == 'preserve':
+            try:
+                append_attempt(args.evidence_dir, args.tag,
+                               'T5_RETENTION=FAIL; error=' + str(exc))
+            except Exception:
+                pass
+        print(type(exc).__name__ + ': ' + str(exc), file=sys.stderr)
+        return 20
+
+
+if __name__ == '__main__':
+    sys.exit(main())
