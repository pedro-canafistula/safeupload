+        for value in negative:
+            with self.subTest(active_xml=value[-80:]):
+                with self.assertRaises(preserve.RetentionError):
+                    preserve.verify_active_run_definition(value, prebegin, overlay,
+                                                         'disallowed active XML change')
+
+        for extra_child in ('label', 'labelskip'):
+            disk_wrapper = ET.fromstring(active_text)
+            disk_security_label = disk_wrapper.find('./devices/disk/seclabel')
+            extra = ET.SubElement(disk_security_label, extra_child)
