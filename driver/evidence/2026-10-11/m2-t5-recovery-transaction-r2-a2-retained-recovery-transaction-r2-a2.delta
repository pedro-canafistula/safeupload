+def _requester_groups(uid: int = 1000) -> set[int]:
+    import grp
+    import pwd
+    record = pwd.getpwuid(uid)
+    groups = {record.pw_gid}
+    groups.update(os.getgrouplist(record.pw_name, record.pw_gid))
+    return groups
+
+
+def _check_requester_cannot_write(path: str, groups: set[int]) -> dict[str, Any]:
+    if not path.startswith('/') or os.path.normpath(path) != path:
+        raise InvocationError('protected source path is not normalized')
+    parts = path[1:].split('/')
+    if any(part in ('', '.', '..') for part in parts):
+        raise InvocationError('protected source path has an unsafe component')
+    current = '/'
+    rows = []
+    for index, part in enumerate(parts):
+        current = (current.rstrip('/') + '/' + part)
+        st = os.lstat(current)
+        if stat.S_ISLNK(st.st_mode):
+            raise InvocationError('protected source path traverses a symbolic link')
+        if index < len(parts) - 1 and not stat.S_ISDIR(st.st_mode):
+            raise InvocationError('protected source parent is not a directory')
+        if index == len(parts) - 1 and not (stat.S_ISREG(st.st_mode) or stat.S_ISDIR(st.st_mode)):
+            raise InvocationError('protected source leaf is not a regular file or directory')
+        mode = stat.S_IMODE(st.st_mode)
+        user_write = ((st.st_uid == 1000 and mode & stat.S_IWUSR) or
+                      (st.st_gid in groups and mode & stat.S_IWGRP) or
+                      bool(mode & stat.S_IWOTH))
+        if user_write:
+            raise InvocationError('requester UID 1000 can write protected source path component: ' + current)
+        try:
+            xattrs = os.listxattr(current, follow_symlinks=False)
+        except OSError as exc:
+            raise InvocationError('cannot inspect protected source ACL metadata: ' + current) from exc
+        if any(name in ('system.posix_acl_access', 'system.posix_acl_default')
+               for name in xattrs):
+            raise InvocationError('protected source path has an ACL requiring external proof: ' + current)
+        rows.append({'Path': current, 'Device': st.st_dev, 'Inode': st.st_ino,
+                     'UID': st.st_uid, 'GID': st.st_gid,
+                     'Mode': format(mode, '04o'), 'Kind':
+                     'directory' if stat.S_ISDIR(st.st_mode) else 'regular-file'})
+    return {'Path': path, 'Components': rows}
+
+
+def _verify_protected_source_filesystem() -> dict[str, Any]:
+    """Prove UID 1000 cannot mutate selected originals through ordinary paths."""
+    groups = _requester_groups()
+    paths = (
+        '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2',
+        '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2',
+        NVRAM_PATH,
+        '/var/lib/libvirt/swtpm/' + DOMAIN_UUID + '/tpm2',
+    )
+    observations = [_check_requester_cannot_write(path, groups) for path in paths]
+    tpm_fd = os.open(paths[-1], os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                     os.O_NOFOLLOW)
+    members = []
+    try:
+        names = sorted(os.listdir(tpm_fd))
+        if not names or '.lock' not in names:
+            raise InvocationError('source TPM directory lacks the measured source-only lock member')
+        for name in names:
+            if name in ('', '.', '..') or '/' in name or '\\' in name or '\x00' in name:
+                raise InvocationError('source TPM directory contains an unsafe member name')
+            fd = os.open(name, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                         dir_fd=tpm_fd)
+            try:
+                row = os.fstat(fd)
+                if not stat.S_ISREG(row.st_mode) or row.st_nlink != 1:
+                    raise InvocationError('source TPM member type/link identity differs')
+                if ((row.st_uid == 1000 and row.st_mode & stat.S_IWUSR)
+                        or row.st_gid in groups and row.st_mode & stat.S_IWGRP
+                        or row.st_mode & stat.S_IWOTH):
+                    raise InvocationError('requester UID 1000 can write a protected TPM member')
+                if any(name in ('system.posix_acl_access', 'system.posix_acl_default')
+                       for name in os.listxattr(fd)):
+                    raise InvocationError('protected TPM member has an ACL requiring external proof')
+                members.append({'Name': name, 'Device': row.st_dev, 'Inode': row.st_ino,
+                                'UID': row.st_uid, 'GID': row.st_gid,
+                                'Mode': format(stat.S_IMODE(row.st_mode), '04o'),
+                                'Bytes': row.st_size})
+            finally:
+                os.close(fd)
+    finally:
+        os.close(tpm_fd)
+    return {'Sources': observations, 'OriginalTPMMembers': members}
+
+
+def _verify_active_lifecycle_enforcement(fs: Any = RootFilesystem) -> dict[str, Any]:
+    """Re-check installed enforcement live; template presence alone is not authority."""
+    receipt = _read_enforcement_receipt(fs)
+    policy_sha = _canonical_file_sha(fs, POLKIT_RULE_PATH, mode='0644')
+    hook_sha = _canonical_file_sha(fs, QEMU_HOOK_PATH, mode='0555')
+    main_hook_sha = _canonical_file_sha(fs, QEMU_MAIN_HOOK_PATH, mode='0555')
+    config_path = receipt['AccessConfigPath']
+    access_config_sha = _canonical_file_sha(fs, config_path, mode='0644')
+    if (policy_sha != receipt['PolicySHA256'] or hook_sha != receipt['QemuHookSHA256']
+            or main_hook_sha != receipt['QemuMainHookSHA256']
+            or access_config_sha != receipt['AccessConfigSHA256']):
+        raise InvocationError('active access-driver configuration or lifecycle hook changed')
+
+    def verify_daemon(pid: int, expected_start: int, expected_exe: str,
+                      service: str, label: str) -> None:
+        try:
+            proc_exe = os.readlink('/proc/%d/exe' % pid)
+            proc_stat = pathlib.Path('/proc/%d/stat' % pid).read_text(encoding='ascii')
+            close = proc_stat.rfind(')')
+            fields = proc_stat[close + 1:].strip().split()
+            process_start_ticks = int(fields[19])
+            process_uid = os.stat('/proc/%d' % pid).st_uid
+            cgroup = pathlib.Path('/proc/%d/cgroup' % pid).read_text(encoding='ascii')
+        except (OSError, ValueError, IndexError) as exc:
+            raise InvocationError('the approved ' + label + ' process identity is absent') from exc
+        if (proc_exe != expected_exe or process_start_ticks != expected_start
+                or process_uid != 0
+                or not any(service in line.split(':', 2)[-1].strip().split('/')
+                           for line in cgroup.splitlines())):
+            raise InvocationError(label + ' process restarted or differs from the active service receipt')
+
+    verify_daemon(receipt['PolkitPID'], receipt['PolkitStartTicks'],
+                  receipt['PolkitExecutable'], receipt['PolkitServiceUnit'], 'polkit')
+    verify_daemon(receipt['QemuPID'], receipt['QemuStartTicks'],
+                  receipt['QemuExecutable'], receipt['QemuServiceUnit'], 'QEMU libvirt')
+    protected = _verify_protected_source_filesystem()
+    return {'ReceiptSHA256': _sha(json.dumps(
+                receipt, sort_keys=True, separators=(',', ':')).encode('utf-8')),
+            'PolicySHA256': policy_sha, 'QemuHookSHA256': hook_sha,
+            'QemuMainHookSHA256': main_hook_sha,
+            'AccessConfigSHA256': access_config_sha,
+            'QemuServiceUnit': receipt['QemuServiceUnit'],
+            'QemuPID': receipt['QemuPID'],
+            'QemuStartTicks': receipt['QemuStartTicks'],
+            'PolkitPID': receipt['PolkitPID'],
+            'PolkitStartTicks': receipt['PolkitStartTicks'],
+            'ProtectedSourceMetadataSHA256': _canonical_hash(protected)}
+
+
+def _xml_source_paths(xml_text: str, run_binding: Any, label: str) -> set[str]:
+    try:
+        root = ET.fromstring(xml_text)
+    except Exception as exc:
+        raise InvocationError(label + ' domain XML cannot be inspected for shared source references') from exc
+    found: set[str] = set()
+    for disk in root.findall('./devices/disk'):
+        for source in disk.findall('source'):
+            for attribute in ('file', 'dev', 'name'):
+                path = source.get(attribute)
+                if path and path.startswith('/'):
+                    found.add(os.path.normpath(path))
+        for backing in disk.iter('backingStore'):
+            for node in backing.iter('path'):
+                if node.text and node.text.strip().startswith('/'):
+                    found.add(os.path.normpath(node.text.strip()))
+    os_node = root.find('os')
+    if os_node is not None:
+        for element in list(os_node.findall('nvram')) + list(os_node.findall('varstore')):
+            if element.text and element.text.strip().startswith('/'):
+                found.add(os.path.normpath(element.text.strip()))
+    for tpm in root.findall('./devices/tpm'):
+        backend = tpm.find('backend')
+        if backend is not None:
+            for source in backend.findall('source'):
+                for value in source.attrib.values():
+                    if value.startswith('/'):
+                        found.add(os.path.normpath(value))
+    return found
+
+
+def _path_overlaps_any(path: str, protected: tuple[str, ...]) -> bool:
+    return any(path == root or path.startswith(root.rstrip('/') + '/')
+               or root.startswith(path.rstrip('/') + '/') for root in protected)
+
+
+def _verify_no_cross_uuid_references(connection: Any, libvirt_module: Any,
+                                     run_binding: Any,
+                                     *, private_paths: tuple[str, ...] = (),
+                                     expected_cold_alias_sha256: str | None = None
+                                     ) -> dict[str, Any]:
+    """Reject cross-domain source references except the exact cold debug2 alias.
+
+    The shared backing is protected by the held source lease.  Its sole
+    existing definition is accepted only while inactive and only with the
+    exact UUID, XML bytes, shutoff/crashed state, and sole protected path from
+    the pinned survey.  The qemu hook continues to reject attempts to start it.
+    """
+    if (expected_cold_alias_sha256 is not None
+            and expected_cold_alias_sha256 != SHARED_COLD_XML_SHA256):
+        raise InvocationError('cold shared-domain baseline differs from the pinned survey')
+    protected = (
+        '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2',
+        SHARED_COLD_BACKING_PATH,
+        NVRAM_PATH,
+        '/var/lib/libvirt/swtpm/' + DOMAIN_UUID + '/tpm2',
+        *private_paths,
+    )
+    flags = (getattr(libvirt_module, 'VIR_CONNECT_LIST_DOMAINS_ACTIVE', 1) |
+             getattr(libvirt_module, 'VIR_CONNECT_LIST_DOMAINS_INACTIVE', 2))
+    try:
+        domains = connection.listAllDomains(flags)
+    except Exception as exc:
+        raise InvocationError('cannot enumerate every domain for source-sharing exclusion') from exc
+    rows = []
+    identities = set()
+    cold_alias_count = 0
+    for domain in domains:
+        try:
+            uuid = str(domain.UUIDString()).lower()
+            name = str(domain.name())
+            active = bool(domain.isActive())
+            xmls = [('inactive', domain.XMLDesc(libvirt_module.VIR_DOMAIN_XML_INACTIVE))]
+            if active:
+                xmls.append(('live', domain.XMLDesc(0)))
+        except Exception as exc:
+            raise InvocationError('domain identity/XML read failed during source-sharing scan') from exc
+        if uuid == DOMAIN_UUID:
+            continue
+        if uuid in identities:
+            raise InvocationError('libvirt domain enumeration returned a duplicate UUID')
+        identities.add(uuid)
+        references = set()
+        for kind, xml_text in xmls:
+            references.update(_xml_source_paths(xml_text, run_binding,
+                                                name + ' ' + kind))
+        matches = sorted(path for path in references
+                         if _path_overlaps_any(path, protected))
+        if uuid == SHARED_COLD_UUID:
+            cold_alias_count += 1
+            try:
+                state, reason = domain.state(0)
+            except Exception as exc:
+                raise InvocationError('cold shared-domain state could not be inspected') from exc
+            inactive_xml = xmls[0][1]
+            inactive_sha = _sha(inactive_xml.encode('utf-8'))
+            if (name != SHARED_COLD_DOMAIN or active
+                    or int(state) != QEMU_STATE
+                    or int(reason) != QEMU_SHUTOFF_CRASHED
+                    or inactive_sha != SHARED_COLD_XML_SHA256
+                    or matches != [SHARED_COLD_BACKING_PATH]):
+                raise InvocationError('cold shared backing alias differs from its exact inactive baseline')
+            rows.append({'Name': name, 'UUID': uuid, 'Active': False,
+                         'XMLKinds': ['inactive'],
+                         'ReferenceSHA256': _canonical_hash(sorted(references)),
+                         'ColdSharedBackingAlias': True,
+                         'InactiveXMLSHA256': inactive_sha,
+                         'State': int(state), 'StateReason': int(reason),
+                         'ProtectedMatches': matches})
+            continue
+        if matches:
+            raise InvocationError('another domain UUID references a selected T5 source/private path: '
+                                  + name + ' ' + ', '.join(matches))
+        rows.append({'Name': name, 'UUID': uuid, 'Active': active,
+                     'XMLKinds': [kind for kind, _ in xmls],
+                     'ReferenceSHA256': _canonical_hash(sorted(references))})
+    if cold_alias_count != 1:
+        raise InvocationError('exact cold shared-backing domain definition is absent or duplicated')
+    return {'DomainsInspected': len(rows), 'Domains': rows,
+            'ProtectedPathSHA256': _canonical_hash(protected),
+            'ColdSharedBackingAliasUUID': SHARED_COLD_UUID,
+            'ColdSharedBackingAliasXMLSHA256': SHARED_COLD_XML_SHA256,
+            'ColdSharedBackingAliasInactive': True}
 
 
 def _load_approvals(trust: dict[str, Any], fs: Any = RootFilesystem) -> None:
@@ -1539,12 +2198,573 @@
     _verify_review_file(RUN_BINDING_RECEIPT_PATH, RUN_BINDING_SHA256, fs)
 
 
+def _create_runner_workspace(tag: str) -> str:
+    if re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}', tag) is None:
+        raise InvocationError('runner workspace tag syntax differs from the fixed T5 syntax')
+    RootFilesystem.directory_traverse('/var/lib')
+    RootFilesystem.directory_traverse('/var/lib/libvirt')
+    RootFilesystem.directory_traverse('/var/lib/libvirt/safeupload-t5')
+    RootFilesystem.directory_stat('/var/lib/libvirt/safeupload-t5/m2-t5-cp1011-r2',
+                                  0, 0, '0711')
+    RootFilesystem.directory_stat(RUN_WORKSPACE_ROOT, 0, 0, '0711')
+    workspace = RUN_WORKSPACE_ROOT + '/' + tag
+    try:
+        os.mkdir(workspace, 0o700)
+    except FileExistsError as exc:
+        raise InvocationError('tag-specific runner workspace already exists') from exc
+    os.chown(workspace, 1000, 1000)
+    os.chmod(workspace, 0o700)
+    evidence_date = time.strftime('%Y-%m-%d')
+    for relative in ('driver', 'driver/evidence',
+                     'driver/evidence/' + evidence_date, 'state',
+                     'state/safeupload', 'state/safeupload/run-disks'):
+        path = workspace + '/' + relative
+        os.mkdir(path, 0o700)
+        os.chown(path, 1000, 1000)
+        os.chmod(path, 0o700)
+        st = os.lstat(path)
+        if (not stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode)
+                or (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) != (1000, 1000, 0o700)):
+            raise InvocationError('runner workspace child directory metadata differs')
+    return workspace
+
+
+def _runner_evidence_directory(workspace: str, evidence_date: str) -> str:
+    if re.fullmatch(r'\d{4}-\d{2}-\d{2}', evidence_date) is None:
+        raise InvocationError('fixed runner evidence date is malformed')
+    return workspace + '/driver/evidence/' + evidence_date
+
+
+def _disk_volume_metadata(volume: Any, expected_path: str,
+                          expected_backing: str | None, label: str) -> dict[str, Any]:
+    try:
+        xml = volume.XMLDesc(0)
+        root = ET.fromstring(xml)
+        name = root.findtext('name')
+        path = root.findtext('target/path')
+        format_node = root.find('target/format')
+        backing_node = root.find('backingStore/path')
+        info = volume.info()
+    except Exception as exc:
+        raise InvocationError(label + ' storage-volume XML/info could not be read') from exc
+    if (name != pathlib.Path(expected_path).name or path != expected_path
+            or format_node is None or format_node.get('type') != 'qcow2'
+            or not isinstance(info, (tuple, list)) or len(info) != 3
+            or any(type(value) is not int or value < 0 for value in info)):
+        raise InvocationError(label + ' exact qcow2 volume identity differs')
+    backing = backing_node.text if backing_node is not None else None
+    if expected_backing is not None and backing != expected_backing:
+        raise InvocationError(label + ' exact backing path differs')
+    return {'Name': name, 'Path': path, 'Format': 'qcow2', 'BackingPath': backing,
+            'StorageInfo': list(info), 'XMLSHA256': _sha(xml.encode('utf-8'))}
+
+
+def _hash_original_disks(storage: Any, connection: Any) -> dict[str, Any]:
+    results = {}
+    for label, path, backing, expected in (
+            ('BaseDisk', '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2',
+             '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2',
+             'd7f20d524ae02a82deb59e55e3e89ff36b062ae4dbe4e57acc1da97a9364bb0f'),
+            ('BackingDisk', '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2',
+             None,
+             '33ef5314def5ffde89941920af6dc0034863e1a3393487fa754aa3312a6d6ad3')):
+        try:
+            volume = connection.storageVolLookupByPath(path)
+        except Exception as exc:
+            raise InvocationError(label + ' exact source volume is not registered') from exc
+        before = _disk_volume_metadata(volume, path, backing, label + ' before hash')
+        first = storage._hash_stream(volume, label + ' full source pass 1')
+        middle = _disk_volume_metadata(volume, path, backing, label + ' between hashes')
+        second = storage._hash_stream(volume, label + ' full source pass 2')
+        after = _disk_volume_metadata(volume, path, backing, label + ' after hash')
+        if (before != middle or middle != after or first != second
+                or first.get('SHA256') != expected
+                or type(first.get('StreamBytes')) is not int
+                or first['StreamBytes'] <= 0):
+            raise InvocationError(label + ' full-source bytes/metadata do not match the fixed baseline twice')
+        results[label] = {'Path': path, 'Metadata': after, 'SHA256': first['SHA256'],
+                          'StreamBytes': first['StreamBytes'], 'Passes': 2}
+    return results
+
+
+def _domain_for(connection: Any, uuid: str = DOMAIN_UUID) -> Any:
+    try:
+        domain = connection.lookupByUUIDString(uuid)
+        if str(domain.UUIDString()).lower() != uuid.lower():
+            raise InvocationError('libvirt UUID lookup returned the wrong domain')
+        return domain
+    except InvocationError:
+        raise
+    except Exception as exc:
+        raise InvocationError('selected T5 domain identity lookup failed') from exc
+
+
+def _domain_state(domain: Any, libvirt_module: Any) -> tuple[int, int, bool]:
+    try:
+        state, reason = domain.state(0)
+        active = bool(domain.isActive())
+    except Exception as exc:
+        raise InvocationError('selected T5 domain state read failed') from exc
+    return int(state), int(reason), active
+
+
+def _require_domain_inactive_xml(domain: Any, libvirt_module: Any,
+                                 expected_xml: str, label: str) -> str:
+    state, reason, active = _domain_state(domain, libvirt_module)
+    if (active or state != libvirt_module.VIR_DOMAIN_SHUTOFF):
+        raise InvocationError(label + ' requires the exact shutoff domain state')
+    try:
+        xml = domain.XMLDesc(libvirt_module.VIR_DOMAIN_XML_INACTIVE)
+    except Exception as exc:
+        raise InvocationError(label + ' inactive domain XML read failed') from exc
+    if not isinstance(expected_xml, str) or not expected_xml:
+        raise InvocationError(label + ' expected inactive XML is absent')
+    return xml
+
+
+def _write_control_response(sock: socket.socket, request: dict[str, Any],
+                            status: str, **fields: Any) -> None:
+    response = {
+        'Schema': RUN_CONTROL_RESPONSE_SCHEMA,
+        'Command': request['Command'], 'Domain': DOMAIN, 'UUID': DOMAIN_UUID,
+        'RunTag': request['RunTag'], 'ActiveLeaseSHA256': request['ActiveLeaseSHA256'],
+        'Status': status,
+    }
+    response.update(fields)
+    raw = _json_bytes(response)
+    if len(raw) > RUN_CONTROL_MAX_BYTES:
+        raise InvocationError('run-control response exceeds its fixed size bound')
+    sock.sendall(struct.pack('!I', len(raw)) + raw)
+
+
+def _receive_control_request(sock: socket.socket) -> tuple[dict[str, Any], int, int]:
+    def exact(size: int) -> bytes:
+        data = bytearray()
+        while len(data) < size:
+            chunk = sock.recv(size - len(data))
+            if not chunk:
+                raise InvocationError('runner control channel closed mid-request')
+            data.extend(chunk)
+        return bytes(data)
+    sock.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
+    header, ancillary, message_flags, _address = sock.recvmsg(
+        4, socket.CMSG_SPACE(struct.calcsize('3i')))
+    if len(header) != 4 or message_flags & getattr(socket, 'MSG_CTRUNC', 0):
+        raise InvocationError('runner control header/credentials are truncated')
+    credentials = []
+    for level, kind, data in ancillary:
+        if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS and len(data) >= 12:
+            credentials.append(struct.unpack('3i', data[:12]))
+    if len(credentials) != 1:
+        raise InvocationError('run-control message lacks one kernel-authenticated sender identity')
+    sender_pid, sender_uid, _sender_gid = credentials[0]
+    size = struct.unpack('!I', header)[0]
+    if size <= 0 or size > RUN_CONTROL_MAX_BYTES:
+        raise InvocationError('runner control request exceeds its fixed size bound')
+    try:
+        request = json.loads(exact(size).decode('utf-8'),
+                             object_pairs_hook=_pairs_no_duplicates)
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise InvocationError('runner control request is not strict UTF-8 JSON') from exc
+    expected = {'Schema', 'Command', 'Domain', 'UUID', 'RunTag', 'ActiveLeaseSHA256'}
+    if (not isinstance(request, dict) or set(request) != expected
+            or request.get('Schema') != RUN_CONTROL_REQUEST_SCHEMA
+            or request.get('Command') not in ('BEGIN', 'PRESTART', 'END')
+            or request.get('Domain') != DOMAIN or request.get('UUID') != DOMAIN_UUID
+            or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}',
+                            request.get('RunTag', '')) is None
+            or not _is_hash(request.get('ActiveLeaseSHA256'))):
+        raise InvocationError('runner control request has unknown or mismatched fields')
+    return request, sender_pid, sender_uid
+
+
+def _verify_control_sender(request: dict[str, Any], sender_pid: int,
+                           sender_uid: int, lifecycle: Any,
+                           lease: Any) -> None:
+    lease.verify_held()
+    try:
+        actual_uids = lifecycle._proc_uids(sender_pid)
+        is_child = lifecycle._is_descendant(
+            sender_pid, os.getpid(), lifecycle.process_start_ticks(os.getpid()))
+    except Exception as exc:
+        raise InvocationError('run-control sender is not a live observed child process') from exc
+    if (sender_uid != 1000 or actual_uids[0] != 1000 or actual_uids[1] != 1000
+            or not is_child):
+        raise InvocationError('run-control sender is outside the exact UID 1000 supervisor child tree')
+    _ensure_control_lease(request, lease)
+
+
+def _domain_live_xml(domain: Any, libvirt_module: Any, expected_paths: set[str]) -> str:
+    try:
+        state, _reason = domain.state(0)
+        active = bool(domain.isActive())
+        xml = domain.XMLDesc(0)
+    except Exception as exc:
+        raise InvocationError('selected domain live endpoint could not be read') from exc
+    if not active or int(state) != int(libvirt_module.VIR_DOMAIN_RUNNING):
+        raise InvocationError('selected domain is not in the exact running state')
+    paths = _xml_source_paths(xml, None, 'selected live domain')
+    if not expected_paths.issubset(paths):
+        raise InvocationError('selected live XML does not reference every exact private run source')
+    if (NVRAM_PATH in paths or
+            '/var/lib/libvirt/swtpm/' + DOMAIN_UUID + '/tpm2' in paths):
+        raise InvocationError('selected live XML still references an original firmware/TPM source')
+    return xml
+
+
+def _same_object_identity(before: dict[str, Any], after: dict[str, Any],
+                          labels: tuple[str, ...]) -> bool:
+    fields = ('Path', 'Device', 'Inode', 'UID', 'GID', 'Mode', 'Links', 'Kind')
+    return all(all(before.get(label, {}).get(field) == after.get(label, {}).get(field)
+                   for field in fields) for label in labels)
+
+
+def _wait_domain_shutdown(domain: Any, libvirt_module: Any,
+                          timeout_seconds: int = 180,
+                          source_guard: Any = None) -> None:
+    try:
+        active = bool(domain.isActive())
+        if active:
+            domain.shutdown()
+    except Exception as exc:
+        raise InvocationError('selected domain graceful shutdown request failed') from exc
+    deadline = time.monotonic() + timeout_seconds
+    while time.monotonic() < deadline:
+        if source_guard is not None:
+            source_guard.verify_held()
+        try:
+            state, _reason = domain.state(0)
+            active = bool(domain.isActive())
+        except Exception as exc:
+            raise InvocationError('selected domain shutdown state could not be observed') from exc
+        if not active and int(state) == int(libvirt_module.VIR_DOMAIN_SHUTOFF):
+            return
+        time.sleep(0.5)
+    raise InvocationError('selected domain did not complete graceful shutdown; run state is retained')
+
+
+def _remove_exact_overlay(connection: Any, pool: Any, overlay: Any,
+                          overlay_path: str) -> None:
+    try:
+        current = connection.storageVolLookupByPath(overlay_path)
+    except Exception:
+        current = None
+    if current is None or current.key() != overlay.key():
+        raise InvocationError('exact run overlay registration changed before cleanup')
+    try:
+        current.delete(0)
+        pool.refresh(0)
+    except Exception as exc:
+        raise InvocationError('exact run overlay deletion failed; retain the run state') from exc
+    try:
+        connection.storageVolLookupByPath(overlay_path)
+    except Exception:
+        pass
+    else:
+        raise InvocationError('run overlay remains registered after delete')
+    if os.path.lexists(overlay_path):
+        raise InvocationError('run overlay path remains after libvirt delete')
+
