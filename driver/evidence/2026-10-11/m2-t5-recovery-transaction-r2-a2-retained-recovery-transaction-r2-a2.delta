+#!/usr/bin/env python3
+"""Static, local-only checks for the T5 preservation decision and format guards.
+
+This self-check uses temporary files and invokes only run-disk.sh's marker guards.
+It does not connect to libvirt, run virsh, start a VM, or invoke the T5 runner.
+"""
+import hashlib
+import fcntl
+import importlib.util
+import io
+import json
+import os
+from pathlib import Path
+import shlex
+import stat
+import struct
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest import mock
+import xml.etree.ElementTree as ET
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HELPER_PATH = Path(__file__).with_name('Preserve-T5Run.py')
+RUN_DISK = ROOT / 'driver' / 'scripts' / 'run-disk.sh'
+SPEC = importlib.util.spec_from_file_location('t5_preserve', HELPER_PATH)
+preserve = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(preserve)
+
+
+def make_elf_core(segments, file_offsets=None, file_sizes=None, memory_sizes=None):
+    """Build a small ELF64 core with PT_LOAD rows for range-validation tests."""
+    count = len(segments)
+    phoff = 64
+    phentsize = 56
+    data_offset = 4096
+    offsets = []
+    cursor = data_offset
+    for index, (_paddr, payload) in enumerate(segments):
+        chosen = file_offsets[index] if file_offsets is not None else cursor
+        offsets.append(chosen)
+        filesz = file_sizes[index] if file_sizes is not None else len(payload)
+        cursor = max(cursor, chosen + filesz)
+    total_size = max(cursor, phoff + phentsize * count)
+    core = bytearray(total_size)
+    core[:16] = b'\x7fELF' + bytes((2, 1, 1)) + b'\0' * 9
+    struct.pack_into('<H', core, 16, 4)       # ET_CORE
+    struct.pack_into('<H', core, 18, 62)      # EM_X86_64
+    struct.pack_into('<I', core, 20, 1)       # EV_CURRENT
+    struct.pack_into('<Q', core, 32, phoff)
+    struct.pack_into('<HHH', core, 52, 64, phentsize, count)
+    for index, (paddr, payload) in enumerate(segments):
+        filesz = file_sizes[index] if file_sizes is not None else len(payload)
+        memsz = memory_sizes[index] if memory_sizes is not None else len(payload)
+        offset = offsets[index]
+        struct.pack_into('<IIQQQQQQ', core, phoff + index * phentsize,
+                         1, 0, offset, 0, paddr, filesz, memsz, 4096)
+        if filesz and offset + filesz <= len(core):
+            core[offset:offset + filesz] = payload[:filesz]
+    return bytes(core)
+
+
+def write_capture_fixture(evidence, tag, mode, driver_sha='A' * 64,
+                          zip_sha='B' * 64, service_sha='C' * 64,
+                          verdict_rows=None, result_overrides=None):
+    evidence = Path(evidence)
+    pins = preserve.expected_input_fields(tag, mode, driver_sha, zip_sha, service_sha)
+    (evidence / (tag + '-input-hashes.txt')).write_text(
+        '\n'.join(key + '=' + value for key, value in pins.items()) + '\n', encoding='utf-8')
+    (evidence / (tag + '-prebegin.json')).write_text(json.dumps({
+        'RunTag': tag, 'Mode': mode, 'InputPins': pins}), encoding='utf-8')
+    result = {
+        'RunTag': tag,
+        'ActorTaskStartIssued': True,
+        'Error': None,
+        'Cases': [
+            {'Kind': 'ProbeDelete'},
+            {'Kind': 'ProbeDeleteOnClose'},
+            {'Kind': 'OnCloseCancellation'},
+            {'Kind': 'NotepadApprove'},
+            {'Kind': 'NotepadHandBack'},
+        ],
+    }
+    if result_overrides:
+        result.update(result_overrides)
+    (evidence / (tag + '-result.json')).write_text(json.dumps(result), encoding='utf-8')
+    raw = evidence / (tag + '-raw')
+    raw.mkdir(exist_ok=True)
+    (raw / 'manifest.ndjson').write_text('{"Schema":"probe"}\n', encoding='utf-8')
+    rows = verdict_rows or [
+        'T5GuestAlive PASS guest answered',
+        'T5ResultEvidence PASS current result parsed',
+        'T5RawObserver PASS raw observer completed',
+        'T5RawEvidenceRetained PASS current raw manifest copied',
+        'T5ActorTaskStart PASS actor task start receipt verified',
+        'T5CasesCompleted PASS exact five-case matrix completed',
+        'T5CanonicalNoUnapprovedByte INCONCLUSIVE strict verdict remains separate',
+        'T5NotepadHandBackNoEmptyVersionPublished FAIL strict verdict remains separate',
+    ]
+    (evidence / (tag + '-verdict.txt')).write_text('\n'.join(rows) + '\n', encoding='utf-8')
+    return pins
+
+
+def call_capture_completeness(evidence, tag, mode='ordinary', driver_sha='A' * 64,
+                              zip_sha='B' * 64, service_sha='C' * 64):
+    return preserve.capture_completeness(
+        evidence, tag, mode, driver_sha, zip_sha, service_sha, 'yes', 'yes', 'yes')
+
+
+def _without_tpm_source(xml_text):
+    root = ET.fromstring(xml_text)
+    backend = root.find('./devices/tpm/backend')
+    if backend is None:
+        raise AssertionError('fixture lacks emulator TPM backend')
+    source = backend.find('source')
+    if source is None:
+        raise AssertionError('fixture lacks TPM source')
+    backend.remove(source)
+    return ET.tostring(root, encoding='unicode')
+
+
+class PreservationSelfCheck(unittest.TestCase):
+    def test_preflight_blocks_unisolated_persistent_firmware_and_tpm_state(self):
+        baseline_path = ROOT / 'driver' / 'evidence' / '2026-10-10' / 'm2-t5-baseline-before.json'
+        baseline_raw = baseline_path.read_bytes()
+        self.assertEqual(hashlib.sha256(baseline_raw).hexdigest(), preserve.BASELINE_SHA256)
+        actual_baseline = json.loads(baseline_raw.decode('utf-8'))['InactiveXML']
+        tag = 'FreshRun42'
+        base_xml = preserve.expected_private_state_xml(actual_baseline, tag)
+        preserve.reject_unisolated_writable_domain_state(base_xml, tag)
+        unsafe_configs = (
+            (base_xml.replace('</os>', '<nvram template="/usr/share/OVMF/vars.fd">'
+                              '/var/lib/libvirt/qemu/nvram/domain_VARS.fd</nvram></os>'),
+             ('T5 run XML lacks',)),
+            (_without_tpm_source(base_xml),
+             ('exact private opaque TPM copy',)),
+            (base_xml.replace('</os>', '<varstore path="/var/lib/libvirt/qemu/varstore/domain.fd"/>'
+                              '</os>'), ('T5 run XML lacks',)),
+            (base_xml.replace('</os>', '<nvram>baseline.fd</nvram><varstore path="vars.fd"/>'
+                              '</os>').replace('</devices>', '<tpm><backend type="emulator"/>'
+                              '</tpm></devices>'), ('T5 run XML lacks',)),
+        )
+        for xml_text, expected_reasons in unsafe_configs:
+            with self.subTest(expected=expected_reasons), self.assertRaises(preserve.RetentionError) as caught:
+                preserve.reject_unisolated_writable_domain_state(xml_text, tag)
+            for reason in expected_reasons:
+                self.assertIn(reason, str(caught.exception))
+
+        with self.assertRaisesRegex(preserve.RetentionError,
+                                    'exact private NVRAM copy|exact private opaque TPM copy'):
+            preserve.reject_unisolated_writable_domain_state(actual_baseline, tag)
+
+        self.assertIn('/t5-copy-' + tag + '-run-nvram/win10-debug3_VARS.fd', base_xml)
+        self.assertIn('/t5-copy-' + tag + '-run-tpm', base_xml)
+        with self.assertRaisesRegex(preserve.RetentionError, 'exact private NVRAM copy'):
+            preserve.reject_unisolated_writable_domain_state(base_xml, 'OtherRun43')
+
+    def test_complete_capture_allows_normal_cleanup_even_with_strict_verdict_failures(self):
+        with tempfile.TemporaryDirectory(prefix='t5-preserve-selfcheck-') as temp:
+            evidence = Path(temp)
+            tag, mode = 'SelfCheckA1', 'ordinary'
+            write_capture_fixture(evidence, tag, mode)
+            complete, reasons = call_capture_completeness(evidence, tag, mode)
+            self.assertTrue(complete, reasons)
+
