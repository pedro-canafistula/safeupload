===== agente/scripts/Get-SafeUploadDiagnostics.ps1 (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/agente/scripts/Get-SafeUploadDiagnostics.ps1
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/agente/scripts/Get-SafeUploadDiagnostics.ps1
@@ -0,0 +1,74 @@
+#Requires -RunAsAdministrator
+#Requires -Version 5.1
+<#
+.SYNOPSIS
+Reads driver diagnostics from the running SafeUpload service (administrator only, read-only).
+
+.DESCRIPTION
+The minifilter's communication port accepts a single client and the service holds it, so no other tool can read the
+driver while the product runs. The service relays two read-only queries over the SYSTEM/Administrators-only pipe
+\\.\pipe\SafeUpload.Agent.Diagnostics:
+
+  counters   refusal counters, how often a path that could not resolve a name answered "the whole volume may be in
+             scope", and the writer-state status (registry entries and capacity, reclaim-worker passes, sections,
+             stage streams).
+  deny-ring  the most recent operations the driver completed with an error status: status, operation, requesting
+             process, flags, and the tail of the requested path or rename target. siteOffset is relative to the
+             driver image base; resolve it against SafeUpload.pdb to name the refusing code.
+
+.EXAMPLE
+.\Get-SafeUploadDiagnostics.ps1 -Query counters
+
+.EXAMPLE
+.\Get-SafeUploadDiagnostics.ps1 -Query deny-ring | Format-Table sequence, statusName, major, processId, name
+#>
+[CmdletBinding()]
+param(
+    [ValidateSet('counters', 'deny-ring', 'help')]
+    [string] $Query = 'counters',
+
+    # deny-ring: return records with a sequence greater than this value.
+    [uint64] $After = 0,
+
+    [int] $TimeoutSeconds = 10
+)
+
+$ErrorActionPreference = 'Stop'
+$pipeName = 'SafeUpload.Agent.Diagnostics'
+
+function Invoke-DiagnosticsQuery([hashtable] $Request) {
+    $client = New-Object System.IO.Pipes.NamedPipeClientStream('.', $pipeName, [System.IO.Pipes.PipeDirection]::InOut)
+    try {
+        $client.Connect($TimeoutSeconds * 1000)
+        $utf8 = New-Object System.Text.UTF8Encoding($false)
+        $writer = New-Object System.IO.StreamWriter($client, $utf8, 1024, $true)
+        $writer.NewLine = "`n"
+        $writer.WriteLine(($Request | ConvertTo-Json -Compress))
+        $writer.Flush()
+        $reader = New-Object System.IO.StreamReader($client, $utf8, $false, 1024, $true)
+        $line = $reader.ReadLine()
+        if ([string]::IsNullOrEmpty($line)) { throw 'The service closed the pipe without a reply.' }
+        $reply = $line | ConvertFrom-Json
+        if (-not $reply.ok) { throw "SafeUpload diagnostics: $($reply.error)" }
+        return $reply.data
+    }
+    finally {
+        $client.Dispose()
+    }
+}
+
+switch ($Query) {
+    'counters' { Invoke-DiagnosticsQuery @{ query = 'counters' } }
+    'help' { Invoke-DiagnosticsQuery @{ query = 'help' } }
+    'deny-ring' {
+        $cursor = $After
+        for (;;) {
+            $page = Invoke-DiagnosticsQuery @{ query = 'deny-ring'; after = $cursor }
+            if ($page.gap) { Write-Warning 'Older records were overwritten before they could be read.' }
+            $records = @($page.records)
+            if ($records.Count -eq 0) { break }
+            $records
+            $cursor = [uint64]$records[$records.Count - 1].sequence
+        }
+    }
+}
===== agente/scripts/Install-SafeUploadAgent.ps1 (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/agente/scripts/Install-SafeUploadAgent.ps1
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/agente/scripts/Install-SafeUploadAgent.ps1
@@ -0,0 +1,149 @@
+#Requires -RunAsAdministrator
+#Requires -Version 5.1
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)]
+    [ValidateScript({ Test-Path -LiteralPath $_ -PathType Leaf })]
+    [string] $ServiceExecutablePath,
+
+    # Central policy server. Empty (the default) keeps the agent autonomous: it reads C:\ProgramData\SafeUpload\policy.json.
+    # appsettings.json ships a panel address, and with any address configured the agent takes its policy from the
+    # panel and falls back to a built-in default (other folder, removable and network scopes) when it cannot reach
+    # it, so the installer states the choice explicitly instead of inheriting the shipped address.
+    [string] $AdminBaseUrl = '',
+
+    # The staged-write driver only works with the agent in staged minifilter mode. Without these arguments the
+    # agent runs outside staged mode (admissionCoverage NotAvailable, auditOnly true) and the driver, which fails
+    # closed, refuses every standard-user save into a protected folder.
+    [string[]] $ServiceArguments = @('--Interception:Mode=Minifilter', '--Interception:StagingPrototype=true',
+        ('--CentroAdministracao:BaseUrl=' + $AdminBaseUrl))
+)
+
+$ErrorActionPreference = 'Stop'
+$serviceName = 'SafeUploadAgent'
+$serviceExecutable = (Resolve-Path -LiteralPath $ServiceExecutablePath).Path
+$quotedExecutable = '"' + $serviceExecutable + '"'
+$binaryPath = (@($quotedExecutable) + $ServiceArguments) -join ' '
+$agentServiceKey = 'HKLM:\SYSTEM\CurrentControlSet\Services\SafeUploadAgent'
+$driverServiceKey = 'HKLM:\SYSTEM\CurrentControlSet\Services\SafeUpload'
+
+function Invoke-ScChecked([string[]] $Arguments, [string] $Description) {
+    $output = & sc.exe @Arguments 2>&1
+    if ($LASTEXITCODE -ne 0) {
+        throw "$Description failed (sc.exe $LASTEXITCODE): $($output -join ' ')"
+    }
+    $output | Out-Host
+}
+
+# sc.exe on Windows 10 prints "SERVICE_SID_TYPE:  UNRESTRICTED"; other builds and docs use "SERVICE_SID_TYPE_UNRESTRICTED".
+function Test-ServiceSidTypeUnrestricted([string] $QueryOutput) {
+    return $QueryOutput -match 'SERVICE_SID_TYPE[_:\s]+UNRESTRICTED'
+}
+
+# Windows PowerShell 5.1 mangles embedded quotes when it passes an argument to sc.exe, so the command line (quoted
+# executable plus arguments) is written to the ImagePath value directly and read back.
+function Set-SafeUploadAgentImagePath {
+    Set-ItemProperty -LiteralPath $agentServiceKey -Name ImagePath -Value $binaryPath -Type ExpandString
+    $written = [string](Get-ItemProperty -LiteralPath $agentServiceKey -Name ImagePath).ImagePath
+    if ($written -ne $binaryPath) {
+        throw "SafeUploadAgent ImagePath was not written as expected: $written"
+    }
+    Write-Output "ServiceCommandLine=$written"
+}
+
+function Invoke-BootPolicySeedAsSystem {
+    $taskName = 'SafeUpload-BootPolicySeed-' + [guid]::NewGuid().ToString('N')
+    $action = New-ScheduledTaskAction -Execute $serviceExecutable -Argument '--seed-boot-policy'
+    $principal = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
+    $settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit ([TimeSpan]::FromMinutes(2))
+    $registered = $false
+    try {
+        Register-ScheduledTask -TaskName $taskName -Action $action -Principal $principal -Settings $settings | Out-Null
+        $registered = $true
+        Start-ScheduledTask -TaskName $taskName
+
+        $deadline = [DateTime]::UtcNow.AddSeconds(60)
+        do {
+            $task = Get-ScheduledTask -TaskName $taskName -ErrorAction Stop
+            $info = Get-ScheduledTaskInfo -TaskName $taskName -ErrorAction Stop
+            if ($task.State -eq 'Ready' -and $info.LastRunTime -gt [DateTime]::FromFileTimeUtc(0)) {
+                if ([int]$info.LastTaskResult -ne 0) {
+                    throw "SYSTEM boot-policy seed failed (task result $($info.LastTaskResult))."
+                }
+                Write-Output 'BootPolicySeededAsSystem=True'
+                return
+            }
+            Start-Sleep -Milliseconds 200
+        } while ([DateTime]::UtcNow -lt $deadline)
+
+        throw 'SYSTEM boot-policy seed timed out; installation cannot continue.'
+    }
+    finally {
+        if ($registered) {
+            Stop-ScheduledTask -TaskName $taskName -ErrorAction SilentlyContinue
+            Unregister-ScheduledTask -TaskName $taskName -Confirm:$false -ErrorAction SilentlyContinue
+        }
+    }
+}
+
+function Set-SafeUploadDriverDemandBeforeSeed {
+    if (-not (Test-Path -LiteralPath $driverServiceKey)) {
+        throw 'SafeUpload minifilter service is not installed. Install the driver package before the agent.'
+    }
+
+    # The INF can already have written BOOT_START. Hold the unloaded filter at
+    # demand start until the SYSTEM seeder has durably verified BootPolicy.
+    Invoke-ScChecked @('config', 'SafeUpload', 'start=', 'demand') 'Holding SafeUpload at demand-start before policy seed'
+    $driverStart = [int](Get-ItemProperty -LiteralPath $driverServiceKey -Name Start -ErrorAction Stop).Start
+    if ($driverStart -ne 3) {
+        throw "SafeUpload could not be held at demand-start before policy seeding (Start=$driverStart)."
+    }
+}
+
+function Set-SafeUploadDriverBootStart {
+    Invoke-ScChecked @('config', 'SafeUpload', 'start=', 'boot') 'Staging SafeUpload as boot-start'
+    $driverStart = [int](Get-ItemProperty -LiteralPath $driverServiceKey -Name Start -ErrorAction Stop).Start
+    if ($driverStart -ne 0) {
+        throw "SafeUpload was not staged as boot-start after policy seeding (Start=$driverStart)."
+    }
+    Write-Output 'DriverBootStartConfigured=True'
+    Write-Output 'DriverStartedByInstaller=False'
+}
+
+if (-not (Test-Path -LiteralPath $driverServiceKey)) {
+    throw 'SafeUpload minifilter service is not installed. Install the driver package before the agent.'
+}
+
+# This record must be durable and verified while the filter is still unloaded.
+# Keep the INF-installed service at demand-start until the SYSTEM task succeeds.
+Set-SafeUploadDriverDemandBeforeSeed
+Invoke-BootPolicySeedAsSystem
+Set-SafeUploadDriverBootStart
+
+$existing = Get-Service -Name $serviceName -ErrorAction SilentlyContinue
+if ($null -eq $existing) {
+    Invoke-ScChecked @('create', $serviceName, 'binPath=', $quotedExecutable,
+        'start=', 'auto', 'obj=', 'LocalSystem') 'Creating SafeUploadAgent'
+}
+else {
+    if ($existing.Status -ne [System.ServiceProcess.ServiceControllerStatus]::Stopped) {
+        throw 'Stop SafeUploadAgent before changing its image path.'
+    }
+    Invoke-ScChecked @('config', $serviceName, 'binPath=', $quotedExecutable,
+        'start=', 'auto', 'obj=', 'LocalSystem') 'Configuring SafeUploadAgent'
+}
+Set-SafeUploadAgentImagePath
+
+# SCM adds this service SID to the service process token. Unrestricted mode
+# retains the LocalSystem token while including NT SERVICE\SafeUploadAgent.
+Invoke-ScChecked @('sidtype', $serviceName, 'unrestricted') 'Configuring the service SID'
+$sidType = (& sc.exe qsidtype $serviceName 2>&1 | Out-String)
+if ($LASTEXITCODE -ne 0 -or -not (Test-ServiceSidTypeUnrestricted $sidType)) {
+    throw "SafeUploadAgent does not have an unrestricted service SID: $sidType"
+}
+
+Write-Output "ServiceName=$serviceName"
+Write-Output 'ServiceSidType=UNRESTRICTED'
+Write-Output 'ServiceConfigured=True'
+Write-Output 'ServiceStarted=False'
+Write-Output 'Protection activates after reboot.'
===== agente/scripts/Protect-SafeUploadPolicy.ps1 (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/agente/scripts/Protect-SafeUploadPolicy.ps1
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/agente/scripts/Protect-SafeUploadPolicy.ps1
@@ -0,0 +1,50 @@
+#Requires -RunAsAdministrator
+#Requires -Version 5.1
+<#
+.SYNOPSIS
+Gives C:\ProgramData\SafeUpload and policy.json the exact protected ACL the agent insists on.
+
+.DESCRIPTION
+The agent refuses to read a policy file whose owner or access list differs from this, instead of repairing it: a file a standard
+user could write may already hold a weakened policy. Owner SYSTEM; inheritance removed; full control for SYSTEM and Administrators
+only (container/object inherit on the directory, no inheritance flags on the file); no entry for any standard user.
+Run it after writing or replacing policy.json and before installing the agent or rebooting. Editing icacls flags by hand does not
+produce this: `(OI)(CI)` on the file adds inheritance flags the verifier rejects.
+#>
+[CmdletBinding()]
+param(
+    [string] $PolicyPath = 'C:\ProgramData\SafeUpload\policy.json'
+)
+
+$ErrorActionPreference = 'Stop'
+$systemSid = [Security.Principal.SecurityIdentifier]::new('S-1-5-18')
+$administratorsSid = [Security.Principal.SecurityIdentifier]::new('S-1-5-32-544')
+$directory = Split-Path -Parent $PolicyPath
+
+if (-not (Test-Path -LiteralPath $directory)) { [void](New-Item -ItemType Directory -Path $directory) }
+
+$directoryAcl = [Security.AccessControl.DirectorySecurity]::new()
+$directoryAcl.SetAccessRuleProtection($true, $false)
+$directoryAcl.SetOwner($systemSid)
+$childFlags = [Security.AccessControl.InheritanceFlags]::ContainerInherit -bor [Security.AccessControl.InheritanceFlags]::ObjectInherit
+foreach ($sid in $systemSid, $administratorsSid) {
+    $directoryAcl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new(
+        $sid, [Security.AccessControl.FileSystemRights]::FullControl, $childFlags,
+        [Security.AccessControl.PropagationFlags]::None, [Security.AccessControl.AccessControlType]::Allow))
+}
+Set-Acl -LiteralPath $directory -AclObject $directoryAcl
+
+if (-not (Test-Path -LiteralPath $PolicyPath)) { throw "No policy file at $PolicyPath; write it first." }
+$fileAcl = [Security.AccessControl.FileSecurity]::new()
+$fileAcl.SetAccessRuleProtection($true, $false)
+$fileAcl.SetOwner($systemSid)
+foreach ($sid in $systemSid, $administratorsSid) {
+    $fileAcl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new(
+        $sid, [Security.AccessControl.FileSystemRights]::FullControl, [Security.AccessControl.InheritanceFlags]::None,
+        [Security.AccessControl.PropagationFlags]::None, [Security.AccessControl.AccessControlType]::Allow))
+}
+Set-Acl -LiteralPath $PolicyPath -AclObject $fileAcl
+
+Write-Output "PolicyAclApplied=True"
+Write-Output ("Directory=" + $directory)
+Write-Output ("File=" + $PolicyPath)
===== driver/scripts/Get-StagedBaseline.ps1 (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/Get-StagedBaseline.ps1
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/Get-StagedBaseline.ps1
@@ -0,0 +1,144 @@
+<#
+Independent, read-only check of the isolated WIN10-DEBUGGED baseline. Run it in a
+separate call before creating a checkpoint and again after every experiment,
+including failures. It never changes state; BaselineClean=False names the
+first failing field instead of throwing so every field is always recorded.
+#>
+param(
+    [string] $ExpectedOriginal = 'ADA9D05AB6AECDD2B6C521B0CE529FC06C732154ACB3EE85439FBDC8AA80DFCE',
+    [string] $ExpectedPolicy = '29DC8A341BD7C549996596D2477A0CCCAF19602C362A2167FB4FDD5C66663731'
+)
+$ErrorActionPreference = 'Continue'
+$ProgressPreference = 'SilentlyContinue'
+$documents = Join-Path $env:USERPROFILE 'Documents'
+$checks = [ordered]@{}
+
+# Read independently of the suite/lifecycle export. Record both native values
+# so the wrapper can compare the pre-case and post-restoration baselines.
+try {
+    if(-not ('SUBaselineAudit' -as [type])){
+        Add-Type -TypeDefinition @'
+using System; using System.Runtime.InteropServices; using System.ComponentModel;
+public static class SUBaselineAudit {
+ [StructLayout(LayoutKind.Sequential)] struct Policy { public Guid Subcategory; public uint Flags; public Guid Category; }
+ [DllImport("advapi32.dll",SetLastError=true)] [return:MarshalAs(UnmanagedType.U1)] static extern bool AuditQuerySystemPolicy(Guid[] categories,uint count,out IntPtr policy);
+ [DllImport("advapi32.dll",SetLastError=true)] [return:MarshalAs(UnmanagedType.U1)] static extern bool AuditEnumeratePerUserPolicy(out IntPtr users);
+ [DllImport("advapi32.dll")] static extern void AuditFree(IntPtr buffer);
+ public static uint[] Read() {
+  IntPtr p;uint flags;Guid[] categories={new Guid("0cce922b-69ae-11d9-bed3-505054503030")};
+  if(!AuditQuerySystemPolicy(categories,1,out p))throw new Win32Exception(Marshal.GetLastWin32Error());
+  try{flags=((Policy)Marshal.PtrToStructure(p,typeof(Policy))).Flags;}finally{AuditFree(p);}
+  if(!AuditEnumeratePerUserPolicy(out p))throw new Win32Exception(Marshal.GetLastWin32Error());
+  try{return new uint[]{flags,(uint)Marshal.ReadInt32(p)};}finally{AuditFree(p);}
+ }
+}
+'@ -ErrorAction Stop
+    }
+    $audit=[SUBaselineAudit]::Read()
+    'ProcessCreationAuditFlags='+$audit[0]
+    'ProcessCreationAuditPerUserCount='+$audit[1]
+    $checks['ProcessCreationAuditRead']=($audit[0] -in @(0,1,2,3,4))
+}catch{
+    $checks['ProcessCreationAuditRead']=$false
+    'ProcessCreationAuditError='+$_.Exception.Message
+}
+
+$uuid = (Get-CimInstance Win32_ComputerSystemProduct).UUID
+# win10-debug and its identical clones win10-debug2/3 (driver/scripts/debuggees.txt, MVP-PLAN 2026-10-07).
+$checks['DebuggeeIdentity'] = ($env:COMPUTERNAME -eq 'WIN10-DEBUGGED' -and $uuid -cin @('9D44EEE8-81CF-4CC1-9FBA-7670F11DEF4D','9D6E3F02-B40A-49F0-A77F-439714F8F308','FFCB9530-146B-43B1-8AF7-2B5CC8EDE2E3'))
+$installedHash = (Get-FileHash -LiteralPath 'C:\Windows\System32\drivers\SafeUpload.sys' -Algorithm SHA256).Hash
+$checks['OriginalDriverHash'] = ($installedHash -eq $ExpectedOriginal)
+$filterInventory = & fltmc.exe filters 2>&1 | Out-String
+$filterInventoryExit = $LASTEXITCODE
+$checks['FiltersEnumerated'] = ($filterInventoryExit -eq 0)
+$checks['FilterUnloaded'] = ($filterInventoryExit -eq 0 -and $filterInventory -notmatch '(?m)^SafeUpload\s')
+$checks['SectionFaultFilterAbsent'] = ($filterInventoryExit -eq 0 -and $filterInventory -notmatch '(?m)^SafeUploadSectionFault\s')
+$checks['SectionFaultBinaryAbsent'] = -not (Test-Path -LiteralPath 'C:\Windows\System32\drivers\SafeUploadSectionFault.sys')
+$checks['SectionFaultRegistryAbsent'] = -not (Test-Path -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Services\SafeUploadSectionFault')
+try {
+    $faultServices = @(Get-CimInstance Win32_SystemDriver -Filter "Name='SafeUploadSectionFault'" -ErrorAction Stop)
+    $checks['SectionFaultServiceEnumerated'] = $true
+    $checks['SectionFaultServiceAbsent'] = ($faultServices.Count -eq 0)
+} catch {
+    $checks['SectionFaultServiceEnumerated'] = $false
+    $checks['SectionFaultServiceAbsent'] = $false
+    'SectionFaultServiceEnumerationError=' + $_.Exception.Message
+}
+$verifierQuery = & verifier.exe /query 2>&1 | Out-String
+$verifierSettings = & verifier.exe /querysettings 2>&1 | Out-String
+$checks['VerifierOff'] = ($verifierQuery -match 'No drivers are currently verified' -and
+    $verifierSettings -match 'Verifier Flags:\s+0x00000000')
+$memory = Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Memory Management'
+$checks['VerifierNotConfigured'] = (-not $memory.VerifyDriverLevel -and -not $memory.VerifyDrivers)
+$service = Get-CimInstance Win32_SystemDriver -Filter "Name='SafeUpload'"
+$checks['ServiceManualStopped'] = ($service.StartMode -eq 'Manual' -and $service.State -eq 'Stopped')
+$policyHash = (Get-FileHash -LiteralPath 'C:\ProgramData\SafeUpload\policy.json' -Algorithm SHA256).Hash
+$checks['OriginalPolicyHash'] = ($policyHash -eq $ExpectedPolicy)
+$inheritedChildren = @(); $fixtureObservers = @(); $lowerExercises = @(); $writerFaultProcesses = @(); $fixtureProcessesRead = $false
+try {
+    $powershellProcesses = @(Get-CimInstance Win32_Process -Filter "Name='powershell.exe'" -ErrorAction Stop)
+    $inheritedChildren = @($powershellProcesses | Where-Object {
+        $_.CommandLine -match 'SafeUpload-admission-[0-9a-f]{32}\\wc-inherit-child\.ps1' })
+    $fixtureObservers = @($powershellProcesses | Where-Object {
+        $_.CommandLine -match 'SafeUpload-owned-[0-9a-f]{32}\.ps1\.observer\.ps1' })
+    $lowerExercises = @($powershellProcesses | Where-Object {
+        $_.CommandLine -match '(Invoke-StagedSectionFault|StagedWriterFault)[A-Za-z0-9._-]*\.ps1' })
+    $writerFaultProcesses = @(Get-CimInstance Win32_Process -Filter "Name='SUHFail.exe'" -ErrorAction Stop)
+    $fixtureProcessesRead = $true
+} catch { 'FixtureProcessEnumerationError=' + $_.Exception.Message }
+$checks['FixtureProcessesEnumerated'] = $fixtureProcessesRead
+$checks['ZeroInheritedFixtureChildren'] = ($fixtureProcessesRead -and $inheritedChildren.Count -eq 0)
+$checks['ZeroFixtureObservers'] = ($fixtureProcessesRead -and $fixtureObservers.Count -eq 0)
+$checks['ZeroLowerFixtureProcesses'] = ($fixtureProcessesRead -and $lowerExercises.Count -eq 0)
+$checks['ZeroWriterFaultFixtureProcesses'] = ($fixtureProcessesRead -and $writerFaultProcesses.Count -eq 0)
+foreach ($process in @($inheritedChildren) + @($fixtureObservers) + @($lowerExercises) + @($writerFaultProcesses)) {
+    'FixtureProcess=' + $process.ProcessId + ';CommandLine=' + $process.CommandLine
+}
+$checks['ZeroAgentProcesses'] = (@(Get-Process SafeUpload.Agent.Service -ErrorAction SilentlyContinue).Count -eq 0)
+$checks['ZeroTestTasks'] = (@(Get-ScheduledTask | Where-Object { $_.TaskName -match '^SafeUpload-(StagedTest-|StagedCleanup-|Owned-)' }).Count -eq 0)
+$checks['NoOwnedVhdx'] = -not ((Test-Path -LiteralPath (Join-Path $documents 'SafeUpload-owned.vhdx')) -or
+    (Test-Path -LiteralPath (Join-Path $documents 'SafeUpload-owned.vhdx.txt')))
+$fixtures = @(Get-ChildItem -LiteralPath $documents -Directory -Force -ErrorAction SilentlyContinue |
+    Where-Object { $_.Name -match '^SafeUpload-.*[0-9a-f]{32}$' })
+$checks['NoGuidFixtureDirectories'] = ($fixtures.Count -eq 0)
+# The invariant suite creates a standard-user actor; its account and profile (C:\Users\<name>) must not survive a run.
+$checks['NoActorUsers'] = (@(Get-LocalUser | Where-Object { $_.Name -match '^su[0-9a-f]{8,}$' -or $_.Name -eq 'surtprobe' }).Count -eq 0)
+# The invariant suite's one-boot interactive actor sets these values, never an LSA secret.
+try {
+    $winlogonNames = (Get-Item 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon' -ErrorAction Stop).GetValueNames()
+    $checks['NoActorAutoLogonValues'] = (@('AutoAdminLogon','DefaultUserName','DefaultDomainName','DefaultPassword','AutoLogonCount') |
+        Where-Object { $winlogonNames -contains $_ }).Count -eq 0
+} catch { $checks['NoActorAutoLogonValues'] = $false }
+$checks['NoTestProfiles'] = (@(Get-CimInstance Win32_UserProfile | Where-Object { -not $_.Special -and $_.LocalPath -notmatch '\\vika$' }).Count -eq 0)
+$checks['NoSyntheticVolume'] = -not (Test-Path -LiteralPath 'S:\')
+$canaries = @()
+$canaryRootsRead = $true
+$canaryVolumes = @()
+try {
+    $canaryVolumes = @(Get-CimInstance Win32_Volume -Filter 'DriveType=3' -ErrorAction Stop |
+        Where-Object FileSystem -eq 'NTFS')
+    if ($canaryVolumes.Count -eq 0) { throw 'No fixed NTFS volume was enumerated.' }
+    foreach ($volume in $canaryVolumes) {
+        try { $canaries += @(Get-ChildItem -LiteralPath $volume.DeviceID -Filter 'SafeUpload-canary-*.tmp' -Force -ErrorAction Stop) }
+        catch { $canaryRootsRead = $false; 'CanaryRootReadError=' + $_.Exception.Message }
+    }
+} catch { $canaryRootsRead = $false; 'CanaryVolumeEnumerationError=' + $_.Exception.Message }
+$checks['CanaryRootsEnumerated'] = $canaryRootsRead
+$checks['NoVolumeCanaryFiles'] = ($canaries.Count -eq 0 -and $canaryRootsRead)
+$volumeInventory = & fltmc.exe volumes 2>&1 | Out-String
+$volumeInventoryExit = $LASTEXITCODE
+$checks['VolumeTopologyRecorded'] = ($volumeInventoryExit -eq 0)
+
+'UTC=' + [DateTime]::UtcNow.ToString('o')
+'Host=' + $env:COMPUTERNAME
+'UUID=' + $uuid
+'OriginalInstalledSHA256=' + $installedHash
+'PolicySHA256=' + $policyHash
+'Service=' + $service.StartMode + '/' + $service.State
+'CanaryVolumeCount=' + $canaryVolumes.Count
+'CanaryVolumeRoots=' + (($canaryVolumes | ForEach-Object DeviceID | Sort-Object) -join ';')
+'FilterManagerVolumeInventory=' + ($volumeInventory.Trim() -replace '[\r\n]+', ' | ')
+foreach ($name in $checks.Keys) { $name + '=' + $checks[$name] }
+if ($fixtures.Count -ne 0) { 'FixtureDirectories=' + (($fixtures | ForEach-Object Name) -join ';') }
+if ($canaries.Count -ne 0) { 'VolumeCanaryFiles=' + (($canaries | ForEach-Object FullName) -join ';') }
+'BaselineClean=' + (-not ($checks.Values -contains $false))
===== driver/scripts/Invoke-StageNotepad.sh (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/Invoke-StageNotepad.sh
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/Invoke-StageNotepad.sh
@@ -0,0 +1,738 @@
+#!/usr/bin/env bash
+# T5: Notepad Save As into a protected folder. On a debuggee in a disposable run disk (run-disk.sh; complete captures are cleaned up,
+# incomplete debug3 captures retain the run overlay and evidence; the base disk is never written), a standard user signs in
+# interactively (one-boot autologon, set before the install reboot) and a
+# task with its interactive token runs t5/notepad-actor.ps1 in that session: native control replays of the common file-dialog test
+# create (with explicit delete and delete-on-close) include a labeled observer pause; separate real Notepad Save As cases use UI
+# Automation, clean and CPF. A SYSTEM
+# coordinator records raw NTFS destination images beside buffered public reads, the raw parent index, journal entries and the driver's
+# deny ring. The independent raw artifacts and result are copied off before the run disk is discarded.
+#
+# Usage: driver/scripts/Invoke-StageNotepad.sh <debuggee domain> <tag> <driver.sys> <agent zip> [ordinary|runtime-verifier|boot-verifier]
+#
+# Evidence: driver/evidence/<day>/<tag>-*; the verdict is <tag>-verdict.txt; the exit status is 0 only when every required line passes.
+set -uo pipefail
+if [ "${T5_LIFECYCLE_SUPERVISED:-}" = yes ]; then umask 077; fi
+workspace_root=${T5_LIFECYCLE_WORKSPACE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)}
+code_root=${T5_LIFECYCLE_CODE_ROOT:-$workspace_root}
+code_scripts="$code_root/driver/scripts"
+cd "$workspace_root"
+dom="${1:?debuggee domain}"; tag="${2:?tag}"; sys="${3:?driver.sys}"; zip="${4:?agent zip}"; mode="${5:-runtime-verifier}"
+[[ "$tag" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{2,29}$ ]] || { echo 'Invalid tag'; exit 2; }
+case "$mode" in ordinary|runtime-verifier|boot-verifier) ;; *) echo 'Unknown mode'; exit 2;; esac
+if [ "$dom" = win10-debug3 ] && [ "${T5_LIFECYCLE_SUPERVISED:-}" != yes ]; then
+    upload_root='/var/lib/libvirt/safeupload-t5/m2-t5-cp1011-r2/inputs/upload'
+    upload_dir="$upload_root/$tag"
+    [ -d "$upload_root" ] && [ ! -L "$upload_root" ] || {
+        echo 'Selected T5 fixed input upload directory is unavailable'; exit 12;
+    }
+    if [ ! -e "$upload_dir" ] && [ ! -L "$upload_dir" ]; then
+        mkdir -m 0700 -- "$upload_dir" || exit 12
+    fi
+    [ -d "$upload_dir" ] && [ ! -L "$upload_dir" ] || {
+        echo 'Selected T5 input directory is not a real directory'; exit 12;
+    }
+    upload_metadata=$(/usr/bin/stat -c '%u:%g:%a:%F' -- "$upload_dir") || exit 12
+    [ "$upload_metadata" = "$(/usr/bin/id -u):$(/usr/bin/id -g):700:directory" ] || {
+        echo 'Selected T5 input directory owner or mode differs'; exit 12;
+    }
+    stage_input() {
+        local source="$1" name="$2" temporary
+        [ -f "$source" ] || return 1
+        temporary=$(/usr/bin/mktemp "$upload_dir/.stage.XXXXXXXX") || return 1
+        if ! /usr/bin/cp -- "$source" "$temporary" ||
+           ! /usr/bin/chmod 0600 -- "$temporary" ||
+           ! /usr/bin/mv -fT -- "$temporary" "$upload_dir/$name"; then
+            /usr/bin/rm -f -- "$temporary"
+            return 1
+        fi
+        [ -f "$upload_dir/$name" ] && [ ! -L "$upload_dir/$name" ]
+    }
+    stage_input "$sys" 'SafeUpload-t5.sys' &&
+        stage_input "$zip" 'stage-service-publish.zip' || {
+        echo 'Could not stage exact selected T5 inputs'; exit 12;
+    }
+    printf '%s\0%s\0' "$tag" "$mode" |
+        /usr/bin/sudo -n -- /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C \
+            SUDO_UID=1000 T5_REQUESTER_UID=1000 /usr/bin/bash --noprofile --norc \
+            /usr/local/libexec/safeupload-t5-copy-r2/Invoke-T5WritableStateCopy.sh
+    exit $?
+fi
+[ -f "$sys" ] && [ -f "$zip" ] || { echo 'needs the signed driver and the agent zip'; exit 2; }
+case "$dom" in
+    win10-debug) expected_guest_uuid='9D44EEE8-81CF-4CC1-9FBA-7670F11DEF4D' ;;
+    win10-debug2) expected_guest_uuid='9D6E3F02-B40A-49F0-A77F-439714F8F308' ;;
+    win10-debug3) expected_guest_uuid='FFCB9530-146B-43B1-8AF7-2B5CC8EDE2E3' ;;
+    *) echo "No pinned guest UUID for requested debuggee $dom"; exit 2 ;;
+esac
+if [ "$dom" = win10-debug3 ]; then
+    [[ "${T5_LIFECYCLE_LEASE_FD:-}" =~ ^[0-9]+$ ]] || {
+        echo 'Selected T5 runs must enter through the fixed root lifecycle supervisor'; exit 12;
+    }
+    /usr/bin/python3.14 -I -S -B "$code_scripts/t5/T5WritableStateLifecycle.py" \
+        validate-child --lease-fd "$T5_LIFECYCLE_LEASE_FD" --tag "$tag" >/dev/null || {
+        echo 'Selected T5 root lifecycle lease/ancestry check failed'; exit 12;
+    }
+fi
+driver_sha=$(sha256sum "$sys" | cut -d' ' -f1 | tr '[:lower:]' '[:upper:]') || exit 2
+agent_zip_sha=$(sha256sum "$zip" | cut -d' ' -f1 | tr '[:lower:]' '[:upper:]') || exit 2
+agent_service_sha=$(python3 - "$zip" <<'PY'
+import hashlib, os, sys, zipfile
+try:
+    with zipfile.ZipFile(sys.argv[1]) as archive:
+        matches = [item for item in archive.infolist()
+                   if not item.is_dir() and os.path.basename(item.filename).lower() == 'safeupload.agent.service.exe']
+        if len(matches) != 1 or matches[0].filename.replace('\\', '/') != 'SafeUpload.Agent.Service.exe':
+            raise ValueError('package must contain exactly one root SafeUpload.Agent.Service.exe')
+        print(hashlib.sha256(archive.read(matches[0])).hexdigest().upper())
+except Exception as exc:
+    print('T5 input package validation failed: ' + str(exc), file=sys.stderr)
+    sys.exit(1)
+PY
+) || exit 2
+[[ "$driver_sha" =~ ^[A-F0-9]{64}$ && "$agent_zip_sha" =~ ^[A-F0-9]{64}$ && "$agent_service_sha" =~ ^[A-F0-9]{64}$ ]] || { echo 'Could not pin T5 input hashes'; exit 2; }
+host=$(awk -v d="$dom" '$1==d{print $2}' "$code_scripts/debuggees.txt"); [ -n "$host" ] || { echo "Unknown debuggee $dom"; exit 2; }
+export SAFEUPLOAD_MIN_FREE_GB=${T5_MIN_FREE_GB:-15}
+V="virsh -c qemu:///system"; ev="driver/evidence/${T5_LIFECYCLE_EVIDENCE_DATE:-$(date +%F)}"; mkdir -p "$ev"
+if find "$ev" -maxdepth 1 \( -type f -o -type d \) -name "$tag-*" -print -quit | grep -q .; then
+    echo "Evidence tag already exists for today: $tag"
+    exit 2
+fi
+{
+    printf 'RunTag=%s\nMode=%s\nRequestedDomain=%s\nExpectedGuestUUID=%s\n' "$tag" "$mode" "$dom" "$expected_guest_uuid"
+    printf 'LocalDriverSys=%s\nLocalDriverSysSHA256=%s\n' "$sys" "$driver_sha"
+    printf 'LocalAgentZip=%s\nLocalAgentZipSHA256=%s\n' "$zip" "$agent_zip_sha"
+    printf 'LocalAgentServiceEntry=SafeUpload.Agent.Service.exe\nExpectedExtractedServiceSHA256=%s\n' "$agent_service_sha"
+} > "$ev/$tag-input-hashes.txt"
+opts=(-F /dev/null -i /home/victor/.ssh/id_ed25519 -o BatchMode=yes -o ConnectTimeout=10 -o LogLevel=ERROR -o StrictHostKeyChecking=accept-new)
+guest='C:/Users/vika/Documents'
+clean() { python3 -c '
+import re, sys, html
+text = sys.stdin.read()
+errors = ["ERROR: " + html.unescape(m).replace("_x000D__x000A_", "\n") for m in re.findall(r"<S S=\"Error\">(.*?)</S>", text, flags=re.S)]
+text = re.sub(r"<Objs.*?</Objs>", "", text, flags=re.S).replace("#< CLIXML", "").replace("\r", "")
+print("\n".join(line for line in (text.split("\n") + errors) if line.strip()))
+'; }
+remote() { python3 "$code_scripts/remote_ps.py" "$host" 2>&1 | clean; }
+wait_ssh() { for _ in $(seq 1 90); do ssh "${opts[@]}" -o ConnectTimeout=5 "vika@$host" 'echo up' >/dev/null 2>&1 && return 0; sleep 10; done; return 1; }
+started=$(date +%s)
+
+echo "== run disk"
+source "$(dirname "${BASH_SOURCE[0]}")/image-store.sh"; source "$(dirname "${BASH_SOURCE[0]}")/run-disk.sh"
+preserve_helper="$(dirname "${BASH_SOURCE[0]}")/t5/Preserve-T5Run.py"
+begin_invoked=no; alive=no; result_saved=no; raw_saved=no
+    if [ "$dom" = win10-debug3 ]; then
+    export SAFEUPLOAD_RUN_DISK_DIR=${SAFEUPLOAD_RUN_DISK_DIR:-/var/lib/libvirt/images/safeupload-t5/m2-t5-cp1011-r2/run}
+    helper_args=(--repo-root "$code_root" --evidence-dir "$ev" --state-dir "$RUN_DISK_STATE"
+        --domain "$dom" --expected-uuid "$expected_guest_uuid" --tag "$tag" --mode "$mode"
+        --run-dir "$SAFEUPLOAD_RUN_DISK_DIR" --driver-sha "$driver_sha"
+        --zip-sha "$agent_zip_sha" --service-sha "$agent_service_sha" --owner-pid "$$")
+        _rd_lock_acquire "$dom" || { echo 'Could not validate the root lifecycle lease'; exit 12; }
+        helper_args+=(--lifecycle-lease-fd "$T5_LIFECYCLE_LEASE_FD")
+    begin_invoked=no; progress_armed=no; progress_token=''
+    finish() {
+        local test_status=$? mutation_status decision_status preservation_status cleanup_status
+        trap - EXIT
+        if [ "$begin_invoked" != yes ]; then
+            if [ "$progress_armed" = yes ]; then
+                if ! python3 "$preserve_helper" cancel-progress "${helper_args[@]}" \
+                    --reason 'T5 begin was not invoked' > "$ev/$tag-run-begin.txt" 2>&1; then
+                    cat "$ev/$tag-run-begin.txt"
+                    echo 'T5InProgressGuard=FAIL; leave the durable guard for inspection'
+                    _rd_lock_release || true
+                    exit 23
+                fi
+            else
+                python3 "$preserve_helper" not-started "${helper_args[@]}" \
+                    --reason 'preflight failed before run_disk_begin was invoked' > "$ev/$tag-run-begin.txt" 2>&1 || true
+            fi
+            _rd_lock_release || { echo 'Could not release the run-disk lifecycle lock'; exit 23; }
+            exit "$test_status"
+        fi
+        python3 "$preserve_helper" mutation "${helper_args[@]}" > "$ev/$tag-mutation-check.txt" 2>&1
+        mutation_status=$?
+        if [ "$mutation_status" -eq 10 ]; then
+            if [ "$progress_armed" = yes ]; then
+                if ! python3 "$preserve_helper" cancel-progress "${helper_args[@]}" \
+                    --reason 'run_disk_begin returned without any observed run-disk mutation' > "$ev/$tag-run-begin.txt" 2>&1; then
+                    cat "$ev/$tag-run-begin.txt"
+                    echo 'T5InProgressGuard=FAIL; leave the durable guard for inspection'
+                    _rd_lock_release || true
+                    exit 23
+                fi
+            else
+                python3 "$preserve_helper" not-started "${helper_args[@]}" \
+                    --reason 'run_disk_begin returned without any observed run-disk mutation' > "$ev/$tag-run-begin.txt" 2>&1 || true
+            fi
+            _rd_lock_release || { echo 'Could not release the run-disk lifecycle lock'; exit 23; }
+            exit "$test_status"
+        fi
+        if [ "$mutation_status" -eq 0 ]; then
+            python3 "$preserve_helper" decide "${helper_args[@]}" --alive "$alive" \
+                --result-saved "$result_saved" --raw-saved "$raw_saved" \
+                > "$ev/$tag-capture-completeness.txt" 2>&1
+            decision_status=$?
+            if [ "$decision_status" -eq 0 ]; then
+                if python3 "$preserve_helper" pre-cleanup "${helper_args[@]}" \
+                    > "$ev/$tag-pre-cleanup.txt" 2>&1; then
+                    echo '== discard the complete-evidence run disk'
+                    if [ "$dom" = win10-debug3 ]; then
+                        printf '%s\n' 'Stop-Computer -Force' | remote \
+                            > "$ev/$tag-shutdown-request.txt" 2>&1 || true
+                    fi
+                    if run_disk_end "$dom" "$tag" > "$ev/$tag-shared-cleanup.txt" 2>&1; then
+                        if python3 "$preserve_helper" verify-cleanup "${helper_args[@]}" \
+                            > "$ev/$tag-final-restored-state.txt" 2>&1; then
+                            cat "$ev/$tag-final-restored-state.txt"
+                            _rd_lock_release || { echo 'Could not release the run-disk lifecycle lock'; exit 23; }
+                            exit "$test_status"
+                        fi
+                    fi
+                    cat "$ev/$tag-shared-cleanup.txt" "$ev/$tag-final-restored-state.txt"
+                    echo 'T5Restoration=FAIL; leave the durable in-progress guard for inspection'
+                else
+                    cat "$ev/$tag-pre-cleanup.txt"
+                fi
+                decision_status=20
+            fi
+        else
+            decision_status=20
+            printf 'T5_CAPTURE_COMPLETENESS=UNAVAILABLE\nmutation-check-exit=%s\n' "$mutation_status" \
+                > "$ev/$tag-capture-completeness.txt"
+        fi
+        echo '== preserve the incomplete-evidence run disk'
+        python3 "$preserve_helper" preserve "${helper_args[@]}" \
+            --reason "incomplete required capture; alive=$alive; mutation-check=$mutation_status; decision-check=$decision_status" \
+            > "$ev/$tag-retention.txt" 2>&1
+        preservation_status=$?
+        cat "$ev/$tag-retention.txt"
+        if [ "$preservation_status" -ne 0 ]; then
+            echo 'T5RetainedState=FAIL; do not call run_disk_end; inspect the active retention marker and run chain'
+            _rd_lock_release || true
+            exit 23
+        fi
+        _rd_lock_release || { echo 'Could not release the run-disk lifecycle lock'; exit 23; }
+        exit "$test_status"
+    }
+    trap finish EXIT
+    trap 'exit 129' HUP
+    trap 'exit 130' INT
+    trap 'exit 143' TERM
+    python3 "$preserve_helper" preflight "${helper_args[@]}" \
+        > "$ev/$tag-preflight.txt" 2>&1 || { cat "$ev/$tag-preflight.txt"; exit 12; }
+    python3 "$preserve_helper" arm "${helper_args[@]}" > "$ev/$tag-inprogress-arm.txt" 2>&1 || {
+        cat "$ev/$tag-inprogress-arm.txt"; exit 12;
+    }
+    progress_arm_count=$(grep -c '^T5_INPROGRESS=ARMED token=' "$ev/$tag-inprogress-arm.txt" || true)
+    progress_token=$(sed -n 's/^T5_INPROGRESS=ARMED token=//p' "$ev/$tag-inprogress-arm.txt")
+    [[ "$progress_arm_count" -eq 1 && "$progress_token" =~ ^[A-Fa-f0-9]{32}$ ]] || {
+        echo 'T5 progress guard token is missing, malformed, or duplicated'; exit 12;
+    }
+    RUN_DISK_T5_GUARD_ACTIVE=yes
+    RUN_DISK_T5_GUARD_DOMAIN=$dom
+    RUN_DISK_T5_GUARD_TAG=$tag
+    RUN_DISK_T5_GUARD_TOKEN=$progress_token
+    progress_armed=yes
+    helper_args+=(--guard-token "$progress_token")
+else
+    finish() {
+        local test_status=$?
+        trap - EXIT
+        echo "== discard the run disk"
+        if ! run_disk_end "$dom" "$tag" > "$ev/$tag-final-restored-state.txt" 2>&1 ||
+            ! grep -qx 'RunDiskBaseUntouched=True' "$ev/$tag-final-restored-state.txt"; then
+            cat "$ev/$tag-final-restored-state.txt"
+            echo 'T5Restoration=FAIL'
+            exit 22
+        fi
+        grep -E 'RunDiskBaseUntouched|deleted|nothing deleted' "$ev/$tag-final-restored-state.txt"
+        exit "$test_status"
+    }
+fi
+begin_invoked=yes
+run_disk_begin "$dom" "$tag" > "$ev/$tag-checkpoint.txt" 2>&1 || { cat "$ev/$tag-checkpoint.txt"; exit 12; }
+if [ "$dom" != win10-debug3 ]; then trap finish EXIT; fi
+wait_ssh || { echo 'guest did not boot on the run disk'; exit 3; }
+
+echo "== baseline"
+scp "${opts[@]}" "$code_scripts/Get-StagedBaseline.ps1" "vika@$host:$guest/Get-StagedBaseline.ps1" || exit 3
+echo "& 'C:\\Users\\vika\\Documents\\Get-StagedBaseline.ps1'" | remote | tee "$ev/$tag-baseline.txt" >/dev/null
+grep -q '^BaselineClean=True' "$ev/$tag-baseline.txt" || { echo 'BASELINE NOT CLEAN on a fresh run disk: the base changed'; exit 10; }
+baseline_uuid_count=$(grep -c '^UUID=' "$ev/$tag-baseline.txt" || true)
+baseline_uuid=$(sed -n 's/^UUID=//p' "$ev/$tag-baseline.txt" | tr '[:lower:]' '[:upper:]')
+if [ "$baseline_uuid_count" -ne 1 ] || [ "$baseline_uuid" != "$expected_guest_uuid" ]; then
+    printf 'T5GuestIdentity=FAIL requested=%s expected=%s observed=%s count=%s\n' "$dom" "$expected_guest_uuid" "${baseline_uuid:-MISSING}" "$baseline_uuid_count" | tee "$ev/$tag-guest-identity.txt"
+    echo 'Guest baseline UUID does not match the requested domain pinned identity'; exit 11
+fi
+printf 'T5GuestIdentity=PASS requested=%s expected=%s observed=%s\n' "$dom" "$expected_guest_uuid" "$baseline_uuid" | tee "$ev/$tag-guest-identity.txt"
+
+echo "== stage files and install"
+scp "${opts[@]}" "$sys" "vika@$host:$guest/SafeUpload-t5.sys" && scp "${opts[@]}" "$zip" "vika@$host:$guest/stage-service-publish.zip" \
+  && scp "${opts[@]}" "$code_root/agente/scripts/Install-SafeUploadAgent.ps1" "vika@$host:$guest/Install-SafeUploadAgent.ps1" \
+  && scp "${opts[@]}" "$code_root/agente/scripts/Protect-SafeUploadPolicy.ps1" "vika@$host:$guest/Protect-SafeUploadPolicy.ps1" \
+  && scp "${opts[@]}" "$code_root/agente/scripts/Get-SafeUploadDiagnostics.ps1" "vika@$host:$guest/Get-SafeUploadDiagnostics.ps1" \
+  && scp "${opts[@]}" "$code_scripts/StagedInvariantObserver.psm1" "vika@$host:$guest/StagedInvariantObserver.psm1" \
+  && scp "${opts[@]}" "$code_scripts/t5/notepad-actor.ps1" "vika@$host:$guest/t5-notepad-actor.ps1" \
+  && scp "${opts[@]}" "$code_scripts/t5/notepad-coordinator.ps1" "vika@$host:$guest/t5-notepad-coordinator.ps1" || { echo 'copy failed'; exit 14; }
+install_ps=$(cat <<'PS'
+$ErrorActionPreference = 'Stop'
+$d = 'C:\Users\vika\Documents'
+$agentDir = 'C:\Program Files\SafeUpload\Agent'
+$expectedDriverSha = '__T5_EXPECTED_DRIVER_SHA__'
+$expectedAgentZipSha = '__T5_EXPECTED_AGENT_ZIP_SHA__'
+$expectedServiceSha = '__T5_EXPECTED_SERVICE_SHA__'
+$uploadedDriverSha = (Get-FileHash -LiteralPath "$d\SafeUpload-t5.sys" -Algorithm SHA256).Hash.ToUpperInvariant()
+$uploadedAgentZipSha = (Get-FileHash -LiteralPath "$d\stage-service-publish.zip" -Algorithm SHA256).Hash.ToUpperInvariant()
+'UPLOAD_DRIVER_SHA256=' + $uploadedDriverSha
+'UPLOAD_AGENT_ZIP_SHA256=' + $uploadedAgentZipSha
+if ($uploadedDriverSha -cne $expectedDriverSha -or $uploadedAgentZipSha -cne $expectedAgentZipSha) { throw 'Uploaded T5 driver/package bytes do not match the pinned local inputs.' }
+New-Item -ItemType Directory -Force -Path $agentDir | Out-Null
+Expand-Archive -LiteralPath "$d\stage-service-publish.zip" -DestinationPath $agentDir -Force
+Copy-Item -LiteralPath "$d\SafeUpload-t5.sys" -Destination 'C:\Windows\System32\drivers\SafeUpload.sys' -Force
+$installedDriverSha = (Get-FileHash -LiteralPath 'C:\Windows\System32\drivers\SafeUpload.sys' -Algorithm SHA256).Hash.ToUpperInvariant()
+$serviceExe = Join-Path $agentDir 'SafeUpload.Agent.Service.exe'
+if (-not (Test-Path -LiteralPath $serviceExe -PathType Leaf)) { throw 'The extracted service executable is missing from the package root.' }
+$extractedServiceSha = (Get-FileHash -LiteralPath $serviceExe -Algorithm SHA256).Hash.ToUpperInvariant()
+'INSTALLED_DRIVER_SHA256=' + $installedDriverSha
+'EXTRACTED_SERVICE_EXE_SHA256=' + $extractedServiceSha
+if ($installedDriverSha -cne $expectedDriverSha -or $extractedServiceSha -cne $expectedServiceSha) { throw 'Installed driver or extracted service executable differs from the pinned local input.' }
+New-Item -ItemType Directory -Force -Path 'C:\Protected' | Out-Null
+& icacls.exe 'C:\Protected' /grant 'BUILTIN\Users:(OI)(CI)M' | Out-Null
+# The destination folder must exist before the driver loads: staging never creates a directory inside a protected folder.
+New-Item -ItemType Directory -Force -Path 'C:\Protected\t5' | Out-Null
+# The actor signs in interactively at the next boot (one-boot autologon on the disposable run disk).
+$name = 't5actor'; $password = 'T5!' + [guid]::NewGuid().ToString('N').Substring(0, 20)
+New-LocalUser -Name $name -Password (ConvertTo-SecureString $password -AsPlainText -Force) -AccountNeverExpires -PasswordNeverExpires | Out-Null
+Add-LocalGroupMember -SID 'S-1-5-32-545' -Member $name -ErrorAction SilentlyContinue
+$key = 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon'
+foreach ($v in @{ AutoAdminLogon = '1'; DefaultUserName = $name; DefaultDomainName = $env:COMPUTERNAME; DefaultPassword = $password }.GetEnumerator()) {
+    New-ItemProperty -LiteralPath $key -Name $v.Key -Value $v.Value -PropertyType String -Force | Out-Null }
+New-ItemProperty -LiteralPath $key -Name AutoLogonCount -Value 1 -PropertyType DWord -Force | Out-Null
+# A brand-new account's first sign-in otherwise stops at the privacy-settings pages and the first-logon animation, with no desktop.
+New-Item -Path 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\OOBE' -Force | Out-Null
+New-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Policies\Microsoft\Windows\OOBE' -Name DisablePrivacyExperience -Value 1 -PropertyType DWord -Force | Out-Null
+New-ItemProperty -LiteralPath 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System' -Name EnableFirstLogonAnimation -Value 0 -PropertyType DWord -Force | Out-Null
+$data = 'C:\ProgramData\SafeUpload'
+New-Item -ItemType Directory -Force -Path $data | Out-Null
+$policy = @{ version = 1; activeCategories = @('Cpf'); monitoredScopes = @{ extensions = @('.txt'); destinationPaths = @('C:\Protected'); removableDrives = $false; networkPaths = $false }; failOpen = $false; auditOnly = $false; overrideEnabled = $false } | ConvertTo-Json -Depth 5
+Set-Content -LiteralPath "$data\policy.json" -Value $policy -Encoding UTF8
+& "$d\Protect-SafeUploadPolicy.ps1"
+& "$d\Install-SafeUploadAgent.ps1" -ServiceExecutablePath "$agentDir\SafeUpload.Agent.Service.exe"
+'DriverStart=' + (Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\SafeUpload').Start
+'INSTALL_DONE=True'
+PS
+)
+install_ps=${install_ps//__T5_EXPECTED_DRIVER_SHA__/$driver_sha}
+install_ps=${install_ps//__T5_EXPECTED_AGENT_ZIP_SHA__/$agent_zip_sha}
+install_ps=${install_ps//__T5_EXPECTED_SERVICE_SHA__/$agent_service_sha}
+printf '%s\n' "$install_ps" | remote | tee "$ev/$tag-install.txt"
+grep -qx 'INSTALL_DONE=True' "$ev/$tag-install.txt" || { echo 'install failed'; exit 15; }
+case "$mode" in
+boot-verifier)
+    remote <<'PS' | tee "$ev/$tag-boot-verifier.txt"
+$ErrorActionPreference = 'Continue'
+& verifier.exe /standard /driver SafeUpload.sys | Out-Null; $a = $LASTEXITCODE
+& verifier.exe /bootmode oneboot | Out-Null; $b = $LASTEXITCODE
+$settings = (& verifier.exe /querysettings 2>&1 | Out-String)
+'BOOT_VERIFIER_CONFIGURED=' + ($a -in 0,2 -and $b -in 0,2 -and $settings -match 'SafeUpload\.sys' -and $settings -match 'Verifier Flags:\s+0x(?!0+\b)[0-9a-fA-F]+')
+PS
+    grep -qx 'BOOT_VERIFIER_CONFIGURED=True' "$ev/$tag-boot-verifier.txt" || { echo 'boot Verifier configuration failed'; exit 16; };;
+esac
+echo "== reboot"
+remote <<<'& shutdown.exe /r /t 5 /c "T5 install"' >/dev/null; sleep 60; wait_ssh || { echo 'guest did not return'; exit 17; }
+remote <<'PS' | tee "$ev/$tag-ready.txt"
+$ErrorActionPreference = 'Continue'
+function Read-AgentFrame {
+    $c = New-Object System.IO.Pipes.NamedPipeClientStream('.', 'SafeUpload.Agent', [System.IO.Pipes.PipeDirection]::In)
+    try { $c.Connect(5000); $r = New-Object System.IO.StreamReader($c); $r.ReadLine() } finally { $c.Dispose() }
+}
+$ready = $false; $last = ''
+for ($i = 0; $i -lt 60 -and -not $ready; $i++) {
+    try { $last = Read-AgentFrame; if ($last -match '"admissionCoverage"\s*:\s*"Ready"') { $ready = $true } } catch { $last = 'ERR ' + $_.Exception.Message }
+    if (-not $ready) { Start-Sleep -Seconds 5 }
+}
+'READY=' + $ready
+'DRIVER_LOADED=' + [bool](fltmc.exe filters | Select-String SafeUpload)
+'VERIFIER=' + ((& verifier.exe /query | Out-String) -replace '\s+', ' ')
+PS
+grep -qx 'READY=True' "$ev/$tag-ready.txt" || { echo 'agent never Ready'; exit 19; }
+if [ "$mode" = runtime-verifier ]; then
+    # As the suite does: volatile Verifier on the boot-loaded driver once it is Ready (an fltmc load after boot is a late attach,
+    # which never reports Ready).
+    remote <<'PS' | tee "$ev/$tag-runtime-verifier.txt"
+$ErrorActionPreference = 'Continue'
+& verifier.exe /volatile /flags 0x13B /adddriver SafeUpload.sys | Out-Null
+$q = (& verifier.exe /query 2>&1 | Out-String)
+'RUNTIME_VERIFIER_ARMED=' + ($q -match 'SafeUpload\.sys' -and $q -match '(?im)^\s*Verifier Flags:\s*0x0*13b\s*$')
+PS
+    grep -qx 'RUNTIME_VERIFIER_ARMED=True' "$ev/$tag-runtime-verifier.txt" || { echo 'runtime Verifier not armed'; exit 18; }
+fi
+
+echo "== the actor's interactive session"
+remote <<'PS' | tee "$ev/$tag-session.txt"
+$deadline = [Diagnostics.Stopwatch]::GetTimestamp() + 180 * [Diagnostics.Stopwatch]::Frequency
+do {
+    $e = @(Get-CimInstance Win32_Process -Filter "Name='explorer.exe'" | Where-Object { (Invoke-CimMethod -InputObject $_ -MethodName GetOwner).User -eq 't5actor' })
+    if ($e.Count) { 'ACTOR_SESSION=' + $e[0].SessionId; break }
+    Start-Sleep -Seconds 2
+} while ([Diagnostics.Stopwatch]::GetTimestamp() -lt $deadline)
+PS
+grep -q '^ACTOR_SESSION=[1-9]' "$ev/$tag-session.txt" || { echo 'the actor never signed in interactively'; exit 20; }
+
+echo "== actor and coordinator ($mode)"
+setup_ps=$(cat <<'PS'
+$ErrorActionPreference = 'Stop'
+$d = 'C:\Users\vika\Documents'
+New-Item -ItemType Directory -Force -Path C:\T5\control | Out-Null
+[string](Get-WinEvent -LogName Application -MaxEvents 1).RecordId | Set-Content -LiteralPath 'C:\T5\event-baseline.txt'
+& icacls.exe 'C:\T5\control' /grant 'BUILTIN\Users:(OI)(CI)M' | Out-Null
+Copy-Item -LiteralPath "$d\t5-notepad-actor.ps1" -Destination 'C:\T5\notepad-actor.ps1' -Force
+& icacls.exe 'C:\T5\notepad-actor.ps1' /grant 'BUILTIN\Users:(R)' | Out-Null
+$name = 't5actor'
+$action = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument '-NoProfile -STA -ExecutionPolicy Bypass -File "C:\T5\notepad-actor.ps1"'
+$principal = New-ScheduledTaskPrincipal -UserId ($env:COMPUTERNAME + '\' + $name) -LogonType Interactive -RunLevel Limited
+$settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Hours 1) -MultipleInstances IgnoreNew
+Register-ScheduledTask -TaskName 't5-actor' -Action $action -Principal $principal -Settings $settings -Force | Out-Null
+$system = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
+$coordinator = New-ScheduledTaskAction -Execute 'powershell.exe' -Argument ('-NoProfile -ExecutionPolicy Bypass -File "' + $d + '\t5-notepad-coordinator.ps1"')
+Register-ScheduledTask -TaskName 't5-coordinator' -Principal $system -Action $coordinator -Settings $settings -Force | Out-Null
+Start-ScheduledTask -TaskName 't5-coordinator'
+'COORDINATOR_STARTED=True'
+PS
+)
+printf '%s\n' "$setup_ps" | remote | tee "$ev/$tag-setup.txt"
+grep -qx 'COORDINATOR_STARTED=True' "$ev/$tag-setup.txt" || { echo 'coordinator did not start'; exit 20; }
+
+limit=1800; waited=0; state=RUNNING; alive=yes
+while [ "$waited" -lt "$limit" ]; do
+    sleep 30; waited=$((waited + 30))
+    if ! state=$(remote <<<"if (Test-Path C:\\T5\\result.json) { 'DONE' } else { 'RUNNING' }" | tail -1); then state=UNREACHABLE; fi
+    case "$state" in DONE*) break;; RUNNING*) alive=yes;; *) # a bugcheck looks like a hang: the guest stops answering
+        if ! ssh "${opts[@]}" -o ConnectTimeout=5 "vika@$host" 'echo up' >/dev/null 2>&1; then alive=no; echo "guest unreachable after ${waited}s"; break; fi;;
+    esac
+done
+echo "wait ended after ${waited}s: $state alive=$alive"
+
+if [ "$alive" = yes ]; then
+    remote <<'PS' > "$ev/$tag-after.txt"
+$ErrorActionPreference = 'Continue'
+'RESULT_PRESENT=' + [bool](Test-Path C:\T5\result.json)
+'RAW_MANIFEST_PRESENT=' + [bool](Test-Path C:\T5\raw\manifest.ndjson)
+'DRIVER_LOADED=' + [bool](fltmc.exe filters | Select-String SafeUpload)
+'VERIFIER=' + ((& verifier.exe /query | Out-String) -replace '\s+', ' ')
+try { $ring = @(& 'C:\Users\vika\Documents\Get-SafeUploadDiagnostics.ps1' -Query deny-ring); 'RING_TOTAL=' + $ring.Count; foreach ($e in $ring | Select-Object -Last 60) { 'RING=' + ($e | ConvertTo-Json -Compress) } } catch { 'RING_ERROR=' + $_.Exception.Message }
+'AFTER_DONE=True'
+PS
+    result_saved=no; raw_saved=no
+    if scp "${opts[@]}" "vika@$host:C:/T5/result.json" "$ev/$tag-result.json" >/dev/null 2>&1; then result_saved=yes; fi
+    if scp -r "${opts[@]}" "vika@$host:C:/T5/raw" "$ev/$tag-raw" >/dev/null 2>&1 && \
+        find "$ev/$tag-raw" -type f -name manifest.ndjson -size +0c -print -quit | grep -q .; then raw_saved=yes; fi
+    scp "${opts[@]}" "vika@$host:C:/T5/control/actor-error.txt" "$ev/$tag-actor-error.txt" >/dev/null 2>&1 || true
+    # The agent's own warnings and errors explain slow or refused publications (record IDs survive the guest clock step).
+    remote <<'PS' > "$ev/$tag-service-events.txt"
+$base = [long](Get-Content -LiteralPath 'C:\T5\event-baseline.txt')
+$xpath = "*[System[Provider[@Name='SafeUpload.Agent.Service'] and EventRecordID > $base and (Level=1 or Level=2 or Level=3 or Level=4)]]"
+Get-WinEvent -LogName Application -FilterXPath $xpath -ErrorAction SilentlyContinue | ForEach-Object {
+    [ordered]@{ RecordId = $_.RecordId; TimeCreated = $_.TimeCreated.ToString('o'); Level = $_.Level; Message = $_.Message } | ConvertTo-Json -Compress
+}
+PS
+else
+    $V screenshot "$dom" "$ev/$tag-unreachable.ppm" >/dev/null 2>&1 || true
+    : > "$ev/$tag-after.txt"
+fi
+
+python3 - "$ev/$tag-after.txt" "$ev/$tag-verdict.txt" "$ev/$tag-result.json" "$ev/$tag-raw" "$mode" "$alive" "$(( $(date +%s) - started ))" "${result_saved:-no}" "${raw_saved:-no}" <<'PY'
+import hashlib, json, os, re, sys
+after_path, verdict_path, result_path, raw_dir, mode, alive, elapsed, result_saved, raw_saved = sys.argv[1:10]
+after = open(after_path, encoding='utf-8', errors='replace').read()
+out = []
+def verdict(name, outcome, reason):
+    if outcome not in ('PASS', 'FAIL', 'INCONCLUSIVE'):
+        outcome = 'FAIL'
+    out.append(f"{name} {outcome} {reason}")
+result = None
+if result_saved == 'yes':
+    try: result = json.load(open(result_path, encoding='utf-8'))
+    except Exception: result = None
+verdict('T5GuestAlive', 'PASS' if alive == 'yes' else 'FAIL', 'the guest answered through the run')
+verdict('T5DriverLoaded', 'PASS' if 'DRIVER_LOADED=True' in after else 'FAIL', 'the filter is still loaded after the run')
+verdict('T5ResultEvidence', 'PASS' if result is not None and result_saved == 'yes' else 'FAIL',
+        f"copied={result_saved}; guest-present={re.search(r'^RESULT_PRESENT=True$', after, re.M) is not None}")
+verdict('T5ActorTaskStart', 'PASS' if result is not None and result.get('ActorTaskStartIssued') is True else 'FAIL',
+        'the SYSTEM coordinator explicitly started the interactive actor after capturing the raw destination baseline')
+ro = (result or {}).get('RawObserver') or {}
+baseline = ro.get('Baseline') or {}
+disposal = ro.get('Disposal') or {}
+raw_samples = ro.get('Samples') or []
+expected_leaves = {'probe-delete.txt', 'probe-doc.txt', 'probe-onclose.txt', 'ok.txt', 'cpf.txt'}
+scope_path = str(ro.get('ScopePath') or '').replace('/', '\\').rstrip('\\')
+expected_paths = {scope_path + '\\' + leaf for leaf in expected_leaves}
+baseline_images = baseline.get('Images') or []
+baseline_current = [i for i in baseline_images if isinstance(i, dict) and i.get('Role') == 'Current']
+baseline_parent = [i for i in baseline_images if isinstance(i, dict) and i.get('Role') == 'Parent']
+baseline_raw_ok = (len(baseline_images) == 6 and len(baseline_current) == 5 and len(baseline_parent) == 1 and
+                   {str(i.get('Path') or '').replace('/', '\\').lower() for i in baseline_current} == {p.lower() for p in expected_paths} and
+                   all(i.get('Absent') is True and i.get('LogicalArtifact') is None and i.get('FileId') is None for i in baseline_current) and
+                   baseline_parent[0].get('Path', '').lower() == r'c:\protected\t5' and
+                   isinstance(baseline_parent[0].get('FileId'), str) and bool(baseline_parent[0].get('FileId')) and
+                   isinstance(baseline_parent[0].get('Reference'), str) and bool(baseline_parent[0].get('Reference')) and
+                   isinstance(baseline_parent[0].get('DirectoryEntries'), list) and len(baseline_parent[0]['DirectoryEntries']) == 0)
+def valid_raw_sample(s):
+    if not isinstance(s, dict) or s.get('Status') != 'OK' or s.get('RawComplete') is not True or \
+       s.get('IndependentReadersAgree') is not True or s.get('NativeReaderCoverageComplete') is not True or \
+       s.get('DirectoryComplete') is not True or not s.get('Phase') or not isinstance(s.get('Sequence'), int) or s['Sequence'] <= 0 or \
+       not isinstance(s.get('ModuleSequence'), int) or s['ModuleSequence'] <= 0 or not isinstance(s.get('DirectoryEntries'), list) or \
+       not isinstance(s.get('TargetAbsent'), bool) or not isinstance(s.get('ForbiddenBytesObserved'), bool):
+        return False
+    start, end = s.get('Start'), s.get('End')
+    if not isinstance(start, dict) or not isinstance(end, dict) or start.get('BootId') != end.get('BootId') or start.get('BootId') != ro.get('BootId') or \
+       not isinstance(start.get('Qpc'), int) or not isinstance(end.get('Qpc'), int) or end['Qpc'] < start['Qpc'] or \
+       not isinstance(start.get('QpcFrequency'), int) or start['QpcFrequency'] <= 0 or end.get('QpcFrequency') != start['QpcFrequency']:
+        return False
+    images = s.get('CurrentImages')
+    public = s.get('PublicReaders')
+    native = s.get('ObserverReaders')
+    if not isinstance(images, list) or not isinstance(public, list) or not isinstance(native, list) or len(images) != 5 or len(public) != 5 or \
+       len(baseline_parent) != 1 or not isinstance(s.get('ParentFileId'), str) or not s.get('ParentFileId') or \
+       not isinstance(s.get('ParentReference'), str) or not s.get('ParentReference') or \
+       s.get('ParentFileId') != baseline_parent[0].get('FileId') or s.get('ParentReference') != baseline_parent[0].get('Reference'):
+        return False
+    image_by_leaf = {}
+    for image in images:
+        if not isinstance(image, dict) or not image.get('Path'):
+            return False
+        leaf = image['Path'].replace('/', '\\').rsplit('\\', 1)[-1].lower()
+        if leaf in image_by_leaf or image['Path'].replace('/', '\\').lower() != (scope_path + '\\' + leaf).lower():
+            return False
+        image_by_leaf[leaf] = image
+        if image.get('Absent') is True:
+            if image.get('FileId') is not None or image.get('LogicalArtifact') is not None or image.get('FileNames') != []:
+                return False
+        elif image.get('Absent') is False:
+            artifact = image.get('LogicalArtifact')
+            if not isinstance(artifact, dict) or not artifact.get('Path') or not isinstance(image.get('Length'), int) or image['Length'] < 0 or \
+               artifact.get('Length') != image['Length'] or not re.fullmatch(r'[A-Fa-f0-9]{64}', str(image.get('Sha256', ''))) or \
+               artifact.get('Sha256') != image.get('Sha256') or not image.get('FileId') or not image.get('Reference') or not isinstance(image.get('FileNames'), list):
+                return False
+        else:
+            return False
+    if set(image_by_leaf) != {x.lower() for x in expected_leaves}:
+        return False
+    public_by_leaf = {}
+    for reader in public:
+        if not isinstance(reader, dict) or not reader.get('Path'):
+            return False
+        leaf = reader['Path'].replace('/', '\\').rsplit('\\', 1)[-1].lower()
+        if leaf in public_by_leaf or reader['Path'].replace('/', '\\').lower() != (scope_path + '\\' + leaf).lower():
+            return False
+        public_by_leaf[leaf] = reader
+    if set(public_by_leaf) != set(image_by_leaf):
+        return False
+    def directory_key(item):
+        return (str(item.get('Name', '')).lower(), str(item.get('Namespace')), str(item.get('Reference')))
+    expected_entries = []
+    for leaf, image in image_by_leaf.items():
+        if image.get('Absent') is True:
+            continue
+        named_in_parent = [f for f in image.get('FileNames') or [] if isinstance(f, dict) and str(f.get('Parent')) == str(s.get('ParentReference'))]
+        if not any(str(f.get('Name', '')).lower() == leaf and str(f.get('Namespace')) != '2' for f in named_in_parent):
+            return False
+        expected_entries.extend(directory_key(f) for f in named_in_parent)
+    actual_entries = [directory_key(d) for d in s.get('DirectoryEntries')]
+    if len(actual_entries) != len(set(actual_entries)) or set(actual_entries) != set(expected_entries) or len(actual_entries) != len(expected_entries):
+        return False
+    for leaf, image in image_by_leaf.items():
+        reader = public_by_leaf[leaf]
+        if image.get('Absent') is True:
+            if reader.get('Status') != 'ABSENT':
+                return False
+            if any(r.get('Path', '').replace('/', '\\').rsplit('\\', 1)[-1].lower() == leaf for r in native if isinstance(r, dict)):
+                return False
+        else:
+            if reader.get('Status') != 'OK' or reader.get('Length') != image.get('Length') or reader.get('Sha256') != image.get('Sha256'):
+                return False
+            matches = [r for r in native if isinstance(r, dict) and r.get('Path', '').replace('/', '\\').rsplit('\\', 1)[-1].lower() == leaf]
+            if len(matches) != 2 or sum(r.get('Unbuffered') is True for r in matches) != 1:
+                return False
+            for r in matches:
+                if r.get('Status') != 'OK' or r.get('Length') != image.get('Length') or r.get('Sha256') != image.get('Sha256') or \
+                   r.get('BeforeFileId') != image.get('FileId') or r.get('AfterFileId') != image.get('FileId'):
+                    return False
+    return True
+def validate_raw_artifacts(directory, observer):
+    manifests = []
+    for base, _, names in os.walk(directory):
+        manifests.extend(os.path.join(base, n) for n in names if n.lower() == 'manifest.ndjson')
+    if len(manifests) != 1:
+        return False, f'found {len(manifests)} raw manifests'
+    manifest_dir = os.path.dirname(manifests[0])
+    artifacts = {}
+    try:
+        with open(manifests[0], encoding='utf-8') as stream:
+            lines = [line for line in stream if line.strip()]
+        if not lines:
+            return False, 'raw manifest is empty'
+        for line in lines:
+            record = json.loads(line)
+            path = record.get('Path')
+            if not path:
+                return False, 'manifest artifact path missing'
+            name = os.path.basename(path.replace('\\', '/'))
+            if not name or name in artifacts or not re.fullmatch(r'[A-Za-z0-9_-]+\.bin', name):
+                return False, 'manifest artifact name missing, duplicate, or malformed'
+            local = os.path.join(manifest_dir, name)
+            if not os.path.isfile(local) or os.path.getsize(local) != record.get('Length'):
+                return False, f'missing/short artifact {name}'
+            digest = hashlib.sha256()
+            with open(local, 'rb') as data:
+                for chunk in iter(lambda: data.read(1024 * 1024), b''):
+                    digest.update(chunk)
+            if digest.hexdigest().upper() != str(record.get('Sha256', '')).upper():
+                return False, f'artifact digest mismatch {name}'
+            artifacts[name] = record
+        required = set()
+        for image in (observer.get('Baseline') or {}).get('Images') or []:
+            artifact = image.get('LogicalArtifact')
+            if artifact and artifact.get('Path'):
+                required.add(os.path.basename(artifact['Path'].replace('\\', '/')))
+        for sample in observer.get('Samples') or []:
+            for image in sample.get('CurrentImages') or []:
+                artifact = image.get('LogicalArtifact')
+                if artifact and artifact.get('Path'):
+                    required.add(os.path.basename(artifact['Path'].replace('\\', '/')))
+        if not required or not required.issubset(artifacts):
+            return False, 'one or more raw logical artifacts are not retained in the manifest'
+        return True, f'{len(artifacts)} artifacts verified; {len(required)} logical images referenced'
+    except Exception as exc:
+        return False, f'raw artifact validation error: {exc}'
+def native_steps_match(case):
+    expected = {
+        'probe-delete': {'test-create': 0, 'test-close': 0, 'test-delete': 0, 'save-create': 0, 'save-write': 0, 'save-close': 0},
+        'probe-doc': {'test-create': 0, 'open-after-doc-flag': 303, 'test-close': 0, 'save-create': 0, 'save-write': 0, 'save-close': 0},
+        'probe-onclose': {'first-create': 0, 'second-open': 0, 'first-on-close-delete': 0, 'open-after-first-flag': 303,
+                          'second-on-close-delete': 0, 'first-on-close-clear': 0, 'open-after-first-clear': 303,
+                          'second-on-close-clear': 0, 'open-after-both-clear': 0, 'save-write': 0, 'save-close': 0,
+                          'first-close': 0, 'second-close': 0},
+    }.get(case.get('Op'))
+    if expected is None:
+        return case.get('NativeStepsOk') is True
+    if case.get('NativeStepsChecked') is not True or case.get('NativeStepsOk') is not True:
+        return False
+    steps = str((case.get('Ack') or {}).get('Steps') or '')
+    for name, code in expected.items():
+        found = re.findall(r'(?:^|\s)' + re.escape(name) + r'=(-?[0-9]+)', steps)
