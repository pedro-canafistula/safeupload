     return policy
+
+
+def _create_exact_directory(path: str, uid: int, gid: int, mode: int) -> None:
+    parent, leaf = RootFilesystem._open_parent(path)
+    try:
+        try:
+            os.mkdir(leaf, mode, dir_fd=parent)
+        except FileExistsError as exc:
+            raise InvocationError('per-run destination already exists: ' + path) from exc
+        fd = os.open(leaf, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                     os.O_NOFOLLOW, dir_fd=parent)
+        try:
+            os.fchown(fd, uid, gid)
+            os.fchmod(fd, mode)
+            row = os.fstat(fd)
+            by_path = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
+            if (not stat.S_ISDIR(row.st_mode) or
+                    (row.st_uid, row.st_gid, stat.S_IMODE(row.st_mode)) !=
+                    (uid, gid, mode) or (row.st_dev, row.st_ino) !=
+                    (by_path.st_dev, by_path.st_ino) or os.listdir(fd)):
+                raise InvocationError('new per-run destination identity/content differs: ' + path)
+            os.fsync(fd)
+            os.fsync(parent)
+        finally:
+            os.close(fd)
+    finally:
+        os.close(parent)
+
+
+def _prepare_run_destinations(tag: str) -> None:
+    """Create one exact run namespace beneath protected root-owned parents."""
+    _verify_destinations(RootFilesystem)
+    _create_exact_directory(STATE_DIRECTORY + '/' + tag, 0, 0, 0o700)
+    _create_exact_directory(EVIDENCE_DIRECTORY + '/' + tag, 0, 0, 0o700)
+    for role, _name, uid, gid, _mode in POOL_SPECS:
+        _create_exact_directory(POOL_PARENT + '/t5-copy-' + tag + '-' + role,
+                                 uid, gid, 0o700)
+
+
+def _read_run_request(stream: Any) -> tuple[str, str]:
+    raw = stream.read(MAX_RUN_REQUEST_BYTES + 1)
+    if not isinstance(raw, bytes) or len(raw) > MAX_RUN_REQUEST_BYTES or not raw.endswith(b'\0'):
+        raise InvocationError('run request must be two bounded NUL-delimited fields')
+    fields = raw[:-1].split(b'\0')
+    if len(fields) != 2:
+        raise InvocationError('run request field count differs from the fixed protocol')
+    try:
+        tag, mode = [value.decode('utf-8', 'strict') for value in fields]
+    except UnicodeError as exc:
+        raise InvocationError('run request fields are not strict UTF-8') from exc
+    if (re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}', tag) is None
+            or mode not in ('ordinary', 'runtime-verifier', 'boot-verifier')):
+        raise InvocationError('run tag or mode differs from the fixed T5 syntax')
+    return tag, mode
+
+
+def _copy_user_input_to_sealed_memfd(path: str, label: str,
+                                     fs: Any = os) -> tuple[int, str, int]:
+    """Copy one UID1000 input into an immutable anonymous file before spawn."""
+    source_fd = -1
+    target_fd = -1
+    try:
+        source_fd = fs.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+        before = fs.fstat(source_fd)
+        if (not stat.S_ISREG(before.st_mode) or before.st_uid != 1000
+                or before.st_nlink != 1 or before.st_size <= 0
+                or before.st_size > MAX_USER_INPUT_BYTES):
+            raise InvocationError(label + ' must be a bounded regular UID1000 file')
+        if not hasattr(os, 'memfd_create') or not hasattr(fcntl, 'F_ADD_SEALS'):
+            raise InvocationError('kernel does not provide sealable anonymous run inputs')
+        target_fd = os.memfd_create('safeupload-t5-' + label,
+                                    os.MFD_CLOEXEC | os.MFD_ALLOW_SEALING)
+        digest = hashlib.sha256()
+        copied = 0
+        while True:
+            chunk = fs.read(source_fd, 1024 * 1024)
+            if not chunk:
+                break
+            copied += len(chunk)
+            if copied > MAX_USER_INPUT_BYTES:
+                raise InvocationError(label + ' exceeded the fixed input size bound')
+            digest.update(chunk)
+            view = memoryview(chunk)
+            while view:
+                written = os.write(target_fd, view)
+                if written <= 0:
+                    raise InvocationError(label + ' sealed input write made no progress')
+                view = view[written:]
+        after = fs.fstat(source_fd)
+        if ((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
+             before.st_ctime_ns) !=
+                (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns,
+                 after.st_ctime_ns) or copied != before.st_size):
+            raise InvocationError(label + ' changed while it was copied')
+        seals = (fcntl.F_SEAL_WRITE | fcntl.F_SEAL_SHRINK | fcntl.F_SEAL_GROW |
+                 fcntl.F_SEAL_SEAL)
+        fcntl.fcntl(target_fd, fcntl.F_ADD_SEALS, seals)
+        if fcntl.fcntl(target_fd, fcntl.F_GET_SEALS) & seals != seals:
+            raise InvocationError(label + ' anonymous input was not sealed immutable')
+        os.lseek(target_fd, 0, os.SEEK_SET)
+        result = target_fd
+        target_fd = -1
+        return result, digest.hexdigest(), copied
+    except InvocationError:
+        raise
+    except BaseException as exc:
+        raise InvocationError('could not snapshot ' + label + ' into a sealed input') from exc
+    finally:
+        if source_fd >= 0:
+            os.close(source_fd)
+        if target_fd >= 0:
+            os.close(target_fd)
+
+
+def _service_sha256_from_sealed_zip(fd: int) -> str:
+    try:
+        duplicate = os.dup(fd)
+        with os.fdopen(duplicate, 'rb', closefd=True) as stream:
+            with zipfile.ZipFile(stream) as archive:
+                matches = [item for item in archive.infolist()
+                           if not item.is_dir() and
+                           os.path.basename(item.filename.replace('\\', '/')).lower() ==
+                           'safeupload.agent.service.exe']
+                if (len(matches) != 1 or
+                        matches[0].filename.replace('\\', '/') !=
+                        'SafeUpload.Agent.Service.exe' or
+                        matches[0].file_size <= 0 or
+                        matches[0].file_size > MAX_USER_INPUT_BYTES):
+                    raise InvocationError('package must contain one bounded root service executable')
+                digest = hashlib.sha256()
+                copied = 0
+                with archive.open(matches[0], 'r') as member:
+                    while True:
+                        chunk = member.read(1024 * 1024)
+                        if not chunk:
+                            break
+                        copied += len(chunk)
+                        if copied > MAX_USER_INPUT_BYTES:
+                            raise InvocationError('service executable exceeds its fixed bound')
+                        digest.update(chunk)
+                if copied != matches[0].file_size:
+                    raise InvocationError('service executable member length differs')
+                return digest.hexdigest().upper()
+    except InvocationError:
+        raise
+    except BaseException as exc:
+        raise InvocationError('agent package is not the exact readable service archive') from exc
+
+
+def _snapshot_run_inputs(request: tuple[str, str]) -> dict[str, Any]:
+    tag, mode = request
+    for path in ('/var/lib', '/var/lib/libvirt',
+                 '/var/lib/libvirt/safeupload-t5',
+                 '/var/lib/libvirt/safeupload-t5/m2-t5-cp1011-r2', RUN_INPUT_ROOT):
+        RootFilesystem.directory_traverse(path, 0, 0)
+    RootFilesystem.directory_stat(RUN_INPUT_DIRECTORY, 1000, 1000, '0700')
+    run_directory = RUN_INPUT_DIRECTORY + '/' + tag
+    RootFilesystem.directory_stat(run_directory, 1000, 1000, '0700')
+    expected_names = {RUN_INPUT_DRIVER_NAME, RUN_INPUT_PACKAGE_NAME}
+    RootFilesystem.list_exact(run_directory, expected_names)
+    driver_path = run_directory + '/' + RUN_INPUT_DRIVER_NAME
+    package_path = run_directory + '/' + RUN_INPUT_PACKAGE_NAME
+    driver_fd, driver_sha, driver_size = _copy_user_input_to_sealed_memfd(
+        driver_path, 'driver.sys')
+    package_fd = -1
+    try:
+        package_fd, package_sha, package_size = _copy_user_input_to_sealed_memfd(
+            package_path, 'agent.zip')
+        service_sha = _service_sha256_from_sealed_zip(package_fd)
+        RootFilesystem.list_exact(run_directory, expected_names)
+        return {
+            'Tag': tag, 'Mode': mode, 'DriverFD': driver_fd,
+            'DriverPath': '/proc/self/fd/' + str(driver_fd),
+            'DriverSHA256': driver_sha.upper(), 'DriverBytes': driver_size,
+            'PackageFD': package_fd,
+            'PackagePath': '/proc/self/fd/' + str(package_fd),
+            'PackageSHA256': package_sha.upper(), 'PackageBytes': package_size,
+            'ServiceSHA256': service_sha,
+        }
+    except BaseException:
+        os.close(driver_fd)
+        if package_fd >= 0:
+            os.close(package_fd)
+        raise
 
 
