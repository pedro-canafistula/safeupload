+                or xml_semantics(before_state_remove['inactive_xml'], 'before-state-remove inactive XML') !=
+                   xml_semantics(saved_xml, 'saved prebegin inactive XML')
+                or vda_path(before_state_remove['inactive_xml'], 'before-state-remove inactive domain') !=
