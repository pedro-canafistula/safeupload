+    def destroy_destination_pools_and_verify_absent(self, policy: CopyPolicy) -> None:
+        """Undefine only the four empty per-run pools after copy finalization."""
+        expected_pools = (policy.run_nvram, policy.run_tpm,
+                          policy.recovery_nvram, policy.recovery_tpm)
+        expected_by_name = {pool.name: pool for pool in expected_pools}
+        if len(expected_by_name) != 4:
+            raise CopyError('per-run destination pool policy contains duplicate names')
+        for expected in expected_pools:
+            pool_data = self.destination_pools.get(expected.role)
+            pool = pool_data.get('Pool') if isinstance(pool_data, dict) else None
+            if pool is None:
+                matches = [item for item in self.connection.listAllStoragePools(0)
+                           if str(item.name()) == expected.name]
+                if len(matches) != 1:
+                    raise CopyError(expected.role + ' exact pool is missing/duplicated before guarded undefine')
+                pool = matches[0]
+            parsed = self._pool_xml(pool, expected.role + ' guarded pool cleanup')
+            if (parsed['Name'], parsed['Target'], parsed['UID'], parsed['GID'], parsed['Mode']) != (
+                    expected.name, expected.target, expected.uid, expected.gid, expected.mode):
+                raise CopyError(expected.role + ' pool identity changed before guarded undefine')
+            if int(pool.isPersistent()) != 1 or int(pool.isActive()) != 1:
+                raise CopyError(expected.role + ' pool is not exact active/persistent state before undefine')
+            names, _volumes = self._pool_volume_names(pool, expected.role + ' guarded empty check')
+            if names:
+                raise CopyError(expected.role + ' pool contains objects before guarded undefine')
+            try:
+                _check_storage_status(pool.destroy(), expected.role + ' pool destroy')
+                _check_storage_status(pool.undefine(), expected.role + ' pool undefine')
+            except Exception as exc:
+                if isinstance(exc, CopyError):
+                    raise
+                raise CopyError('could not destroy/undefine exact ' + expected.role +
+                                ' destination pool: ' + str(exc)) from exc
+            if expected.name in set(self._pool_names()):
+                raise CopyError(expected.role + ' pool remains registered after guarded undefine')
+            observed = Openat2DestinationObserver(self.helper).observe_pool_tree(expected, [])
+            directory = observed['IdentityObjects'][0]
+            before = pool_data.get('RootObservation') if isinstance(pool_data, dict) else None
+            if isinstance(before, dict):
+                original_directory = before['IdentityObjects'][0]
+                if (directory['Device'], directory['Inode']) != (
+                        original_directory['Device'], original_directory['Inode']):
+                    raise CopyError(expected.role + ' empty directory identity changed after pool undefine')
+        self.destination_pools = {}
+
 
