+#!/usr/bin/env python3
+"""Offline schema and fail-closed controls for the T5 lifecycle lease."""
+from __future__ import annotations
+
+import copy
+import importlib.util
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+HERE = Path(__file__).resolve().parent
+SPEC = importlib.util.spec_from_file_location(
+    't5_lifecycle_under_test', HERE / 'T5WritableStateLifecycle.py')
+if SPEC is None or SPEC.loader is None:
+    raise RuntimeError('cannot load exact lifecycle helper')
+module = importlib.util.module_from_spec(SPEC)
+sys.modules[SPEC.name] = module
+SPEC.loader.exec_module(module)
+
+
+def preparation():
+    return {
+        'Schema': module.PREPARATION_SCHEMA, 'Status': 'PREPARING',
+        'Domain': module.DOMAIN, 'UUID': module.DOMAIN_UUID, 'URI': module.URI,
+        'RunTag': 'run-20261011', 'Token': 'a' * 64,
+        'SupervisorPID': 123, 'SupervisorStartTicks': 456,
+        'RequesterUID': 1000, 'LockPath': module.LOCK_PATH,
+        'LockDevice': 1, 'LockInode': 2, 'SupervisorLockFD': 7,
+        'RequestSHA256': 'b' * 64, 'StartedUnixNS': 789,
+        'Disposition': 'ROOT_SUPERVISOR_PREPARATION_LOCK',
+    }
+
+
+def active():
+    row = preparation()
+    return {
+        'Schema': module.SCHEMA, 'Status': 'ACTIVE', 'Domain': module.DOMAIN,
+        'UUID': module.DOMAIN_UUID, 'URI': module.URI, 'RunTag': row['RunTag'],
+        'Token': row['Token'], 'SupervisorPID': row['SupervisorPID'],
+        'SupervisorStartTicks': row['SupervisorStartTicks'], 'RequesterUID': 1000,
+        'LockPath': module.LOCK_PATH, 'LockDevice': row['LockDevice'],
+        'LockInode': row['LockInode'], 'SupervisorLockFD': row['SupervisorLockFD'],
+        'PreparedReceiptSHA256': 'c' * 64,
+        'PrivateStateBindingReceiptSHA256': 'd' * 64,
+        'PreparationLeaseSHA256': 'e' * 64, 'StartedUnixNS': 790,
+        'Disposition': 'ROOT_SUPERVISOR_PRIVATE_EXCLUSIVE_LOCK',
+    }
+
+
+class LifecycleControls(unittest.TestCase):
+    def test_local_linux_allows_exclusive_flock_on_readonly_descriptor(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'lock'
+            path.write_bytes(b'')
+            path.chmod(0o444)
+            observer = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
+            try:
+                module.fcntl.flock(observer, module.fcntl.LOCK_EX | module.fcntl.LOCK_NB)
+                module.fcntl.flock(observer, module.fcntl.LOCK_UN)
+            finally:
+                os.close(observer)
+
+    def test_polkit_shared_lock_observer_reports_idle_and_held(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'lock'
+            path.write_bytes(b'')
+            path.chmod(0o600)
+            holder = os.open(path, os.O_RDWR | os.O_CLOEXEC)
+            observer = os.open(path, os.O_RDONLY | os.O_CLOEXEC)
+            try:
+                self.assertFalse(module._shared_lock_busy_probe(observer))
+                module.fcntl.flock(holder, module.fcntl.LOCK_EX | module.fcntl.LOCK_NB)
+                self.assertTrue(module._shared_lock_busy_probe(observer))
+                module.fcntl.flock(holder, module.fcntl.LOCK_UN)
+                self.assertFalse(module._shared_lock_busy_probe(observer))
+            finally:
+                os.close(observer)
+                os.close(holder)
+
+    def test_preparation_record_is_exact_and_has_no_mutating_authority(self):
+        row = preparation()
+        module._validate_preparation_lease(row)
+        for mutate in (
+                lambda value: value.__setitem__('Status', 'ACTIVE'),
+                lambda value: value.__setitem__('LockPath', module.LEGACY_USER_LOCK_PATH),
+                lambda value: value.__setitem__('RequesterUID', 0),
+                lambda value: value.__setitem__('RequestSHA256', 'x' * 64),
+                lambda value: value.__setitem__('Unexpected', False),
+                lambda value: value.__setitem__('Token', 'short')):
+            candidate = copy.deepcopy(row)
+            mutate(candidate)
+            with self.assertRaises(module.LifecycleError):
+                module._validate_preparation_lease(candidate)
+
+    def test_active_record_requires_both_receipt_hashes_and_preparation_hash(self):
+        row = active()
+        module._validate_lease(row)
+        for field in ('PreparedReceiptSHA256',
+                      'PrivateStateBindingReceiptSHA256',
+                      'PreparationLeaseSHA256'):
+            candidate = copy.deepcopy(row)
+            candidate[field] = None
+            with self.subTest(field=field), self.assertRaises(module.LifecycleError):
+                module._validate_lease(candidate)
+        candidate = copy.deepcopy(row)
+        candidate['RunTag'] = '../escape'
+        with self.assertRaises(module.LifecycleError):
+            module._validate_lease(candidate)
+
+    def test_start_release_is_typed_and_bound_to_one_active_lease(self):
+        active_row = active()
+        active_raw = (json.dumps(active_row, sort_keys=True, separators=(',', ':')) + '\n').encode()
+        release = {
+            'Schema': module.START_RELEASE_SCHEMA, 'Status': 'PRESTART_VERIFIED',
+            'Domain': module.DOMAIN, 'UUID': module.DOMAIN_UUID, 'URI': module.URI,
+            'RunTag': active_row['RunTag'], 'Token': active_row['Token'],
+            'SupervisorPID': active_row['SupervisorPID'],
+            'SupervisorStartTicks': active_row['SupervisorStartTicks'],
+            'LockPath': module.LOCK_PATH, 'LockDevice': active_row['LockDevice'],
+            'LockInode': active_row['LockInode'],
+            'ActiveLeaseSHA256': hashlib.sha256(active_raw).hexdigest(),
+            'PreparedReceiptSHA256': active_row['PreparedReceiptSHA256'],
+            'PrivateStateBindingReceiptSHA256':
