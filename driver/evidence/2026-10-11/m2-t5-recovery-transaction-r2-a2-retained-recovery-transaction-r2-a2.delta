+            active_text.replace('/dev/pts/4', '/dev/ttyS0'),
+            active_text.replace('port="0"', 'port="1"', 1),
+            active_text.replace('runtime-label', ''),
+            active_text.replace('model="dac" relabel="no"', 'model="other" relabel="no"'),
