+                xml_semantics(saved_xml, 'saved prebegin inactive XML'):
+            raise RetentionError('Restored whole-tree inactive XML differs semantically from saved XML')
+        if vda_path(post['inactive_xml'], 'restored inactive domain') != prebegin['BasePath']:
+            raise RetentionError('Restored inactive vda is not the pinned base')
+        if post['domain'].UUIDString().lower() != DOMAIN_UUID:
+            raise RetentionError('Restored domain UUID differs from pinned debug3 UUID')
+        pool.refresh(0)
+        base_after = volume_by_path(conn, prebegin['BasePath'], libvirt)
+        backing_after = volume_by_path(conn, prebegin['BackingPath'], libvirt)
+        overlay_after = volume_by_path(conn, overlay_path, libvirt)
+        if base_after is None or backing_after is None or overlay_after is None:
+            raise RetentionError('Pinned base/backing or retained overlay is absent after XML restore')
+        base_after_hash = volume_sha256(conn, base_after)
+        backing_after_hash = volume_sha256(conn, backing_after)
+        overlay_after_hash = volume_sha256(conn, overlay_after)
+        if (base_after_hash['sha256'] != BASE_VOLUME_SHA256
+                or backing_after_hash['sha256'] != BACKING_VOLUME_SHA256
+                or base_after_hash['bytes'] != prebegin['BaseBytes']
+                or backing_after_hash['bytes'] != prebegin['BackingBytes']
+                or overlay_after_hash['sha256'] != overlay_hash['sha256']):
+            raise RetentionError('Post-restore full stream SHA differs for base/backing/retained overlay')
+        check_volume_identity(base_after, prebegin['BasePath'], 'qcow2', 'restored base',
+                              expected_name=Path(prebegin['BasePath']).name,
+                              expected_backing=prebegin['BackingPath'])
+        check_volume_identity(backing_after, prebegin['BackingPath'], 'qcow2', 'restored backing',
+                              expected_name=Path(prebegin['BackingPath']).name)
+        check_private_identity(parse_volume_xml(base_after.XMLDesc(0), 'restored base'),
+                               private_identity_from_pinned_base(prebegin), 'restored base')
+        overlay_after_details = check_volume_identity(
+            overlay_after, overlay_path, 'qcow2', 'retained overlay',
+            expected_name=Path(overlay_path).name, expected_backing=prebegin['BasePath'])
+        if overlay_after_details['backing_format'] != 'qcow2':
+            raise RetentionError('Retained overlay no longer declares a qcow2 backing format')
+        ram_after_hash = None
+        if ram_volume is not None:
+            ram_after = volume_by_path(conn, ram_details['path'], libvirt)
+            if ram_after is None:
+                raise RetentionError('Retained RAM volume disappeared after saved XML restoration')
+            ram_after_details = check_volume_identity(ram_after, ram_details['path'], 'raw', 'retained RAM',
+                                                      expected_name=ram_details['name'])
+            check_private_identity(ram_after_details, private_identity, 'retained RAM')
+            if ram_after_details['capacity'] != storage_volume_info(
+                    ram_after, 'retained RAM volume')['capacity']:
+                raise RetentionError('Retained RAM volume XML and libvirt info disagree on the ELF file length')
+            ram_after_hash = hash_and_validate_ram(
+                conn, ram_after, guest_memory, ram_logical_capacity,
+                ram_region_map['Parsed']['Ranges'])
+            if (ram_after_hash['sha256'] != ram_hash['sha256']
+                    or ram_after_hash['bytes'] != ram_hash['bytes']):
+                raise RetentionError('Retained RAM volume changed after durable archive creation')
+
+        restore_record = {
+            'Schema': 'T5PostRestoreVerificationV1', 'RunTag': args.tag,
+            'Domain': DOMAIN, 'UUID': DOMAIN_UUID, 'DomainState': post['state_name'],
+            'WholeTreeInactiveXMLSemanticMatch': True, 'InactiveVdaIsPinnedBase': True,
+            'BasePresent': True, 'BaseSHA256': base_after_hash['sha256'],
+            'BackingPresent': True, 'BackingSHA256': backing_after_hash['sha256'],
+            'RetainedOverlayPresent': True, 'RetainedOverlayPath': overlay_path,
+            'RetainedOverlaySHA256': overlay_after_hash['sha256'],
+            'RAMVolumePresent': ram_volume is None or ram_after is not None,
+            'RAMVolumePath': ram_details['path'] if ram_volume is not None else None,
+            'RAMVolumeSHA256': ram_after_hash['sha256'] if ram_after_hash is not None else None,
+            'RAMVolumeBytes': ram_after_hash['bytes'] if ram_after_hash is not None else None,
+            'RunDiskStateArchived': run_state is not None,
+            'RunDiskStateSHA256': sha256_bytes(state_bytes) if state_bytes is not None else None,
+            'RunDiskStateRemovedFromActiveState': False,
+            'CaptureReason': args.reason,
+        }
+        atomic_json(target / 'post-restore-verification.json', restore_record)
+        if run_state is not None:
+            if (state_path.is_symlink() or not state_path.is_file()
+                    or state_path.read_bytes() != run_state['bytes']):
+                raise RetentionError('Active run state changed after archive verification')
+            state_path.unlink()
+            fsync_directory(state_path.parent)
+        if state_path.exists() or state_path.is_symlink():
+            raise RetentionError('Active run-disk state remains after restoration')
+        restore_record['RunDiskStateRemovedFromActiveState'] = run_state is not None
+        atomic_json(target / 'post-restore-verification.json', restore_record, replace=True)
+        verify_retained_archive(target, members)
+        final_restore = parse_json_unique(target / 'post-restore-verification.json')
+        if (final_restore.get('WholeTreeInactiveXMLSemanticMatch') is not True
+                or final_restore.get('InactiveVdaIsPinnedBase') is not True
+                or final_restore.get('RetainedOverlaySHA256') != overlay_hash['sha256']
+                or final_restore.get('RAMVolumePresent') is not True
+                or final_restore.get('RunDiskStateRemovedFromActiveState') is not (run_state is not None)
