 class RunCompletionVerifier(Protocol):
     def verify(self, prepared: dict[str, Any]) -> VerifiedRunCompletion: ...
+
+
+class RunSourceBindingVerifier(Protocol):
+    """Root-controlled binder for the exact VDA/NVRAM/TPM guest sources.
+
+    `bind()` must verify the held lifecycle capability and source/private
+    identities, rewrite only the exact selected domain's inactive XML, and
+    return a typed receipt that independently re-reads the resulting XML.
+    It must not start the guest. The actual run-disk overlay is created by the
+    held T5 lifecycle runner and is checked again before the start request.
+    """
+    def bind(self, prepared_core: dict[str, Any], preparation_core_sha256: str,
+             policy: CopyPolicy, capability: VerifiedExecutionCapability,
+             endpoint: EndpointProvider) -> 'VerifiedRunSourceBinding': ...
+
+
+@dataclass(frozen=True)
+class VerifiedRunSourceBinding:
+    schema: str
+    domain_uuid: str
+    run_tag: str
+    preparation_core_sha256: str
+    lifecycle_receipt_sha256: str
+    original_xml_sha256: str
+    run_xml_sha256: str
+    run_disk_path: str
+    run_nvram_path: str
+    run_tpm_directory: str
+    private_identity_sha256: str
+    binding_receipt_sha256: str
+
+    def validate(self, prepared_core: dict[str, Any],
+                 preparation_core_sha256: str) -> None:
+        for value in (self.preparation_core_sha256,
+                      self.lifecycle_receipt_sha256, self.original_xml_sha256,
+                      self.run_xml_sha256, self.private_identity_sha256,
+                      self.binding_receipt_sha256):
+            if not _is_sha256(value):
+                raise CopyError('typed run-source binding contains a malformed evidence hash')
+        if (self.schema != RUN_BINDING_SCHEMA or self.domain_uuid != DOMAIN_UUID
+                or self.run_tag != prepared_core.get('RunTag')
+                or self.preparation_core_sha256 != preparation_core_sha256
+                or self.original_xml_sha256 != PRE_MUTATION_INACTIVE_XML_SHA256
+                or self.run_nvram_path != prepared_core.get('RunNVRAMPath')
+                or self.run_tpm_directory != prepared_core.get('RunTPMDirectory')
