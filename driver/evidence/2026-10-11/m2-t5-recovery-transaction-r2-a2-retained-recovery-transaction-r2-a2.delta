+    def test_cleanup_failure_does_not_mask_primary_pool_validation_failure(self):
+        receipt = inventory.parse_json_unique(
+            HELPER_PATH.parents[3] / 'driver/evidence/2026-10-11/m2-t5-inventory-r4-actual-transient-pool-xml-root.json'
+        )
+        bad_xml = receipt['XML'].replace('<source>\n  </source>', '<source>unexpected</source>')
+        bad_xml = bad_xml.replace(receipt['Name'], 't5-inventory-CheckTag-nvram')
+        conn = FakeConnection([], xml_override=bad_xml, destroy_error='injected cleanup fault',
+                              pool_uuid='8fe473bb-d3e1-4de6-a0c9-db266d00ae60')
+        with self.assertRaises(inventory.InventoryError) as raised:
+            inventory.inspect_directory(conn, 'CheckTag', 'nvram', inventory.NVRAM_DIRECTORY)
+        message = str(raised.exception)
+        self.assertIn('Primary failure: InventoryError', message)
+        self.assertIn('source element is not empty', message)
+        self.assertIn('cleanup failure: InventoryError', message)
+        self.assertIn('destroy failed: injected cleanup fault', message)
+        self.assertIsInstance(raised.exception.__cause__, inventory.InventoryError)
+        self.assertIn('source element is not empty', str(raised.exception.__cause__))
+        self.assertEqual(len(conn.pools), 1)
+
+    def test_selected_volume_xml_info_diagnostic_preserves_primary_and_cleanup_and_skips_sibling(self):
+        target = inventory.NVRAM_DIRECTORY
+        selected = FakeVolume('win10-debug3_VARS.fd', target + '/win10-debug3_VARS.fd', b'firmware')
+        selected.xml = '<volume><name>truncated selected volume XML'
+        sibling = FakeVolume('other-domain_VARS.fd', target + '/other-domain_VARS.fd', b'unrelated')
+        sibling.xml = '<volume><name>malformed sibling XML'
+        conn = FakeConnection([sibling, selected], destroy_error='injected cleanup fault')
+        preserve = inventory._preserve_module()
+        with mock.patch.object(preserve, 'volume_sha256') as hash_volume:
+            with self.assertRaises(inventory.InventoryError) as raised:
+                inventory.inspect_directory(conn, 'CheckTag', 'nvram', target,
+                                            target + '/win10-debug3_VARS.fd')
+        hash_volume.assert_not_called()
+        self.assertEqual(selected.xml_reads, 1)
+        self.assertEqual(selected.info_reads, 1)
+        self.assertEqual(sibling.xml_reads, 0)
+        self.assertEqual(sibling.info_reads, 0)
+        self.assertEqual(len(conn.pools), 1)
+
+        marker = 'T5_SELECTED_VOLUME_XML_INFO_DIAGNOSTIC='
+        primary_text = str(raised.exception.__cause__)
+        self.assertIn(marker, primary_text)
+        self.assertIn('cleanup failure: InventoryError', str(raised.exception))
+        self.assertIn('destroy failed: injected cleanup fault', str(raised.exception))
+        self.assertIn(primary_text, str(raised.exception))
+        payload_text = primary_text.split(marker, 1)[1]
+        payload = json.loads(payload_text)
+        self.assertEqual(payload['Schema'], 'T5SelectedVolumeXMLInfoParseFailureV1')
+        self.assertEqual(payload['VolumeName'], 'win10-debug3_VARS.fd')
+        self.assertEqual(payload['TargetDirectory'], target)
+        self.assertEqual(payload['SelectedPath'], target + '/win10-debug3_VARS.fd')
+        self.assertEqual(payload['RawVolumeXML'], selected.xml)
+        self.assertEqual(payload['RawStorageVolumeInfo'], {
+            'Available': True, 'PythonType': 'tuple', 'Repr': '(0, 8, 8)'})
+        self.assertEqual(payload['XMLParseError']['Type'], 'RetentionError')
+
