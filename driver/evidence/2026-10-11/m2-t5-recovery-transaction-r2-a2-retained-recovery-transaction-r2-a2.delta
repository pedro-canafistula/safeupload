+def _ensure_control_lease(request: dict[str, Any], lease: Any) -> None:
+    lease.verify_held()
+    if (request['RunTag'] != lease.preparation_row['RunTag']
+            or request['ActiveLeaseSHA256'] != lease.lease_sha256
+            or not lease.active):
+        raise InvocationError('runner control request does not bind the live root lease')
+
+
+def _create_run_overlay(connection: Any, prepared: dict[str, Any],
+                        run_binding: Any, run_tag: str) -> dict[str, Any]:
+    path = RUN_DISK_POOL_PATH + '/' + DOMAIN + '.safeupload-run-' + run_tag + '.qcow2'
+    run_nvram = prepared['RunNVRAMPath']
+    run_tpm = prepared['RunTPMDirectory']
+    run_binding.validate_run_paths(run_disk_path=path, run_nvram_path=run_nvram,
+                                   run_tpm_path=run_tpm, run_tag=run_tag)
+    if os.path.lexists(path):
+        raise InvocationError('tagged private run overlay path already exists')
+    base_path = '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2'
+    try:
+        base = connection.storageVolLookupByPath(base_path)
+        capacity = int(base.info()[1])
+        base_row = _disk_volume_metadata(
+            base, base_path,
+            '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2',
+            'run overlay base')
+    except Exception as exc:
+        if isinstance(exc, InvocationError):
+            raise
+        raise InvocationError('cannot verify the fixed run overlay backing volume') from exc
+    if capacity <= 0 or capacity != base.info()[1]:
+        raise InvocationError('base logical capacity changed during run overlay preparation')
+    try:
+        pools = connection.listAllStoragePools(0)
+    except Exception as exc:
+        raise InvocationError('cannot enumerate run-disk storage pools') from exc
+    pool_matches = []
+    for pool in pools:
+        try:
+            xml = ET.fromstring(pool.XMLDesc(0))
+            target = xml.findtext('target/path')
+            pool_name = pool.name()
+            if (target == RUN_DISK_POOL_PATH or
+                    pool_name == 'm2-t5-cp1011-r2-run'):
+                pool_matches.append(pool)
+        except Exception as exc:
+            raise InvocationError('storage-pool XML could not be checked for run-pool identity') from exc
+    if len(pool_matches) != 1 or not bool(pool_matches[0].isActive()):
+        raise InvocationError('fixed T5 run-disk pool is absent, ambiguous, or inactive')
+    pool = pool_matches[0]
+    try:
+        pool_xml = ET.fromstring(pool.XMLDesc(0))
+        pool_name = pool.name()
+        pool_type = pool_xml.get('type')
+        target_path = pool_xml.findtext('target/path')
+        permissions = pool_xml.find('target/permissions')
+        children = list(permissions) if permissions is not None else []
+        permission_values = {
+            node.tag: (node.text or '').strip() for node in children
+            if not list(node) and not node.attrib
+        }
+        persistent = bool(pool.isPersistent())
+    except Exception as exc:
+        raise InvocationError('fixed run-disk pool metadata cannot be verified') from exc
+    if (pool_name != 'm2-t5-cp1011-r2-run' or pool_type != 'dir'
+            or target_path != RUN_DISK_POOL_PATH or not persistent
+            or permissions is None or permissions.attrib
+            or [node.tag for node in children] != ['mode', 'owner', 'group']
+            or permission_values != {'mode': '0700', 'owner': '958', 'group': '958'}):
+        raise InvocationError('run-disk pool name/type/target/permissions differ from fixed policy')
+    name = pathlib.Path(path).name
+    volume_root = ET.Element('volume')
+    ET.SubElement(volume_root, 'name').text = name
+    ET.SubElement(volume_root, 'capacity', {'unit': 'bytes'}).text = str(capacity)
+    target = ET.SubElement(volume_root, 'target')
+    ET.SubElement(target, 'format', {'type': 'qcow2'})
+    backing = ET.SubElement(volume_root, 'backingStore')
+    ET.SubElement(backing, 'path').text = base_path
+    ET.SubElement(backing, 'format', {'type': 'qcow2'})
+    volume_xml = ET.tostring(volume_root, encoding='unicode')
+    try:
+        volume = pool.createXML(volume_xml, 0)
+    except Exception as exc:
+        raise InvocationError('libvirt refused the exact tag-specific run overlay') from exc
+    overlay_row = _disk_volume_metadata(volume, path, base_path, 'created run overlay')
+    try:
+        overlay_stat = os.lstat(path)
+    except OSError as exc:
+        raise InvocationError('created run overlay path is not available for identity checks') from exc
+    if (not stat.S_ISREG(overlay_stat.st_mode) or stat.S_ISLNK(overlay_stat.st_mode)
+            or (overlay_stat.st_uid, overlay_stat.st_gid, stat.S_IMODE(overlay_stat.st_mode))
+            != (run_binding.RUN_UID, run_binding.RUN_GID, 0o600)
+            or overlay_stat.st_nlink != 1):
+        raise InvocationError('created run overlay owner/mode/link identity differs')
+    try:
+        base_stat = os.lstat(base_path)
+    except OSError as exc:
+        raise InvocationError('pinned base disk path cannot be statted') from exc
+    if not stat.S_ISREG(base_stat.st_mode) or stat.S_ISLNK(base_stat.st_mode):
+        raise InvocationError('pinned base disk is not a regular non-symlink file')
+    before_state = str(int(base_stat.st_mtime)) + ' ' + str(base_stat.st_size)
+    return {'Path': path, 'BasePath': base_path, 'BaseVolume': base,
+            'BaseMetadata': base_row, 'BaseCapacity': capacity,
+            'OverlayVolume': volume, 'OverlayMetadata': overlay_row,
+            'BaseStat': before_state, 'Pool': pool}
+
