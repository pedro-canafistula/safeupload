+#!/usr/bin/env python3
+"""Read-only libvirt inventory of the pinned T5 EFI and swtpm state files.
+
+The helper creates only transient directory-pool objects with flags=0, refreshes
+their file lists, and reads source file bytes through libvirt storage streams. It
+never defines a persistent pool or creates, uploads, deletes, or changes a source
+volume. The pool backend does not expose non-regular directory entries, so its
+file inventory is explicitly not treated as a complete directory-tree proof.
+"""
+import argparse
+import datetime
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+import uuid
+import xml.etree.ElementTree as ET
+
+
+DOMAIN = 'win10-debug3'
+DOMAIN_UUID = 'ffcb9530-146b-43b1-8af7-2b5cc8ede2e3'
+LIBVIRT_URI = 'qemu:///system'
+LIBVIRT_VERSION = 12007000
+QEMU_DRIVER = '/usr/lib/libvirt/connection-driver/libvirt_driver_qemu.so'
+QEMU_DRIVER_SHA256 = '767cd5f1034c163939a430872c5d0923faaea42d3de7b8c35f4a364212da98f9'
+LIBVIRT_SO = '/usr/lib/libvirt.so.0'
+LIBVIRT_SO_SHA256 = '3147a0c46dfa2e2f9874d6099e4afc1cef0949ee31ae9b8b7a2b065da0ece3d7'
+LOCALSTATEDIR = '/var'
+NVRAM_DIRECTORY = '/var/lib/libvirt/qemu/nvram'
+NVRAM_PATH = NVRAM_DIRECTORY + '/win10-debug3_VARS.fd'
+SWTPM_ROOT = '/var/lib/libvirt/swtpm'
+TPM_STATE_DIRECTORY = SWTPM_ROOT + '/' + DOMAIN_UUID + '/tpm2'
+TPM_LOCK_BASENAME = '.lock'
+TPM_LOCK_MODE = '0640'
+# swtpm v0.10.1 uses this exact hidden file as an advisory state-directory
+# lock: SWTPM_NVRAM_Lock_Dir opens <state-dir>/.lock with O_WRONLY|O_CREAT|
+# O_TRUNC|O_NOFOLLOW and mode 0660, then applies fcntl(F_SETLK); it writes no
+# payload. The local pinned volume observation reports the effective 0640
+# owner/group 972:972 file as zero capacity/allocation. Primary source:
+# https://github.com/stefanberger/swtpm/blob/v0.10.1/src/swtpm/swtpm_nvstore_dir.c#L97-L156
+SWTPM_LOCK_SOURCE_VERSION = '0.10.1'
+SWTPM_LOCK_SOURCE_URL = ('https://github.com/stefanberger/swtpm/blob/v0.10.1/'
+                         'src/swtpm/swtpm_nvstore_dir.c#L97-L156')
+HOST_SCOPE_METADATA_RECEIPT = 'driver/evidence/2026-10-11/m2-t5-host-scope-state-metadata-root.json'
+HOST_SCOPE_METADATA_RECEIPT_SHA256 = '2457e45776c484185ed8d34e780f1c822f4b491a9800c80f4534e27a93b40e81'
+HOST_SCOPE_EXECUTION_SCOPE = 'escalated host process; compare sandbox UID/GID mappings separately'
+HOST_USER_UID = 1000
+HOST_USER_GROUPS = (959, 990, 998, 1000)
+NVRAM_UID_GID = (958, 958)
+TPM_UID_GID = (972, 972)
+SOURCE_PRINCIPALS = {'nvram': NVRAM_UID_GID, 'tpm': TPM_UID_GID}
+
+
+class InventoryError(RuntimeError):
+    pass
+
+
+_PRESERVE = None
+
+
+def _preserve_module():
+    global _PRESERVE
+    if _PRESERVE is not None:
+        return _PRESERVE
+    path = Path(__file__).with_name('Preserve-T5Run.py')
+    spec = importlib.util.spec_from_file_location('t5_preserve_inventory_dependency', path)
+    if spec is None or spec.loader is None:
+        raise InventoryError('Could not load the pinned T5 preservation helper')
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    _PRESERVE = module
+    return _PRESERVE
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def parse_json_unique(path):
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise InventoryError('Duplicate JSON key in ' + str(path) + ': ' + key)
+            result[key] = value
+        return result
+    try:
+        return json.loads(Path(path).read_text(encoding='utf-8'), object_pairs_hook=unique)
+    except InventoryError:
+        raise
+    except Exception as exc:
+        raise InventoryError('Could not parse pinned metadata receipt ' + str(path) + ': ' + str(exc)) from exc
+
+
+def _lstat(path):
+    try:
+        row = os.lstat(path)
+    except Exception as exc:
+        raise InventoryError('Could not lstat exact pinned source path ' + path + ': ' + str(exc)) from exc
+    if stat.S_ISLNK(row.st_mode):
+        raise InventoryError('Pinned writable-state source path is a symlink: ' + path)
+    return row
+
+
+def object_metadata(path, expect_directory):
+    row = _lstat(path)
+    if expect_directory and not stat.S_ISDIR(row.st_mode):
+        raise InventoryError('Pinned writable-state path is not a directory: ' + path)
+    if not expect_directory and not stat.S_ISREG(row.st_mode):
+        raise InventoryError('Pinned NVRAM path is not a regular file: ' + path)
+    try:
+        names = sorted(os.listxattr(path, follow_symlinks=False))
+        xattrs = {}
+        for name in names:
+            value = os.getxattr(path, name, follow_symlinks=False)
+            xattrs[name] = hashlib.sha256(value).hexdigest()
+    except Exception as exc:
+        raise InventoryError('Could not completely inspect xattrs for ' + path + ': ' + str(exc)) from exc
+    return {
+        'Path': path, 'Kind': 'directory' if expect_directory else 'regular-file',
+        'Device': row.st_dev, 'Inode': row.st_ino, 'Links': row.st_nlink,
+        'UID': row.st_uid, 'GID': row.st_gid, 'Mode': format(stat.S_IMODE(row.st_mode), '04o'),
+        'Bytes': row.st_size, 'MtimeNs': row.st_mtime_ns, 'CtimeNs': row.st_ctime_ns,
+        'Xattrs': xattrs, 'XattrReadComplete': True,
+    }
+
+
+def require_exact_metadata(observed, expected, label):
+    fields = ('Path', 'Kind', 'Device', 'Inode', 'Links', 'UID', 'GID', 'Mode', 'Bytes',
+              'MtimeNs', 'CtimeNs', 'Xattrs', 'XattrReadComplete')
+    if not isinstance(expected, dict) or any(
+            observed.get(key) != expected[key] for key in fields if key in expected):
+        raise InventoryError(label + ' metadata differs from its read-only pinned receipt')
+
+
+def _verify_source_path_formula(root):
+    if root != SWTPM_ROOT or not root.startswith(LOCALSTATEDIR + '/'):
+        raise InventoryError('TPM source path does not follow the pinned LOCALSTATEDIR formula')
+    if (Path(TPM_STATE_DIRECTORY).parent.name != DOMAIN_UUID
+            or Path(TPM_STATE_DIRECTORY).name != 'tpm2'):
+        raise InventoryError('TPM source path UUID/tpm2 suffix differs from the selected domain')
+
+
+def _verify_runtime_version(libvirt, conn):
+    try:
+        python_version = int(libvirt.getVersion())
+        daemon_version = int(conn.getLibVersion())
+    except Exception as exc:
+        raise InventoryError('Could not verify Python/libvirt-daemon versions: ' + str(exc)) from exc
+    if python_version != LIBVIRT_VERSION or daemon_version != LIBVIRT_VERSION:
+        raise InventoryError('Installed libvirt runtime version is not the pinned 12.7.0 build')
+    for path, expected in ((QEMU_DRIVER, QEMU_DRIVER_SHA256), (LIBVIRT_SO, LIBVIRT_SO_SHA256)):
+        try:
+            actual = sha256_file(path)
+        except Exception as exc:
+            raise InventoryError('Could not hash pinned libvirt binary ' + path + ': ' + str(exc)) from exc
+        if actual != expected:
+            raise InventoryError('Installed libvirt binary differs from the inspected 12.7.0 build: ' + path)
+    return {'PythonLibvirtVersion': python_version, 'DaemonLibvirtVersion': daemon_version,
+            'QemuDriverPath': QEMU_DRIVER, 'QemuDriverSHA256': QEMU_DRIVER_SHA256,
+            'LibvirtLibraryPath': LIBVIRT_SO, 'LibvirtLibrarySHA256': LIBVIRT_SO_SHA256,
+            'CompiledLocalStateDirectory': LOCALSTATEDIR,
+            'TPMDefaultPathFormula': '%s/lib/libvirt/swtpm/<domain UUID>/tpm2'}
+
+
+def _pool_name(tag, kind):
+    return 't5-inventory-' + tag + '-' + kind
+
+
+def _pool_names(conn):
+    try:
+        return [str(pool.name()) for pool in conn.listAllStoragePools(0)]
+    except Exception as exc:
+        raise InventoryError('Could not inspect active/inactive pool names before transient inventory: ' + str(exc)) from exc
+
+
+def _verify_directory_pool(pool, expected_name, expected_path):
+    try:
+        if pool.name() != expected_name or int(pool.isPersistent()) != 0 or int(pool.isActive()) != 1:
+            raise InventoryError('Created inventory pool is not the exact active transient pool')
+        parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True, insert_pis=True))
+        root = ET.fromstring(pool.XMLDesc(0), parser=parser)
+        if root.tag != 'pool' or root.attrib != {'type': 'dir'}:
+            raise InventoryError('Transient inventory pool XML differs from exact directory-only target')
+        direct_names = [child.tag for child in list(root)]
+        allowed_names = {'name', 'uuid', 'capacity', 'allocation', 'available', 'source', 'target'}
+        if any(name not in allowed_names for name in direct_names):
+            raise InventoryError('Transient inventory pool XML contains an unknown top-level element')
+        if any(direct_names.count(name) != 1 for name in ('name', 'uuid', 'capacity', 'allocation',
+                                                           'available', 'target')):
+            raise InventoryError('Transient inventory pool XML has missing or duplicate identity/target fields')
+        if direct_names.count('source') > 1:
+            raise InventoryError('Transient inventory pool XML has duplicate source elements')
+        name_node = root.find('./name')
+        uuid_node = root.find('./uuid')
+        if (name_node.attrib or list(name_node) or (name_node.text or '').strip() != expected_name):
+            raise InventoryError('Transient inventory pool XML name differs from the exact requested name')
+        try:
+            pool_uuid = str(pool.UUIDString())
+            canonical_uuid = str(uuid.UUID(pool_uuid))
+        except Exception as exc:
+            raise InventoryError('Transient inventory pool did not return a valid UUID: ' + str(exc)) from exc
+        if (pool_uuid != canonical_uuid or uuid_node.attrib or list(uuid_node)
+                or (uuid_node.text or '').strip() != pool_uuid):
+            raise InventoryError('Transient inventory pool XML UUID differs from its exact API identity')
+        for field in ('capacity', 'allocation', 'available'):
+            node = root.find('./' + field)
+            if (node.attrib != {'unit': 'bytes'} or list(node)
+                    or not re.fullmatch(r'[0-9]+', (node.text or '').strip())):
+                raise InventoryError('Transient inventory pool XML has malformed ' + field + ' metadata')
+        sources = root.findall('./source')
+        if sources:
+            source = sources[0]
+            if source.attrib or list(source) or (source.text or '').strip():
+                raise InventoryError('Transient inventory pool XML source element is not empty')
+        if len(root.findall('.//source')) != len(sources):
+            raise InventoryError('Transient inventory pool XML contains a nested source element')
+        targets = root.findall('./target')
+        target = targets[0]
+        if target.attrib:
+            raise InventoryError('Transient inventory pool XML target has unexpected attributes')
+        target_children = list(target)
+        paths = [child for child in target_children if child.tag == 'path']
+        permissions = [child for child in target_children if child.tag == 'permissions']
+        if (len(paths) != 1 or len(permissions) != 1 or len(target_children) != 2
+                or paths[0].attrib or list(paths[0])
+                or (paths[0].text or '').strip() != expected_path):
+            raise InventoryError('Transient inventory pool XML target differs from the exact requested path')
+        permission = permissions[0]
+        permission_children = list(permission)
+        if (permission.attrib or [child.tag for child in permission_children] != ['mode', 'owner', 'group']
+                or any(child.attrib or list(child) for child in permission_children)):
+            raise InventoryError('Transient inventory pool XML target permissions have an unexpected shape')
+        mode, owner, group = [(child.text or '').strip() for child in permission_children]
+        if (not re.fullmatch(r'0[0-7]{3}', mode) or not re.fullmatch(r'[0-9]+', owner)
+                or not re.fullmatch(r'[0-9]+', group)):
+            raise InventoryError('Transient inventory pool XML target permissions are malformed')
+    except InventoryError:
+        raise
+    except Exception as exc:
+        raise InventoryError('Could not validate transient inventory pool: ' + str(exc)) from exc
+
+
+def _destroy_transient_pool(conn, pool, name):
+    failures = []
+    try:
+        if pool is not None and int(pool.isActive()) == 1:
+            # Installed libvirt-python 12.7.0 exposes virStoragePool.destroy(self)
+            # with no flags argument; see the offline binding ABI self-check.
+            result = pool.destroy()
+            if result not in (None, 0):
+                failures.append('destroy returned ' + repr(result))
+    except Exception as exc:
+        failures.append('destroy failed: ' + str(exc))
+    try:
+        if name in _pool_names(conn):
+            failures.append('transient pool remains registered after destroy')
+    except Exception as exc:
+        failures.append('could not verify pool absence: ' + str(exc))
+    if failures:
+        raise InventoryError('Could not prove transient source inventory pool cleanup: ' + '; '.join(failures))
+
+
+def _parse_tpm_lock_xml(xml_text, expected_path, expected_uid_gid):
+    """Validate the single swtpm advisory lockfile without relaxing state parsers."""
+    try:
+        parser = ET.XMLParser(target=ET.TreeBuilder(insert_comments=True, insert_pis=True))
+        root = ET.fromstring(xml_text, parser=parser)
+    except Exception as exc:
+        raise InventoryError('Malformed swtpm .lock volume XML: ' + str(exc)) from exc
+    if root.tag != 'volume' or root.attrib != {'type': 'file'}:
+        raise InventoryError('swtpm .lock volume is not an exact FILE volume')
+    if [child.tag for child in list(root)] != ['name', 'key', 'capacity', 'allocation', 'target']:
+        raise InventoryError('swtpm .lock volume XML has unexpected top-level fields')
+
+    def child_text(parent, tag, label, attributes=None):
+        nodes = [node for node in list(parent) if node.tag == tag]
+        if (len(nodes) != 1 or nodes[0].attrib != (attributes or {}) or list(nodes[0])):
+            raise InventoryError('swtpm .lock XML has malformed ' + label)
+        return (nodes[0].text or '').strip()
+
+    name = child_text(root, 'name', 'name')
+    key = child_text(root, 'key', 'key')
+    capacity_text = child_text(root, 'capacity', 'capacity', {'unit': 'bytes'})
+    allocation_text = child_text(root, 'allocation', 'allocation', {'unit': 'bytes'})
+    if name != TPM_LOCK_BASENAME or key != expected_path:
+        raise InventoryError('swtpm .lock XML name/key does not identify the exact pinned state path')
+    if not re.fullmatch(r'[0-9]+', capacity_text) or not re.fullmatch(r'[0-9]+', allocation_text):
+        raise InventoryError('swtpm .lock XML has malformed size metadata')
+    capacity = int(capacity_text)
+    allocation = int(allocation_text)
+    if capacity != 0 or allocation != 0:
+        raise InventoryError('swtpm .lock XML is not the expected zero-capacity, zero-allocation lockfile')
+
+    target = [node for node in list(root) if node.tag == 'target'][0]
+    target_children = list(target)
+    if (target.attrib or [child.tag for child in target_children]
+            != ['path', 'format', 'permissions', 'timestamps']):
+        raise InventoryError('swtpm .lock XML target has an unexpected shape')
+    path_node, format_node, permissions_node, timestamps_node = target_children
+    if (path_node.attrib or list(path_node) or (path_node.text or '').strip() != expected_path
+            or format_node.attrib != {'type': 'raw'} or list(format_node)
+            or (format_node.text or '').strip()):
+        raise InventoryError('swtpm .lock XML path/format differs from the exact raw file target')
+    if permissions_node.attrib or [node.tag for node in list(permissions_node)] != ['mode', 'owner', 'group']:
+        raise InventoryError('swtpm .lock XML permissions have an unexpected shape')
+    mode, owner, group = [child_text(permissions_node, tag, 'permissions/' + tag)
+                          for tag in ('mode', 'owner', 'group')]
+    if (mode != TPM_LOCK_MODE or owner != str(expected_uid_gid[0])
+            or group != str(expected_uid_gid[1])):
+        raise InventoryError('swtpm .lock XML permissions differ from the pinned 0640 source identity')
+    if (timestamps_node.attrib or [node.tag for node in list(timestamps_node)]
+            != ['atime', 'mtime', 'ctime', 'btime']):
+        raise InventoryError('swtpm .lock XML timestamps have an unexpected shape')
+    timestamps = {}
+    for node in list(timestamps_node):
+        if node.attrib or list(node) or not re.fullmatch(r'[0-9]+(?:\.[0-9]+)?', (node.text or '').strip()):
+            raise InventoryError('swtpm .lock XML contains malformed timestamp metadata')
+        timestamps[node.tag] = (node.text or '').strip()
+    return {'name': name, 'key': key, 'path': expected_path, 'capacity': capacity,
+            'allocation': allocation, 'physical': None, 'format': 'raw', 'mode': mode,
+            'owner': owner, 'group': group, 'timestamps': timestamps}
+
+
+def _tpm_lock_storage_info(volume):
+    try:
+        raw = volume.info()
+        if not isinstance(raw, (list, tuple)) or len(raw) != 3:
+            raise ValueError('expected standard (type, capacity, allocation) triple')
+        if any(type(value) is not int for value in raw):
+            raise ValueError('storage info fields are not exact integers')
+        values = tuple(raw)
+    except Exception as exc:
+        raise InventoryError('Could not read exact swtpm .lock StorageVol.info(): ' + str(exc)) from exc
+    if values != (0, 0, 0):
+        raise InventoryError('swtpm .lock StorageVol.info() is not exact FILE/zero/zero metadata: '
+                             + repr(values))
+    return values
+
+
+def _hash_tpm_empty_lock(conn, volume, before_details, before_info):
+    digest = hashlib.sha256()
+    received = [0]
+    stream = None
+    finished = False
+
+    def receive(_stream, data, _opaque):
+        if not isinstance(data, (bytes, bytearray, memoryview)):
+            raise InventoryError('swtpm .lock storage stream returned non-byte data')
+        digest.update(data)
+        received[0] += len(data)
+        return len(data)
+
+    try:
+        stream = conn.newStream(0)
+        volume.download(stream, 0, 0, 0)
+        stream.recvAll(receive, None)
+        stream.finish()
+        finished = True
+    except Exception as exc:
+        raise InventoryError('Could not read swtpm .lock through a full read-only storage stream: '
+                             + str(exc)) from exc
+    finally:
+        if not finished and stream is not None:
+            try:
+                stream.abort()
+            except Exception:
+                pass
+    try:
+        after_xml = volume.XMLDesc(0)
+        after_details = _parse_tpm_lock_xml(after_xml, before_details['path'], TPM_UID_GID)
+        after_info = _tpm_lock_storage_info(volume)
+    except Exception as exc:
+        raise InventoryError('Could not revalidate swtpm .lock metadata after its stream: '
+                             + str(exc)) from exc
+    before_compare = dict(before_details)
+    after_compare = dict(after_details)
+    before_timestamps = dict(before_compare.pop('timestamps'))
+    after_timestamps = dict(after_compare.pop('timestamps'))
+    before_timestamps.pop('atime', None)
+    after_timestamps.pop('atime', None)
+    if (before_compare != after_compare or before_timestamps != after_timestamps
+            or after_info != before_info):
+        raise InventoryError('swtpm .lock metadata changed during its exact empty-file stream')
+    if received[0] != 0:
+        raise InventoryError('swtpm .lock has nonempty stream bytes despite zero-size metadata: '
+                             + str(received[0]))
+    return {'sha256': digest.hexdigest(), 'bytes': 0, 'virtual_capacity': 0,
+            'allocation': 0, 'physical_bytes': 0}
+
+
+def _read_pool_files(conn, pool, expected_target, expected_uid_gid, selected_path=None):
+    preserve = _preserve_module()
+    try:
+        pool.refresh(0)
+        volumes = pool.listAllVolumes(0)
+    except Exception as exc:
+        raise InventoryError('Read-only libvirt directory-pool refresh/list failed: ' + str(exc)) from exc
+    records = []
+    seen_names = set()
+    seen_paths = set()
+    selected = []
+    selected_name = Path(selected_path).name if selected_path is not None else None
+    named_volumes = []
+    for volume in volumes:
+        try:
+            named_volumes.append((volume, str(volume.name())))
+        except Exception as exc:
+            raise InventoryError('Could not inspect libvirt directory-pool volume name: ' + str(exc)) from exc
+    if expected_target == TPM_STATE_DIRECTORY:
+        lock_count = sum(name == TPM_LOCK_BASENAME for _volume, name in named_volumes)
+        if lock_count != 1:
+            raise InventoryError('Pinned TPM directory name listing must contain exactly one swtpm .lock '
+                                 'volume before any volume metadata or bytes are read; found '
+                                 + str(lock_count))
+    if selected_path is not None:
+        selected_volumes = [(volume, name) for volume, name in named_volumes if name == selected_name]
+        if len(selected_volumes) != 1:
+            raise InventoryError('Pinned NVRAM basename did not appear exactly once in the pool name listing')
+        volumes_to_read = selected_volumes
+    else:
+        volumes_to_read = named_volumes
+    # A directory pool exposes every sibling name. For NVRAM, the name listing
+    # above selects the pinned basename; only that volume proceeds to XML/info
+    # inspection and the data stream.
+    for volume, name in volumes_to_read:
+        is_tpm_lock = name == TPM_LOCK_BASENAME
+        if is_tpm_lock:
+            if (expected_target != TPM_STATE_DIRECTORY or expected_uid_gid != TPM_UID_GID
+                    or (selected_path is not None and selected_path != str(Path(expected_target) / TPM_LOCK_BASENAME))):
+                raise InventoryError('Hidden .lock basename is permitted only at the exact pinned swtpm TPM path')
+        elif not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,254}', name) or name in ('.', '..'):
+            raise InventoryError('Libvirt directory-pool volume has an unsafe or unrecognized basename')
+        expected_path = str(Path(expected_target) / name)
+        try:
+            xml_text = volume.XMLDesc(0)
+        except Exception as exc:
+            raise InventoryError('Could not read exact libvirt volume metadata: ' + str(exc)) from exc
+        if is_tpm_lock:
+            details = _parse_tpm_lock_xml(xml_text, expected_path, expected_uid_gid)
+            info_values = _tpm_lock_storage_info(volume)
+            info = {'type': info_values[0], 'capacity': info_values[1], 'allocation': info_values[2]}
+            if (details['name'] != name or details['path'] != expected_path
+                    or details['format'] != 'raw' or details['capacity'] != 0
+                    or details['allocation'] != 0 or details['physical'] is not None
+                    or info['type'] != 0 or info['capacity'] != 0 or info['allocation'] != 0):
+                raise InventoryError('swtpm .lock metadata differs from the exact zero-size FILE lock role')
+        else:
+            try:
+                details = preserve.parse_volume_xml(xml_text, 'writable-state source')
+            except Exception as parse_exc:
+                try:
+                    raw_info = volume.info()
+                    info_diagnostic = {'Available': True, 'PythonType': type(raw_info).__name__,
+                                       'Repr': repr(raw_info)}
+                except Exception as info_exc:
+                    info_diagnostic = {'Available': False, 'ErrorType': type(info_exc).__name__,
+                                       'Error': str(info_exc)}
+                diagnostic = {
+                    'Schema': 'T5SelectedVolumeXMLInfoParseFailureV1',
+                    'VolumeName': name,
+                    'TargetDirectory': expected_target,
+                    'SelectedPath': selected_path,
+                    'RawVolumeXML': xml_text,
+                    'RawStorageVolumeInfo': info_diagnostic,
+                    'XMLParseError': {'Type': type(parse_exc).__name__, 'Message': str(parse_exc)},
+                }
+                encoded_diagnostic = json.dumps(diagnostic, sort_keys=True, ensure_ascii=True,
+                                                separators=(',', ':'))
+                raise InventoryError('T5_SELECTED_VOLUME_XML_INFO_DIAGNOSTIC=' + encoded_diagnostic) from parse_exc
+            try:
+                info = preserve.storage_volume_info(volume, 'writable-state source')
+            except Exception as exc:
+                raise InventoryError('Could not read exact libvirt volume metadata: ' + str(exc)) from exc
+        if (details['name'] != name or details['path'] != expected_path
+                or details['format'] != 'raw' or info['type'] != 0
+                or details['owner'] != str(expected_uid_gid[0])
+                or details['group'] != str(expected_uid_gid[1])):
+            raise InventoryError('Storage API file metadata is outside the pinned regular '
+                                 + str(expected_uid_gid[0]) + ':' + str(expected_uid_gid[1])
+                                 + ' source path/format/type/owner shape: ' + repr(details))
+        if not is_tpm_lock and (details['capacity'] != info['capacity']
+                                or details['physical'] != info['capacity']
+                                or details['allocation'] != info['allocation']
+                                or details['mode'] != '0600'):
+            raise InventoryError('Storage API file metadata is outside the pinned regular '
+                                 + str(expected_uid_gid[0]) + ':' + str(expected_uid_gid[1])
+                                 + ' 0600 state shape: '
+                                 + repr(details))
+        if name in seen_names or details['path'] in seen_paths:
+            raise InventoryError('Libvirt storage inventory contains duplicate source names/paths')
+        seen_names.add(name)
+        seen_paths.add(details['path'])
+        before_xml = xml_text
+        if is_tpm_lock:
+            digest = _hash_tpm_empty_lock(conn, volume, details, info_values)
+            physical_bytes = 0
+        else:
+            digest = preserve.volume_sha256(conn, volume)
+            after_xml = volume.XMLDesc(0)
+            if before_xml != after_xml:
+                raise InventoryError('Source volume XML changed during read-only stream hashing: ' + name)
+            physical_bytes = details['physical']
+        record = {'Name': name, 'Path': details['path'], 'Format': details['format'],
+                  'VolumeType': info['type'], 'CapacityBytes': info['capacity'],
+                  'PhysicalBytes': physical_bytes, 'AllocationBytes': info['allocation'],
+                  'OwnerUID': expected_uid_gid[0], 'GroupGID': expected_uid_gid[1],
+                  'Mode': details['mode'],
+                  'SHA256': digest['sha256'], 'StreamBytes': digest['bytes'],
+                  'VolumeXMLSHA256': hashlib.sha256(xml_text.encode('utf-8')).hexdigest()}
+        if is_tpm_lock:
+            record.update({
+                'Role': 'SWTPM_DIRECTORY_ADVISORY_LOCKFILE_NOT_TPM_STATE_BLOB',
+                'EmptyPayloadVerifiedByFullStorageStream': True,
+                'SwtpmSourceVersion': SWTPM_LOCK_SOURCE_VERSION,
+                'SwtpmSourceURL': SWTPM_LOCK_SOURCE_URL,
+                'SwtpmSourceOpenMode': '0660',
+            })
+        records.append(record)
+        if selected_path is not None and details['path'] == selected_path:
+            selected.append(record)
+    records.sort(key=lambda row: row['Name'])
+    if selected_path is not None and len(selected) != 1:
+        raise InventoryError('Pinned NVRAM file did not appear exactly once in its transient pool inventory')
+    if selected_path is not None and (len(records) != 1 or records[0]['Path'] != selected_path):
+        raise InventoryError('NVRAM pool result contains anything other than the exact pinned file')
+    return {'Files': records, 'Selected': selected[0] if selected else None,
+            'RegularVolumesEnumerated': True,
+            'SelectedVolumeOnly': selected_path is not None,
+            'SiblingNamesEnumerated': selected_path is not None,
+            'DirectoryEntriesComplete': False,
+            'DirectoryEntryLimitation': (
+                ('The libvirt v12.7.0 directory-pool API enumerates regular-file sibling names to locate the '
+                 'selected NVRAM basename; only the exact selected volume XML/info/bytes are read or reported. '
+                 'The API does not expose skipped non-regular entries or recursively enumerate nested directories.')
+                if selected_path is not None else
+                ('The libvirt v12.7.0 directory-pool API reports regular file volumes; the API does not expose '
+                 'skipped non-regular entries or recursively enumerate nested directories.'))}
+
+
+def inspect_directory(conn, tag, kind, target, selected_path=None):
+    if kind not in SOURCE_PRINCIPALS:
+        raise InventoryError('Unknown writable-state source kind')
+    expected_uid_gid = SOURCE_PRINCIPALS[kind]
+    name = _pool_name(tag, kind)
+    if name in _pool_names(conn):
+        raise InventoryError('Transient inventory pool name already exists: ' + name)
+    xml = ("<pool type='dir'><name>%s</name><target><path>%s</path></target></pool>" %
+           (name, target))
+    pool = None
+    try:
+        try:
+            pool = conn.storagePoolCreateXML(xml, 0)
+        except Exception as exc:
+            raise InventoryError('Could not create the exact transient read-only inventory pool: ' + str(exc)) from exc
+        _verify_directory_pool(pool, name, target)
+        inventory = _read_pool_files(conn, pool, target, expected_uid_gid, selected_path)
+        result = {'PoolName': name, 'PoolPath': target, 'PersistentPool': False,
+                  'PoolDestroyVerified': True, **inventory}
+    except BaseException as primary:
+        try:
+            _destroy_transient_pool(conn, pool, name)
+        except BaseException as cleanup:
+            details = ('Primary failure: ' + type(primary).__name__ + ': ' + str(primary)
+                       + '; cleanup failure: ' + type(cleanup).__name__ + ': ' + str(cleanup))
+            if isinstance(primary, Exception):
+                raise InventoryError(details) from primary
+            if hasattr(primary, 'add_note'):
+                primary.add_note(details)
+        raise
+    else:
+        _destroy_transient_pool(conn, pool, name)
+        return result
+
+
+def validate_pinned_paths(repo_root):
+    preserve = _preserve_module()
+    root = Path(repo_root).resolve(strict=True)
+    baseline, _preflight = preserve.load_pinned_receipts(root)
+    if sha256_file(root / HOST_SCOPE_METADATA_RECEIPT) != HOST_SCOPE_METADATA_RECEIPT_SHA256:
+        raise InventoryError('Pinned host-scope writable-state metadata receipt hash changed')
+    host_scope = parse_json_unique(root / HOST_SCOPE_METADATA_RECEIPT)
+    if (host_scope.get('ExecutionScope') != HOST_SCOPE_EXECUTION_SCOPE
+            or host_scope.get('ReadOnlyMetadata') is not True
+            or host_scope.get('CurrentUID') != HOST_USER_UID
+            or tuple(sorted(row.get('GID') for row in host_scope.get('CurrentGroups', [])))
+            != HOST_USER_GROUPS):
+        raise InventoryError('Host-scope metadata receipt is not the exact pinned un-mapped user scope')
+    if (os.geteuid() != HOST_USER_UID
+            or tuple(sorted(os.getgroups())) != HOST_USER_GROUPS):
+        raise InventoryError('Inventory CLI is not running in the pinned host UID/GID namespace')
+    nvram_path = baseline['InactiveXML']
+    try:
+        domain = ET.fromstring(nvram_path)
+    except Exception as exc:
+        raise InventoryError('Pinned baseline domain XML is malformed: ' + str(exc)) from exc
+    nvram_nodes = domain.findall('./os/nvram')
+    tpm_nodes = domain.findall('./devices/tpm')
+    if (len(nvram_nodes) != 1 or (nvram_nodes[0].text or '').strip() != NVRAM_PATH
+            or len(tpm_nodes) != 1 or tpm_nodes[0].get('model') != 'tpm-crb'):
+        raise InventoryError('Pinned domain XML no longer has the exact selected NVRAM and TPM devices')
+    backends = tpm_nodes[0].findall('./backend')
+    if (len(backends) != 1 or backends[0].get('type') != 'emulator'
+            or backends[0].get('version') != '2.0' or backends[0].find('source') is not None):
+        raise InventoryError('Pinned TPM backend is not the expected implicit emulator TPM 2.0 backend')
+    _verify_source_path_formula(SWTPM_ROOT)
+    host_rows = host_scope.get('Rows')
+    expected_rows = {
+        NVRAM_PATH: {'UID': 958, 'GID': 958, 'Mode': '0o600', 'Device': 31, 'Inode': 645571,
+                     'Links': 1, 'Bytes': 540672, 'MtimeNs': 1791667560911537125,
+                     'CtimeNs': 1791668147471778767, 'Directory': False, 'Socket': False},
+        SWTPM_ROOT: {'UID': 0, 'GID': 0, 'Mode': '0o711', 'Device': 31, 'Inode': 269115,
+                     'Links': 1, 'Bytes': 360, 'MtimeNs': 1791394301928302042,
+                     'CtimeNs': 1791394301928302042, 'Directory': True, 'Socket': False},
+        str(Path(SWTPM_ROOT) / DOMAIN_UUID): {'UID': 0, 'GID': 0, 'Mode': '0o711',
+                     'Device': 31, 'Inode': 645574, 'Links': 1, 'Bytes': 8,
+                     'MtimeNs': 1791394301928302042, 'CtimeNs': 1791394301928302042,
+                     'Directory': True, 'Socket': False},
+        TPM_STATE_DIRECTORY: {'UID': 972, 'GID': 972, 'Mode': '0o700', 'Device': 31,
+                     'Inode': 645575, 'Links': 1, 'Bytes': 40,
+                     'MtimeNs': 1791668147271925560, 'CtimeNs': 1791668147271925560,
+                     'Directory': True, 'Socket': False},
+        '/run/docker.sock': {'UID': 0, 'GID': 966, 'Mode': '0o660', 'Device': 26,
+                     'Inode': 3126, 'Links': 1, 'Bytes': 0,
+                     'MtimeNs': 1791651384804555492, 'CtimeNs': 1791651384811827913,
+                     'Directory': False, 'Socket': True},
+    }
+    if not isinstance(host_rows, list) or len(host_rows) != len(expected_rows):
+        raise InventoryError('Pinned host-scope metadata receipt has an incomplete object set')
+    rows_by_path = {}
+    for row in host_rows:
+        if not isinstance(row, dict) or row.get('Path') in rows_by_path:
+            raise InventoryError('Pinned host-scope metadata receipt contains malformed/duplicate paths')
+        rows_by_path[row.get('Path')] = row
+    if set(rows_by_path) != set(expected_rows):
+        raise InventoryError('Pinned host-scope metadata receipt path set changed')
+    for path, expected in expected_rows.items():
+        row = rows_by_path[path]
+        if (row.get('StatSucceeded') is not True or row.get('XattrReadComplete') is not True
+                or row.get('XattrHashes') != {} or row.get('CurrentUserReadWrite') is not False
+                or any(row.get(key) != value for key, value in expected.items())):
+            raise InventoryError('Pinned host-scope metadata row changed: ' + path)
+    expected_nvram = {
+        'Path': NVRAM_PATH, 'Kind': 'regular-file', 'Device': 31, 'Inode': 645571,
+        'Links': 1, 'UID': 958, 'GID': 958, 'Mode': '0600', 'Bytes': 540672,
+        'MtimeNs': 1791667560911537125, 'CtimeNs': 1791668147471778767,
+        'Xattrs': {}, 'XattrReadComplete': True,
+    }
+    expected_tpm = {
+        'Path': TPM_STATE_DIRECTORY, 'Kind': 'directory', 'Device': 31, 'Inode': 645575,
+        'Links': 1, 'UID': 972, 'GID': 972, 'Mode': '0700', 'Bytes': 40,
+        'MtimeNs': 1791668147271925560, 'CtimeNs': 1791668147271925560,
+        'Xattrs': {}, 'XattrReadComplete': True,
+    }
+    expected_tpm_root = {
+        'Path': SWTPM_ROOT, 'Kind': 'directory', 'Device': 31, 'Inode': 269115,
+        'Links': 1, 'UID': 0, 'GID': 0, 'Mode': '0711', 'Bytes': 360,
+        'MtimeNs': 1791394301928302042, 'CtimeNs': 1791394301928302042,
+        'Xattrs': {}, 'XattrReadComplete': True,
+    }
+    expected_tpm_domain = {
+        'Path': str(Path(SWTPM_ROOT) / DOMAIN_UUID), 'Kind': 'directory',
+        'Device': 31, 'Inode': 645574, 'Links': 1, 'UID': 0, 'GID': 0,
+        'Mode': '0711', 'Bytes': 8, 'MtimeNs': 1791394301928302042,
+        'CtimeNs': 1791394301928302042, 'Xattrs': {}, 'XattrReadComplete': True,
+    }
+    observed_nvram = object_metadata(NVRAM_PATH, False)
+    observed_tpm_root = object_metadata(SWTPM_ROOT, True)
+    observed_tpm_domain = object_metadata(str(Path(SWTPM_ROOT) / DOMAIN_UUID), True)
+    observed_tpm = object_metadata(TPM_STATE_DIRECTORY, True)
+    require_exact_metadata(observed_nvram, expected_nvram, 'Pinned NVRAM object')
+    require_exact_metadata(observed_tpm_root, expected_tpm_root, 'Pinned swtpm root directory')
+    require_exact_metadata(observed_tpm_domain, expected_tpm_domain, 'Pinned swtpm UUID directory')
+    require_exact_metadata(observed_tpm, expected_tpm, 'Pinned TPM state directory')
+    for path, parent in ((NVRAM_PATH, NVRAM_DIRECTORY), (TPM_STATE_DIRECTORY, SWTPM_ROOT)):
+        if os.path.realpath(path) != path or os.path.realpath(parent) != parent:
+            raise InventoryError('Pinned writable-state path resolves through a symlink or alias')
+    return {'BaselineXMLSHA256': hashlib.sha256(baseline['InactiveXML'].encode('utf-8')).hexdigest(),
+            'NVRAMPath': NVRAM_PATH, 'NVRAMMetadata': observed_nvram,
+            'TPMPath': TPM_STATE_DIRECTORY, 'TPMMetadata': observed_tpm,
+            'SwtpmRootMetadata': observed_tpm_root,
+            'SwtpmDomainMetadata': observed_tpm_domain,
+            'HostScopeMetadataReceiptSHA256': HOST_SCOPE_METADATA_RECEIPT_SHA256,
+            'NVRAMOwnerUIDGID': list(NVRAM_UID_GID), 'TPMOwnerUIDGID': list(TPM_UID_GID)}
+
+
+def _validate_domain_endpoint(preserve, snapshot, libvirt, baseline_xml, label):
+    if snapshot.get('state') != libvirt.VIR_DOMAIN_SHUTOFF or snapshot.get('active') is not False:
+        raise InventoryError(label + ' domain endpoint is not shut off and inactive')
+    try:
+        observed = preserve.xml_semantics(snapshot['inactive_xml'], label + ' inactive domain')
+        expected = preserve.xml_semantics(baseline_xml, 'pinned baseline domain')
+    except Exception as exc:
+        raise InventoryError(label + ' domain XML could not be validated: ' + str(exc)) from exc
+    if observed != expected:
+        raise InventoryError(label + ' inactive domain XML differs from the pinned baseline')
+    semantic_bytes = json.dumps(observed, ensure_ascii=False, separators=(',', ':')).encode('utf-8')
+    return {'State': int(snapshot['state']), 'StateName': snapshot.get('state_name', 'shutoff'),
+            'Reason': snapshot.get('reason'), 'Active': False,
+            'InactiveXMLSemanticSHA256': hashlib.sha256(semantic_bytes).hexdigest(),
+            'PinnedInactiveXMLSemanticsMatch': True}
+
+
+def _require_matching_domain_endpoints(before, after):
+    fields = ('State', 'Reason', 'Active', 'InactiveXMLSemanticSHA256')
+    if any(before.get(key) != after.get(key) for key in fields):
+        raise InventoryError('Selected domain state/reason/inactive XML changed between observation endpoints')
+
+
+def inventory(args):
+    preserve = _preserve_module()
+    if not re.fullmatch(r'[A-Za-z0-9]{3,30}', args.tag):
+        raise InventoryError('Invalid T5 writable-state inventory tag')
+    lock = preserve.require_lifecycle_lock(args)
+    state_dir = Path(args.state_dir).resolve(strict=True)
+    for path in (state_dir / DOMAIN, preserve.marker_path(state_dir), preserve.inprogress_path(state_dir)):
+        if path.exists() or path.is_symlink():
+            raise InventoryError('T5 writable-state inventory requires an idle domain with no run-state guard')
+    path_pins = validate_pinned_paths(args.repo_root)
+    libvirt, conn = preserve.open_connection()
+    try:
+        runtime = _verify_runtime_version(libvirt, conn)
+        baseline_xml = preserve.load_pinned_receipts(Path(args.repo_root).resolve())[0]['InactiveXML']
+        before_snapshot = preserve.domain_snapshot(conn, libvirt)
+        before_domain = _validate_domain_endpoint(preserve, before_snapshot, libvirt, baseline_xml,
+                                                  'Before-inventory')
+        fresh_metadata_before = {
+            'NVRAMMetadata': object_metadata(NVRAM_PATH, False),
+            'SwtpmRootMetadata': object_metadata(SWTPM_ROOT, True),
+            'SwtpmDomainMetadata': object_metadata(str(Path(SWTPM_ROOT) / DOMAIN_UUID), True),
+            'TPMMetadata': object_metadata(TPM_STATE_DIRECTORY, True),
+        }
+        for key in ('NVRAMMetadata', 'SwtpmRootMetadata', 'SwtpmDomainMetadata', 'TPMMetadata'):
+            if fresh_metadata_before[key] != path_pins.get(key):
+                raise InventoryError('Fresh pre-pool source metadata differs from the pinned observation: ' + key)
+        nvram_result = inspect_directory(conn, args.tag, 'nvram', NVRAM_DIRECTORY, NVRAM_PATH)
+        tpm_result = inspect_directory(conn, args.tag, 'tpm', TPM_STATE_DIRECTORY)
+        fresh_metadata_after = {
+            'NVRAMMetadata': object_metadata(NVRAM_PATH, False),
+            'SwtpmRootMetadata': object_metadata(SWTPM_ROOT, True),
+            'SwtpmDomainMetadata': object_metadata(str(Path(SWTPM_ROOT) / DOMAIN_UUID), True),
+            'TPMMetadata': object_metadata(TPM_STATE_DIRECTORY, True),
+        }
+        if fresh_metadata_before != fresh_metadata_after:
+            raise InventoryError('Pinned source object metadata changed during the read-only libvirt inventory')
+        if nvram_result['Selected']['SHA256'] is None or nvram_result['Selected']['StreamBytes'] != 540672:
+            raise InventoryError('Pinned NVRAM file stream did not match its exact stat size')
+        pool_absence = set(_pool_names(conn)).isdisjoint({nvram_result['PoolName'], tpm_result['PoolName']})
+        if not pool_absence:
+            raise InventoryError('A transient read-only source pool remains after inventory')
+        # This is an endpoint check only. The cooperating T5 lifecycle flock
+        # does not exclude arbitrary external libvirt clients, and cannot prove
+        # that a start/stop did not occur between snapshots.
+        after_snapshot = preserve.domain_snapshot(conn, libvirt)
+        after_domain = _validate_domain_endpoint(preserve, after_snapshot, libvirt, baseline_xml,
+                                                 'After-inventory')
+        _require_matching_domain_endpoints(before_domain, after_domain)
+        return {
+            'Schema': 'T5WritableStateInventoryV1', 'CapturedUTC': datetime.datetime.now(
+                datetime.timezone.utc).isoformat(),
+            'Status': 'PARTIAL_READONLY_OBSERVATION_NOT_ATOMIC',
+            'Domain': DOMAIN, 'UUID': DOMAIN_UUID, 'LifecycleLock': lock,
+            'LibvirtRuntime': runtime, 'PinnedSourceObjects': path_pins,
+            'DomainEndpointObservation': {'Before': before_domain, 'After': after_domain,
+                                          'EndpointsMatch': True},
+            'ConcurrentStartExclusionProven': False,
+            'StartStopBetweenEndpointsExcluded': False,
+            'AtomicSnapshotProven': False,
+            'SourceByteStabilityProven': False,
+            'NoHelperSourceMutations': True,
+            'SourceStorageMutations': [],
+            'TransientPoolsDestroyedAndAbsent': pool_absence,
+            'NVRAM': nvram_result,
+            'TPM': tpm_result,
+            'RunLocalIsolationAllowed': False,
+            'NoBootReason': ('This is only a partial read-only observation: directory-pool inventory omits '
+                             'non-regular and nested TPM entries, TPM member bytes have no per-member '
+                             'before/after consistency proof, and no exclusion of external domain start/stop '
+                             'between endpoint snapshots is established. It is not a consistent source snapshot '
+                             'or a complete state copy.'),
+            'VMStarted': False, 'RAMReadOrDumped': False,
+        }
+    finally:
+        conn.close()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--repo-root', default='.')
+    parser.add_argument('--state-dir', required=True)
+    parser.add_argument('--tag', required=True)
+    parser.add_argument('--lifecycle-lock-fd', type=int, required=True)
+    parser.add_argument('--owner-pid', type=int, default=os.getppid())
+    args = parser.parse_args(argv)
+    try:
+        record = inventory(args)
+        print(json.dumps(record, sort_keys=True, ensure_ascii=False))
+        return 10
+    except Exception as exc:
+        print(type(exc).__name__ + ': ' + str(exc), file=sys.stderr)
+        return 20
+
+
+if __name__ == '__main__':
+    sys.exit(main())
