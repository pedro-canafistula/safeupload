+#!/usr/bin/env python3
+"""Fail-closed T5 run-disk evidence preservation for win10-debug3.
+
+All disk inspection and hashing uses libvirt storage-volume metadata and streams.
+This helper never reads a qcow2 path directly and never removes a retained overlay.
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import stat
+import struct
+import subprocess
+import sys
+import xml.etree.ElementTree as ET
+
+
+DOMAIN = 'win10-debug3'
+DOMAIN_UUID = 'ffcb9530-146b-43b1-8af7-2b5cc8ede2e3'
+POOL_PATH = '/var/lib/libvirt/images/safeupload-t5/m2-t5-cp1011-r2/run'
+RUNNER_WORKSPACE_ROOT = '/var/lib/libvirt/safeupload-t5/m2-t5-cp1011-r2/runner-work'
+RUN_POOL_PARENT = '/var/lib/libvirt/images/safeupload-t5/m2-t5-cp1011-r2'
+DEFAULT_RUN_TAG = 'm2-t5-cp1011-r2'
+ORIGINAL_NVRAM_PATH = '/var/lib/libvirt/qemu/nvram/win10-debug3_VARS.fd'
+BASELINE_RECEIPT = 'driver/evidence/2026-10-10/m2-t5-baseline-before.json'
+PREFLIGHT_RECEIPT = 'driver/evidence/2026-10-10/m2-t5-preparation-identity-preflight-2.json'
+BASELINE_SHA256 = 'd26a3e98adce54375a24ade5838ff870e957852ee1a29e7908062f12abfdef9d'
+PREFLIGHT_SHA256 = 'ca8e55049bbf97ed0207c1552f392ff1f7c459b3ffd4c5f78588ec2b0ea6024c'
+BASE_VOLUME_SHA256 = 'd7f20d524ae02a82deb59e55e3e89ff36b062ae4dbe4e57acc1da97a9364bb0f'
+BACKING_VOLUME_SHA256 = '33ef5314def5ffde89941920af6dc0034863e1a3393487fa754aa3312a6d6ad3'
+RETENTION_SUFFIX = '.t5-retention'
+INPROGRESS_SUFFIX = '.t5-inprogress'
+LIBVIRT_URI = 'qemu:///system'
+KIB = 1024
+MIB = 1024 * 1024
+GIB = 1024 * MIB
+RAM_DUMP_FREE_MARGIN = GIB
+MAX_QEMU_MTREE_BYTES = 8 * MIB
+QEMU_MTREE_FLATVIEW_COMMAND = ['virsh', '-c', LIBVIRT_URI, 'qemu-monitor-command',
+                               DOMAIN_UUID, '--hmp', 'info mtree -f -o']
+QEMU_MTREE_REGION_TREE_COMMAND = ['virsh', '-c', LIBVIRT_URI, 'qemu-monitor-command',
+                                  DOMAIN_UUID, '--hmp', 'info mtree -o']
+
+
+class RetentionError(RuntimeError):
+    pass
+
+
+def sha256_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with open(path, 'rb') as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b''):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def fsync_directory(path):
+    fd = os.open(str(path), os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def atomic_write(path, data, mode=0o600, replace=False):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if not replace and path.exists():
+        raise RetentionError('Refusing to overwrite retained evidence: ' + str(path))
+    temporary = path.with_name(path.name + '.tmp-' + secrets.token_hex(8))
+    fd = os.open(str(temporary), os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode)
+    try:
+        view = memoryview(data)
+        while view:
+            view = view[os.write(fd, view):]
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    try:
+        if replace:
+            os.replace(str(temporary), str(path))
+        else:
+            os.link(str(temporary), str(path), follow_symlinks=False)
+            os.unlink(str(temporary))
+    except Exception:
+        try:
+            temporary.unlink()
+        except FileNotFoundError:
+            pass
+        raise
+    fsync_directory(path.parent)
+
+
+def atomic_json(path, value, replace=False):
+    data = (json.dumps(value, sort_keys=True, indent=2, ensure_ascii=False) + '\n').encode('utf-8')
+    atomic_write(path, data, replace=replace)
+    return sha256_bytes(data)
+
+
+def parse_json_unique(path):
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise RetentionError('Duplicate JSON key in ' + str(path) + ': ' + key)
+            result[key] = value
+        return result
+    try:
+        return json.loads(Path(path).read_text(encoding='utf-8'), object_pairs_hook=unique)
+    except RetentionError:
+        raise
+    except Exception as exc:
+        raise RetentionError('Malformed JSON receipt ' + str(path) + ': ' + str(exc)) from exc
+
+
+def canonical_element(element):
+    return (element.tag, tuple(sorted(element.attrib.items())),
+            (element.text or '').strip(), tuple(canonical_element(child) for child in list(element)))
+
+
+def xml_semantics(xml_text, label):
+    try:
+        root = ET.fromstring(xml_text)
+    except Exception as exc:
+        raise RetentionError('Malformed ' + label + ' XML: ' + str(exc)) from exc
+    return canonical_element(root)
+
+
+def vda_path(xml_text, label):
+    root = ET.fromstring(xml_text)
+    matches = []
+    for disk in root.iter('disk'):
+        target = disk.find('target')
+        source = disk.find('source')
+        if (disk.get('device') == 'disk' and target is not None
+                and target.get('dev') == 'vda'):
+            matches.append(source.get('file', '') if source is not None else '')
+    if len(matches) != 1 or not matches[0]:
+        raise RetentionError(label + ' does not have exactly one file-backed vda disk')
+    return matches[0]
+
+
+def run_definition_semantics(xml_text, overlay_path, label):
+    try:
+        root = ET.fromstring(xml_text)
+    except Exception as exc:
+        raise RetentionError('Malformed ' + label + ' XML: ' + str(exc)) from exc
+    matches = []
+    for disk in root.iter('disk'):
+        target = disk.find('target')
+        if disk.get('device') == 'disk' and target is not None and target.get('dev') == 'vda':
+            matches.append(disk)
+    if len(matches) != 1:
+        raise RetentionError(label + ' must define exactly one vda disk')
+    disk = matches[0]
+    source = disk.find('source')
+    if disk.get('type') != 'file' or source is None or source.get('file') != overlay_path:
+        raise RetentionError(label + ' live/inactive vda is not the exact tag-named run overlay')
+    if source.get('dev') or source.get('name') or source.get('protocol'):
+        raise RetentionError(label + ' vda source is not exclusively a file-backed overlay')
+    backing = disk.find('backingStore')
+    if backing is not None:
+        disk.remove(backing)
+    return canonical_element(root)
+
+
+def expected_run_definition_semantics(prebegin_xml, overlay_path, label):
+    return canonical_element(expected_run_definition_root(prebegin_xml, overlay_path, label))
+
+
+def expected_run_definition_root(prebegin_xml, overlay_path, label):
+    try:
+        root = ET.fromstring(prebegin_xml)
+    except Exception as exc:
+        raise RetentionError('Malformed ' + label + ' baseline XML: ' + str(exc)) from exc
+    matches = []
+    for disk in root.iter('disk'):
+        target = disk.find('target')
+        if disk.get('device') == 'disk' and target is not None and target.get('dev') == 'vda':
+            matches.append(disk)
+    if len(matches) != 1:
+        raise RetentionError(label + ' pinned baseline must define exactly one vda disk')
+    disk = matches[0]
+    source = disk.find('source')
+    if source is None or not source.get('file'):
+        raise RetentionError(label + ' pinned baseline vda must be file-backed')
+    source.attrib.clear()
+    source.set('file', overlay_path)
+    backing = disk.find('backingStore')
+    if backing is not None:
+        disk.remove(backing)
+    return root
+
+
+def verify_run_definition(xml_text, prebegin_xml, overlay_path, label):
+    observed = run_definition_semantics(xml_text, overlay_path, label)
+    expected = expected_run_definition_semantics(prebegin_xml, overlay_path, label)
+    if observed != expected:
+        raise RetentionError(label + ' whole-tree definition differs from the pinned run-overlay definition')
+
+
+def _parent_map(root):
+    return {child: parent for parent in root.iter() for child in list(parent)}
+
+
+def _exact_expected_nodes(expected_root, tag, observed_node):
+    return [node for node in expected_root.iter(tag)
+            if canonical_element(node) == canonical_element(observed_node)]
+
+
+def _expected_device_peer(observed_root, expected_root, observed_device):
+    expected_devices = expected_root.find('devices')
+    observed_devices = observed_root.find('devices')
+    if expected_devices is None or observed_devices is None:
+        return None
+    observed_children = list(observed_devices)
+    try:
+        position = observed_children.index(observed_device)
+    except ValueError:
+        return None
+    ordinal = sum(1 for node in observed_children[:position]
+                  if node.tag == observed_device.tag)
+    matches = [node for node in list(expected_devices) if node.tag == observed_device.tag]
+    return matches[ordinal] if ordinal < len(matches) else None
+
+
+def _generated_qemu_alias(device, name):
+    patterns = {
+        'disk': r'(?:virtio-disk[0-9]+|(?:sata|scsi|ide|usb)[0-9]+-[0-9]+-[0-9]+)',
+        'interface': r'net[0-9]+',
+        'controller': r'(?:usb|ide|(?:virtio-serial|virtio-scsi|scsi)[0-9]+|pcie\.[0-9]+|pci\.[0-9]+)',
+        'serial': r'serial[0-9]+',
+        'console': r'serial[0-9]+',
+        'video': r'video[0-9]+',
+        'input': r'input[0-9]+',
+        'memballoon': r'balloon[0-9]+',
+        'sound': r'sound[0-9]+',
+    }
+    pattern = patterns.get(device.tag)
+    return pattern is not None and re.fullmatch(pattern, name) is not None
+
+
+def normalize_active_runtime_xml(observed_root, expected_root, label):
+    """Remove only libvirt's documented active-only output, tied to pinned XML.
+
+    Inactive XML remains byte-semantically strict. Active-only domain id,
+    generated non-ua device aliases, allocated PTY source/console tty, and a
+    generated interface target are removed only in their documented shapes;
+    the final whole-tree comparison still pins every persistent device field.
+    Output-only security label data is admitted only in its documented parent.
+    """
+    # The domain id exists only while active.  It is not persistent identity:
+    # name and UUID remain part of the exact tree comparison below.
+    if 'id' in observed_root.attrib and 'id' not in expected_root.attrib:
+        if not re.fullmatch(r'[0-9]+', observed_root.get('id', '')):
+            raise RetentionError(label + ' active domain id is not a numeric libvirt runtime id')
+        del observed_root.attrib['id']
+
+    # QEMU/libvirt assigns non-user aliases when a domain starts.  Only known
+    # device-specific generated-name forms are normalized when the pinned
+    # same-position device has no alias.  A user alias (the documented ua- form)
+    # remains part of the persistent configuration and is never normalized.
+    devices = observed_root.find('devices')
+    if devices is not None:
+        for device in list(devices):
+            aliases = device.findall('alias')
+            if not aliases:
+                continue
+            if len(aliases) != 1:
+                raise RetentionError(label + ' active device has multiple aliases')
+            alias = aliases[0]
+            name = alias.get('name', '')
+            if (set(alias.attrib) != {'name'} or list(alias) or (alias.text or '').strip()
+                    or not re.fullmatch(r'[A-Za-z0-9_.-]{1,128}', name)):
+                raise RetentionError(label + ' active device alias is not a generated libvirt alias')
+            if name.startswith('ua-'):
+                continue
+            peer = _expected_device_peer(observed_root, expected_root, device)
+            if peer is not None and peer.find('alias') is None:
+                if not _generated_qemu_alias(device, name):
+                    raise RetentionError(label + ' active device alias does not match a known QEMU-generated form')
+                device.remove(alias)
+
+    # A PTY allocated at start has an output-only /dev/pts/N source path;
+    # libvirt duplicates that path to the console tty attribute.  Admit the
+    # fields only on the matching pty character device and only in this shape.
+    if devices is not None:
+        for device in list(devices):
+            if device.tag not in ('serial', 'console') or device.get('type') != 'pty':
+                continue
+            peer = _expected_device_peer(observed_root, expected_root, device)
+            sources = list(device.findall('source'))
+            if peer is not None and peer.find('source') is None and sources:
+                if len(sources) != 1:
+                    raise RetentionError(label + ' active pty has multiple generated source paths')
+                source = sources[0]
+                if (set(source.attrib) != {'path'} or not re.fullmatch(
+                        r'/dev/pts/[0-9]+', source.get('path', '')) or list(source)
+                        or (source.text or '').strip()):
+                    raise RetentionError(label + ' active pty source is outside the generated /dev/pts/N shape')
+                device.remove(source)
+            if (device.tag == 'console' and 'tty' in device.attrib
+                    and peer is not None and 'tty' not in peer.attrib):
+                tty = device.get('tty', '')
+                if not re.fullmatch(r'/dev/pts/[0-9]+', tty):
+                    raise RetentionError(label + ' active console tty is outside the generated /dev/pts/N shape')
+                del device.attrib['tty']
+
+    parents = _parent_map(observed_root)
+
+    for node in list(observed_root.iter('target')):
+        parent = parents.get(node)
+        if (parent is None or parent.tag != 'interface' or parent.get('type') != 'network'
+                or set(node.attrib) != {'dev'} or not re.fullmatch(r'vnet[0-9]+', node.get('dev', ''))
+                or list(node) or (node.text or '').strip()):
+            continue
+        peer = _expected_device_peer(observed_root, expected_root, parent)
+        if peer is not None and peer.find('target') is None:
+            parent.remove(node)
+
+    parents = _parent_map(observed_root)
+    for node in list(observed_root.iter('imagelabel')):
+        parent = parents.get(node)
+        if (parent is None or parent.tag != 'seclabel' or parents.get(parent) is not observed_root
+                or node.attrib or list(node) or not (node.text or '').strip()):
+            raise RetentionError(label + ' active imagelabel is outside the documented top-level security label')
+        wrapper_children = list(parent)
+        wrapper_has_one_runtime_child = (
+            len(wrapper_children) == 1 and wrapper_children[0] is node
+            and not (parent.text or '').strip() and not (node.tail or '').strip())
+        parent.remove(node)
+        matching_labels = _exact_expected_nodes(expected_root, 'seclabel', parent)
+        if len(matching_labels) == 1:
+            continue
+        if matching_labels or list(expected_root.findall('seclabel')):
+            parent.append(node)
+            raise RetentionError(label + ' output-only imagelabel is not attached to one exact pinned label')
+        else:
+            if (set(parent.attrib) != {'type', 'model'} or parent.get('type') != 'dynamic'
+                    or parent.get('model') not in ('dac', 'selinux', 'apparmor')
+                    or not wrapper_has_one_runtime_child):
+                parent.append(node)
+                raise RetentionError(label + ' generated top-level seclabel is outside the exact one-child runtime shape')
+            observed_root.remove(parent)
+
+    parents = _parent_map(observed_root)
+    for node in list(observed_root.iter('labelskip')):
+        parent = parents.get(node)
+        disk = parents.get(parent) if parent is not None else None
+        if (parent is None or parent.tag != 'seclabel' or disk is None or disk.tag != 'disk'
+                or node.attrib or list(node) or (node.text or '').strip()):
+            raise RetentionError(label + ' active labelskip is outside a disk security label')
+        wrapper_children = list(parent)
+        wrapper_has_one_runtime_child = (
+            len(wrapper_children) == 1 and wrapper_children[0] is node
+            and not (parent.text or '').strip() and not (node.tail or '').strip())
+        parent.remove(node)
+        matching_labels = _exact_expected_nodes(expected_root, 'seclabel', parent)
+        if len(matching_labels) == 1:
+            continue
+        if matching_labels:
+            parent.append(node)
+            raise RetentionError(label + ' output-only labelskip has ambiguous pinned security-label parents')
+        else:
+            if (set(parent.attrib) != {'model', 'relabel'} or parent.get('model') != 'dac'
+                    or parent.get('relabel') != 'no'
+                    or not wrapper_has_one_runtime_child):
+                parent.append(node)
+                raise RetentionError(label + ' generated disk seclabel is outside the exact one-child runtime shape')
+            disk.remove(parent)
+
+    return observed_root
+
+
+def verify_active_run_definition(xml_text, prebegin_xml, overlay_path, label):
+    verify_active_definition(xml_text, prebegin_xml, label, overlay_path=overlay_path)
+
+
+def verify_active_definition(xml_text, expected_xml, label, overlay_path=None):
+    if overlay_path is not None:
+        observed = run_definition_root(xml_text, overlay_path, label)
+        expected = expected_run_definition_root(expected_xml, overlay_path, label)
+    else:
+        try:
+            observed = ET.fromstring(xml_text)
+            expected = ET.fromstring(expected_xml)
+        except Exception as exc:
+            raise RetentionError('Malformed ' + label + ' XML: ' + str(exc)) from exc
+        expected_vda = vda_path(expected_xml, label + ' expected')
+        if vda_path(xml_text, label) != expected_vda:
+            raise RetentionError(label + ' active vda differs from the exact pinned base path')
+    normalize_active_runtime_xml(observed, expected, label)
+    if canonical_element(observed) != canonical_element(expected):
+        raise RetentionError(label + ' active whole-tree definition differs from its exact pinned definition')
+
+
+def run_definition_root(xml_text, overlay_path, label):
+    try:
+        root = ET.fromstring(xml_text)
+    except Exception as exc:
+        raise RetentionError('Malformed ' + label + ' XML: ' + str(exc)) from exc
+    matches = []
+    for disk in root.iter('disk'):
+        target = disk.find('target')
+        if disk.get('device') == 'disk' and target is not None and target.get('dev') == 'vda':
+            matches.append(disk)
+    if len(matches) != 1:
+        raise RetentionError(label + ' must define exactly one vda disk')
+    disk = matches[0]
+    source = disk.find('source')
+    if disk.get('type') != 'file' or source is None or source.get('file') != overlay_path:
+        raise RetentionError(label + ' vda is not the exact tag-named run overlay')
+    if source.get('dev') or source.get('name') or source.get('protocol'):
+        raise RetentionError(label + ' vda source is not exclusively a file-backed overlay')
+    backing = disk.find('backingStore')
+    if backing is not None:
+        disk.remove(backing)
+    return root
+
+
+def require_domain_identity(xml_text, label, uuid=DOMAIN_UUID):
+    root = ET.fromstring(xml_text)
+    name = root.findtext('name')
+    observed_uuid = (root.findtext('uuid') or '').lower()
+    if name != DOMAIN or observed_uuid != uuid:
+        raise RetentionError(label + ' domain name/UUID mismatch: ' + repr((name, observed_uuid)))
+    return root
+
+
+def quantity_bytes(element, label):
+    if element is None or not element.text:
+        raise RetentionError('Missing ' + label + ' memory quantity')
+    units = {'b': 1, 'bytes': 1, 'kb': 1000, 'kib': KIB,
+             'mb': 1000 ** 2, 'mib': MIB, 'gb': 1000 ** 3, 'gib': GIB,
+             'tb': 1000 ** 4, 'tib': 1024 ** 4}
+    unit = (element.get('unit') or 'KiB').lower()
+    multiplier = units.get(unit)
+    if multiplier is None:
+        raise RetentionError('Unsupported ' + label + ' memory unit: ' + unit)
+    try:
+        value = int(element.text) * multiplier
+    except ValueError as exc:
+        raise RetentionError('Malformed ' + label + ' memory quantity') from exc
+    if value <= 0:
+        raise RetentionError(label + ' memory quantity must be positive')
+    return value
+
+
+def load_pinned_receipts(root):
+    baseline_path = root / BASELINE_RECEIPT
+    preflight_path = root / PREFLIGHT_RECEIPT
+    if sha256_file(baseline_path) != BASELINE_SHA256:
+        raise RetentionError('Pinned T5 baseline receipt hash changed')
+    if sha256_file(preflight_path) != PREFLIGHT_SHA256:
+        raise RetentionError('Pinned T5 preflight receipt hash changed')
+    baseline = parse_json_unique(baseline_path)
+    preflight = parse_json_unique(preflight_path)
+    if (baseline.get('Domain') != DOMAIN or str(baseline.get('UUID', '')).lower() != DOMAIN_UUID
+            or baseline.get('State') != 'shut off' or baseline.get('HashingComplete') is not True
+            or baseline.get('BasePath') != '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2'
+            or baseline.get('BaseSHA256', '').lower() != BASE_VOLUME_SHA256
+            or baseline.get('BackingPath') != '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2'
+            or baseline.get('BackingSHA256', '').lower() != BACKING_VOLUME_SHA256):
+        raise RetentionError('Pinned T5 baseline receipt fields do not match reviewed identity')
+    checks = preflight.get('Checks')
+    if (preflight.get('BaselineReceiptSHA256') != BASELINE_SHA256
+            or preflight.get('Domain') != DOMAIN or not isinstance(checks, dict)
+            or set(checks) != {'DomainShutOff', 'DomainUUID', 'InactiveDefinition', 'BaseVolumePath',
+                               'BaseBackingPath', 'BackingVolumePath', 'BackingIsFlat', 'NoRunState'}
+            or not all(value is True for value in checks.values())
+            or preflight.get('IdentityPreflight') is not True
+            or preflight.get('FullDiskHashesVerified') is not False
+            or preflight.get('RuntimeStartedByVerifier') is not False
+            or preflight.get('ReadOnly') is not True):
+        raise RetentionError('Pinned T5 identity preflight receipt is incomplete or mismatched')
+    if not isinstance(baseline.get('InactiveXML'), str) or not isinstance(baseline.get('BaseVolumeXML'), str) \
+            or not isinstance(baseline.get('BackingVolumeXML'), str):
+        raise RetentionError('Pinned baseline receipt lacks full XML records')
+    return baseline, preflight
+
+
+def parse_volume_xml(xml_text, label):
+    try:
+        root = ET.fromstring(xml_text)
+        name = root.findtext('name')
+        key = root.findtext('key')
+        capacity = int(root.findtext('capacity'))
+        allocation_text = root.findtext('allocation')
+        physical_text = root.findtext('physical')
+        allocation = int(allocation_text) if allocation_text else None
+        physical = int(physical_text) if physical_text else None
+        target = root.find('target')
+        path = target.findtext('path') if target is not None else None
+        fmt_node = target.find('format') if target is not None else None
+        fmt = fmt_node.get('type') if fmt_node is not None else None
+        backing = root.find('backingStore')
+        backing_path = backing.findtext('path') if backing is not None else None
+        backing_fmt_node = backing.find('format') if backing is not None else None
+        backing_fmt = backing_fmt_node.get('type') if backing_fmt_node is not None else None
+        permissions = target.find('permissions') if target is not None else None
+        mode = permissions.findtext('mode') if permissions is not None else None
+        owner = permissions.findtext('owner') if permissions is not None else None
+        group = permissions.findtext('group') if permissions is not None else None
+    except Exception as exc:
+        raise RetentionError('Malformed ' + label + ' libvirt volume XML: ' + str(exc)) from exc
+    if not name or not path or not fmt or capacity <= 0:
+        raise RetentionError(label + ' libvirt volume XML lacks name/path/format/capacity')
+    return {'name': name, 'key': key, 'path': path, 'capacity': capacity,
+            'allocation': allocation, 'physical': physical, 'format': fmt,
+            'backing_path': backing_path, 'backing_format': backing_fmt,
+            'mode': mode, 'owner': owner, 'group': group}
+
+
+def private_identity_from_pinned_base(baseline):
+    details = parse_volume_xml(baseline['BaseVolumeXML'], 'pinned base')
+    try:
+        mode = int(str(details['mode']), 8)
+        owner = int(str(details['owner']), 10)
+        group = int(str(details['group']), 10)
+        import pwd
+        owner_name = pwd.getpwuid(owner).pw_name
+    except Exception as exc:
+        raise RetentionError('Pinned base private ownership metadata is unavailable: ' + str(exc)) from exc
+    if (details['path'] != baseline['BasePath'] or details['format'] != 'qcow2'
+            or details['name'] != Path(baseline['BasePath']).name
+            or mode != 0o600 or owner != 958 or group != 958 or owner_name != 'libvirt-qemu'):
+        raise RetentionError('Pinned base no longer declares the exact QEMU-private uid/gid 958 mode 0600 identity')
+    return {'owner': owner, 'group': group, 'mode': mode, 'owner_name': owner_name}
+
+
+def check_volume_identity(volume, expected_path, expected_format, label,
+                          expected_name=None, expected_backing=None):
+    details = parse_volume_xml(volume.XMLDesc(0), label)
+    if details['path'] != expected_path or details['format'] != expected_format:
+        raise RetentionError(label + ' volume path/format mismatch: ' + repr(details))
+    if expected_name is not None and details['name'] != expected_name:
+        raise RetentionError(label + ' volume name mismatch: ' + repr(details['name']))
+    if expected_backing is not None and details['backing_path'] != expected_backing:
+        raise RetentionError(label + ' backing path mismatch: ' + repr(details['backing_path']))
+    return details
+
+
+def storage_volume_info(volume, label):
+    """Return StorageVol.info() fields in libvirt's documented ABI order.
+
+    virStorageVolInfo is (type, capacity, allocation).  The type value is
+    VIR_STORAGE_VOL_FILE (0) for the pinned file-backed pool.
+    """
+    try:
+        info = volume.info()
+        if len(info) < 3:
+            raise ValueError('expected (type, capacity, allocation)')
+        kind, capacity, allocation = (int(info[0]), int(info[1]), int(info[2]))
+    except Exception as exc:
+        raise RetentionError(label + ' libvirt StorageVol.info() is unavailable or malformed: ' + str(exc)) from exc
+    if kind != 0 or capacity <= 0 or allocation < 0:
+        raise RetentionError(label + ' libvirt StorageVol.info() is not a file volume with valid size fields: '
+                             + repr((kind, capacity, allocation)))
+    return {'type': kind, 'capacity': capacity, 'allocation': allocation}
+
+
+def check_private_identity(details, identity, label):
+    try:
+        observed = {'owner': int(str(details['owner']), 10),
+                    'group': int(str(details['group']), 10),
+                    'mode': int(str(details['mode']), 8)}
+    except Exception as exc:
+        raise RetentionError(label + ' volume permission metadata is unavailable: ' + str(exc)) from exc
+    expected = {key: identity[key] for key in ('owner', 'group', 'mode')}
+    if observed != expected:
+        raise RetentionError(label + ' volume private owner/mode differs from pinned QEMU identity: '
+                             + repr({'observed': observed, 'expected': expected}))
+    return {'OwnerUID': observed['owner'], 'OwnerName': identity['owner_name'],
+            'GroupGID': observed['group'], 'Mode': format(observed['mode'], '04o')}
+
+
+def volume_sha256(conn, volume):
+    """Hash the complete on-disk file bytes, not a qcow2 image's virtual capacity."""
+    before = parse_volume_xml(volume.XMLDesc(0), 'volume before full stream')
+    info = storage_volume_info(volume, 'volume before full stream')
+    capacity = info['capacity']
+    allocation = info['allocation']
+    physical = before['physical']
+    if capacity != before['capacity'] or physical is None or physical <= 0:
+        raise RetentionError('Volume XML lacks exact physical file length or disagrees with libvirt virtual capacity')
+    if allocation != before['allocation']:
+        raise RetentionError('Volume XML and libvirt info disagree on physical allocation metadata')
+    digest = hashlib.sha256()
+    received = [0]
+
+    def receive(_stream, data, _opaque):
+        if not isinstance(data, (bytes, bytearray, memoryview)):
+            raise RetentionError('libvirt storage stream returned non-byte data')
+        digest.update(data)
+        received[0] += len(data)
+        return len(data)
+
+    stream = conn.newStream(0)
+    finished = False
+    try:
+        # For local file pools, length=0 requests the complete physical file.
+        # A qcow2 volume's virtual capacity can be far larger than its file.
+        volume.download(stream, 0, 0, 0)
+        stream.recvAll(receive, None)
+        stream.finish()
+        finished = True
+    finally:
+        if not finished:
+            try:
+                stream.abort()
+            except Exception:
+                pass
+    after = parse_volume_xml(volume.XMLDesc(0), 'volume after full stream')
+    info_after = storage_volume_info(volume, 'volume after full stream')
+    if (after['path'] != before['path'] or after['capacity'] != capacity
+            or after['physical'] != physical or after['allocation'] != allocation
+            or info_after['type'] != info['type']
+            or info_after['capacity'] != capacity or info_after['allocation'] != allocation):
+        raise RetentionError('Volume metadata changed while its full physical file stream was read')
+    if received[0] != physical:
+        raise RetentionError('Full physical volume stream length differs from XML metadata: received %d of %d bytes' %
+                              (received[0], physical))
+    return {'sha256': digest.hexdigest(), 'bytes': received[0],
+            'virtual_capacity': capacity, 'allocation': allocation, 'physical_bytes': physical}
+
+
+def volume_read_range(conn, volume, offset, length):
+    capacity = storage_volume_info(volume, 'range-read volume')['capacity']
+    if offset < 0 or length <= 0 or offset + length > capacity:
+        raise RetentionError('Refusing an out-of-bounds libvirt volume read range')
+    data = bytearray()
+
+    def receive(_stream, block, _opaque):
+        if not isinstance(block, (bytes, bytearray, memoryview)):
+            raise RetentionError('libvirt storage stream returned non-byte data')
+        data.extend(block)
+        return len(block)
+
+    stream = conn.newStream(0)
+    finished = False
+    try:
+        volume.download(stream, offset, length, 0)
+        stream.recvAll(receive, None)
+        stream.finish()
+        finished = True
+    finally:
+        if not finished:
+            try:
+                stream.abort()
+            except Exception:
+                pass
+    if len(data) != length:
+        raise RetentionError('Short libvirt volume range: received %d of %d bytes' % (len(data), length))
+    return bytes(data)
+
+
+def open_connection():
+    try:
+        import libvirt
+    except Exception as exc:
+        raise RetentionError('Python libvirt binding unavailable: ' + str(exc)) from exc
+    conn = libvirt.open(LIBVIRT_URI)
+    if conn is None:
+        raise RetentionError('Could not open libvirt system connection')
+    return libvirt, conn
+
+
+def pool_for_exact_path(conn, run_dir):
+    libvirt = __import__('libvirt')
+    matches = []
+    for pool in conn.listAllStoragePools(0):
+        try:
+            root = ET.fromstring(pool.XMLDesc(0))
+            path = root.findtext('./target/path')
+            if path == run_dir:
+                matches.append(pool)
+        except Exception as exc:
+            raise RetentionError('Unable to inspect a libvirt storage pool: ' + str(exc)) from exc
+    if len(matches) != 1:
+        raise RetentionError('Expected one libvirt pool with exact target path %s; found %d' %
+                             (run_dir, len(matches)))
+    pool = matches[0]
+    info = pool.info()
+    if info[0] != libvirt.VIR_STORAGE_POOL_RUNNING:
+        raise RetentionError('Pinned T5 run pool is not active')
+    return pool
+
+
+def pool_lookup_volume(pool, name, libvirt):
+    try:
+        return pool.storageVolLookupByName(name)
+    except libvirt.libvirtError as exc:
+        code = exc.get_error_code() if hasattr(exc, 'get_error_code') else None
+        if code == getattr(libvirt, 'VIR_ERR_NO_STORAGE_VOL', object()):
+            return None
+        raise RetentionError('Libvirt could not query pool volume ' + name + ': ' + str(exc)) from exc
+
+
+def volume_by_path(conn, path, libvirt):
+    try:
+        return conn.storageVolLookupByPath(path)
+    except libvirt.libvirtError as exc:
+        code = exc.get_error_code() if hasattr(exc, 'get_error_code') else None
+        if code == getattr(libvirt, 'VIR_ERR_NO_STORAGE_VOL', object()):
+            return None
+        raise RetentionError('Libvirt could not query storage path ' + path + ': ' + str(exc)) from exc
+
+
+def verify_private_volume(details, identity, label):
+    return check_private_identity(details, identity, label)
+
+
+def sha_baseline_volumes(conn, baseline, root, run_dir):
+    base_path = baseline['BasePath']
+    backing_path = baseline['BackingPath']
+    libvirt = __import__('libvirt')
+    base = volume_by_path(conn, base_path, libvirt)
+    if base is None:
+        raise RetentionError('Pinned base is absent from libvirt storage metadata')
+    backing = volume_by_path(conn, backing_path, libvirt)
+    if backing is None:
+        raise RetentionError('Pinned backing volume is absent from libvirt storage metadata')
+    base_details = check_volume_identity(base, base_path, 'qcow2', 'base',
+                                         expected_name=Path(base_path).name)
+    backing_details = check_volume_identity(backing, backing_path, 'qcow2', 'backing',
+                                            expected_name=Path(backing_path).name)
+    if base_details['backing_path'] != backing_path:
+        raise RetentionError('Pinned base no longer backs directly to the recorded flat volume')
+    if backing_details['backing_path']:
+        raise RetentionError('Pinned backing volume is no longer flat')
+    pinned_identity = private_identity_from_pinned_base(baseline)
+    check_private_identity(base_details, pinned_identity, 'base')
+    for label, details, xml_text in (('base', base_details, baseline['BaseVolumeXML']),
+                                     ('backing', backing_details, baseline['BackingVolumeXML'])):
+        pinned_details = parse_volume_xml(xml_text, 'pinned ' + label)
+        for field in ('name', 'path', 'capacity', 'allocation', 'physical', 'format',
+                      'backing_path', 'backing_format', 'mode', 'owner', 'group'):
+            if details[field] != pinned_details[field]:
+                raise RetentionError('Current ' + label + ' volume metadata differs from pinned baseline: ' + field)
+    if (base_details['physical'] is None or backing_details['physical'] is None
+            or base_details['physical'] <= 0 or backing_details['physical'] <= 0):
+        raise RetentionError('Pinned base/backing physical file lengths are missing')
+    base_hash = volume_sha256(conn, base)
+    backing_hash = volume_sha256(conn, backing)
+    if base_hash['sha256'] != BASE_VOLUME_SHA256 or backing_hash['sha256'] != BACKING_VOLUME_SHA256:
+        raise RetentionError('Full libvirt stream SHA-256 differs from the pinned baseline')
+    if (base_hash['bytes'] != base_details['physical']
+            or backing_hash['bytes'] != backing_details['physical']):
+        raise RetentionError('Full libvirt stream lengths differ from pinned physical file lengths')
+    return {'base': base, 'backing': backing, 'base_details': base_details,
+            'backing_details': backing_details, 'base_hash': base_hash,
+            'backing_hash': backing_hash, 'private_identity': pinned_identity}
+
+
+def marker_path(state_dir, domain=DOMAIN):
+    return Path(state_dir) / (domain + RETENTION_SUFFIX)
+
+
+def inprogress_path(state_dir, domain=DOMAIN):
+    return Path(state_dir) / (domain + INPROGRESS_SUFFIX)
+
+
+def create_progress_guard(state_dir, tag, owner_pid):
+    state_dir = Path(state_dir).resolve()
+    state_dir.mkdir(parents=True, exist_ok=True)
+    path = inprogress_path(state_dir)
+    if path.exists() or path.is_symlink() or marker_path(state_dir).exists() or marker_path(state_dir).is_symlink():
+        raise RetentionError('Existing T5 progress/retention guard blocks a new run')
+    token = secrets.token_hex(16)
+    payload = {'Schema': 'T5InProgressV1', 'Domain': DOMAIN, 'RunTag': tag,
+               'PID': int(owner_pid), 'Token': token,
+               'CreatedUTC': datetime.datetime.now(datetime.timezone.utc).isoformat()}
+    data = (json.dumps(payload, sort_keys=True) + '\n').encode('utf-8')
+    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, 'O_NOFOLLOW', 0)
+    fd = os.open(str(path), flags, 0o600)
+    try:
+        view = memoryview(data)
+        while view:
+            view = view[os.write(fd, view):]
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    fsync_directory(state_dir)
+    return token
+
+
+def verify_progress_guard(state_dir, tag, token, owner_pid):
+    path = inprogress_path(state_dir)
+    if path.is_symlink() or not path.is_file() or stat.S_IMODE(path.stat().st_mode) != 0o600:
+        raise RetentionError('T5 in-progress guard is absent or has unsafe file metadata')
+    if path.stat().st_uid != os.getuid():
+        raise RetentionError('T5 in-progress guard is owned by a different user')
+    row = parse_json_unique(path)
+    if (row.get('Schema') != 'T5InProgressV1' or row.get('Domain') != DOMAIN
+            or row.get('RunTag') != tag or row.get('Token') != token
+            or row.get('PID') != int(owner_pid)):
+        raise RetentionError('T5 in-progress guard does not match this exact shell/tag/token')
+    return row
+
+
+def require_lifecycle_lock(args):
+    """Validate the inherited immutable lease, never inherit the root lock FD."""
+    try:
+        lease_fd = int(args.lifecycle_lease_fd)
+        helper_path = Path(__file__).resolve(strict=True).with_name(
+            'T5WritableStateLifecycle.py')
+        expected_root = Path('/usr/local/libexec/safeupload-t5-copy-r2/driver/scripts/t5')
+        if helper_path.parent != expected_root:
+            raise RetentionError('lifecycle helper is outside the fixed root-owned install')
+        helper_stat = helper_path.lstat()
+        if (not stat.S_ISREG(helper_stat.st_mode) or helper_stat.st_uid != 0
+                or helper_stat.st_gid != 0 or helper_stat.st_nlink != 1
+                or stat.S_IMODE(helper_stat.st_mode) != 0o444):
+            raise RetentionError('installed lifecycle validator metadata differs')
+        import importlib.util
+        spec = importlib.util.spec_from_file_location('t5_fixed_lifecycle_validator',
+                                                      helper_path)
+        if spec is None or spec.loader is None:
+            raise RetentionError('fixed lifecycle validator cannot be loaded')
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[spec.name] = module
+        spec.loader.exec_module(module)
+        row = module.validate_active_lease_fd(lease_fd, expected_tag=args.tag)
+    except RetentionError:
+        raise
+    except Exception as exc:
+        raise RetentionError('Missing valid root lifecycle lease proof: ' + str(exc)) from exc
+    if (row['Domain'] != DOMAIN or row['UUID'] != DOMAIN_UUID
+            or row['LockPath'] != '/run/safeupload-t5/' + DOMAIN + '.lifecycle.lock'):
+        raise RetentionError('T5 lifecycle lease differs from the exact selected domain/lock')
+    return {'Path': row['LockPath'], 'SupervisorPID': row['SupervisorPID'],
+            'LockDevice': row['LockDevice'], 'LockInode': row['LockInode'],
+            'RunTag': row['RunTag'],
+            'PreparedReceiptSHA256': row['PreparedReceiptSHA256'],
+            'PrivateStateBindingReceiptSHA256': row['PrivateStateBindingReceiptSHA256']}
+
+
+def remove_progress_guard(state_dir, tag, token, owner_pid):
+    path = inprogress_path(state_dir)
+    verify_progress_guard(state_dir, tag, token, owner_pid)
+    path.unlink()
+    fsync_directory(path.parent)
+
+
+def require_dump_space(available_bytes, logical_capacity_bytes, margin_bytes=RAM_DUMP_FREE_MARGIN):
+    available = int(available_bytes)
+    capacity = int(logical_capacity_bytes)
+    margin = int(margin_bytes)
+    if capacity <= 0 or margin < 0 or available < capacity + margin:
+        raise RetentionError('Run pool free space is below dump logical-capacity plus safety-margin requirement')
+    return {'AvailableBytes': available, 'LogicalCapacityBytes': capacity,
+            'SafetyMarginBytes': margin,
+            'MinimumAvailableBytes': capacity + margin}
+
+
+def parse_state_file(path, tag, base_path, overlay_path):
+    path = Path(path)
+    if not path.exists():
+        return None
+    if path.is_symlink() or not path.is_file():
+        raise RetentionError('Run-disk state is not a regular file')
+    raw = path.read_bytes()
+    fields = {}
+    for line in raw.decode('utf-8').splitlines():
+        if '=' not in line:
+            raise RetentionError('Malformed run-disk state row')
+        key, value = line.split('=', 1)
+        if not key or key in fields:
+            raise RetentionError('Duplicate/empty run-disk state key')
+        fields[key] = value
+    if (set(fields) != {'base', 'overlay', 'tag', 'basestat'} or fields['base'] != base_path
+            or fields['overlay'] != overlay_path or fields['tag'] != tag
+            or not re.fullmatch(r'[0-9]+ [0-9]+', fields['basestat'])):
+        raise RetentionError('Run-disk state does not match this exact T5 tag and disk chain')
+    return {'bytes': raw, 'fields': fields}
+
+
+def input_hashes(path):
+    fields = {}
+    try:
+        for line in Path(path).read_text(encoding='utf-8').splitlines():
+            if '=' not in line:
+                raise RetentionError('Malformed T5 input-hash row')
+            key, value = line.split('=', 1)
+            if not key or key in fields:
+                raise RetentionError('Duplicate/empty T5 input-hash key')
+            fields[key] = value
+    except RetentionError:
+        raise
+    except Exception as exc:
+        raise RetentionError('Could not read tag-bound T5 input hashes: ' + str(exc)) from exc
+    return fields
+
+
+def expected_input_fields(tag, mode, driver_sha, zip_sha, service_sha):
+    return {'RunTag': tag, 'Mode': mode, 'RequestedDomain': DOMAIN,
+            'ExpectedGuestUUID': DOMAIN_UUID.upper(),
+            'LocalDriverSysSHA256': driver_sha.upper(),
+            'LocalAgentZipSHA256': zip_sha.upper(),
+            'ExpectedExtractedServiceSHA256': service_sha.upper()}
+
+
+def validate_current_inputs(evidence_dir, tag, mode, driver_sha, zip_sha, service_sha, prebegin=None):
+    fields = input_hashes(Path(evidence_dir) / (tag + '-input-hashes.txt'))
+    expected = expected_input_fields(tag, mode, driver_sha, zip_sha, service_sha)
+    if any(fields.get(key) != value for key, value in expected.items()):
+        raise RetentionError('Current T5 input-hash record does not match tag/domain/mode/input pins')
+    if prebegin is not None:
+        if (prebegin.get('RunTag') != tag or prebegin.get('Mode') != mode
+                or prebegin.get('InputPins') != expected):
+            raise RetentionError('Current T5 inputs do not match the durable prebegin pin')
+    return expected
+
+
+def exact_verdict(verdict_path, name):
+    try:
+        lines = Path(verdict_path).read_text(encoding='utf-8', errors='strict').splitlines()
+    except Exception:
+        return False, 'verdict file missing or unreadable'
+    rows = [line for line in lines if re.match(r'^\s*' + re.escape(name) + r'(?:\s|$)', line)]
+    if len(rows) != 1:
+        return False, 'expected exactly one ' + name + ' verdict; found ' + str(len(rows))
+    match = re.fullmatch(re.escape(name) + r' (PASS|FAIL|INCONCLUSIVE) .+', rows[0])
+    if match is None or match.group(1) != 'PASS':
+        return False, 'required ' + name + ' verdict is not PASS'
+    return True, rows[0].split(' ', 2)[2]
+
+
+def capture_completeness(evidence_dir, tag, mode, driver_sha, zip_sha, service_sha,
+                         alive, result_saved, raw_saved):
+    reasons = []
+    if alive != 'yes':
+        reasons.append('guest not confirmed alive')
+    try:
+        prebegin = parse_json_unique(Path(evidence_dir) / (tag + '-prebegin.json'))
+        validate_current_inputs(evidence_dir, tag, mode, driver_sha, zip_sha, service_sha, prebegin)
+    except Exception as exc:
+        prebegin = None
+        reasons.append('tag/input pin mismatch: ' + str(exc))
+    if result_saved != 'yes':
+        reasons.append('current result copy missing')
+    result_path = Path(evidence_dir) / (tag + '-result.json')
+    try:
+        if result_path.is_symlink() or not result_path.is_file() or result_path.stat().st_size <= 0:
+            raise ValueError('not a nonempty regular file')
+        result = parse_json_unique(result_path)
+        if not isinstance(result, dict):
+            raise ValueError('top-level JSON is not an object')
+    except Exception as exc:
+        reasons.append('current copied result is malformed: ' + str(exc))
+    if raw_saved != 'yes':
+        reasons.append('current raw-evidence copy missing')
+    raw_dir = Path(evidence_dir) / (tag + '-raw')
+    manifests = []
+    if raw_dir.is_dir() and not raw_dir.is_symlink():
+        manifests = [path for path in raw_dir.rglob('manifest.ndjson') if path.is_file() and not path.is_symlink()]
+    if len(manifests) != 1 or (manifests and manifests[0].stat().st_size <= 0):
+        reasons.append('current raw manifest absent, ambiguous, or empty')
+    for name in ('T5GuestAlive', 'T5ResultEvidence', 'T5RawObserver', 'T5RawEvidenceRetained',
+                 'T5ActorTaskStart', 'T5CasesCompleted'):
+        passed, detail = exact_verdict(Path(evidence_dir) / (tag + '-verdict.txt'), name)
+        if not passed:
+            reasons.append(detail)
+    if 'result' in locals() and isinstance(result, dict):
+        if result.get('ActorTaskStartIssued') is not True:
+            reasons.append('current result does not prove the interactive actor task was started')
+        cases = result.get('Cases')
+        expected_kinds = {'ProbeDelete', 'ProbeDeleteOnClose', 'OnCloseCancellation',
+                          'NotepadApprove', 'NotepadHandBack'}
+        if (not isinstance(cases, list) or len(cases) != 5
+                or any(not isinstance(case, dict) for case in cases)
+                or {case.get('Kind') for case in cases if isinstance(case, dict)} != expected_kinds
+                or result.get('Error') is not None):
+            reasons.append('current result does not contain the exact five-case matrix without an error')
+    return (not reasons), reasons
+
+
+def libvirt_state_name(libvirt, state):
+    names = {
+        getattr(libvirt, 'VIR_DOMAIN_NOSTATE', -1): 'nostate',
+        getattr(libvirt, 'VIR_DOMAIN_RUNNING', -1): 'running',
+        getattr(libvirt, 'VIR_DOMAIN_BLOCKED', -1): 'blocked',
+        getattr(libvirt, 'VIR_DOMAIN_PAUSED', -1): 'paused',
+        getattr(libvirt, 'VIR_DOMAIN_SHUTDOWN', -1): 'shutdown',
+        getattr(libvirt, 'VIR_DOMAIN_SHUTOFF', -1): 'shutoff',
+        getattr(libvirt, 'VIR_DOMAIN_CRASHED', -1): 'crashed',
+        getattr(libvirt, 'VIR_DOMAIN_PMSUSPENDED', -1): 'pmsuspended',
+    }
+    return names.get(state, 'unknown-' + str(state))
+
+
+def domain_snapshot(conn, libvirt):
+    try:
+        domain = conn.lookupByName(DOMAIN)
+    except Exception as exc:
+        raise RetentionError('Could not look up pinned T5 domain: ' + str(exc)) from exc
+    if domain.UUIDString().lower() != DOMAIN_UUID:
+        raise RetentionError('Live libvirt domain UUID differs from pinned debug3 UUID')
+    state, reason = domain.state(0)
+    active = bool(domain.isActive())
+    inactive_xml = domain.XMLDesc(libvirt.VIR_DOMAIN_XML_INACTIVE)
+    live_xml = domain.XMLDesc(0) if active else None
+    require_domain_identity(inactive_xml, 'inactive domain')
+    if live_xml is not None:
+        require_domain_identity(live_xml, 'live domain')
+    return {'domain': domain, 'state': state, 'state_name': libvirt_state_name(libvirt, state),
+            'reason': reason, 'active': active, 'inactive_xml': inactive_xml, 'live_xml': live_xml}
+
+
+def live_preflight(args):
+    root = Path(args.repo_root).resolve()
+    evidence = Path(args.evidence_dir).resolve()
+    run_dir = os.path.realpath(args.run_dir)
+    state_dir = Path(args.state_dir).resolve()
+    if args.domain != DOMAIN or args.expected_uuid.lower() != DOMAIN_UUID:
+        raise RetentionError('Failure-preservation T5 path is pinned only for win10-debug3')
+    if run_dir != POOL_PATH:
+        raise RetentionError('T5 run overlay path differs from the pinned NAS pool directory')
+    runner_workspace = Path(RUNNER_WORKSPACE_ROOT) / args.tag
+    if (root != Path('/usr/local/libexec/safeupload-t5-copy-r2')
+            or evidence != runner_workspace / 'driver' / 'evidence' / evidence.name
+            or state_dir != runner_workspace / 'state'
+            or re.fullmatch(r'\d{4}-\d{2}-\d{2}', evidence.name) is None):
+        raise RetentionError('T5 code, evidence, or state path is outside the fixed installed-run layout')
+    if not re.fullmatch(r'[A-Za-z0-9]{3,30}', args.tag):
+        raise RetentionError('Invalid T5 retention tag')
+    for path in (evidence / (args.tag + '-prebegin.json'), evidence / (args.tag + '-prebegin-inactive.xml'),
+                 evidence / (args.tag + '-run-begin.txt')):
+        if path.exists() or path.is_symlink():
+            raise RetentionError('T5 prebegin evidence path already exists: ' + str(path))
+    if not evidence.is_dir():
+        raise RetentionError('T5 evidence date directory does not exist')
+    baseline, preflight = load_pinned_receipts(root)
+    if (Path(args.state_dir, DOMAIN).exists() or Path(args.state_dir, DOMAIN).is_symlink()
+            or marker_path(state_dir).exists() or marker_path(state_dir).is_symlink()
+            or inprogress_path(state_dir).exists() or inprogress_path(state_dir).is_symlink()):
+        raise RetentionError('T5 run state or durable progress/retention guard already exists')
+    overlay_path = str(Path(run_dir) / (DOMAIN + '.safeupload-run-' + args.tag + '.qcow2'))
+    if os.path.lexists(overlay_path):
+        raise RetentionError('T5 expected run overlay already exists')
+
+    libvirt, conn = open_connection()
+    try:
+        pool = pool_for_exact_path(conn, run_dir)
+        snap = domain_snapshot(conn, libvirt)
+        if snap['state'] != libvirt.VIR_DOMAIN_SHUTOFF or snap['active']:
+            raise RetentionError('T5 debug3 must be shut off before run begin')
+        expected_private_xml = expected_private_state_xml(baseline['InactiveXML'], args.tag)
+        if xml_semantics(snap['inactive_xml'], 'current inactive domain') != xml_semantics(
+                expected_private_xml, 'expected private-state domain'):
+            raise RetentionError('Current inactive XML differs outside the exact private NVRAM/TPM binding')
+        reject_unisolated_writable_domain_state(snap['inactive_xml'], args.tag)
+        if vda_path(snap['inactive_xml'], 'current inactive domain') != baseline['BasePath']:
+            raise RetentionError('Current inactive vda is not the pinned exact base')
+        volumes = sha_baseline_volumes(conn, baseline, root, run_dir)
+        for suffix in ('memory.elf', 'memory-probe.raw'):
+            candidate = DOMAIN + '.safeupload-t5-' + args.tag + '-' + suffix
+            if pool_lookup_volume(pool, candidate, libvirt) is not None:
+                raise RetentionError('T5 private volume name already exists: ' + candidate)
+        pins = expected_input_fields(args.tag, args.mode, args.driver_sha, args.zip_sha, args.service_sha)
+        inputs = validate_current_inputs(evidence, args.tag, args.mode, args.driver_sha,
+                                         args.zip_sha, args.service_sha)
+        if inputs != pins:
+            raise RetentionError('T5 input pins do not match current invocation')
+        xml_bytes = snap['inactive_xml'].encode('utf-8')
+        xml_hash = sha256_bytes(xml_bytes)
+        atomic_write(evidence / (args.tag + '-prebegin-inactive.xml'), xml_bytes)
+        record = {
+            'Schema': 'T5PrebeginPinV1', 'CapturedUTC': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+            'Domain': DOMAIN, 'UUID': DOMAIN_UUID, 'State': 'shut off', 'Active': False,
+            'RunTag': args.tag, 'Mode': args.mode, 'RunPoolPath': run_dir, 'RunPoolName': pool.name(),
+            'BaselineReceiptPath': str(root / BASELINE_RECEIPT), 'BaselineReceiptSHA256': BASELINE_SHA256,
+            'PreflightReceiptPath': str(root / PREFLIGHT_RECEIPT), 'PreflightReceiptSHA256': PREFLIGHT_SHA256,
+            'OriginalInactiveXMLSHA256': sha256_bytes(baseline['InactiveXML'].encode('utf-8')),
+            'InputPins': pins, 'InactiveXMLPath': str(evidence / (args.tag + '-prebegin-inactive.xml')),
+            'InactiveXMLSHA256': xml_hash, 'BasePath': baseline['BasePath'],
+            'BaseVolumeXML': volumes['base'].XMLDesc(0), 'BaseSHA256': volumes['base_hash']['sha256'],
+            'BaseBytes': volumes['base_hash']['bytes'], 'BackingPath': baseline['BackingPath'],
+            'BackingVolumeXML': volumes['backing'].XMLDesc(0),
+            'BackingSHA256': volumes['backing_hash']['sha256'],
+            'BackingBytes': volumes['backing_hash']['bytes'],
+        }
+        atomic_json(evidence / (args.tag + '-prebegin.json'), record)
+        return record
+    finally:
+        conn.close()
+
+
+def _private_nvram_path(tag):
+    if not isinstance(tag, str) or re.fullmatch(r'[A-Za-z0-9]{3,30}', tag) is None:
+        raise RetentionError('Invalid T5 private-state run tag')
+    return (RUN_POOL_PARENT + '/t5-copy-' + tag + '-run-nvram/'
+            + DOMAIN + '_VARS.fd')
+
+
+def _private_tpm_path(tag):
+    if not isinstance(tag, str) or re.fullmatch(r'[A-Za-z0-9]{3,30}', tag) is None:
+        raise RetentionError('Invalid T5 private-state run tag')
+    return RUN_POOL_PARENT + '/t5-copy-' + tag + '-run-tpm'
+
+
+def reject_unisolated_writable_domain_state(xml_text, tag=DEFAULT_RUN_TAG):
+    """Require the exact private NVRAM/TPM substitutions before run-disk."""
+    root = ET.fromstring(xml_text)
+    nvram = root.findall('./os/nvram')
+    varstore = root.findall('./os/varstore')
+    tpm_emulators = []
+    for node in root.findall('./devices/tpm'):
+        backend = node.find('backend')
+        if backend is not None and backend.get('type') == 'emulator':
+            tpm_emulators.append(node)
+    if len(nvram) != 1 or varstore or len(tpm_emulators) != 1:
+        raise RetentionError('T5 run XML lacks the exact single UEFI NVRAM and emulator TPM bindings')
+    if (nvram[0].text or '').strip() != _private_nvram_path(tag):
+        raise RetentionError('T5 run XML does not bind the exact private NVRAM copy')
+    backend = tpm_emulators[0].find('backend')
+    if (backend is None or backend.get('version') != '2.0'
+            or backend.get('persistent_state') != 'yes'
+            or backend.findall('source') != [backend.find('source')]
+            or backend.find('source') is None
+            or backend.find('source').get('type') != 'dir'
+            or backend.find('source').get('path') != _private_tpm_path(tag)):
+        raise RetentionError('T5 run XML does not bind the exact private opaque TPM copy')
+
+
+def expected_private_state_xml(original_xml, tag=DEFAULT_RUN_TAG):
+    root = require_domain_identity(original_xml, 'pinned original baseline')
+    nvram = root.findall('./os/nvram')
+    varstore = root.findall('./os/varstore')
+    emulators = []
+    for node in root.findall('./devices/tpm'):
+        backend = node.find('backend')
+        if backend is not None and backend.get('type') == 'emulator':
+            emulators.append(backend)
+    if len(nvram) != 1 or varstore or len(emulators) != 1:
+        raise RetentionError('pinned baseline lacks the exact original UEFI/TPM shape')
+    if (nvram[0].text or '').strip() != ORIGINAL_NVRAM_PATH:
+        raise RetentionError('pinned baseline NVRAM path differs from the reviewed source')
+    backend = emulators[0]
+    if backend.findall('source'):
+        raise RetentionError('pinned baseline TPM already has an unexpected source')
+    nvram[0].text = _private_nvram_path(tag)
+    backend.set('persistent_state', 'yes')
+    ET.SubElement(backend, 'source', {'type': 'dir', 'path': _private_tpm_path(tag)})
+    return ET.tostring(root, encoding='unicode')
+
+
+def arm_progress(args):
+    if args.domain != DOMAIN or args.expected_uuid.lower() != DOMAIN_UUID:
+        raise RetentionError('T5 progress guard is pinned only for win10-debug3')
+    if not re.fullmatch(r'[A-Za-z0-9]{3,30}', args.tag):
+        raise RetentionError('Invalid T5 progress-guard tag')
+    evidence = Path(args.evidence_dir).resolve()
+    prebegin = read_prebegin(evidence, args.tag, args.repo_root)
+    validate_current_inputs(evidence, args.tag, args.mode, args.driver_sha,
+                            args.zip_sha, args.service_sha, prebegin)
+    token = create_progress_guard(args.state_dir, args.tag, args.owner_pid)
+    print('T5_INPROGRESS=ARMED token=' + token)
+    return 0
+
+
+def cancel_progress(args):
+    if not args.guard_token:
+        raise RetentionError('Missing exact T5 progress-guard token')
+    verify_progress_guard(args.state_dir, args.tag, args.guard_token, args.owner_pid)
+    result = inspect_mutation(args)
+    if result['Mutation']:
+        raise RetentionError('Cannot clear T5 guard while disk/domain mutation exists: ' +
+                             '; '.join(result['Reasons']))
+    emit_no_mutation(args, args.reason)
+    remove_progress_guard(args.state_dir, args.tag, args.guard_token, args.owner_pid)
+    print('T5_INPROGRESS=REMOVED; no run-disk mutation was observed')
+    return 0
+
+
+def read_prebegin(evidence_dir, tag, repo_root):
+    record_path = Path(evidence_dir) / (tag + '-prebegin.json')
+    record = parse_json_unique(record_path)
+    if (record.get('Schema') != 'T5PrebeginPinV1' or record.get('RunTag') != tag
+            or record.get('Domain') != DOMAIN or record.get('UUID') != DOMAIN_UUID
+            or record.get('BaselineReceiptSHA256') != BASELINE_SHA256
+            or record.get('PreflightReceiptSHA256') != PREFLIGHT_SHA256
+            or record.get('OriginalInactiveXMLSHA256') != sha256_bytes(
+                load_pinned_receipts(Path(repo_root).resolve())[0]['InactiveXML'].encode('utf-8'))):
+        raise RetentionError('T5 prebegin pin is malformed or belongs to a different run')
+    xml_path = Path(evidence_dir) / (tag + '-prebegin-inactive.xml')
+    if record.get('InactiveXMLPath') != str(xml_path):
+        raise RetentionError('T5 prebegin inactive XML path does not match the exact tag evidence path')
+    if sha256_file(xml_path) != record.get('InactiveXMLSHA256'):
+        raise RetentionError('Saved full inactive XML no longer matches its prebegin hash')
+    baseline, _preflight = load_pinned_receipts(Path(repo_root).resolve())
+    if (record.get('BasePath') != baseline['BasePath'] or record.get('BackingPath') != baseline['BackingPath']
+            or record.get('BaseSHA256') != BASE_VOLUME_SHA256
+            or record.get('BackingSHA256') != BACKING_VOLUME_SHA256
+            or xml_semantics(xml_path.read_text(encoding='utf-8'), 'saved prebegin private-state XML') !=
+            xml_semantics(expected_private_state_xml(baseline['InactiveXML'], tag),
+                          'expected private-state XML')):
+        raise RetentionError('T5 prebegin private-state pin does not match the independently pinned baseline identity')
+    baseline_base = parse_volume_xml(baseline['BaseVolumeXML'], 'pinned baseline base')
+    pinned_base = parse_volume_xml(record['BaseVolumeXML'], 'prebegin base')
+    baseline_backing = parse_volume_xml(baseline['BackingVolumeXML'], 'pinned baseline backing')
+    pinned_backing = parse_volume_xml(record['BackingVolumeXML'], 'prebegin backing')
+    for label, expected, observed in (('base', baseline_base, pinned_base),
+                                      ('backing', baseline_backing, pinned_backing)):
+        for field in ('name', 'path', 'capacity', 'allocation', 'physical', 'format',
+                      'backing_path', 'backing_format', 'mode', 'owner', 'group'):
+            if observed[field] != expected[field]:
+                raise RetentionError('T5 prebegin ' + label + ' volume identity differs from pinned baseline: ' + field)
+    if private_identity_from_pinned_base(record) != private_identity_from_pinned_base(baseline):
+        raise RetentionError('T5 prebegin volume permissions differ from pinned QEMU-private identity')
+    if (record.get('BaseBytes') != parse_volume_xml(baseline['BaseVolumeXML'], 'pinned base')['physical']
+            or record.get('BackingBytes') != parse_volume_xml(baseline['BackingVolumeXML'], 'pinned backing')['physical']):
+        raise RetentionError('T5 prebegin full-stream lengths differ from pinned physical file lengths')
+    if record.get('RunPoolPath') != POOL_PATH:
+        raise RetentionError('T5 prebegin run-pool path mismatch')
+    return record
+
+
+def inspect_mutation(args):
+    """Prove no run-begin mutation only when every read-only check succeeds."""
+    prebegin = read_prebegin(args.evidence_dir, args.tag, args.repo_root)
+    baseline_xml = Path(prebegin['InactiveXMLPath']).read_text(encoding='utf-8')
+    state_path = Path(args.state_dir) / DOMAIN
+    overlay_path = str(Path(POOL_PATH) / (DOMAIN + '.safeupload-run-' + args.tag + '.qcow2'))
+    state_present = state_path.exists() or state_path.is_symlink()
+    libvirt, conn = open_connection()
+    try:
+        snap = domain_snapshot(conn, libvirt)
+        base_path = prebegin['BasePath']
+        reasons = []
+        if state_present:
+            reasons.append('run-state-file-present')
+        if snap['active'] or snap['state'] != libvirt.VIR_DOMAIN_SHUTOFF:
+            reasons.append('domain-state-changed-to-' + snap['state_name'])
+        if xml_semantics(snap['inactive_xml'], 'current inactive domain') != \
+                xml_semantics(baseline_xml, 'pinned prebegin domain'):
+            reasons.append('inactive-definition-differs-from-prebegin')
+        if vda_path(snap['inactive_xml'], 'current inactive domain') != base_path:
+            reasons.append('inactive-vda-no-longer-base')
+        if snap['live_xml'] and vda_path(snap['live_xml'], 'live domain') != base_path:
+            reasons.append('live-vda-no-longer-base')
+        if snap['live_xml']:
+            try:
+                verify_active_definition(snap['live_xml'], baseline_xml, 'current live domain')
+            except RetentionError:
+                reasons.append('live-definition-differs-from-prebegin')
+        vol = volume_by_path(conn, overlay_path, libvirt)
+        if vol is not None or os.path.lexists(overlay_path):
+            reasons.append('tagged-run-overlay-exists')
+        return {'Mutation': bool(reasons), 'Reasons': reasons,
+                'StateFilePresent': state_present, 'DomainState': snap['state_name'],
+                'InactiveVda': vda_path(snap['inactive_xml'], 'current inactive domain'),
+                'OverlayPath': overlay_path}
+    finally:
+        conn.close()
+
+
+def pinned_volume_hash(conn, volume, expected_xml, label, expected_sha256):
+    details = check_volume_identity(volume, parse_volume_xml(expected_xml, 'pinned ' + label)['path'],
+                                    'qcow2', label)
+    pinned = parse_volume_xml(expected_xml, 'pinned ' + label)
+    for field in ('name', 'path', 'capacity', 'allocation', 'physical', 'format',
+                  'backing_path', 'backing_format', 'mode', 'owner', 'group'):
+        if details[field] != pinned[field]:
+            raise RetentionError(label + ' volume identity differs from its pinned XML: ' + field)
+    result = volume_sha256(conn, volume)
+    if result['sha256'] != expected_sha256 or result['bytes'] != pinned['physical']:
+        raise RetentionError(label + ' full physical-file hash/length differs from the pinned baseline')
+    return {'details': details, 'stream': result}
+
+
+def t5_pre_cleanup(args):
+    state_dir = Path(args.state_dir).resolve()
+    evidence = Path(args.evidence_dir).resolve()
+    root = Path(args.repo_root).resolve()
+    if not args.guard_token:
+        raise RetentionError('Missing exact T5 in-progress guard token')
+    verify_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+    prebegin = read_prebegin(evidence, args.tag, root)
+    validate_current_inputs(evidence, args.tag, args.mode, args.driver_sha,
+                            args.zip_sha, args.service_sha, prebegin)
+    pinned_xml = Path(prebegin['InactiveXMLPath']).read_text(encoding='utf-8')
+    overlay_path = str(Path(POOL_PATH) / (DOMAIN + '.safeupload-run-' + args.tag + '.qcow2'))
+    state_path = state_dir / DOMAIN
+    state = parse_state_file(state_path, args.tag, prebegin['BasePath'], overlay_path)
+    if state is None:
+        raise RetentionError('Complete-evidence cleanup requires the exact current run-state file')
+    libvirt, conn = open_connection()
+    try:
+        pool = pool_for_exact_path(conn, POOL_PATH)
+        if pool.name() != prebegin.get('RunPoolName'):
+            raise RetentionError('T5 run pool name changed before complete-evidence cleanup')
+        snap = domain_snapshot(conn, libvirt)
+        if vda_path(snap['inactive_xml'], 'pre-cleanup inactive domain') != overlay_path:
+            raise RetentionError('Pre-cleanup inactive vda is not the exact tag overlay')
+        verify_run_definition(snap['inactive_xml'], pinned_xml, overlay_path,
+                              'pre-cleanup inactive run domain')
+        if snap['active']:
+            if snap['state'] != libvirt.VIR_DOMAIN_RUNNING or snap['live_xml'] is None:
+                raise RetentionError('Pre-cleanup active domain is not in the running state')
+            if vda_path(snap['live_xml'], 'pre-cleanup live domain') != overlay_path:
+                raise RetentionError('Pre-cleanup live vda is not the exact tag overlay')
+            verify_active_run_definition(snap['live_xml'], pinned_xml, overlay_path,
+                                         'pre-cleanup live run domain')
+        overlay = volume_by_path(conn, overlay_path, libvirt)
+        if overlay is None:
+            raise RetentionError('Pre-cleanup exact run overlay is not registered')
+        overlay_details = check_volume_identity(overlay, overlay_path, 'qcow2', 'pre-cleanup overlay',
+                                                expected_name=Path(overlay_path).name,
+                                                expected_backing=prebegin['BasePath'])
+        if overlay_details['backing_format'] != 'qcow2':
+            raise RetentionError('Pre-cleanup run overlay does not declare a qcow2 backing format')
+        if overlay_details['capacity'] != parse_volume_xml(prebegin['BaseVolumeXML'], 'pinned base')['capacity']:
+            raise RetentionError('Pre-cleanup overlay virtual capacity differs from pinned base capacity')
+        base = volume_by_path(conn, prebegin['BasePath'], libvirt)
+        backing = volume_by_path(conn, prebegin['BackingPath'], libvirt)
+        if base is None or backing is None:
+            raise RetentionError('Pre-cleanup pinned base/backing volume is absent')
+        base_result = pinned_volume_hash(conn, base, prebegin['BaseVolumeXML'], 'base', BASE_VOLUME_SHA256)
+        backing_result = pinned_volume_hash(conn, backing, prebegin['BackingVolumeXML'],
+                                            'backing', BACKING_VOLUME_SHA256)
+        receipt = {
+            'Schema': 'T5PreCleanupVerificationV1', 'RunTag': args.tag, 'Domain': DOMAIN,
+            'UUID': DOMAIN_UUID, 'InputPins': prebegin['InputPins'],
+            'RunPoolPath': POOL_PATH, 'RunPoolName': pool.name(),
+            'StateSHA256': sha256_bytes(state['bytes']), 'DomainState': snap['state_name'],
+            'Active': snap['active'], 'InactiveXMLSHA256': sha256_bytes(snap['inactive_xml'].encode('utf-8')),
+            'LiveXMLSHA256': sha256_bytes(snap['live_xml'].encode('utf-8')) if snap['live_xml'] else None,
+            'OverlayPath': overlay_path, 'OverlayVolume': overlay_details,
+            'BaseSHA256': base_result['stream']['sha256'], 'BaseBytes': base_result['stream']['bytes'],
+            'BackingSHA256': backing_result['stream']['sha256'],
+            'BackingBytes': backing_result['stream']['bytes'],
+        }
+        atomic_json(evidence / (args.tag + '-pre-cleanup.json'), receipt)
+        print('T5_PRE_CLEANUP=PASS base=' + receipt['BaseSHA256'] +
+              ' backing=' + receipt['BackingSHA256'] + ' overlay=' + overlay_path)
+        return 0
+    finally:
+        conn.close()
+
+
+def t5_verify_cleanup(args):
+    state_dir = Path(args.state_dir).resolve()
+    evidence = Path(args.evidence_dir).resolve()
+    root = Path(args.repo_root).resolve()
+    if not args.guard_token:
+        raise RetentionError('Missing exact T5 in-progress guard token')
+    verify_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+    prebegin = read_prebegin(evidence, args.tag, root)
+    validate_current_inputs(evidence, args.tag, args.mode, args.driver_sha,
+                            args.zip_sha, args.service_sha, prebegin)
+    pre_path = evidence / (args.tag + '-pre-cleanup.json')
+    pre = parse_json_unique(pre_path)
+    if (pre.get('Schema') != 'T5PreCleanupVerificationV1' or pre.get('RunTag') != args.tag
+            or pre.get('Domain') != DOMAIN or pre.get('UUID') != DOMAIN_UUID
+            or pre.get('InputPins') != prebegin['InputPins']
+            or pre.get('BaseSHA256') != BASE_VOLUME_SHA256
+            or pre.get('BackingSHA256') != BACKING_VOLUME_SHA256):
+        raise RetentionError('Pre-cleanup receipt does not bind the exact current T5 baseline')
+    state_path = state_dir / DOMAIN
+    overlay_path = str(Path(POOL_PATH) / (DOMAIN + '.safeupload-run-' + args.tag + '.qcow2'))
+    if state_path.exists() or state_path.is_symlink():
+        raise RetentionError('Run-disk state remains after shared cleanup')
+    libvirt, conn = open_connection()
+    try:
+        pool = pool_for_exact_path(conn, POOL_PATH)
+        if pool.name() != prebegin.get('RunPoolName'):
+            raise RetentionError('T5 run pool name changed after complete-evidence cleanup')
+        snap = domain_snapshot(conn, libvirt)
+        if snap['active'] or snap['state'] != libvirt.VIR_DOMAIN_SHUTOFF:
+            raise RetentionError('Post-cleanup domain is not confirmed shut off')
+        pinned_xml = Path(prebegin['InactiveXMLPath']).read_text(encoding='utf-8')
+        if (xml_semantics(snap['inactive_xml'], 'post-cleanup inactive domain') !=
+                xml_semantics(pinned_xml, 'pinned prebegin XML')
+                or vda_path(snap['inactive_xml'], 'post-cleanup inactive domain') != prebegin['BasePath']):
+            raise RetentionError('Post-cleanup whole-tree XML/vda does not match the pinned base definition')
+        overlay = volume_by_path(conn, overlay_path, libvirt)
+        if overlay is not None or os.path.lexists(overlay_path):
+            raise RetentionError('Tag-specific run overlay remains registered or present after cleanup')
+        base = volume_by_path(conn, prebegin['BasePath'], libvirt)
+        backing = volume_by_path(conn, prebegin['BackingPath'], libvirt)
+        if base is None or backing is None:
+            raise RetentionError('Pinned base/backing volume is absent after cleanup')
+        base_result = pinned_volume_hash(conn, base, prebegin['BaseVolumeXML'], 'post-cleanup base',
+                                         BASE_VOLUME_SHA256)
+        backing_result = pinned_volume_hash(conn, backing, prebegin['BackingVolumeXML'],
+                                           'post-cleanup backing', BACKING_VOLUME_SHA256)
+        receipt = {
+            'Schema': 'T5PostCleanupVerificationV1', 'RunTag': args.tag, 'Domain': DOMAIN,
+            'UUID': DOMAIN_UUID, 'DomainState': snap['state_name'], 'Active': False,
+            'WholeTreeXMLMatchesPrebegin': True, 'InactiveVdaIsPinnedBase': True,
+            'RunDiskStateAbsent': True, 'RunOverlayAbsent': True,
+            'BaseSHA256': base_result['stream']['sha256'], 'BaseBytes': base_result['stream']['bytes'],
+            'BackingSHA256': backing_result['stream']['sha256'],
+            'BackingBytes': backing_result['stream']['bytes'],
+            'PreCleanupReceiptSHA256': sha256_file(pre_path),
+        }
+        post_path = evidence / (args.tag + '-post-cleanup-verification.json')
+        atomic_json(post_path, receipt)
+        if parse_json_unique(post_path) != receipt:
+            raise RetentionError('Post-cleanup verification receipt did not round-trip exactly')
+        verify_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+        remove_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+        print('T5PostCleanup=PASS')
+        print('RunDiskBaseUntouched=True')
+        return 0
+    finally:
+        conn.close()
+
+
+def exact_write_marker(state_dir, tag, prebegin_path):
+    path = marker_path(state_dir)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if path.exists() or path.is_symlink():
+        raise RetentionError('A T5 retained-state marker already exists; refusing replacement')
+    prebegin_path = Path(prebegin_path)
+    prebegin_hash = sha256_file(prebegin_path) if prebegin_path.is_file() and not prebegin_path.is_symlink() else None
+    payload = (json.dumps({'Schema': 'T5RetentionMarkerV1', 'Domain': DOMAIN,
+                           'RunTag': tag, 'CreatedUTC': datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                           'PrebeginPath': str(prebegin_path), 'PrebeginSHA256': prebegin_hash},
+                          sort_keys=True) + '\n').encode('utf-8')
+    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
+    try:
+        view = memoryview(payload)
+        while view:
+            view = view[os.write(fd, view):]
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    fsync_directory(path.parent)
+    return path
+
+
+def append_attempt(evidence_dir, tag, line):
+    path = Path(evidence_dir) / (tag + '-retention-attempt.txt')
+    flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND | getattr(os, 'O_NOFOLLOW', 0)
+    fd = os.open(str(path), flags, 0o600)
+    try:
+        view = memoryview((line.rstrip('\n') + '\n').encode('utf-8'))
+        while view:
+            view = view[os.write(fd, view):]
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    fsync_directory(path.parent)
+
+
+def memory_volume_name(tag):
+    return DOMAIN + '.safeupload-t5-' + tag + '-memory.elf'
+
+
+def make_memory_volume_xml(name, capacity, identity):
+    root = ET.Element('volume')
+    ET.SubElement(root, 'name').text = name
+    ET.SubElement(root, 'capacity', {'unit': 'bytes'}).text = str(capacity)
+    ET.SubElement(root, 'allocation', {'unit': 'bytes'}).text = '0'
+    target = ET.SubElement(root, 'target')
+    ET.SubElement(target, 'format', {'type': 'raw'})
+    permissions = ET.SubElement(target, 'permissions')
+    ET.SubElement(permissions, 'mode').text = format(identity['mode'], '04o')
+    ET.SubElement(permissions, 'owner').text = str(identity['owner'])
+    ET.SubElement(permissions, 'group').text = str(identity['group'])
+    return ET.tostring(root, encoding='unicode')
+
+
+def _merge_ranges(ranges, label):
+    ordered = sorted((int(start), int(end)) for start, end in ranges)
+    merged = []
+    for start, end in ordered:
+        if start < 0 or end <= start or end > (1 << 64):
+            raise RetentionError(label + ' contains an invalid 64-bit physical interval')
+        if merged and start < merged[-1][1]:
+            raise RetentionError(label + ' contains overlapping or duplicate physical intervals')
+        if merged and start == merged[-1][1]:
+            merged[-1] = (merged[-1][0], end)
+        else:
+            merged.append((start, end))
+    return merged
+
+
+def _mtree_owner_suffix(tail, line_number):
+    """Split the exact `info mtree -o` owner/parent suffix from a row label."""
+    owner = None
+    parent = None
+    orphan = False
+    text = tail.rstrip()
+    if text.endswith(' orphan'):
+        text = text[:-7]
+        orphan = True
+    parent_match = re.search(r' parent:\{([^{}]+)\}$', text)
+    if parent_match:
+        parent = parent_match.group(1)
+        text = text[:parent_match.start()]
+    owner_match = re.search(r' owner:\{([^{}]+)\}$', text)
+    if owner_match:
+        owner = owner_match.group(1)
+        text = text[:owner_match.start()]
+    if not (orphan or owner is not None or parent is not None) or not text.strip():
+        raise RetentionError('QEMU `info mtree -o` owner/parent row syntax is incomplete at line %d' % line_number)
+    for value in (owner, parent):
+        if value is not None and (not value or any(ord(c) < 0x20 for c in value)):
+            raise RetentionError('QEMU memory-region owner metadata is malformed at line %d' % line_number)
+    return text.strip(), owner, parent, orphan
+
+
+def _mtree_rows(text, label, flatview):
+    if not isinstance(text, str) or not text or '\x00' in text:
+        raise RetentionError(label + ' output is empty or malformed')
+    encoded = text.encode('utf-8', 'strict')
+    if len(encoded) > MAX_QEMU_MTREE_BYTES:
+        raise RetentionError(label + ' output exceeds the pinned inspection limit')
+    range_re = re.compile(
+        r'^\s+([0-9a-fA-F]{1,16})-([0-9a-fA-F]{1,16}) '
+        r'\(prio (-?[0-9]+), (nv-)?(ramd|ram|romd|rom|i/o|container)\): (.+)$')
+    rows = []
+    flatview_re = re.compile(r'^FlatView #([0-9]+)$')
+    address_space_re = re.compile(r'^ AS "([^"]+)", root: (.+)$')
+    in_memory_view = False
+    current_flatview = None
+    flatview_has_memory = False
+    memory_views = 0
+    for line_number, line in enumerate(text.splitlines(), 1):
+        if flatview:
+            view_match = flatview_re.fullmatch(line)
+            if view_match:
+                current_flatview = int(view_match.group(1))
+                in_memory_view = False
+                flatview_has_memory = False
+                continue
+            as_match = address_space_re.fullmatch(line)
+            if as_match:
+                if current_flatview is None:
+                    raise RetentionError('QEMU memory-tree address space precedes every FlatView header')
+                if as_match.group(1) == 'memory':
+                    flatview_has_memory = True
+                    if as_match.group(2) != 'system':
+                        raise RetentionError('QEMU guest physical address space does not have the pinned system root')
+                continue
+            if line.startswith(' Root memory region: '):
+                in_memory_view = flatview_has_memory
+                if in_memory_view:
+                    memory_views += 1
+                continue
+            if not in_memory_view:
+                continue
+        if not re.match(r'^\s+[0-9a-fA-F]{1,16}-', line):
+            continue
+        match = range_re.fullmatch(line)
+        if match is None:
+            raise RetentionError('Unrecognized QEMU %s range syntax at line %d' % (label, line_number))
+        start = int(match.group(1), 16)
+        # QEMU's mtree range end is start + size - 1 (MR_SIZE), so convert it
+        # into the half-open intervals used by the ELF validator.
+        end = int(match.group(2), 16) + 1
+        kind = match.group(5)
+        nonvolatile = match.group(4) is not None
+        tail = match.group(6)
+        accelerator = None
+        if flatview:
+            # QEMU appends the accelerator label only for rows handled by that
+            # accelerator; absence is normal for MMIO rows. The selected
+            # runner is KVM-pinned, so any present label must be exactly KVM.
+            accelerator_match = re.search(r' KVM$', tail)
+            other_accel = re.search(r' (?:TCG|HVF|WHPX|NVMM|Xen)$', tail)
+            if other_accel is not None:
+                raise RetentionError('QEMU system-memory FlatView row reports an unpinned accelerator')
+            if accelerator_match:
+                accelerator = 'KVM'
+                tail = tail[:accelerator_match.start()]
+        region_tail, owner, parent, orphan = _mtree_owner_suffix(tail, line_number)
+        offset = None
+        region = region_tail
+        if flatview:
+            offset_match = re.fullmatch(r'(.+?) @([0-9a-fA-F]{1,16})', region_tail)
+            if offset_match:
+                region = offset_match.group(1).strip()
+                offset = int(offset_match.group(2), 16)
+        else:
+            # info mtree's non-flat tree labels aliases as
+            # `alias NAME @TARGET START-END`; the target MemoryRegion also has
+            # its own row and is the object referenced by FlatView.
+            alias_match = re.fullmatch(
+                r'alias (.+?) @(.+) ([0-9a-fA-F]{1,16})-([0-9a-fA-F]{1,16})', region_tail)
+            if alias_match:
+                region = alias_match.group(1).strip()
+        if end <= start or end > (1 << 64) or not region:
+            raise RetentionError('QEMU %s range is invalid at line %d' % (label, line_number))
+        if any(ord(character) < 0x20 for character in region):
+            raise RetentionError('QEMU %s region label has control characters' % label)
+        rows.append({'start': start, 'end': end, 'kind': kind,
+                     'nonvolatile': nonvolatile, 'region': region,
+                     'owner': owner, 'parent': parent, 'orphan': orphan,
+                     'offset': offset, 'accelerator': accelerator,
+                     'flatview': current_flatview if flatview else None})
+    if flatview and (memory_views != 1 or not rows):
+        raise RetentionError('QEMU output must contain exactly one nonempty system-memory FlatView')
+    if not flatview and not rows:
+        raise RetentionError('QEMU `info mtree -o` contains no raw MemoryRegion rows')
+    return rows
+
+
+def parse_qemu_ram_map(flatview_text, region_tree_text, guest_memory_bytes=None):
+    """Classify a paused QEMU system-memory FlatView against raw MR types.
+
+    `info mtree -f` replaces readonly range types with `rom`, so its output
+    alone cannot separate read-only MR_RAM from non-RAM ROM/ROMD.  The paired
+    `info mtree -o` tree shows memory_region_type(MR): `rom` means
+    mr->ram && mr->readonly, while `romd` and `i/o` are not MR_RAM.  Matching
+    exact region name and owner identity lets this code follow QEMU's dump
+    listener predicate without treating every ROMD as RAM.
+    """
+    flat_rows = _mtree_rows(flatview_text, 'FlatView', True)
+    tree_rows = _mtree_rows(region_tree_text, 'MemoryRegion tree', False)
+    flatview_id = flat_rows[0]['flatview']
+    definitions = {}
+    for row in tree_rows:
+        key = (row['region'], row['owner'], row['parent'], row['orphan'])
+        definitions.setdefault(key, set()).add((row['kind'], row['nonvolatile']))
+    dumpable = []
+    matched_rows = []
+    for row in flat_rows:
+        key = (row['region'], row['owner'], row['parent'], row['orphan'])
+        types = definitions.get(key)
+        if not types or len(types) != 1:
+            raise RetentionError('FlatView region has no unique raw MemoryRegion type/identity: ' + row['region'])
+        raw_kind, raw_nonvolatile = next(iter(types))
+        visible_kind = row['kind']
+        compatible = {
+            'ram': ('ram',),
+            # -f presents any readonly FlatRange as `rom`, even when the raw
+            # MemoryRegion is a container. Keep its raw type in the join so it
+            # remains excluded from the dump predicate below.
+            'rom': ('ram', 'rom', 'ramd', 'romd', 'i/o', 'container'),
+            'ramd': ('ramd',),
+            'romd': ('romd',),
+            'i/o': ('i/o', 'container'),
+        }
+        if raw_kind not in compatible.get(visible_kind, ()):
+            raise RetentionError('FlatView type conflicts with the raw MemoryRegion type for ' + row['region'])
+        entry = dict(row)
+        entry['RawMemoryRegionKind'] = raw_kind
+        entry['RawMemoryRegionNonvolatile'] = raw_nonvolatile
+        matched_rows.append(entry)
+        # QEMU v11.1.1 memory_region_is_ram() returns mr->ram; its raw type
+        # distinguishes readonly MR_RAM (`rom`) from ROMD (`romd`) and MMIO
+        # (`i/o`). QEMU's dump listener also excludes RAM-device and
+        # nonvolatile MemoryRegions.
+        if raw_kind in ('ram', 'rom') and not raw_nonvolatile:
+            dumpable.append((row['start'], row['end']))
+    if not dumpable:
+        raise RetentionError('QEMU system-memory FlatView contains no dumpable ordinary RAM')
+    ranges = _merge_ranges(dumpable, 'QEMU dumpable RAM map')
+    total = sum(end - start for start, end in ranges)
+    result = {'AddressSpace': 'memory', 'Root': 'system', 'FlatView': flatview_id,
+              'Entries': matched_rows, 'Ranges': [[start, end] for start, end in ranges],
+              'DumpableRAMBytes': total,
+              'DumpPredicate': 'MR_RAM excluding ram-device and nonvolatile regions'}
+    if guest_memory_bytes is not None:
+        result['ConfiguredGuestMemoryBytes'] = int(guest_memory_bytes)
+    return result
+
+
+def capture_qemu_ram_region_map(guest_memory_bytes):
+    captures = {}
+    commands = {'FlatView': QEMU_MTREE_FLATVIEW_COMMAND,
+                'RegionTree': QEMU_MTREE_REGION_TREE_COMMAND}
+    for name, command in commands.items():
+        try:
+            result = subprocess.run(command, stdout=subprocess.PIPE,
+                                    stderr=subprocess.PIPE, timeout=30, check=False)
+        except Exception as exc:
+            raise RetentionError('Could not capture read-only QEMU %s map: %s' % (name, exc)) from exc
+        if result.returncode != 0 or result.stderr:
+            stderr = result.stderr.decode('utf-8', 'replace') if isinstance(result.stderr, bytes) else str(result.stderr)
+            raise RetentionError('Read-only QEMU `info mtree` %s query failed: exit=%s stderr=%r' %
+                                 (name, result.returncode, stderr))
+        try:
+            raw = bytes(result.stdout)
+            text = raw.decode('utf-8', 'strict')
+        except Exception as exc:
+            raise RetentionError('QEMU %s map output is not strict UTF-8: %s' % (name, exc)) from exc
+        if not raw or len(raw) > MAX_QEMU_MTREE_BYTES:
+            raise RetentionError('QEMU %s map is empty or exceeds the pinned inspection limit' % name)
+        captures[name] = {'Command': command, 'Text': text,
+                          'SHA256': sha256_bytes(raw), 'Bytes': len(raw)}
+    parsed = parse_qemu_ram_map(captures['FlatView']['Text'], captures['RegionTree']['Text'],
+                                guest_memory_bytes)
+    return {'FlatView': captures['FlatView'], 'RegionTree': captures['RegionTree'], 'Parsed': parsed}
+
+
+def require_paused_by_t5(snapshot, libvirt, label):
+    expected_state = getattr(libvirt, 'VIR_DOMAIN_PAUSED', None)
+    expected_reason = getattr(libvirt, 'VIR_DOMAIN_PAUSED_USER', None)
+    if (expected_state is None or expected_reason is None or not snapshot['active']
+            or snapshot['state'] != expected_state or snapshot['reason'] != expected_reason
+            or snapshot['live_xml'] is None):
+        raise RetentionError(label + ' is not confirmed paused by this preservation operation')
+    return {'DomainStateCode': snapshot['state'], 'DomainStateName': snapshot['state_name'],
+            'DomainStateReasonCode': snapshot['reason'], 'DomainStateReasonName': 'PAUSED_USER'}
+
+
+def require_dump_shutdown(snapshot, libvirt):
+    expected_state = getattr(libvirt, 'VIR_DOMAIN_SHUTOFF', None)
+    expected_reason = getattr(libvirt, 'VIR_DOMAIN_SHUTOFF_CRASHED', None)
+    if (expected_state is None or expected_reason is None or snapshot['active']
+            or snapshot['state'] != expected_state or snapshot['reason'] != expected_reason
+            or snapshot['live_xml'] is not None):
+        raise RetentionError('RAM dump did not leave the guest in exact SHUTOFF/SHUTOFF_CRASHED state')
+    return {'DomainStateCode': snapshot['state'], 'DomainStateName': snapshot['state_name'],
+            'DomainStateReasonCode': snapshot['reason'], 'DomainStateReasonName': 'SHUTOFF_CRASHED'}
+
+
+def require_stable_qemu_ram_map(before, after):
+    if (not isinstance(before, dict) or not isinstance(after, dict)
+            or before.get('Parsed') != after.get('Parsed')):
+        raise RetentionError('Effective QEMU RAM map changed while the failed guest was paused')
+    for name in ('FlatView', 'RegionTree'):
+        before_capture = before.get(name)
+        after_capture = after.get(name)
+        fields = ('Command', 'Text', 'Bytes', 'SHA256')
+        if (not isinstance(before_capture, dict) or not isinstance(after_capture, dict)
+                or any(before_capture.get(field) != after_capture.get(field) for field in fields)):
+            raise RetentionError('Effective QEMU RAM map changed while the failed guest was paused')
+
+
+def verify_paused_failed_run(snapshot, libvirt, before_pause, pinned_inactive_xml,
+                             overlay_path, label):
+    pause_state = require_paused_by_t5(snapshot, libvirt, label)
+    if snapshot['domain'].UUIDString().lower() != DOMAIN_UUID:
+        raise RetentionError(label + ' UUID changed while preparing the RAM map')
+    if (xml_semantics(snapshot['inactive_xml'], label + ' inactive XML') !=
+            xml_semantics(before_pause['inactive_xml'], 'pre-pause inactive XML')
+            or xml_semantics(snapshot['live_xml'], label + ' live XML') !=
+            xml_semantics(before_pause['live_xml'], 'pre-pause live XML')):
+        raise RetentionError(label + ' domain XML changed while preparing the RAM map')
+    if (vda_path(snapshot['inactive_xml'], label + ' inactive XML') != overlay_path
+            or vda_path(snapshot['live_xml'], label + ' live XML') != overlay_path):
+        raise RetentionError(label + ' live/inactive vda escaped the exact run overlay')
+    verify_run_definition(snapshot['inactive_xml'], pinned_inactive_xml, overlay_path,
+                          label + ' inactive run domain')
+    verify_active_run_definition(snapshot['live_xml'], pinned_inactive_xml, overlay_path,
+                                 label + ' live run domain')
+    return pause_state
+
+
+def elf_validate(prefix, size, guest_memory_bytes, logical_capacity_bytes, expected_ram_ranges):
+    if len(prefix) < 64 or prefix[:4] != b'\x7fELF' or prefix[4] != 2 or prefix[5] != 1 or prefix[6] != 1:
+        raise RetentionError('RAM volume does not begin with a valid little-endian ELF64 header')
+    e_type, machine = struct.unpack_from('<HH', prefix, 16)
+    if e_type != 4 or machine != 62:
+        raise RetentionError('RAM ELF is not an x86-64 core file')
+    e_version = struct.unpack_from('<I', prefix, 20)[0]
+    phoff = struct.unpack_from('<Q', prefix, 32)[0]
+    ehsize, phentsize, phnum = struct.unpack_from('<HHH', prefix, 52)
+    if e_version != 1 or ehsize < 64 or phoff < ehsize or phentsize < 56 or phnum <= 0:
+        raise RetentionError('RAM ELF header has invalid version or program-header dimensions')
+    ph_end = phoff + phentsize * phnum
+    if ph_end > size or ph_end > len(prefix):
+        raise RetentionError('RAM ELF program-header table is outside retained stream or inspection prefix')
+    load_segments = []
+    file_ranges = [(0, ph_end)]
+    segment_end = ph_end
+    for index in range(phnum):
+        offset = phoff + index * phentsize
+        p_type = struct.unpack_from('<I', prefix, offset)[0]
+        p_offset = struct.unpack_from('<Q', prefix, offset + 8)[0]
+        p_paddr = struct.unpack_from('<Q', prefix, offset + 24)[0]
+        p_filesz = struct.unpack_from('<Q', prefix, offset + 32)[0]
+        p_memsz = struct.unpack_from('<Q', prefix, offset + 40)[0]
+        if p_offset + p_filesz > size or p_filesz > p_memsz:
+            raise RetentionError('RAM ELF program segment exceeds the captured volume or memory size')
+        segment_end = max(segment_end, p_offset + p_filesz)
+        if p_filesz:
+            file_ranges.append((p_offset, p_offset + p_filesz))
+        if p_type == 1:  # PT_LOAD
+            if p_filesz <= 0 or p_memsz <= 0:
+                raise RetentionError('RAM ELF contains a zero-backed or empty PT_LOAD segment')
+            physical_end = p_paddr + p_memsz
+            if physical_end > (1 << 64) or p_paddr >= physical_end:
+                raise RetentionError('RAM ELF PT_LOAD physical interval overflows 64-bit guest address space')
+            if p_filesz != p_memsz:
+                raise RetentionError('RAM ELF PT_LOAD has zero-filled or missing physical-memory bytes')
+            load_segments.append({'paddr': p_paddr, 'memsz': p_memsz,
+                                  'filesz': p_filesz, 'offset': p_offset})
+    if not load_segments:
+        raise RetentionError('RAM ELF contains no PT_LOAD segments')
+    file_ranges.sort()
+    for previous, current in zip(file_ranges, file_ranges[1:]):
+        if current[0] < previous[1]:
+            raise RetentionError('RAM ELF contains overlapping or duplicate program-header file ranges')
+    observed_phys = sorted((row['paddr'], row['paddr'] + row['memsz']) for row in load_segments)
+    for previous, current in zip(observed_phys, observed_phys[1:]):
+        if current[0] < previous[1]:
+            raise RetentionError('RAM ELF contains overlapping or duplicate PT_LOAD physical ranges')
+    expected_merged = _merge_ranges(expected_ram_ranges, 'Pinned QEMU dumpable RAM map')
+    observed_merged = _merge_ranges(observed_phys, 'RAM ELF PT_LOAD ranges')
+    if observed_merged != expected_merged:
+        raise RetentionError('RAM ELF PT_LOAD physical/file coverage differs from the pinned QEMU dumpable RAM map')
+    load_bytes = sum(row['filesz'] for row in load_segments)
+    if size <= 0 or size > logical_capacity_bytes:
+        raise RetentionError('RAM ELF logical length is empty or exceeds the pinned logical capacity')
+    # The dump volume has a larger logical capacity for ELF headers and segments. A successful
+    # capture must reflect its ELF data length after O_TRUNC; large zero-filled tails are rejected.
+    if size - segment_end > 16 * MIB:
+        raise RetentionError('RAM ELF volume contains excessive trailing preallocation padding')
+    return {'ELFClass': 64, 'Machine': 'x86_64', 'Type': 'core',
+            'GuestMemoryBytes': guest_memory_bytes, 'LogicalBytes': size,
+            'PTLoadSegments': len(load_segments), 'PTLoadBytes': load_bytes,
+            'ExpectedRAMRanges': [[start, end] for start, end in expected_merged],
+            'ObservedPTLoadRanges': [[start, end] for start, end in observed_merged],
+            'LastSegmentEnd': segment_end, 'TrailingPaddingBytes': size - segment_end}
+
+
+def hash_and_validate_ram(conn, volume, guest_memory_bytes, logical_capacity_bytes, expected_ram_ranges):
+    capacity = storage_volume_info(volume, 'RAM volume before stream')['capacity']
+    if capacity <= 0 or capacity > logical_capacity_bytes:
+        raise RetentionError('Refreshed RAM volume length is empty or exceeds pre-dump logical capacity')
+    digest = hashlib.sha256()
+    received = [0]
+    prefix = bytearray()
+    prefix_limit = 16 * MIB
+
+    def receive(_stream, data, _opaque):
+        if not isinstance(data, (bytes, bytearray, memoryview)):
+            raise RetentionError('libvirt RAM stream returned non-byte data')
+        digest.update(data)
+        received[0] += len(data)
+        if len(prefix) < prefix_limit:
+            prefix.extend(data[:prefix_limit - len(prefix)])
+        return len(data)
+
+    stream = conn.newStream(0)
+    finished = False
+    try:
+        volume.download(stream, 0, capacity, 0)
+        stream.recvAll(receive, None)
+        stream.finish()
+        finished = True
+    finally:
+        if not finished:
+            try:
+                stream.abort()
+            except Exception:
+                pass
+    if received[0] != capacity:
+        raise RetentionError('Short RAM volume stream: received %d of %d bytes' %
+                              (received[0], capacity))
+    elf = elf_validate(bytes(prefix), capacity, guest_memory_bytes, logical_capacity_bytes,
+                       expected_ram_ranges)
+    return {'sha256': digest.hexdigest(), 'bytes': received[0], 'elf': elf}
+
+
+def store_volume_xml(staging, filename, volume):
+    data = volume.XMLDesc(0).encode('utf-8')
+    atomic_write(Path(staging) / filename, data)
+    return {'path': filename, 'sha256': sha256_bytes(data), 'bytes': len(data)}
+
+
+def verify_retained_archive(target, expected_hashes):
+    target = Path(target)
+    if not target.is_dir() or target.is_symlink():
+        raise RetentionError('Retained archive directory is absent or unsafe')
+    for relative, record in expected_hashes.items():
+        path = target / relative
+        if path.is_symlink() or not path.is_file():
+            raise RetentionError('Retained archive member is missing or unsafe: ' + relative)
+        if path.stat().st_size != record['bytes'] or sha256_file(path) != record['sha256']:
+            raise RetentionError('Retained archive member size/hash mismatch: ' + relative)
+    return True
+
+
+def durable_retention(args):
+    root = Path(args.repo_root).resolve()
+    evidence = Path(args.evidence_dir).resolve()
+    state_dir = Path(args.state_dir).resolve()
+    marker = exact_write_marker(state_dir, args.tag, evidence / (args.tag + '-prebegin.json'))
+    append_attempt(evidence, args.tag, 'RETENTION_MARKER_CREATED=' + str(marker))
+    if not args.guard_token:
+        raise RetentionError('Missing exact T5 in-progress guard token')
+    verify_progress_guard(state_dir, args.tag, args.guard_token, args.owner_pid)
+    marker_record = parse_json_unique(marker)
+    prebegin_path = evidence / (args.tag + '-prebegin.json')
+    if (marker_record.get('Schema') != 'T5RetentionMarkerV1'
+            or marker_record.get('Domain') != DOMAIN or marker_record.get('RunTag') != args.tag
+            or marker_record.get('PrebeginPath') != str(prebegin_path)
+            or marker_record.get('PrebeginSHA256') != sha256_file(prebegin_path)):
+        raise RetentionError('Durable marker does not bind the exact T5 prebegin receipt')
+    prebegin = read_prebegin(evidence, args.tag, root)
+    pinned_inactive_xml = Path(prebegin['InactiveXMLPath']).read_text(encoding='utf-8')
+    validate_current_inputs(evidence, args.tag, args.mode, args.driver_sha,
+                            args.zip_sha, args.service_sha, prebegin)
+    libvirt, conn = open_connection()
+    try:
+        pool = pool_for_exact_path(conn, POOL_PATH)
+        if pool.name() != prebegin.get('RunPoolName'):
+            raise RetentionError('T5 run pool name changed after prebegin identity pin')
+        state_path = state_dir / DOMAIN
+        overlay_path = str(Path(POOL_PATH) / (DOMAIN + '.safeupload-run-' + args.tag + '.qcow2'))
+        run_state = parse_state_file(state_path, args.tag, prebegin['BasePath'], overlay_path)
+        snap = domain_snapshot(conn, libvirt)
+        pre_dump_snap = snap
+        current_xml = pre_dump_snap['inactive_xml']
+        current_vda = vda_path(current_xml, 'current inactive domain')
+        if current_vda not in (prebegin['BasePath'], overlay_path):
+            raise RetentionError('Current inactive vda is outside the pinned base/tagged-overlay pair')
+        if run_state is not None and current_vda != overlay_path:
+            raise RetentionError('Recorded run state exists but inactive vda is not the tagged overlay')
+        overlay = volume_by_path(conn, overlay_path, libvirt)
+        if overlay is None:
+            raise RetentionError('Exact tag-named run overlay is absent from libvirt metadata')
+        overlay_details = check_volume_identity(overlay, overlay_path, 'qcow2', 'run overlay',
+                                                expected_name=Path(overlay_path).name,
+                                                expected_backing=prebegin['BasePath'])
+        if overlay_details['backing_format'] != 'qcow2':
+            raise RetentionError('Run overlay does not declare a qcow2 backing format')
+        if current_vda == overlay_path:
+            verify_run_definition(current_xml, pinned_inactive_xml, overlay_path,
+                                  'current inactive run domain')
+        elif xml_semantics(current_xml, 'current inactive domain') != \
+                xml_semantics(pinned_inactive_xml, 'pinned prebegin domain'):
+            raise RetentionError('Current inactive base definition differs from pinned prebegin XML')
+        if snap['active']:
+            if snap['live_xml'] is None or snap['state'] != libvirt.VIR_DOMAIN_RUNNING:
+                raise RetentionError('Active T5 domain is not in the expected running state')
+            if current_vda != overlay_path or vda_path(snap['live_xml'], 'current live domain') != overlay_path:
+                raise RetentionError('Active T5 domain live and inactive vda are not the exact run overlay')
+            verify_active_run_definition(snap['live_xml'], pinned_inactive_xml, overlay_path,
+                                         'current live run domain')
+        elif run_state is None and current_vda != prebegin['BasePath']:
+            raise RetentionError('Inactive overlay definition has no matching run state')
+        base_volume = volume_by_path(conn, prebegin['BasePath'], libvirt)
+        backing_volume = volume_by_path(conn, prebegin['BackingPath'], libvirt)
+        if base_volume is None or backing_volume is None:
+            raise RetentionError('Pinned base or flat backing volume is absent during preservation')
+        base_details = check_volume_identity(base_volume, prebegin['BasePath'], 'qcow2', 'base')
+        backing_details = check_volume_identity(backing_volume, prebegin['BackingPath'], 'qcow2', 'backing')
+        if (base_details['backing_path'] != prebegin['BackingPath']
+                or base_details['backing_format'] != 'qcow2' or backing_details['backing_path']):
+            raise RetentionError('Run disk chain is not exactly tagged overlay -> pinned base -> flat backing')
+        for label, details, xml_text in (('base', base_details, prebegin['BaseVolumeXML']),
+                                         ('backing', backing_details, prebegin['BackingVolumeXML'])):
+            pinned_details = parse_volume_xml(xml_text, 'prebegin ' + label)
+            for field in ('name', 'path', 'capacity', 'allocation', 'physical', 'format',
+                          'backing_path', 'backing_format', 'mode', 'owner', 'group'):
+                if details[field] != pinned_details[field]:
+                    raise RetentionError('Pinned ' + label + ' volume metadata changed during T5 run: ' + field)
+        if overlay_details['capacity'] != base_details['capacity']:
+            raise RetentionError('Run overlay virtual capacity differs from the pinned base')
+        # Prove the complete original chain bytes before any crash dump can stop
+        # the guest.  Metadata alone cannot detect same-size content changes.
+        pre_dump_base_result = pinned_volume_hash(
+            conn, base_volume, prebegin['BaseVolumeXML'], 'pre-dump base', BASE_VOLUME_SHA256)
+        pre_dump_backing_result = pinned_volume_hash(
+            conn, backing_volume, prebegin['BackingVolumeXML'], 'pre-dump backing', BACKING_VOLUME_SHA256)
+        ram_hash = None
+        ram_after = None
+        private_identity = None
+        guest_memory = None
+        ram_logical_capacity = None
+        dump_space = None
+        ram_region_map = None
+        pause_state = None
+        dump_shutdown_state = None
+        if snap['state'] == libvirt.VIR_DOMAIN_SHUTOFF and not snap['active']:
+            ram_record = {'Status': 'UNAVAILABLE_ALREADY_SHUT_OFF', 'Reason': 'domain was already stopped'}
+            ram_volume = None
+            ram_details = None
+        else:
+            memory_root = ET.fromstring(Path(prebegin['InactiveXMLPath']).read_text(encoding='utf-8'))
+            guest_memory = quantity_bytes(memory_root.find('memory'), 'maximum')
+            current_memory_node = memory_root.find('currentMemory')
+            if current_memory_node is not None and quantity_bytes(current_memory_node, 'current') != guest_memory:
+                raise RetentionError('Current guest RAM differs from the pinned maximum-memory size')
+            ram_logical_capacity = guest_memory + max(GIB, guest_memory // 4)
+            name = memory_volume_name(args.tag)
+            if pool_lookup_volume(pool, name, libvirt) is not None:
+                raise RetentionError('Tag-specific RAM volume already exists')
+            private_identity = private_identity_from_pinned_base(prebegin)
+            pool.refresh(0)
+            pool_info = pool.info()
+            if len(pool_info) < 4:
+                raise RetentionError('Libvirt did not return the run-pool available-space field')
+            dump_space = require_dump_space(pool_info[3], ram_logical_capacity)
+            vol_xml = make_memory_volume_xml(name, ram_logical_capacity, private_identity)
+            ram_volume = pool.createXML(vol_xml, 0)
+            pool.refresh(0)
+            ram_volume = pool_lookup_volume(pool, name, libvirt)
+            if ram_volume is None:
+                raise RetentionError('Registered private RAM volume disappeared after create')
+            expected_ram_path = str(Path(POOL_PATH) / name)
+            ram_details = check_volume_identity(ram_volume, expected_ram_path, 'raw', 'RAM', expected_name=name)
+            ram_permissions = verify_private_volume(ram_details, private_identity, 'RAM before dump')
+            if (ram_details['capacity'] != ram_logical_capacity
+                    or storage_volume_info(ram_volume, 'RAM volume before dump')['capacity'] != ram_logical_capacity):
+                raise RetentionError('RAM volume XML and libvirt info do not both report the exact logical capacity before dump')
+            # Freeze only the already-validated failed T5 child before reading
+            # its effective RAM map.  Any failure from here leaves it paused or
+            # stopped under the durable retention marker; it is never resumed.
+            try:
+                suspend_result = snap['domain'].suspend()
+            except Exception as exc:
+                raise RetentionError('Could not pause the exact failed T5 guest before RAM-map capture: '
+                                     + str(exc)) from exc
+            if suspend_result not in (None, 0):
+                raise RetentionError('Libvirt returned a nonzero result while pausing the failed T5 guest')
+            paused = domain_snapshot(conn, libvirt)
+            pause_state = verify_paused_failed_run(
+                paused, libvirt, pre_dump_snap, pinned_inactive_xml, overlay_path,
+                'paused failed T5 run')
+            ram_region_map = capture_qemu_ram_region_map(guest_memory)
+            retained_map_paths = {}
+            for map_name in ('FlatView', 'RegionTree'):
+                capture = ram_region_map[map_name]
+                map_bytes = capture['Text'].encode('utf-8', 'strict')
+                if len(map_bytes) != capture['Bytes'] or sha256_bytes(map_bytes) != capture['SHA256']:
+                    raise RetentionError('QEMU %s RAM map bytes changed while being pinned' % map_name)
+                map_stem = {'FlatView': 'flatview', 'RegionTree': 'tree'}[map_name]
+                map_path = evidence / (args.tag + '-ram-region-' + map_stem + '.txt')
+                atomic_write(map_path, map_bytes)
+                retained_map_paths[map_name] = map_path
+                append_attempt(evidence, args.tag,
+                               'RAM_REGION_%s_SHA256=%s' % (map_name.upper(), capture['SHA256']))
+            paused_before_dump = domain_snapshot(conn, libvirt)
+            verify_paused_failed_run(
+                paused_before_dump, libvirt, pre_dump_snap, pinned_inactive_xml, overlay_path,
+                'paused failed T5 run immediately before dump')
+            final_region_map = capture_qemu_ram_region_map(guest_memory)
+            require_stable_qemu_ram_map(ram_region_map, final_region_map)
+            paused_at_dump = domain_snapshot(conn, libvirt)
+            verify_paused_failed_run(
+                paused_at_dump, libvirt, pre_dump_snap, pinned_inactive_xml, overlay_path,
+                'paused failed T5 run at dump start')
+            dump = subprocess.run(['virsh', '-c', LIBVIRT_URI, 'dump', DOMAIN_UUID, ram_details['path'],
+                                   '--crash', '--memory-only', '--format', 'elf'],
+                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
+            dump_stdout = dump.stdout.decode('utf-8', 'replace')
+            dump_stderr = dump.stderr.decode('utf-8', 'replace')
+            atomic_write(evidence / (args.tag + '-retention-dump.stdout.txt'),
+                         dump_stdout.encode('utf-8'))
+            atomic_write(evidence / (args.tag + '-retention-dump.stderr.txt'),
+                         dump_stderr.encode('utf-8'))
+            if dump.returncode != 0:
+                raise RetentionError('virsh dump --crash --memory-only --format elf failed with '
+                                     + str(dump.returncode))
+            pool.refresh(0)
+            ram_volume = pool_lookup_volume(pool, name, libvirt)
+            if ram_volume is None:
+                raise RetentionError('RAM volume missing after libvirt dump and pool refresh')
+            ram_details = check_volume_identity(ram_volume, expected_ram_path, 'raw', 'RAM', expected_name=name)
+            ram_permissions = verify_private_volume(ram_details, private_identity, 'RAM after dump')
+            if ram_details['capacity'] != storage_volume_info(ram_volume, 'RAM volume after dump')['capacity']:
+                raise RetentionError('RAM volume XML and libvirt info disagree on the post-dump ELF file length')
+            after_dump = domain_snapshot(conn, libvirt)
+            dump_shutdown_state = require_dump_shutdown(after_dump, libvirt)
+            ram_hash = hash_and_validate_ram(
+                conn, ram_volume, guest_memory, ram_logical_capacity,
+                ram_region_map['Parsed']['Ranges'])
+            if after_dump['live_xml'] is not None or \
+                    xml_semantics(after_dump['inactive_xml'], 'post-dump inactive domain') != \
+                    xml_semantics(pre_dump_snap['inactive_xml'], 'pre-dump inactive domain'):
+                raise RetentionError('Domain definition changed during the RAM dump')
+            if vda_path(after_dump['inactive_xml'], 'post-dump inactive domain') != overlay_path:
+                raise RetentionError('Post-dump inactive vda is not the exact run overlay')
+            verify_run_definition(after_dump['inactive_xml'], pinned_inactive_xml, overlay_path,
+                                  'post-dump inactive run domain')
+            overlay = volume_by_path(conn, overlay_path, libvirt)
+            if overlay is None:
+                raise RetentionError('Exact run overlay disappeared after the RAM dump')
+            overlay_details = check_volume_identity(overlay, overlay_path, 'qcow2',
+                                                    'post-dump run overlay',
+                                                    expected_name=Path(overlay_path).name,
+                                                    expected_backing=prebegin['BasePath'])
+            if (overlay_details['backing_format'] != 'qcow2'
+                    or overlay_details['capacity'] != base_details['capacity']):
+                raise RetentionError('Post-dump overlay chain metadata differs from the pinned run disk')
+            ram_record = {'Status': 'CAPTURED', 'VolumeName': name, 'Path': ram_details['path'],
+                          'LogicalFileBytes': ram_details['capacity'], 'SHA256': ram_hash['sha256'],
+                          'StreamBytes': ram_hash['bytes'], 'Permissions': ram_permissions,
+                          'ELF': ram_hash['elf'], 'PreDumpLogicalCapacityBytes': ram_logical_capacity,
+                          'PauseState': pause_state, 'DumpPostState': dump_shutdown_state,
+                          'RegionMapCaptures': {
+                              map_name: {'SHA256': ram_region_map[map_name]['SHA256'],
+                                         'Bytes': ram_region_map[map_name]['Bytes'],
+                                         'Command': ram_region_map[map_name]['Command']}
+                              for map_name in ('FlatView', 'RegionTree')},
+                          'ExpectedRAMRegions': ram_region_map['Parsed']['Ranges'],
+                          'DumpableRAMBytes': ram_region_map['Parsed']['DumpableRAMBytes'],
+                          'RunPoolAvailableBytesBeforeDump': dump_space['AvailableBytes'],
+                          'RunPoolSafetyMarginBytes': dump_space['SafetyMarginBytes'],
+                          'RunPoolMinimumAvailableBytes': dump_space['MinimumAvailableBytes']}
+            snap = after_dump
+
+        # Hash every byte through libvirt's storage-volume API while the guest is stopped.
+        base_hash = volume_sha256(conn, base_volume)
+        backing_hash = volume_sha256(conn, backing_volume)
+        overlay_hash = volume_sha256(conn, overlay)
+        if (base_hash['sha256'] != BASE_VOLUME_SHA256
+                or backing_hash['sha256'] != BACKING_VOLUME_SHA256
+                or base_hash['bytes'] != prebegin['BaseBytes']
+                or backing_hash['bytes'] != prebegin['BackingBytes']
+                or base_hash['sha256'] != pre_dump_base_result['stream']['sha256']
+                or backing_hash['sha256'] != pre_dump_backing_result['stream']['sha256']
+                or base_hash['bytes'] != pre_dump_base_result['stream']['bytes']
+                or backing_hash['bytes'] != pre_dump_backing_result['stream']['bytes']):
+            raise RetentionError('Post-dump full base/backing stream differs from the pinned pre-dump bytes')
+
+        target = evidence / (args.tag + '-retention')
+        staging = evidence / (args.tag + '-retention.tmp-' + secrets.token_hex(8))
+        if target.exists() or target.is_symlink():
+            raise RetentionError('Final T5 retention archive path already exists')
+        staging.mkdir(mode=0o700)
+        members = {}
+
+        def save_member(relative, data):
+            member_path = staging / relative
+            atomic_write(member_path, data)
+            members[relative] = {'sha256': sha256_bytes(data), 'bytes': len(data)}
+
+        prebegin_xml_bytes = (evidence / (args.tag + '-prebegin-inactive.xml')).read_bytes()
+        save_member('prebegin-inactive.xml', prebegin_xml_bytes)
+        save_member('current-inactive.xml', current_xml.encode('utf-8'))
+        if pre_dump_snap['live_xml'] is not None:
+            save_member('current-live.xml', pre_dump_snap['live_xml'].encode('utf-8'))
+        if run_state is not None:
+            save_member('run-disk-state.txt', run_state['bytes'])
+        volume_records = {}
+        volume_records['base'] = store_volume_xml(staging, 'base-volume.xml', base_volume)
+        volume_records['backing'] = store_volume_xml(staging, 'backing-volume.xml', backing_volume)
+        volume_records['overlay'] = store_volume_xml(staging, 'overlay-volume.xml', overlay)
+        for row in volume_records.values():
+            members[row['path']] = {'sha256': row['sha256'], 'bytes': row['bytes']}
+        if ram_volume is not None:
+            volume_records['ram'] = store_volume_xml(staging, 'ram-volume.xml', ram_volume)
+            members[volume_records['ram']['path']] = {
+                'sha256': volume_records['ram']['sha256'], 'bytes': volume_records['ram']['bytes']}
+            for map_name in ('FlatView', 'RegionTree'):
+                retained_map_bytes = retained_map_paths[map_name].read_bytes()
+                capture = ram_region_map[map_name]
+                if (len(retained_map_bytes) != capture['Bytes']
+                        or sha256_bytes(retained_map_bytes) != capture['SHA256']):
+                    raise RetentionError('Retained pre-dump %s RAM map changed before archive creation' % map_name)
+                map_stem = {'FlatView': 'flatview', 'RegionTree': 'tree'}[map_name]
+                save_member('ram-region-' + map_stem + '.txt', retained_map_bytes)
+        state_bytes = run_state['bytes'] if run_state is not None else None
+        receipt = {
+            'Schema': 'T5PreservedRunV1', 'RunTag': args.tag, 'Domain': DOMAIN,
+            'UUID': DOMAIN_UUID, 'RetentionMarker': str(marker), 'RunPoolName': pool.name(),
+            'RunPoolPath': POOL_PATH, 'BasePath': prebegin['BasePath'],
+            'PreDumpBaseSHA256': pre_dump_base_result['stream']['sha256'],
+            'PreDumpBaseStreamBytes': pre_dump_base_result['stream']['bytes'],
+            'PreDumpBackingSHA256': pre_dump_backing_result['stream']['sha256'],
+            'PreDumpBackingStreamBytes': pre_dump_backing_result['stream']['bytes'],
+            'BaseSHA256': base_hash['sha256'], 'BaseStreamBytes': base_hash['bytes'],
+            'BackingPath': prebegin['BackingPath'], 'BackingSHA256': backing_hash['sha256'],
+            'BackingStreamBytes': backing_hash['bytes'], 'OverlayPath': overlay_path,
+            'OverlaySHA256': overlay_hash['sha256'], 'OverlayStreamBytes': overlay_hash['bytes'],
+            'OverlayVolume': overlay_details, 'CurrentVdaBeforeRestore': current_vda,
+            'RunDiskStatePresent': run_state is not None,
+            'RunDiskStateSHA256': sha256_bytes(state_bytes) if state_bytes is not None else None,
+            'RunDiskStateFields': run_state['fields'] if run_state is not None else None,
+            'RAM': ram_record, 'PrebeginXMLSHA256': prebegin['InactiveXMLSHA256'],
+            'PreRestoreInactiveXMLSHA256': sha256_bytes(current_xml.encode('utf-8')),
+            'Members': members, 'SavedXMLSemanticMatchToBaseline': True,
+            'CaptureReason': args.reason,
+        }
+        atomic_json(staging / 'receipt.json', receipt)
+        # Include the receipt itself in the archive verification set after its atomic write.
+        members['receipt.json'] = {'sha256': sha256_file(staging / 'receipt.json'),
+                                   'bytes': (staging / 'receipt.json').stat().st_size}
+        atomic_json(staging / 'archive-manifest.json', {'Schema': 'T5RetentionArchiveV1',
+                                                        'RunTag': args.tag, 'Members': members})
+        fsync_directory(staging)
+        os.rename(str(staging), str(target))
+        fsync_directory(evidence)
+        verify_retained_archive(target, members)
+        # Verify the prebegin XML and complete archive before changing persistent libvirt XML.
+        if xml_semantics((target / 'prebegin-inactive.xml').read_text(encoding='utf-8'), 'retained prebegin XML') != \
+                xml_semantics(prebegin['InactiveXMLPath'] and Path(prebegin['InactiveXMLPath']).read_text(encoding='utf-8'),
+                              'prebegin XML pin'):
+            raise RetentionError('Archived prebegin XML is not semantically identical to pinned XML')
+        archive_manifest = parse_json_unique(target / 'archive-manifest.json')
+        if archive_manifest.get('RunTag') != args.tag or archive_manifest.get('Members') != members:
+            raise RetentionError('Retained archive manifest did not round-trip exactly')
+
+        # Redefine only after durable archive verification. The saved XML is the exact prebegin
+        # document; the run overlay remains registered in the pool and is never deleted.
+        restore_pre = domain_snapshot(conn, libvirt)
+        if restore_pre['active'] or restore_pre['state'] not in (
+                libvirt.VIR_DOMAIN_SHUTOFF, libvirt.VIR_DOMAIN_CRASHED):
+            raise RetentionError('Domain is not stopped immediately before saved XML restore')
+        if xml_semantics(restore_pre['inactive_xml'], 'pre-restore inactive domain') != \
+                xml_semantics(current_xml, 'captured current inactive XML'):
+            raise RetentionError('Inactive domain XML changed after capture and before restore')
+        restore_vda = vda_path(restore_pre['inactive_xml'], 'pre-restore inactive domain')
+        if restore_vda not in (prebegin['BasePath'], overlay_path):
+            raise RetentionError('Pre-restore inactive vda escaped the pinned base/tagged-overlay pair')
+        if run_state is not None and restore_vda != overlay_path:
+            raise RetentionError('Pre-restore inactive vda no longer points to the recorded run overlay')
+        if restore_vda == overlay_path:
+            verify_run_definition(restore_pre['inactive_xml'], pinned_inactive_xml, overlay_path,
+                                  'pre-restore inactive run domain')
+        elif xml_semantics(restore_pre['inactive_xml'], 'pre-restore inactive domain') != \
+                xml_semantics(pinned_inactive_xml, 'pinned prebegin XML'):
+            raise RetentionError('Pre-restore base definition differs from the pinned prebegin XML')
+        snap = restore_pre
+        saved_xml = (evidence / (args.tag + '-prebegin-inactive.xml')).read_text(encoding='utf-8')
+        defined = conn.defineXML(saved_xml)
+        if defined is None:
+            raise RetentionError('Libvirt refused the saved prebegin inactive XML')
