+        with self.assertRaisesRegex(inventory.InventoryError, 'pre-pool source metadata differs'):
+            self._run_inventory_with_after_snapshot(after, replacement, observed_pools)
+        self.assertEqual(observed_pools, [])
+
+    def test_final_domain_state_or_xml_drift_fails_inventory(self):
+        preserve = inventory._preserve_module()
+        repo_root = HELPER_PATH.parents[3]
+        baseline = preserve.load_pinned_receipts(repo_root)[0]['InactiveXML']
+        wrong_xml = '<domain><name>unrelated-definition</name></domain>'
+        cases = (
+            {'state': 1, 'reason': 0, 'state_name': 'running',
+             'active': True, 'inactive_xml': baseline},
+            {'state': 5, 'reason': 0, 'state_name': 'shutoff',
+             'active': False, 'inactive_xml': wrong_xml},
+            {'state': 5, 'reason': 1, 'state_name': 'shutoff',
+             'active': False, 'inactive_xml': baseline},
+        )
+        for after in cases:
+            with self.subTest(after=after):
+                with self.assertRaises(inventory.InventoryError):
+                    self._run_inventory_with_after_snapshot(after)
+
+    def test_sandbox_mapped_source_owner_fails_before_libvirt_pool_creation(self):
+        preserve = inventory._preserve_module()
