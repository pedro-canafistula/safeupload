+def _read_enforcement_receipt(fs: Any = RootFilesystem) -> dict[str, Any]:
+    raw, _ = fs.read_regular(HOST_ENFORCEMENT_RECEIPT_PATH,
+                             expected_uid=0, expected_gid=0,
+                             expected_mode='0400', max_bytes=MAX_TRUST_BYTES)
+    try:
+        value = json.loads(raw.decode('utf-8'), object_pairs_hook=_pairs_no_duplicates)
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise InvocationError('lifecycle enforcement receipt is malformed') from exc
+    fields = {
+        'Schema', 'Status', 'Domain', 'UUID', 'LockPath',
+        'PolicyPath', 'PolicySHA256', 'QemuHookPath', 'QemuHookSHA256',
+        'QemuMainHookPath', 'QemuMainHookSHA256', 'AccessConfigPath',
+        'AccessConfigSHA256', 'AccessDriver', 'QemuServiceUnit',
+        'QemuPID', 'QemuStartTicks', 'QemuExecutable',
+        'PolkitServiceUnit', 'PolkitPID', 'PolkitStartTicks', 'PolkitExecutable',
+        'InstallTransactionSHA256', 'Disposition',
+    }
+    if (not isinstance(value, dict) or set(value) != fields
+            or value.get('Schema') != 'T5LifecycleEnforcementActiveV2'
+            or value.get('Status') != 'ACTIVE_FIXED_POLICY_AND_HOOK'
+            or value.get('Domain') != DOMAIN or value.get('UUID') != DOMAIN_UUID
+            or value.get('LockPath') != LIFECYCLE_LOCK_PATH
+            or value.get('PolicyPath') != POLKIT_RULE_PATH
+            or value.get('QemuHookPath') != QEMU_HOOK_PATH
+            or value.get('QemuMainHookPath') != QEMU_MAIN_HOOK_PATH
+            or value.get('PolkitExecutable') not in (
+                '/usr/lib/polkit-1/polkitd', '/usr/libexec/polkit-1/polkitd')
+            or value.get('PolkitServiceUnit') != 'polkit.service'
+            or value.get('QemuServiceUnit') not in LIBVIRT_ACCESS_CONFIG_PATHS
+            or value.get('AccessConfigPath') !=
+               LIBVIRT_ACCESS_CONFIG_PATHS.get(value.get('QemuServiceUnit'))
+            or value.get('QemuExecutable') not in (
+                '/usr/sbin/libvirtd', '/usr/libexec/libvirtd',
+                '/usr/sbin/virtqemud', '/usr/libexec/virtqemud')
+            or value.get('AccessDriver') != 'polkit'
+            or not _is_hash(value.get('PolicySHA256'))
+            or not _is_hash(value.get('QemuHookSHA256'))
+            or not _is_hash(value.get('QemuMainHookSHA256'))
+            or not _is_hash(value.get('AccessConfigSHA256'))
+            or not _is_hash(value.get('InstallTransactionSHA256'))
+            or type(value.get('PolkitPID')) is not int or value['PolkitPID'] <= 1
+            or type(value.get('PolkitStartTicks')) is not int
+            or value['PolkitStartTicks'] <= 0
+            or type(value.get('QemuPID')) is not int or value['QemuPID'] <= 1
+            or type(value.get('QemuStartTicks')) is not int or value['QemuStartTicks'] <= 0
+            or value.get('Disposition') != (
+                'ROOT_INSTALLED; POLKIT_ACCESS_DRIVER_AND_QEMU_HOOK_PRESENT_AT_DAEMON_START; '
+                'LIVE_FILES_AND_BOTH_DAEMON_IDENTITIES_RECHECKED')):
+        raise InvocationError('lifecycle enforcement receipt does not have the exact active schema')
