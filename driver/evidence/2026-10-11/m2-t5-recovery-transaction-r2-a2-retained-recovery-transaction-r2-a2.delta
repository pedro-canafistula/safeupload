+                original_xml, current, run_disk_path=run_disk,
+                run_nvram_path=run_nvram, run_tpm_path=run_tpm, run_tag=run_tag)
+            objects = run_binding.observe_private_objects(
+                run_disk_path=run_disk, run_nvram_path=run_nvram,
