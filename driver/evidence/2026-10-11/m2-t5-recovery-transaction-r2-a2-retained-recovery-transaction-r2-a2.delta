+    def create_destination_pools(self, policy: CopyPolicy) -> dict[str, Any]:
+        """Define each exact per-run pool after the durable marker exists."""
+        validate_copy_policy(policy)
+        expected_pools = (policy.run_nvram, policy.run_tpm,
+                          policy.recovery_nvram, policy.recovery_tpm)
+        expected_names = {pool.name for pool in expected_pools}
+        if len(expected_names) != 4 or expected_names & set(self._pool_names()):
+            raise CopyError('per-run destination storage-pool name collision after durable marker')
+        observer = Openat2DestinationObserver(self.helper)
+        created: dict[str, dict[str, Any]] = {}
+        destination_identities: set[tuple[int, int]] = set()
+        for expected in expected_pools:
+            if expected.name in set(self._pool_names()):
+                raise CopyError(expected.role + ' destination pool collided at its creation boundary')
+            before = observer.observe_pool_tree(expected, [])
+            directory = before['IdentityObjects'][0]
+            identity = (directory['Device'], directory['Inode'])
+            if identity in destination_identities:
+                raise CopyError(expected.role + ' destination directory aliases another per-run pool')
+            destination_identities.add(identity)
+
+            root = ET.Element('pool', {'type': 'dir'})
+            ET.SubElement(root, 'name').text = expected.name
+            target = ET.SubElement(root, 'target')
+            ET.SubElement(target, 'path').text = expected.target
+            permissions = ET.SubElement(target, 'permissions')
+            ET.SubElement(permissions, 'mode').text = expected.mode
+            ET.SubElement(permissions, 'owner').text = str(expected.uid)
+            ET.SubElement(permissions, 'group').text = str(expected.gid)
+            xml = ET.tostring(root, encoding='unicode')
+            try:
+                pool = self.connection.storagePoolDefineXML(xml, 0)
+                if pool is None:
+                    raise CopyError(expected.role + ' persistent pool definition returned no handle')
+                if int(pool.isPersistent()) != 1 or int(pool.isActive()) != 0:
+                    raise CopyError(expected.role + ' pool was not created persistent and inactive')
+                _check_storage_status(pool.create(0), expected.role + ' pool activate')
+            except BaseException as exc:
+                if isinstance(exc, CopyError):
+                    raise
+                raise CopyError('could not define/start exact ' + expected.role +
+                                ' per-run destination pool: ' + str(exc)) from exc
+
+            parsed = self._pool_xml(pool, expected.role + ' created destination')
+            if (parsed['Name'], parsed['Target'], parsed['UID'], parsed['GID'],
+                    parsed['Mode'], int(pool.isPersistent()), int(pool.isActive())) != (
+                    expected.name, expected.target, expected.uid, expected.gid,
+                    expected.mode, 1, 1):
+                raise CopyError(expected.role + ' created pool differs from the exact persistent policy')
+            names, _volumes = self._pool_volume_names(pool, expected.role + ' created destination')
+            if names:
+                raise CopyError(expected.role + ' destination pool is not empty after creation')
+            after = observer.observe_pool_tree(expected, [])
+            after_directory = after['IdentityObjects'][0]
+            if (after_directory['Device'], after_directory['Inode']) != identity:
+                raise CopyError(expected.role + ' destination directory identity changed during pool creation')
+            created[expected.role] = {'Pool': pool, 'PoolXML': parsed,
+                                      'RootObservation': after}
+
+        if set(created) != {'run-nvram', 'run-tpm', 'recovery-nvram', 'recovery-tpm'}:
+            raise CopyError('created destination pool set is incomplete')
+        self.destination_pools = created
+        return {'DestinationPools': created,
+                'DestinationPoolNames': sorted(expected_names)}
 
