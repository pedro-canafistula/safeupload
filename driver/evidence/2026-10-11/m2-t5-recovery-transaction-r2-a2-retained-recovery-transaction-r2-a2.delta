+    def test_actual_libvirt_serialized_empty_source_pool_xml_is_accepted_exactly(self):
+        repo_root = HELPER_PATH.parents[3]
+        receipt_path = repo_root / 'driver/evidence/2026-10-11/m2-t5-inventory-r4-actual-transient-pool-xml-root.json'
+        receipt = inventory.parse_json_unique(receipt_path)
+        self.assertEqual(receipt['XMLSHA256'],
+                         'cf8ac36bd63357e1a2c72111f2833f503368c227126801ac81b22574d74797a5')
+        xml = receipt['XML']
+        self.assertEqual(hashlib.sha256(xml.encode('utf-8')).hexdigest(), receipt['XMLSHA256'])
+        pool_uuid = '8fe473bb-d3e1-4de6-a0c9-db266d00ae60'
+        conn = FakeConnection([])
+        pool = FakePool(conn, receipt['Name'], inventory.NVRAM_DIRECTORY, [],
+                        xml_override=xml, pool_uuid=pool_uuid)
+        inventory._verify_directory_pool(pool, receipt['Name'], inventory.NVRAM_DIRECTORY)
+
+        # Libvirt emits the empty source node in its serialized XML, while the
+        # requested XML has no source node. Both forms are valid, but a
+        # populated or duplicated source is outside this directory-only target.
+        no_source_xml = xml.replace('  <source>\n  </source>\n', '')
+        no_source_pool = FakePool(conn, receipt['Name'], inventory.NVRAM_DIRECTORY, [],
+                                  xml_override=no_source_xml, pool_uuid=pool_uuid)
+        inventory._verify_directory_pool(no_source_pool, receipt['Name'], inventory.NVRAM_DIRECTORY)
+
+        invalid_source_fragments = (
+            ('attribute', "  <source id='unexpected'>\n  </source>\n"),
+            ('child', '  <source><unexpected/></source>\n'),
+            ('text', '  <source>unexpected</source>\n'),
+            ('duplicate', '  <source>\n  </source>\n  <source>\n  </source>\n'),
+        )
+        original = '  <source>\n  </source>\n'
+        for label, replacement in invalid_source_fragments:
+            with self.subTest(source=label):
+                malformed = xml.replace(original, replacement, 1)
+                bad_pool = FakePool(conn, receipt['Name'], inventory.NVRAM_DIRECTORY, [],
+                                    xml_override=malformed, pool_uuid=pool_uuid)
+                with self.assertRaisesRegex(inventory.InventoryError, 'source'):
+                    inventory._verify_directory_pool(bad_pool, receipt['Name'],
+                                                     inventory.NVRAM_DIRECTORY)
+
