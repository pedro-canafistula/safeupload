--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/T5SourceLeaseGuard.SelfCheck.py
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/T5SourceLeaseGuard.SelfCheck.py
@@ -0,0 +1,349 @@
+#!/usr/bin/env python3
+"""Offline controls for exact source read-lease acquisition and FD custody."""
+from __future__ import annotations
+
+import array
+import fcntl
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import socket
+import tempfile
+import types
+
+
+SCRIPT = Path(__file__).resolve().with_name('T5SourceLeaseGuard.py')
+SPEC = importlib.util.spec_from_file_location('t5_source_lease_selfcheck', SCRIPT)
+if SPEC is None or SPEC.loader is None:
+    raise RuntimeError('could not load source lease guard')
+GUARD = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(GUARD)
+
+
+class SocketFDCustodian:
+    """Offline SCM_RIGHTS surrogate; it does not contact systemd."""
+
+    def __init__(self):
+        self.sender, self.receiver = socket.socketpair(
+            socket.AF_UNIX, socket.SOCK_SEQPACKET)
+        self.saved: tuple[int, ...] = ()
+        self.expected_count = 0
+        self.store_calls = 0
+        self.remove_calls = 0
+
+    def preflight(self, transaction_id, descriptor_count):
+        self.expected_limit = descriptor_count
+        return {'SurrogateOnly': True, 'TransactionID': transaction_id,
+                'DescriptorLimit': descriptor_count}
+
+    def bind_count(self, descriptor_count):
+        if not 2 <= descriptor_count <= self.expected_limit:
+            raise AssertionError('exact descriptor count exceeded offline preflight')
+        self.expected_count = descriptor_count
+
+    def store(self, descriptors):
+        ints = array.array('i', descriptors)
+        self.sender.sendmsg([b'FDSTORE surrogate'],
+                            [(socket.SOL_SOCKET, socket.SCM_RIGHTS, ints)])
+        _payload, ancillary, flags, _address = self.receiver.recvmsg(
+            64, socket.CMSG_SPACE(len(descriptors) * ints.itemsize))
+        if flags & getattr(socket, 'MSG_CTRUNC', 0):
+            raise AssertionError('offline descriptor custody control truncated')
+        received = []
+        for level, kind, data in ancillary:
+            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
+                incoming = array.array('i')
+                incoming.frombytes(data[:len(data) - len(data) % incoming.itemsize])
+                received.extend(incoming.tolist())
+        if len(received) != self.expected_count:
+            raise AssertionError('offline descriptor custody count differs')
+        self.saved = tuple(received)
+        self.store_calls += 1
+        return {'SurrogateOnly': True, 'DescriptorCount': len(received),
+                'CustodyMethod': 'SCM_RIGHTS_UNIX_SEQPACKET'}
+
+    def verify(self, descriptors):
+        if len(descriptors) != len(self.saved):
+            raise AssertionError('offline custodian descriptor count changed')
+        for source_fd, held_fd in zip(descriptors, self.saved, strict=True):
+            left, right = os.fstat(source_fd), os.fstat(held_fd)
+            if (left.st_dev, left.st_ino) != (right.st_dev, right.st_ino):
+                raise AssertionError('offline custodian does not hold the same inode')
+
+    def remove(self):
+        for fd in self.saved:
+            try:
+                os.close(fd)
+            except OSError:
+                pass
+        self.saved = ()
+        self.remove_calls += 1
+
+    def close(self):
+        self.remove()
+        self.sender.close()
+        self.receiver.close()
+
+
+def _write(path: Path, data: bytes = b'fixture source bytes') -> None:
+    path.write_bytes(data)
+    os.chmod(path, 0o400)
+
+
+def _controls():
+    return {
+        GUARD.LEASES_ENABLE_PATH: '1',
+        GUARD.LEASE_BREAK_TIME_PATH: '0',
+    }
+
+
+def _make_sources(root: Path):
+    disk_a = root / 'disk-base.qcow2'
+    disk_b = root / 'disk-backing.qcow2'
+    nvram = root / 'vars.fd'
+    tpm = root / 'tpm'
+    tpm.mkdir()
+    _write(disk_a)
+    _write(disk_b)
+    _write(nvram)
+    _write(tpm / '.lock', b'')
+    _write(tpm / 'tpm2-00.permall', b'tpm fixture')
+    return (str(disk_a), str(disk_b)), str(nvram), str(tpm)
+
+
+def check_systemd_restart_contract() -> dict[str, str]:
+    """Exercise unit pinning/named-FD restart logic with a synthetic manager."""
+    manager = {'names': {}}
+    messages = []
+    transaction = 'offline-r2'
+    unit = GUARD.FDCUSTODY_UNIT_PREFIX + transaction + '.service'
+    properties = lambda: {
+        'MainPID': str(os.getpid()), 'FileDescriptorStoreMax': '20',
+        'FileDescriptorStorePreserve': 'yes', 'NotifyAccess': 'main',
+        'NFileDescriptorStore': str(len(manager['names'])),
+    }
+
+    def run(_argv, **_kwargs):
+        stdout = ''.join(key + '=' + value + '\n'
+                         for key, value in properties().items()).encode('ascii')
+        return types.SimpleNamespace(returncode=0, stdout=stdout)
+
+    def notify(message, fds):
+        messages.append(message)
+        fields = dict(line.split('=', 1) for line in message.splitlines())
+        if fields.get('FDSTORE') == '1':
+            if len(fds) != 1 or fields.get('FDNAME') in manager['names']:
+                raise AssertionError('synthetic FD store received duplicate/unbound names')
+            manager['names'][fields['FDNAME']] = fds[0]
+        elif fields.get('FDSTOREREMOVE') == '1':
+            manager['names'].pop(fields['FDNAME'], None)
+        else:
+            raise AssertionError('synthetic manager received an unknown notification')
+        return 1
+
+    class FakePath:
+        def __init__(self, _path):
+            pass
+
+        def read_text(self, *, encoding):
+            if encoding != 'utf-8':
+                raise AssertionError('unexpected cgroup encoding')
+            return '0::/system.slice/' + unit + '\n'
+
+    original_path = GUARD.Path
+    try:
+        GUARD.Path = FakePath
+        env = {'NOTIFY_SOCKET': '/tmp/offline-notify'}
+        custodian = GUARD.SystemdFDCustodian(env=env, run=run,
+                                             pid=os.getpid(), notify=notify)
+        preflight = custodian.preflight(transaction, 20)
+        custodian.bind_count(3)
+        if (preflight['Unit'] != unit or preflight['ManagerStoreCount'] != 0
+                or len(custodian.store_names) != 3):
+            raise AssertionError('synthetic manager unit/count preflight differs')
+        custodian.store((101, 102, 103))
+        custodian.verify((101, 102, 103))
+        names = list(custodian.store_names)
+        restart_env = {
+            'NOTIFY_SOCKET': '/tmp/offline-notify',
+            'LISTEN_PID': str(os.getpid()), 'LISTEN_FDS': '3',
+            'LISTEN_FDNAMES': ':'.join(reversed(names)),
+        }
+        adopted, descriptors = GUARD.SystemdFDCustodian.reattach(
+            transaction, 3, env=restart_env, run=run,
+            notify=notify, pid=os.getpid())
+        if (adopted.unit != unit or not adopted.stored
+                or set(descriptors) != set(names)
+                or len(set(descriptors.values())) != 3):
+            raise AssertionError('synthetic systemd restart did not map exact named descriptors')
+        try:
+            GUARD.SystemdFDCustodian.reattach(
+                transaction, 3, env={**restart_env, 'LISTEN_FDS': '2'},
+                run=run, pid=os.getpid())
+        except GUARD.SourceLeaseError:
+            pass
+        else:
+            raise AssertionError('synthetic systemd restart accepted a short descriptor set')
+        adopted.remove()
+        if manager['names']:
+            raise AssertionError('synthetic manager retained a descriptor after verified removal')
+        return {'named_store_and_restart_recheck': 'PASS',
+                'short_restart_fd_set_rejected': 'PASS',
+                'manager_store_removed_after_restore_boundary': 'PASS'}
+    finally:
+        GUARD.Path = original_path
+
+
+def run() -> dict[str, str]:
+    checks = check_systemd_restart_contract()
+    with tempfile.TemporaryDirectory(prefix='t5-source-lease-') as temp:
+        root = Path(temp)
+        disk_paths, nvram_path, tpm_directory = _make_sources(root)
+        lock_path = root / 'canonical.lock'
+        lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
+        try:
+            # A nonzero break timeout is rejected before the payload opener or
+            # custody transfer runs. The supplied reader is a synthetic value;
+            # the machine's /proc/sys controls are never written or changed.
+            custodian = SocketFDCustodian()
+            opened = []
+            try:
+                GUARD.SourceLeaseGuard.acquire(
+                    transaction_id='offline-r2', lock_fd=lock_fd,
+                    custodian=custodian,
+                    read_control=lambda path: (
+                        '45' if path == GUARD.LEASE_BREAK_TIME_PATH else '1'),
+                    tpm_directory=tpm_directory, disk_paths=disk_paths,
+                    nvram_path=nvram_path,
+                    opener=lambda path, flags: (opened.append(path) or
+                                                GUARD._open_no_symlinks(path, flags)))
+            except GUARD.SourceLeaseError:
+                pass
+            else:
+                raise AssertionError('finite kernel lease timeout was accepted')
+            if opened or custodian.store_calls:
+                raise AssertionError('finite-timeout failure opened or stored source descriptors')
+            checks['finite_timeout_fails_before_source_open'] = 'PASS'
+            custodian.close()
+
+            # Actual kernel leases are acquired only on disposable files.
+            custodian = SocketFDCustodian()
+            fd_fsync = []
+            guard = GUARD.SourceLeaseGuard.acquire(
+                transaction_id='offline-r2', lock_fd=lock_fd,
+                custodian=custodian, read_control=lambda path: _controls()[path],
+                tpm_directory=tpm_directory, disk_paths=disk_paths,
+                nvram_path=nvram_path,
+                fsync=lambda fd: (fd_fsync.append(fd), os.fsync(fd))[1])
+            try:
+                receipt = guard.verify_held()
+                expected_count = len(disk_paths) + 1 + 2
+                if (receipt['SourceCount'] != expected_count
+                        or receipt['AllReadLeasesHeld'] is not True
+                        or custodian.store_calls != 1
+                        or len(fd_fsync) != expected_count
+                        or len(set(fd_fsync)) != expected_count):
+                    raise AssertionError('same-FD lease/fsync/FD-store evidence is incomplete')
+                if any(fcntl.fcntl(fd, GUARD.F_GETLEASE) != GUARD.F_RDLCK
+                       for _path, fd in guard.files):
+                    raise AssertionError('a disposable source file lacks its exact read lease')
+                checks['same_fd_read_lease_fsync_and_descriptor_custody'] = 'PASS'
+                sample_path, sample_fd = guard.files[0]
+                sample_stat = os.fstat(sample_fd)
+                device_text = '%02x:%02x:%d' % (
+                    os.major(sample_stat.st_dev), os.minor(sample_stat.st_dev),
+                    sample_stat.st_ino)
+                active_row = ('17: LEASE ACTIVE READ %d %s 0 EOF\n' %
+                              (os.getpid(), device_text))
+                GUARD._verify_kernel_lease(
+                    sample_fd, sample_path, os.getpid(), lambda: active_row)
+                breaking_row = ('17: LEASE BREAKING UNLOCK %d %s 0 EOF\n' %
+                                (os.getpid(), device_text))
+                try:
+                    GUARD._verify_kernel_lease(
+                        sample_fd, sample_path, os.getpid(), lambda: breaking_row)
+                except GUARD.SourceLeaseError:
+                    checks['kernel_pending_break_row_rejected'] = 'PASS'
+                else:
+                    raise AssertionError('pending /proc/locks break state was accepted')
+                restore = {
+                    'Schema': 'T5WritableStateRestoreVerifiedV1',
+                    'OriginalSourceMatchesPreRunRecoveryByFullStream': True,
+                    'OriginalPayloadsWritten': False,
+                    'RetentionMarkerRemovedLast': True,
+                    'RestoreReceiptSHA256': 'a' * 64,
+                }
+                guard.release_after_restore(restore, 'b' * 64)
+                if custodian.remove_calls != 1 or guard.files:
+                    raise AssertionError('verified restore did not release only after FD-store removal')
+                checks['release_requires_independent_restore_receipts'] = 'PASS'
+            finally:
+                if not guard.closed:
+                    guard.retain_failure()
+                custodian.close()
+
+            # A pre-existing write-open makes lease acquisition fail before
+            # any custodian store call. No dirty-state takeover is attempted.
+            writer_path = Path(disk_paths[0])
+            os.chmod(writer_path, 0o600)
+            writer_fd = os.open(writer_path, os.O_WRONLY | os.O_CLOEXEC)
+            os.chmod(writer_path, 0o400)
+            custodian = SocketFDCustodian()
+            try:
+                try:
+                    GUARD.SourceLeaseGuard.acquire(
+                        transaction_id='offline-r2', lock_fd=lock_fd,
+                        custodian=custodian,
+                        read_control=lambda path: _controls()[path],
+                        tpm_directory=tpm_directory, disk_paths=disk_paths,
+                        nvram_path=nvram_path)
+                except (GUARD.SourceLeaseError, OSError):
+                    pass
+                else:
+                    raise AssertionError('pre-existing source writer did not block lease acquisition')
+                if custodian.store_calls:
+                    raise AssertionError('partial source set reached custody after dirty acquire')
+                checks['dirty_at_acquire_rejected_without_store'] = 'PASS'
+            finally:
+                os.close(writer_fd)
+                os.chmod(writer_path, 0o400)
+                custodian.close()
+
+            # The inode lease does not pretend to freeze directory membership:
+            # every subsequent check compares the exact TPM name set.
+            custodian = SocketFDCustodian()
+            guard = GUARD.SourceLeaseGuard.acquire(
+                transaction_id='offline-r2', lock_fd=lock_fd,
+                custodian=custodian, read_control=lambda path: _controls()[path],
+                tpm_directory=tpm_directory, disk_paths=disk_paths,
+                nvram_path=nvram_path)
+            try:
+                _write(Path(tpm_directory) / 'unexpected.member')
+                try:
+                    guard.verify_held()
+                except GUARD.SourceLeaseError:
+                    checks['tpm_directory_membership_change_detected'] = 'PASS'
+                else:
+                    raise AssertionError('TPM directory membership change was not detected')
+            finally:
+                guard.retain_failure()
+                for _path, fd in guard.files:
+                    try:
+                        fcntl.fcntl(fd, GUARD.F_SETLEASE, GUARD.F_UNLCK)
+                        os.close(fd)
+                    except OSError:
+                        pass
+                custodian.close()
+            checks['sysctl_policy_reader_is_synthetic'] = 'PASS'
+        finally:
+            os.close(lock_fd)
+    return checks
+
+
+if __name__ == '__main__':
+    print(json.dumps({'Schema': 'T5SourceLeaseGuardSelfCheckV1',
+                      'Status': 'PASS',
+                      'Scope': 'disposable temporary files and local SCM_RIGHTS surrogate only',
+                      'Checks': run()}, sort_keys=True, separators=(',', ':')))
===== driver/scripts/t5/T5SourceLeaseGuard.py (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/T5SourceLeaseGuard.py
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/T5SourceLeaseGuard.py
@@ -0,0 +1,862 @@
+#!/usr/bin/env python3
+"""Candidate read leases for the exact T5 source set.
+
+This module never changes a sysctl or source object.  It requires an
+unbounded kernel lease break interval and a qualified supervisor FD store
+before it opens payload paths.  All data access remains read-only and every
+lease is acquired on, fsynced through, and checked on the same descriptor.
+The production adapter is intended for a reviewed systemd service unit; it
+fails closed when the process is not that unit's main process.
+"""
+from __future__ import annotations
+
+import ctypes
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import stat
+import subprocess
+import threading
+import time
+from typing import Any, Callable
+
+
+DISK_PATHS = (
+    '/var/lib/libvirt/images/win10-debug3.base-20261009.qcow2',
+    '/mnt/storage/libvirt/images/win10-debug2.flat-20261009.qcow2',
+)
+NVRAM_PATH = '/var/lib/libvirt/qemu/nvram/win10-debug3_VARS.fd'
+TPM_DIRECTORY = '/var/lib/libvirt/swtpm/ffcb9530-146b-43b1-8af7-2b5cc8ede2e3/tpm2'
+CANONICAL_LOCK_PATH = '/run/safeupload-t5/win10-debug3.lifecycle.lock'
+LEASE_BREAK_TIME_PATH = '/proc/sys/fs/lease-break-time'
+LEASES_ENABLE_PATH = '/proc/sys/fs/leases-enable'
+SCHEMA = 'T5SourceLeaseSetV1'
+MAX_TPM_MEMBERS = 16
+FDCUSTODY_UNIT_PREFIX = 'safeupload-t5-copy-r2@'
+F_SETLEASE = getattr(fcntl, 'F_SETLEASE', 1024)
+F_GETLEASE = getattr(fcntl, 'F_GETLEASE', 1025)
+F_RDLCK = fcntl.F_RDLCK
+F_UNLCK = fcntl.F_UNLCK
+TOKEN_RE = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}\Z')
+SHA_RE = re.compile(r'[0-9a-f]{64}\Z')
+LEASE_ROW_RE = re.compile(
+    r'^(?:\d+):\s+LEASE\s+(ACTIVE|BREAKING)\s+(READ|WRITE|UNLOCK)\s+'
+    r'(\d+)\s+([0-9a-fA-F]+):([0-9a-fA-F]+):(\d+)(?:\s+.*)?$')
+
+
+class SourceLeaseError(RuntimeError):
+    pass
+
+
+def _sha(raw: bytes) -> str:
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _identity(fd: int, path: str) -> dict[str, Any]:
+    row = os.fstat(fd)
+    if not stat.S_ISREG(row.st_mode) or row.st_nlink != 1:
+        raise SourceLeaseError('protected source is not one regular inode: ' + path)
+    by_path = _stat_no_symlinks(path)
+    if (not stat.S_ISREG(by_path.st_mode) or by_path.st_nlink != 1
+            or (by_path.st_dev, by_path.st_ino) != (row.st_dev, row.st_ino)):
+        raise SourceLeaseError('protected source path does not name the opened inode: ' + path)
+    return {
+        'Path': path, 'Device': row.st_dev, 'Inode': row.st_ino,
+        'UID': row.st_uid, 'GID': row.st_gid,
+        'Mode': format(stat.S_IMODE(row.st_mode), '04o'),
+        'Bytes': row.st_size, 'MTimeNS': row.st_mtime_ns,
+        'CTimeNS': row.st_ctime_ns, 'LinkCount': row.st_nlink,
+    }
+
+
+def _open_parent_no_symlinks(path: str) -> tuple[int, str]:
+    if (not isinstance(path, str) or not path.startswith('/') or path == '/'
+            or os.path.normpath(path) != path or '\x00' in path):
+        raise SourceLeaseError('source path is not normalized absolute')
+    parts = path[1:].split('/')
+    if any(part in ('', '.', '..') for part in parts):
+        raise SourceLeaseError('source path contains an unsafe component')
+    current = os.open('/', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
+    try:
+        for part in parts[:-1]:
+            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                          os.O_NOFOLLOW, dir_fd=current)
+            st = os.fstat(nxt)
+            if not stat.S_ISDIR(st.st_mode):
+                os.close(nxt)
+                raise SourceLeaseError('source path parent is not a directory')
+            os.close(current)
+            current = nxt
+        return current, parts[-1]
+    except BaseException:
+        os.close(current)
+        raise
+
+
+def _open_no_symlinks(path: str, flags: int) -> int:
+    parent, leaf = _open_parent_no_symlinks(path)
+    try:
+        return os.open(leaf, flags | os.O_NOFOLLOW, dir_fd=parent)
+    finally:
+        os.close(parent)
+
+
+def _stat_no_symlinks(path: str) -> os.stat_result:
+    parent, leaf = _open_parent_no_symlinks(path)
+    try:
+        return os.stat(leaf, dir_fd=parent, follow_symlinks=False)
+    finally:
+        os.close(parent)
+
+
+def _source_names(tpm_directory: str) -> tuple[str, ...]:
+    directory_fd = _open_no_symlinks(tpm_directory, os.O_RDONLY | os.O_DIRECTORY |
+                                     os.O_CLOEXEC)
+    try:
+        names = tuple(sorted(os.listdir(directory_fd)))
+        if not names or '.lock' not in names or len(names) > MAX_TPM_MEMBERS:
+            raise SourceLeaseError('TPM source member set is empty, unbounded, or lacks .lock')
+        for name in names:
+            if (not name or name in ('.', '..') or '/' in name or '\\' in name
+                    or '\x00' in name):
+                raise SourceLeaseError('TPM source contains an unsafe member name')
+        return names
+    finally:
+        os.close(directory_fd)
+
+
+def _read_sysctl(path: str) -> str:
+    if path not in (LEASE_BREAK_TIME_PATH, LEASES_ENABLE_PATH):
+        raise SourceLeaseError('unexpected lease sysctl path')
+    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+    try:
+        row = os.fstat(fd)
+        if not stat.S_ISREG(row.st_mode):
+            raise SourceLeaseError('lease kernel control is not a regular read-only value')
+        raw = os.read(fd, 128)
+        if not raw or len(raw) >= 128:
+            raise SourceLeaseError('lease kernel control value is empty or unbounded')
+        return raw.decode('ascii').strip()
+    finally:
+        os.close(fd)
+
+
+def _require_kernel_lease_policy(read_control: Callable[[str], str]) -> dict[str, int]:
+    """Require leases enabled and zero automatic break timeout, read-only."""
+    try:
+        enabled_text = read_control(LEASES_ENABLE_PATH)
+        break_text = read_control(LEASE_BREAK_TIME_PATH)
+        enabled, break_time = int(enabled_text), int(break_text)
+    except (OSError, ValueError, UnicodeError) as exc:
+        raise SourceLeaseError('cannot verify the fixed kernel lease policy') from exc
+    if enabled != 1 or break_time != 0:
+        raise SourceLeaseError('kernel leases must be enabled with zero automatic break timeout')
+    return {'LeasesEnabled': enabled, 'LeaseBreakTimeSeconds': break_time,
+            'ControlsWritten': False}
+
+
+def _process_start_ticks(pid: int) -> int:
+    try:
+        raw = Path('/proc/%d/stat' % pid).read_text(encoding='ascii')
+    except (OSError, UnicodeError) as exc:
+        raise SourceLeaseError('lease owner process identity is unavailable') from exc
+    close = raw.rfind(')')
+    if close < 0:
+        raise SourceLeaseError('lease owner process record is malformed')
+    fields = raw[close + 1:].split()
+    if len(fields) <= 19 or not fields[19].isdigit():
+        raise SourceLeaseError('lease owner start-time record is malformed')
+    return int(fields[19])
+
+
+def _optional_process_start_ticks(pid: int) -> int | None:
+    try:
+        raw = Path('/proc/%d/stat' % pid).read_text(encoding='ascii')
+    except FileNotFoundError:
+        return None
+    except (OSError, UnicodeError) as exc:
+        raise SourceLeaseError('lease owner process identity is not inspectable') from exc
+    close = raw.rfind(')')
+    if close < 0:
+        raise SourceLeaseError('lease owner process record is malformed')
+    fields = raw[close + 1:].split()
+    if len(fields) <= 19 or not fields[19].isdigit():
+        raise SourceLeaseError('lease owner start-time record is malformed')
+    return int(fields[19])
+
+
+def _proc_locks_rows(read_locks: Callable[[], str]) -> list[dict[str, Any]]:
+    try:
+        raw = read_locks()
+    except (OSError, UnicodeError) as exc:
+        raise SourceLeaseError('kernel lock table could not be inspected') from exc
+    if not isinstance(raw, str) or len(raw) > 4 * 1024 * 1024:
+        raise SourceLeaseError('kernel lock table exceeds its strict read bound')
+    rows = []
+    for line in raw.splitlines():
+        if 'LEASE' not in line:
+            continue
+        match = LEASE_ROW_RE.fullmatch(line)
+        if match is None:
+            raise SourceLeaseError('kernel lease lock-table row is malformed')
+        status, mode, pid, major, minor, inode = match.groups()
+        rows.append({'Status': status, 'Mode': mode, 'PID': int(pid),
+                     'Major': int(major, 16), 'Minor': int(minor, 16),
+                     'Inode': int(inode)})
+    return rows
+
+
+def _read_proc_locks() -> str:
+    fd = os.open('/proc/locks', os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+    try:
+        chunks = []
+        total = 0
+        while total <= 4 * 1024 * 1024:
+            chunk = os.read(fd, min(65536, 4 * 1024 * 1024 + 1 - total))
+            if not chunk:
+                break
+            chunks.append(chunk)
+            total += len(chunk)
+        if total > 4 * 1024 * 1024:
+            raise SourceLeaseError('kernel lock table exceeds its strict read bound')
+        return b''.join(chunks).decode('ascii', 'strict')
+    finally:
+        os.close(fd)
+
+
+def _verify_kernel_lease(fd: int, path: str, expected_owner_pid: int,
+                         read_locks: Callable[[], str], *,
+                         rows: list[dict[str, Any]] | None = None) -> dict[str, Any]:
+    if fcntl.fcntl(fd, F_GETLEASE) != F_RDLCK:
+        raise SourceLeaseError('source descriptor does not report an active read lease: ' + path)
+    st = os.fstat(fd)
+    major, minor = os.major(st.st_dev), os.minor(st.st_dev)
+    matches = [row for row in (rows if rows is not None else _proc_locks_rows(read_locks))
+               if (row['Major'], row['Minor'], row['Inode']) ==
+               (major, minor, st.st_ino)]
+    if (len(matches) != 1 or matches[0]['Status'] != 'ACTIVE'
+            or matches[0]['Mode'] != 'READ'
+            or matches[0]['PID'] != expected_owner_pid):
+        raise SourceLeaseError('kernel lock table does not show one active read lease owner for: ' + path)
+    return {'PID': expected_owner_pid,
+            'Major': major, 'Minor': minor, 'Inode': st.st_ino,
+            'Status': 'ACTIVE', 'Mode': 'READ'}
+
+
+class SystemdFDCustodian:
+    """Store lease FDs in the exact running systemd service manager.
+
+    A unit with FileDescriptorStorePreserve=yes is required so process exit
+    cannot drop the last lease.  This class does not create or edit a unit.
+    """
+
+    def __init__(self, *, env: dict[str, str] | None = None,
+                 run: Callable[..., Any] = subprocess.run,
+                 pid: int | None = None,
+                 notify: Callable[[str, tuple[int, ...]], int] | None = None):
+        self.env = dict(os.environ if env is None else env)
+        self.run = run
+        self.pid = os.getpid() if pid is None else pid
+        self.notify = notify or self._sd_notify
+        self.unit: str | None = None
+        self.max_fds = 0
+        self.descriptor_limit = 0
+        self.descriptor_count = 0
+        self.store_names: list[str] = []
+        self.stored = False
+        self._last_manager_check = 0.0
+
+    @staticmethod
+    def _unit_from_cgroup(raw: str) -> str:
+        units = set()
+        for line in raw.splitlines():
+            parts = line.split(':', 2)
+            if len(parts) != 3:
+                raise SourceLeaseError('process cgroup record is malformed')
+            for component in parts[2].split('/'):
+                if component.endswith('.service'):
+                    units.add(component)
+        if len(units) != 1:
+            raise SourceLeaseError('process is not in one exact systemd service cgroup')
+        return next(iter(units))
+
+    def _properties(self, unit: str) -> dict[str, str]:
+        try:
+            result = self.run(
+                ['/usr/bin/systemctl', 'show', '--no-pager',
+                 '--property=MainPID', '--property=FileDescriptorStoreMax',
+                 '--property=FileDescriptorStorePreserve', '--property=NotifyAccess',
+                 '--property=NFileDescriptorStore',
+                 unit], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                stderr=subprocess.PIPE, env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'},
+                timeout=5, check=False)
+        except (OSError, subprocess.TimeoutExpired) as exc:
+            raise SourceLeaseError('cannot inspect the current service FD-store policy') from exc
+        if result.returncode != 0:
+            raise SourceLeaseError('systemd did not return the current service FD-store policy')
+        values: dict[str, str] = {}
+        try:
+            lines = result.stdout.decode('utf-8', 'strict').splitlines()
+        except UnicodeError as exc:
+            raise SourceLeaseError('systemd service properties are not UTF-8') from exc
+        for line in lines:
+            key, separator, value = line.partition('=')
+            if not separator or key in values:
+                raise SourceLeaseError('systemd service FD-store properties are malformed')
+            values[key] = value
+        expected = {'MainPID', 'FileDescriptorStoreMax',
+                    'FileDescriptorStorePreserve', 'NotifyAccess',
+                    'NFileDescriptorStore'}
+        if set(values) != expected:
+            raise SourceLeaseError('systemd omitted a required service FD-store property')
+        return values
+
+    def preflight(self, transaction_id: str, descriptor_count: int) -> dict[str, Any]:
+        if (not isinstance(transaction_id, str) or TOKEN_RE.fullmatch(transaction_id) is None
+                or type(descriptor_count) is not int or descriptor_count < 2
+                or descriptor_count > MAX_TPM_MEMBERS + len(DISK_PATHS) + 2):
+            raise SourceLeaseError('FD-store transaction or descriptor count is malformed')
+        if not self.env.get('NOTIFY_SOCKET'):
+            raise SourceLeaseError('process has no systemd notification FD store')
+        try:
+            cgroup = Path('/proc/self/cgroup').read_text(encoding='utf-8')
+            unit = self._unit_from_cgroup(cgroup)
+            properties = self._properties(unit)
+            main_pid = int(properties['MainPID'])
+            max_fds = int(properties['FileDescriptorStoreMax'])
+            store_count = int(properties['NFileDescriptorStore'])
+        except (OSError, UnicodeError, ValueError) as exc:
+            raise SourceLeaseError('cannot validate the exact systemd unit identity') from exc
+        expected_unit = FDCUSTODY_UNIT_PREFIX + transaction_id + '.service'
+        if (unit != expected_unit or main_pid != self.pid or max_fds < descriptor_count
+                or properties['FileDescriptorStorePreserve'] != 'yes'
+                or properties['NotifyAccess'] != 'main'
+                or store_count != 0):
+            raise SourceLeaseError('systemd unit does not preserve enough descriptors across process exit')
+        self.unit = unit
+        self.max_fds = max_fds
+        self.descriptor_limit = descriptor_count
+        self.store_names = ['t5-' + transaction_id + '-lock'] + [
+            't5-' + transaction_id + '-source-' + format(index, '02d')
+            for index in range(descriptor_count - 1)]
+        return {'Unit': unit, 'MainPID': main_pid, 'StoreMax': max_fds,
+                'DescriptorCount': descriptor_count,
+                'Preserve': properties['FileDescriptorStorePreserve'],
+                'NotifyAccess': properties['NotifyAccess'],
+                'ManagerStoreCount': store_count,
+                'TransactionStoreNames': list(self.store_names)}
+
+    def bind_count(self, descriptor_count: int) -> None:
+        if (type(descriptor_count) is not int or descriptor_count < 2
+                or descriptor_count > self.descriptor_limit):
+            raise SourceLeaseError('exact FD-store count exceeds its preflight bound')
+        self.descriptor_count = descriptor_count
+        self.store_names = self.store_names[:descriptor_count]
+
+    @staticmethod
+    def _sd_notify(message: str, fds: tuple[int, ...]) -> int:
+        try:
+            library = ctypes.CDLL('libsystemd.so.0', use_errno=True)
+            function = library.sd_pid_notify_with_fds
+            function.argtypes = (ctypes.c_int, ctypes.c_int, ctypes.c_char_p,
+                                 ctypes.POINTER(ctypes.c_int), ctypes.c_uint)
+            function.restype = ctypes.c_int
+            array_type = ctypes.c_int * len(fds)
+            array = array_type(*fds) if fds else None
+            return int(function(0, 0, message.encode('ascii'), array, len(fds)))
+        except (OSError, AttributeError, UnicodeError) as exc:
+            raise SourceLeaseError('libsystemd FD-store notification is unavailable') from exc
+
+    def store(self, descriptors: tuple[int, ...]) -> dict[str, Any]:
+        if (self.unit is None or len(self.store_names) != self.descriptor_count
+                or len(descriptors) != self.descriptor_count):
+            raise SourceLeaseError('FD-store was not preflighted for this exact descriptor set')
+        results = []
+        try:
+            for descriptor, name in zip(descriptors, self.store_names, strict=True):
+                result = self.notify('FDSTORE=1\nFDNAME=' + name, (descriptor,))
+                if result <= 0:
+                    raise SourceLeaseError('systemd did not acknowledge a named source lease FD')
+                results.append(result)
+            self.stored = True
+            self._await_manager_store_count(len(descriptors))
+        except BaseException:
+            # Keep any accepted manager descriptors accounted for. The caller
+            # may retry exact removals while its local descriptors remain open.
+            self.stored = bool(results)
+            raise
+        return {'Unit': self.unit, 'StoreNames': list(self.store_names),
+                'DescriptorCount': len(descriptors), 'NotifyResults': results,
+                'ManagerAcknowledgedMessage': True,
+                'RestartReattachmentMustBeRevalidated': True}
+
+    def _manager_count(self) -> int:
+        if self.unit is None:
+            raise SourceLeaseError('systemd unit identity is absent')
+        properties = self._properties(self.unit)
+        try:
+            count = int(properties['NFileDescriptorStore'])
+            main_pid = int(properties['MainPID'])
+        except ValueError as exc:
+            raise SourceLeaseError('systemd FD-store count or MainPID is malformed') from exc
+        if (main_pid != self.pid or count < 0 or count > self.max_fds
+                or properties['FileDescriptorStorePreserve'] != 'yes'
+                or properties['NotifyAccess'] != 'main'):
+            raise SourceLeaseError('systemd FD-store identity or preserve policy changed')
+        return count
+
+    def _await_manager_store_count(self, expected: int) -> None:
+        deadline = time.monotonic() + 5.0
+        while True:
+            count = self._manager_count()
+            if count == expected:
+                self._last_manager_check = time.monotonic()
+                return
+            if count > expected or time.monotonic() >= deadline:
+                raise SourceLeaseError(
+                    'systemd manager descriptor count differs: expected %d, observed %d' %
+                    (expected, count))
+            time.sleep(0.05)
+
+    def verify(self, descriptors: tuple[int, ...]) -> None:
+        if (not self.stored or self.unit is None
+                or len(self.store_names) != self.descriptor_count
+                or len(descriptors) != self.descriptor_count):
+            raise SourceLeaseError('systemd FD-store receipt is absent or incomplete')
+        if (os.getpid() != self.pid or self.max_fds < len(descriptors)
+                or not self.env.get('NOTIFY_SOCKET')):
+            raise SourceLeaseError('systemd FD-store process capability changed')
+        now = time.monotonic()
+        if now - self._last_manager_check >= 1.0:
+            if self._manager_count() != len(descriptors):
+                raise SourceLeaseError('systemd no longer retains the exact source lease descriptor set')
+            self._last_manager_check = now
+
+    def remove(self) -> None:
+        if not self.stored or not self.store_names:
+            return
+        for name in self.store_names:
+            result = self.notify('FDSTOREREMOVE=1\nFDNAME=' + name, ())
+            if result <= 0:
+                raise SourceLeaseError('systemd did not acknowledge removal of a completed transaction FD')
+        self._await_manager_store_count(0)
+        self.stored = False
+        self.store_names.clear()
+
+    @classmethod
+    def reattach(cls, transaction_id: str, descriptor_count: int, *,
+                 env: dict[str, str] | None = None,
+                 run: Callable[..., Any] = subprocess.run,
+                 notify: Callable[[str, tuple[int, ...]], int] | None = None,
+                 pid: int | None = None) -> tuple['SystemdFDCustodian', dict[str, int]]:
+        """Adopt the exact per-run service descriptors after process restart."""
+        environment = dict(os.environ if env is None else env)
+        process_id = os.getpid() if pid is None else pid
+        if (not isinstance(transaction_id, str) or TOKEN_RE.fullmatch(transaction_id) is None
+                or type(descriptor_count) is not int or descriptor_count < 2
+                or descriptor_count > MAX_TPM_MEMBERS + len(DISK_PATHS) + 2):
+            raise SourceLeaseError('FD-store recovery identity or count is malformed')
+        expected_names = ['t5-' + transaction_id + '-lock'] + [
+            't5-' + transaction_id + '-source-' + format(index, '02d')
+            for index in range(descriptor_count - 1)]
+        try:
+            listen_pid = int(environment['LISTEN_PID'])
+            listen_count = int(environment['LISTEN_FDS'])
+            names = environment['LISTEN_FDNAMES'].split(':')
+        except (KeyError, ValueError) as exc:
+            raise SourceLeaseError('systemd restart did not provide named retained descriptors') from exc
+        if (listen_pid != process_id or listen_count != descriptor_count
+                or len(names) != descriptor_count or len(set(names)) != descriptor_count
+                or set(names) != set(expected_names)):
+            raise SourceLeaseError('systemd restart descriptor names/count differ from the exact transaction')
+        unit = cls._unit_from_cgroup(Path('/proc/self/cgroup').read_text(encoding='utf-8'))
+        if unit != FDCUSTODY_UNIT_PREFIX + transaction_id + '.service':
+            raise SourceLeaseError('recovery process is outside the exact per-run systemd service')
+        custodian = cls(env=environment, run=run, notify=notify, pid=process_id)
+        custodian.unit = unit
+        properties = custodian._properties(unit)
+        try:
+            main_pid = int(properties['MainPID'])
+            max_fds = int(properties['FileDescriptorStoreMax'])
+            manager_count = int(properties['NFileDescriptorStore'])
+        except ValueError as exc:
+            raise SourceLeaseError('systemd restart service properties are malformed') from exc
+        if (main_pid != process_id or max_fds < descriptor_count
+                or manager_count != descriptor_count
+                or properties['FileDescriptorStorePreserve'] != 'yes'
+                or properties['NotifyAccess'] != 'main'
+                or not environment.get('NOTIFY_SOCKET')):
+            raise SourceLeaseError('systemd restart did not preserve the exact source FDs')
+        custodian.max_fds = max_fds
+        custodian.descriptor_limit = descriptor_count
+        custodian.descriptor_count = descriptor_count
+        custodian.store_names = expected_names
+        custodian.stored = True
+        custodian._last_manager_check = time.monotonic()
+        first_fd = 3
+        adopted = {name: first_fd + names.index(name) for name in expected_names}
+        return custodian, adopted
+
+
+class SourceLeaseGuard:
+    """Hold the exact source inode set until independent restoration evidence."""
+
+    def __init__(self, *, transaction_id: str, files: list[tuple[str, int]],
+                 tpm_directory: str, identities: list[dict[str, Any]],
+                 directory_names: tuple[str, ...], policy: dict[str, int],
+                 custodian: Any, custody_receipt: dict[str, Any],
+                 lock_fd: int, break_flag: threading.Event,
+                 read_control: Callable[[str], str],
+                 lease_owner_pid: int, lease_owner_start_ticks: int,
+                 read_locks: Callable[[], str],
+                 process_restarted: bool = False):
+        self.transaction_id = transaction_id
+        self.files = files
+        self.tpm_directory = tpm_directory
+        self.identities = identities
+        self.directory_names = directory_names
+        self.policy = policy
+        self.custodian = custodian
+        self.custody_receipt = custody_receipt
+        self.lock_fd = lock_fd
+        self.break_flag = break_flag
+        self.read_control = read_control
+        self.lease_owner_pid = lease_owner_pid
+        self.lease_owner_start_ticks = lease_owner_start_ticks
+        self.read_locks = read_locks
+        self.process_restarted = process_restarted
+        self.closed = False
+        self.retained = False
+
+    @classmethod
+    def acquire(cls, *, transaction_id: str, lock_fd: int,
+                custodian: Any,
+                read_control: Callable[[str], str] = _read_sysctl,
+                tpm_directory: str = TPM_DIRECTORY,
+                disk_paths: tuple[str, ...] = DISK_PATHS,
+                nvram_path: str = NVRAM_PATH,
+                opener: Callable[..., int] = _open_no_symlinks,
+                setter: Callable[..., Any] = fcntl.fcntl,
+                fsync: Callable[[int], Any] = os.fsync,
+                getter: Callable[[int], int] = lambda fd: fcntl.fcntl(fd, F_GETLEASE),
+                signal_handler: Callable[[int, Any], Any] = signal.signal,
+                read_locks: Callable[[], str] = _read_proc_locks) -> 'SourceLeaseGuard':
+        if not isinstance(transaction_id, str) or TOKEN_RE.fullmatch(transaction_id) is None:
+            raise SourceLeaseError('source lease transaction identity is malformed')
+        policy = _require_kernel_lease_policy(read_control)
+        custodian.preflight(
+            transaction_id, MAX_TPM_MEMBERS + len(DISK_PATHS) + 2)
+        names = _source_names(tpm_directory)
+        paths = tuple(disk_paths) + (nvram_path,) + tuple(
+            tpm_directory.rstrip('/') + '/' + name for name in names)
+        owner_pid = os.getpid()
+        owner_start_ticks = _process_start_ticks(owner_pid)
+        custodian.bind_count(len(paths) + 1)
+        files: list[tuple[str, int]] = []
+        identities: list[dict[str, Any]] = []
+        break_flag = threading.Event()
+        old_handler = signal.getsignal(signal.SIGIO)
+
+        def noticed_break(_signum: int, _frame: Any) -> None:
+            break_flag.set()
+
+        opened_by_path: dict[str, int] = {}
+        try:
+            signal_handler(signal.SIGIO, noticed_break)
+            for path in paths:
+                fd = opener(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW |
+                            getattr(os, 'O_NOATIME', 0))
+                opened_by_path[path] = fd
+                identity = _identity(fd, path)
+                setter(fd, F_SETLEASE, F_RDLCK)
+                fsync(fd)
+                _verify_kernel_lease(fd, path, owner_pid, read_locks)
+                if getter(fd) != F_RDLCK:
+                    raise SourceLeaseError('source read lease did not remain on its exact descriptor')
+                identity_after = _identity(fd, path)
+                if identity_after != identity:
+                    raise SourceLeaseError('source identity changed while acquiring its read lease')
+                files.append((path, fd))
+                identities.append(identity)
+            current_names = _source_names(tpm_directory)
+            if current_names != names:
+                raise SourceLeaseError('TPM directory membership changed during lease acquisition')
+            descriptors = (lock_fd,) + tuple(fd for _path, fd in files)
+            custody_receipt = custodian.store(descriptors)
+            custodian.verify(descriptors)
+            guard = cls(transaction_id=transaction_id, files=files,
+                        tpm_directory=tpm_directory, identities=identities,
+                        directory_names=names, policy=policy,
+                        custodian=custodian, custody_receipt=custody_receipt,
+                        lock_fd=lock_fd, break_flag=break_flag,
+                        read_control=read_control, lease_owner_pid=owner_pid,
+                        lease_owner_start_ticks=owner_start_ticks,
+                        read_locks=read_locks)
+            guard._old_signal_handler = old_handler
+            guard.verify_held()
+            return guard
+        except BaseException:
+            try:
+                custodian.remove()
+            except BaseException:
+                pass
+            for fd in opened_by_path.values():
+                try:
+                    if getter(fd) != F_UNLCK:
+                        setter(fd, F_SETLEASE, F_UNLCK)
+                except BaseException:
+                    pass
+                try:
+                    os.close(fd)
+                except OSError:
+                    pass
+            try:
+                signal_handler(signal.SIGIO, old_handler)
+            except BaseException:
+                pass
+            raise
+
+    @classmethod
+    def reattach_from_receipt(cls, *, receipt: dict[str, Any],
+                              receipt_sha256: str,
+                              env: dict[str, str] | None = None,
+                              run: Callable[..., Any] = subprocess.run,
+                              pid: int | None = None,
+                              read_control: Callable[[str], str] = _read_sysctl,
+                              fsync: Callable[[int], Any] = os.fsync,
+                              getter: Callable[[int], int] = lambda fd: fcntl.fcntl(fd, F_GETLEASE),
+                              signal_handler: Callable[[int, Any], Any] = signal.signal,
+                              read_locks: Callable[[], str] = _read_proc_locks
+                              ) -> 'SourceLeaseGuard':
+        """Reconstruct source custody from a pinned receipt and systemd FDs.
+
+        The restart path never reopens a protected payload inode to acquire a
+        fresh lease. It adopts only the exact manager-retained descriptors,
+        then verifies their lease, inode, path, lock and TPM membership.
+        """
+        if (not isinstance(receipt, dict)
+                or receipt.get('Schema') != 'T5SourceLeaseSetReceiptV1'
+                or receipt.get('Domain') != 'win10-debug3'
+                or receipt.get('UUID') != 'ffcb9530-146b-43b1-8af7-2b5cc8ede2e3'
+                or not isinstance(receipt.get('RunTag'), str)
+                or TOKEN_RE.fullmatch(receipt['RunTag']) is None
+                or not isinstance(receipt.get('RequestSHA256'), str)
+                or SHA_RE.fullmatch(receipt['RequestSHA256']) is None
+                or not isinstance(receipt_sha256, str)
+                or SHA_RE.fullmatch(receipt_sha256) is None):
+            raise SourceLeaseError('durable source lease receipt identity is malformed')
+        canonical_receipt = json.dumps(
+            receipt, sort_keys=True, separators=(',', ':'),
+            ensure_ascii=False).encode('utf-8')
+        if _sha(canonical_receipt) != receipt_sha256:
+            raise SourceLeaseError('durable source lease receipt hash differs from its exact bytes')
+        source_guard_receipt = receipt.get('SourceGuard')
+        if not isinstance(source_guard_receipt, dict):
+            raise SourceLeaseError('durable source guard receipt is not an object')
+        owner_pid = source_guard_receipt.get('LeaseOwnerPID')
+        owner_start_ticks = source_guard_receipt.get('LeaseOwnerStartTicks')
+        if (type(owner_pid) is not int or owner_pid <= 0
+                or type(owner_start_ticks) is not int or owner_start_ticks <= 0):
+            raise SourceLeaseError('durable source lease owner identity is absent')
+        names_raw = source_guard_receipt.get('TPMDirectoryNames')
+        identities_raw = receipt.get('SourceInodes')
+        lock_path = receipt.get('CanonicalLockPath')
+        lock_device = receipt.get('CanonicalLockDevice')
+        lock_inode = receipt.get('CanonicalLockInode')
+        if (lock_path != CANONICAL_LOCK_PATH
+                or type(lock_device) is not int or lock_device < 0
+                or type(lock_inode) is not int or lock_inode <= 0
+                or not isinstance(names_raw, list) or not names_raw
+                or names_raw != sorted(set(names_raw))
+                or '.lock' not in names_raw or len(names_raw) > MAX_TPM_MEMBERS
+                or not isinstance(identities_raw, list)):
+            raise SourceLeaseError('durable source lease receipt omits exact lock/source identities')
+        names = tuple(names_raw)
+        if any(not isinstance(name, str) or name in ('', '.', '..')
+               or '/' in name or '\\' in name or '\x00' in name for name in names):
+            raise SourceLeaseError('durable TPM membership contains an unsafe member name')
+        expected_paths = (DISK_PATHS + (NVRAM_PATH,) + tuple(
+            TPM_DIRECTORY.rstrip('/') + '/' + name for name in names))
+        if (len(identities_raw) != len(expected_paths)
+                or any(not isinstance(row, dict) or row.get('Path') != path
+                       for row, path in zip(identities_raw, expected_paths, strict=True))):
+            raise SourceLeaseError('durable source lease inode set differs from the exact fixed source set')
+        for row in identities_raw:
+            required = {'Path', 'Device', 'Inode', 'UID', 'GID', 'Mode',
+                        'Bytes', 'MTimeNS', 'CTimeNS', 'LinkCount'}
+            if (set(row) != required or type(row['Device']) is not int
+                    or type(row['Inode']) is not int or row['Inode'] <= 0
+                    or type(row['UID']) is not int or type(row['GID']) is not int
+                    or type(row['Bytes']) is not int or row['Bytes'] < 0
+                    or type(row['MTimeNS']) is not int or type(row['CTimeNS']) is not int
+                    or row['LinkCount'] != 1):
+                raise SourceLeaseError('durable source lease inode metadata is malformed')
+        if (not isinstance(source_guard_receipt, dict)
+                or source_guard_receipt.get('Schema') != SCHEMA
+                or source_guard_receipt.get('SourceCount') != len(expected_paths)
+                or source_guard_receipt.get('AllReadLeasesHeld') is not True
+                or source_guard_receipt.get('SourceIdentitySHA256') != _sha(json.dumps(
+                    identities_raw, sort_keys=True, separators=(',', ':')).encode())
+                or source_guard_receipt.get('KernelPolicy') != {
+                    'LeasesEnabled': 1, 'LeaseBreakTimeSeconds': 0,
+                    'ControlsWritten': False}):
+            raise SourceLeaseError('durable source guard receipt is not an exact read-lease set')
+        expected_store_names = ['t5-' + receipt['RunTag'] + '-lock'] + [
+            't5-' + receipt['RunTag'] + '-source-' + format(index, '02d')
+            for index in range(len(expected_paths))]
+        initial_custody = source_guard_receipt.get('FDCustody')
+        if (not isinstance(initial_custody, dict)
+                or initial_custody.get('Unit') !=
+                   FDCUSTODY_UNIT_PREFIX + receipt['RunTag'] + '.service'
+                or initial_custody.get('StoreNames') != expected_store_names
+                or initial_custody.get('DescriptorCount') != len(expected_store_names)
+                or initial_custody.get('ManagerAcknowledgedMessage') is not True):
+            raise SourceLeaseError('durable source lease FD-store record is not exact')
+        policy = _require_kernel_lease_policy(read_control)
+        custody = SystemdFDCustodian.reattach(
+            receipt['RunTag'], len(expected_paths) + 1,
+            env=env, run=run, pid=pid)
+        custodian, descriptors = custody
+        lock_fd = descriptors['t5-' + receipt['RunTag'] + '-lock']
+        lock_stat = os.fstat(lock_fd)
+        try:
+            lock_path_now = os.readlink('/proc/%d/fd/%d' % (
+                os.getpid() if pid is None else pid, lock_fd))
+            lock_fdinfo = Path('/proc/%d/fdinfo/%d' % (
+                os.getpid() if pid is None else pid, lock_fd)).read_text(encoding='ascii')
+        except (OSError, UnicodeError) as exc:
+            raise SourceLeaseError('canonical lifecycle lock descriptor cannot be inspected after restart') from exc
+        lock_records = [line for line in lock_fdinfo.splitlines()
+                        if re.fullmatch(r'lock:\s+\d+:\s+FLOCK\s+ADVISORY\s+WRITE\s+\d+\s+'
+                                        r'[0-9a-fA-F]+:[0-9a-fA-F]+:\d+\s+0\s+EOF', line)]
+        if (lock_path_now != CANONICAL_LOCK_PATH
+                or (lock_stat.st_dev, lock_stat.st_ino) != (lock_device, lock_inode)
+                or lock_stat.st_uid != 0 or lock_stat.st_gid != 0
+                or stat.S_IMODE(lock_stat.st_mode) != 0o444 or lock_stat.st_nlink != 1
+                or len(lock_records) != 1):
+            raise SourceLeaseError('systemd-retained FD is not the exact held canonical root lock')
+        current_owner_ticks = _optional_process_start_ticks(owner_pid)
+        if current_owner_ticks is not None:
+            if current_owner_ticks != owner_start_ticks:
+                raise SourceLeaseError('original source lease owner PID was reused before restart adoption')
+            raise SourceLeaseError('prior source lease owner is still alive during restart adoption')
+        lease_rows = _proc_locks_rows(read_locks)
+        files = []
+        identities = []
+        for index, (path, expected) in enumerate(zip(
+                expected_paths, identities_raw, strict=True)):
+            fd = descriptors['t5-' + receipt['RunTag'] + '-source-' + format(index, '02d')]
+            access_mode = fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE
+            if (access_mode != os.O_RDONLY or getter(fd) != F_RDLCK
+                    or _identity(fd, path) != expected):
+                raise SourceLeaseError('re-attached descriptor is not the exact held source read lease: ' + path)
+            fsync(fd)
+            _verify_kernel_lease(fd, path, owner_pid, read_locks, rows=lease_rows)
+            if getter(fd) != F_RDLCK or _identity(fd, path) != expected:
+                raise SourceLeaseError('source read lease changed during restart revalidation: ' + path)
+            files.append((path, fd))
+            identities.append(expected)
+        if _source_names(TPM_DIRECTORY) != names:
+            raise SourceLeaseError('TPM directory membership changed while supervisor restarted')
+        old_handler = signal.getsignal(signal.SIGIO)
+        break_flag = threading.Event()
+
+        def noticed_break(_signum: int, _frame: Any) -> None:
+            break_flag.set()
+
+        signal_handler(signal.SIGIO, noticed_break)
+        custody_receipt = {
+            'RestartReattached': True, 'PriorReceiptSHA256': receipt_sha256,
+            'Unit': custodian.unit, 'StoreNames': list(custodian.store_names),
+            'DescriptorCount': len(expected_paths) + 1,
+            'ManagerStoreCount': len(custodian.store_names),
+            'RestartDescriptorsVerified': True,
+        }
+        guard = cls(transaction_id=receipt['RunTag'], files=files,
+                    tpm_directory=TPM_DIRECTORY, identities=identities,
+                    directory_names=names, policy=policy,
+                    custodian=custodian, custody_receipt=custody_receipt,
+                    lock_fd=lock_fd, break_flag=break_flag,
+                    read_control=read_control, lease_owner_pid=owner_pid,
+                    lease_owner_start_ticks=owner_start_ticks,
+                    read_locks=read_locks, process_restarted=True)
+        guard._old_signal_handler = old_handler
+        guard.verify_held()
+        return guard
+
+    def verify_held(self) -> dict[str, Any]:
+        if self.closed or self.retained:
+            raise SourceLeaseError('source lease guard is closed or retained for recovery')
+        if self.break_flag.is_set():
+            raise SourceLeaseError('kernel notified a source lease break request')
+        policy_now = _require_kernel_lease_policy(self.read_control)
+        if policy_now != self.policy:
+            raise SourceLeaseError('kernel lease policy changed while source lease was held')
+        owner_ticks_now = _optional_process_start_ticks(self.lease_owner_pid)
+        if self.process_restarted:
+            if owner_ticks_now is not None:
+                raise SourceLeaseError('prior source lease owner is still alive or its PID is reused')
+        elif (self.lease_owner_pid != os.getpid()
+              or owner_ticks_now != self.lease_owner_start_ticks):
+            raise SourceLeaseError('source lease supervisor process identity changed')
+        self.custodian.verify((self.lock_fd,) + tuple(fd for _path, fd in self.files))
+        if _source_names(self.tpm_directory) != self.directory_names:
+            raise SourceLeaseError('TPM source directory membership changed while leased')
+        lease_rows = _proc_locks_rows(self.read_locks)
+        for (path, fd), expected in zip(self.files, self.identities, strict=True):
+            _verify_kernel_lease(fd, path, self.lease_owner_pid,
+                                 self.read_locks, rows=lease_rows)
+            if _identity(fd, path) != expected:
+                raise SourceLeaseError('source inode/path identity changed: ' + path)
+        return {'Schema': SCHEMA, 'TransactionID': self.transaction_id,
+                'SourceCount': len(self.files),
+                'SourceIdentitySHA256': _sha(json.dumps(
+                    self.identities, sort_keys=True, separators=(',', ':')).encode()),
+                'LeaseOwnerPID': self.lease_owner_pid,
+                'LeaseOwnerStartTicks': self.lease_owner_start_ticks,
+                'KernelLeaseTableVerified': True,
+                'TPMDirectoryNames': list(self.directory_names),
+                'KernelPolicy': dict(self.policy),
+                'FDCustody': dict(self.custody_receipt),
+                'AllReadLeasesHeld': True}
+
+    def retain_failure(self) -> dict[str, Any]:
+        if self.closed:
+            raise SourceLeaseError('cannot retain a closed source lease guard')
+        self.retained = True
+        return {'TransactionID': self.transaction_id,
+                'FDCustody': dict(self.custody_receipt),
+                'RetainedForRecovery': True,
+                'AutomaticRelease': False}
+
+    def release_after_restore(self, restore_receipt: dict[str, Any],
+                              completion_receipt_sha256: str) -> None:
+        if (self.closed or self.retained or not isinstance(restore_receipt, dict)
+                or restore_receipt.get('Schema') != 'T5WritableStateRestoreVerifiedV1'
+                or restore_receipt.get('OriginalSourceMatchesPreRunRecoveryByFullStream') is not True
+                or restore_receipt.get('OriginalPayloadsWritten') is not False
+                or restore_receipt.get('RetentionMarkerRemovedLast') is not True
+                or not isinstance(restore_receipt.get('RestoreReceiptSHA256'), str)
+                or SHA_RE.fullmatch(restore_receipt['RestoreReceiptSHA256']) is None
+                or SHA_RE.fullmatch(completion_receipt_sha256) is None):
+            raise SourceLeaseError('independent whole-state restoration receipt is not complete')
+        self.verify_held()
+        self.custodian.remove()
+        for _path, fd in self.files:
+            if fcntl.fcntl(fd, F_GETLEASE) != F_RDLCK:
+                raise SourceLeaseError('source lease changed before verified release')
+            fcntl.fcntl(fd, F_SETLEASE, F_UNLCK)
+            os.close(fd)
+        self.files.clear()
+        self.closed = True
+        old_handler = getattr(self, '_old_signal_handler', signal.SIG_DFL)
+        signal.signal(signal.SIGIO, old_handler)
+
+
+def source_lease_manifest(guard: SourceLeaseGuard) -> dict[str, Any]:
+    return guard.verify_held()
+
