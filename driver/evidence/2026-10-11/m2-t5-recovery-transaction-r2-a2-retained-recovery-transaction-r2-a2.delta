+    def test_actor_and_case_admission_are_required_and_exact(self):
+        variants = (
+            ('missing-actor-verdict', None,
+             ['T5ActorTaskStart PASS actor task start receipt verified']),
+            ('duplicate-actor-verdict', None,
+             ['T5ActorTaskStart PASS first', 'T5ActorTaskStart PASS duplicate']),
+            ('missing-cases-verdict', None,
+             ['T5CasesCompleted PASS exact five-case matrix completed']),
+            ('duplicate-cases-verdict', None,
+             ['T5CasesCompleted PASS first', 'T5CasesCompleted PASS duplicate']),
+            ('actor-not-started', {'ActorTaskStartIssued': False}, []),
+            ('missing-case', {'Cases': [{'Kind': 'ProbeDelete'}]}, []),
+            ('duplicate-case-kind', {'Cases': [
+                {'Kind': 'ProbeDelete'}, {'Kind': 'ProbeDelete'},
+                {'Kind': 'OnCloseCancellation'}, {'Kind': 'NotepadApprove'},
+                {'Kind': 'NotepadHandBack'}]}, []),
+            ('wrong-case-kind', {'Cases': [
+                {'Kind': 'ProbeDelete'}, {'Kind': 'ProbeDeleteOnClose'},
+                {'Kind': 'OnCloseCancellation'}, {'Kind': 'NotepadApprove'},
+                {'Kind': 'Unrelated'}]}, []),
+            ('result-error', {'Error': 'actor failed'}, []),
+        )
+        for label, result_overrides, verdict_replacements in variants:
+            with self.subTest(label=label), tempfile.TemporaryDirectory(
+                    prefix='t5-preserve-selfcheck-') as temp:
+                evidence = Path(temp)
+                tag = 'SelfCheckG7'
+                rows = [
+                    'T5GuestAlive PASS guest answered',
+                    'T5ResultEvidence PASS current result parsed',
+                    'T5RawObserver PASS raw observer completed',
+                    'T5RawEvidenceRetained PASS current raw manifest copied',
+                    'T5ActorTaskStart PASS actor task start receipt verified',
+                    'T5CasesCompleted PASS exact five-case matrix completed',
+                ]
+                if label == 'missing-actor-verdict':
+                    rows = [row for row in rows if not row.startswith('T5ActorTaskStart ')]
+                elif label == 'duplicate-actor-verdict':
+                    rows.extend(verdict_replacements)
+                elif label == 'missing-cases-verdict':
+                    rows = [row for row in rows if not row.startswith('T5CasesCompleted ')]
+                elif label == 'duplicate-cases-verdict':
+                    rows.extend(verdict_replacements)
+                write_capture_fixture(evidence, tag, 'ordinary', verdict_rows=rows,
+                                      result_overrides=result_overrides)
+                complete, reasons = call_capture_completeness(evidence, tag)
+                self.assertFalse(complete, reasons)
