+            999999, 1000, 'org.libvirt.api.storage-vol.data-write',
+            pool_name='default', volume_name=None), 'DENY')
+
+    def test_qemu_hook_enforcement_and_unsupported_paths_are_explicit(self):
+        subprocess = __import__('subprocess')
+        adapter = HERE / 'T5WritableStateQemuHook.sh'
+        syntax = subprocess.run(['/usr/bin/bash', '-n', str(adapter)],
+                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                                check=False)
+        self.assertEqual(syntax.returncode, 0, syntax.stderr.decode('utf-8', 'replace'))
+        helper = HERE / 'T5WritableStateQemuHook.py'
+        other_xml = (b'<domain type="kvm"><name>win10-debug2</name>'
+                     b'<uuid>00000000-0000-0000-0000-000000000001</uuid>'
+                     b'<devices/></domain>')
