+     a.Allocation=I64(b,p+40); a.Eof=I64(b,p+48); a.ValidData=I64(b,p+56);
+     Require(ro>=64 && ro<len && a.Allocation>=0 && a.Eof>=0 && a.ValidData>=0 && a.ValidData<=a.Eof && a.CompressionUnit<=8,"Attribute","Bad nonresident sizes/offset");
