+#!/usr/bin/env python3
+"""Source-structure controls for the inert T5 R2 recovery candidate.
+
+This check parses only candidate source. It performs no imports of production
+helpers, filesystem changes, libvirt calls, or host actions.
+"""
+from __future__ import annotations
+
+import ast
+import json
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parent
+INVOCATION = ROOT / 'T5WritableStateCopyRootInvocation.py'
+SOURCE_GUARD = ROOT / 'T5SourceLeaseGuard.py'
+HOST_INSTALL = ROOT / 'T5WritableStateHostInstall.py'
+
+
+def _tree(path: Path) -> ast.Module:
+    return ast.parse(path.read_text(encoding='utf-8'), filename=str(path))
+
+
+def _nodes(tree: ast.AST, name: str, kinds=(ast.FunctionDef, ast.AsyncFunctionDef)):
+    found = [node for node in ast.walk(tree)
+             if isinstance(node, kinds) and node.name == name]
+    if not found:
+        raise AssertionError('missing exact source function: ' + name)
+    return found
+
+
+def _calls(node: ast.AST, name: str) -> list[int]:
+    def qualified(value: ast.AST) -> str:
+        if isinstance(value, ast.Name):
+            return value.id
+        if isinstance(value, ast.Attribute):
+            return qualified(value.value) + '.' + value.attr
+        return ''
+
+    lines = []
+    for call in ast.walk(node):
+        if not isinstance(call, ast.Call):
+            continue
+        function = call.func
+        if qualified(function) == name or qualified(function).endswith('.' + name):
+            lines.append(call.lineno)
+    return sorted(lines)
+
+
+def _ordered(node: ast.AST, names: tuple[str, ...], label: str) -> None:
+    positions = [min(_calls(node, name), default=0) for name in names]
+    if not all(positions) or positions != sorted(positions) or len(set(positions)) != len(positions):
+        raise AssertionError(label + ' source ordering differs: ' + repr(positions))
+
+
+def check() -> dict[str, str]:
+    invocation = _tree(INVOCATION)
+    guard = _tree(SOURCE_GUARD)
+    install = _tree(HOST_INSTALL)
+
+    run = _nodes(invocation, '_run_fixed_invocation')[0]
+    prep_line = min(_calls(run, 'publish_preparation_lease'), default=0)
+    intent_and_receipt = _calls(run, 'create_regular_exclusive')
+    source_line = min(_calls(run, 'SourceLeaseGuard.acquire'), default=0)
+    copy_line = min(_calls(run, 'prepare'), default=0)
+    if (not prep_line or not source_line or not copy_line
+            or len(intent_and_receipt) < 2
+            or not (prep_line < intent_and_receipt[0] < source_line
+                    < intent_and_receipt[1] < copy_line)):
+        raise AssertionError('root lock/API/source/copy sequence differs: ' + repr(
+            (prep_line, intent_and_receipt, source_line, copy_line)))
+    checks = {'preparation_api_barrier_precedes_source_scan_and_copy': 'PASS'}
+
+    cross_uuid = _nodes(invocation, '_verify_no_cross_uuid_references')[0]
+    text = ast.unparse(cross_uuid)
+    for required in ('SHARED_COLD_UUID', 'SHARED_COLD_DOMAIN',
+                     'SHARED_COLD_XML_SHA256', 'QEMU_SHUTOFF_CRASHED',
+                     'SHARED_COLD_BACKING_PATH', 'cold_alias_count != 1'):
+        if required not in text:
+            raise AssertionError('cold shared backing alias check lacks ' + required)
+    if 'if matches:' not in text:
+        raise AssertionError('ordinary cross-UUID path aliases are not rejected')
+    checks['cold_debug2_is_one_exact_inactive_alias'] = 'PASS'
+
+    provider = next(node for node in ast.walk(run)
+                    if isinstance(node, ast.ClassDef) and node.name == 'ProviderFactory')
+    provider_call = next(node for node in provider.body
+                         if isinstance(node, ast.FunctionDef) and node.name == '__call__')
+    _ordered(provider_call, ('verify_held', '_hash_original_disks',
+                             'create_regular_exclusive'),
+             'disk source baseline receipt')
+    checks['two_pass_source_disk_baseline_is_durable_before_copy'] = 'PASS'
+
+    binder = next(node for node in ast.walk(run)
+                  if isinstance(node, ast.ClassDef) and node.name == 'RunSourceBinder')
+    bind = next(node for node in binder.body
+                if isinstance(node, ast.FunctionDef) and node.name == 'bind')
+    _ordered(bind, ('read_regular', '_persist_recovery_xml', 'defineXML'),
+             'original/private XML checkpoint')
+    control = _nodes(invocation, '_handle_run_control')[0]
+    _ordered(control, ('_persist_recovery_xml', '_create_run_overlay', 'defineXML'),
+             'run XML checkpoint')
+    checks['all_xml_mutations_have_prior_recovery_bytes'] = 'PASS'
+
+    acquire = _nodes(guard, 'acquire')[0]
+    acquire_text = ast.unparse(acquire)
+    for required in ('F_SETLEASE', 'F_RDLCK', 'fsync(fd)', 'F_GETLEASE',
+                     'os.O_RDONLY', 'custodian.store'):
+        if required not in acquire_text:
+            raise AssertionError('source inode acquisition lacks ' + required)
+    reattach = _nodes(guard, 'reattach_from_receipt')[0]
+    reattach_text = ast.unparse(reattach)
+    if ('SystemdFDCustodian.reattach' not in reattach_text
+            or '_open_no_symlinks' in reattach_text
+            or 'F_GETLEASE' not in reattach_text):
+        raise AssertionError('restart path does not adopt and validate existing lease descriptors')
+    lease_verify = _nodes(guard, '_verify_kernel_lease')[0]
+    lease_verify_text = ast.unparse(lease_verify)
+    if ('_proc_locks_rows' not in lease_verify_text
+            or 'BREAKING' not in ast.unparse(guard)
+            or "'ACTIVE'" not in lease_verify_text):
+        raise AssertionError('lease verification does not reject pending kernel break state')
+    checks['same_fd_source_leases_and_existing_fd_restart_adoption'] = 'PASS'
+
+    auth = _nodes(install, '_verify_auth')[0]
+    auth_text = ast.unparse(auth)
+    if ('active_domains' not in auth_text or 'if active_domains:' not in auth_text):
+        raise AssertionError('host installation does not refuse every active domain')
+    checks['host_install_preserves_any_active_builder'] = 'PASS'
+
+    except_lines = [node for node in ast.walk(run)
+                    if isinstance(node, ast.ExceptHandler)]
+    failure_path = next((node for node in except_lines
+                         if 'supervisor-failure.json' in ast.unparse(node)), None)
+    if failure_path is None:
+        raise AssertionError('supervisor failure path does not retain durable evidence')
+    checks['failure_receipt_and_lifecycle_retention_present'] = 'PASS'
+    return checks
+
+
+if __name__ == '__main__':
+    print(json.dumps({'Schema': 'T5RecoveryTransactionSourceSelfCheckV1',
+                      'Status': 'PASS',
+                      'Scope': 'candidate source parsing only; no host or VM actions',
+                      'Checks': check()}, sort_keys=True, separators=(',', ':')))
