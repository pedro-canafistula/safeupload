+        wrong_nvram = FakeVolume('win10-debug3_VARS.fd', target + '/win10-debug3_VARS.fd', b'nvram')
+        conn = FakeConnection([wrong_nvram])
+        with self.assertRaises(inventory.InventoryError):
+            inventory.inspect_directory(conn, 'CheckTag', 'nvram', target,
+                                        target + '/win10-debug3_VARS.fd')
+        self.assertEqual(conn.pools, [])
+
+        wrong_tpm = FakeVolume('tpm2-00.permall', '/tmp/t5-source/tpm2/tpm2-00.permall')
+        wrong_tpm.xml = volume_xml(wrong_tpm._name, wrong_tpm._path,
+                                   owner='65534', group='65534')
+        conn = FakeConnection([wrong_tpm])
+        with self.assertRaises(inventory.InventoryError):
+            inventory.inspect_directory(conn, 'CheckTag', 'tpm', '/tmp/t5-source/tpm2')
+        self.assertEqual(conn.pools, [])
