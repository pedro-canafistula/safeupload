+            'RunXMLSHA256': 'f' * 64, 'PrivateIdentitySHA256': 'e' * 64,
+            'RunDiskPath': '/var/lib/libvirt/images/safeupload-t5/m2-t5-cp1011-r2/run/'
+                           'win10-debug3.safeupload-run-' + active_row['RunTag'] + '.qcow2',
+            'PublishedUnixNS': 900,
+            'Disposition': 'ROOT_SUPERVISOR_TYPED_PRESTART_AUTHORIZATION',
+        }
+        module._validate_release_binding(release, active_row, active_raw)
+        for field, value in (('RunXMLSHA256', 'malformed'),
+                             ('RunDiskPath', '/tmp/overlay.qcow2'),
+                             ('PrivateIdentitySHA256', 'malformed')):
+            candidate = copy.deepcopy(release)
+            candidate[field] = value
+            with self.subTest(field=field), self.assertRaises(module.LifecycleError):
+                module._validate_release_binding(candidate, active_row, active_raw)
+        candidate = copy.deepcopy(release)
+        wrong_active_raw = active_raw + b'changed'
+        with self.assertRaises(module.LifecycleError):
+            module._validate_release_binding(candidate, active_row, wrong_active_raw)
+
+    def test_polkit_allows_normal_policy_only_when_runtime_gate_is_absent(self):
+        with mock.patch.object(module, 'RUNTIME_DIRECTORY',
+                               '/definitely-absent-safeupload-t5-lifecycle-check'):
+            self.assertEqual(module.polkit_decision(999999, 1000), 'NO_LEASE')
+
+    def test_selected_domain_mutations_are_denied_without_a_run_lease(self):
+        for action in (
