+#!/usr/bin/env python3
+"""Fixed root-supervisor lease for the selected T5 lifecycle.
+
+The supervisor owns one exclusive flock for the entire copy/run/restore
+transaction.  It never passes that descriptor to the UID 1000 runner.  The
+runner receives only an immutable, root-created lease descriptor and must
+prove that it remains a descendant of the exact live root supervisor.  This
+module does not start guests, alter XML, or call libvirt.
+"""
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import stat
+import sys
+import time
+from dataclasses import dataclass
+from typing import Any
+
+DOMAIN = 'win10-debug3'
+DOMAIN_UUID = 'ffcb9530-146b-43b1-8af7-2b5cc8ede2e3'
+URI = 'qemu:///system'
+RUN_DISK_POOL_NAME = 'm2-t5-cp1011-r2-run'
+RUNTIME_DIRECTORY = '/run/safeupload-t5'
+LOCK_PATH = RUNTIME_DIRECTORY + '/' + DOMAIN + '.lifecycle.lock'
+ACTIVE_LEASE_PATH = RUNTIME_DIRECTORY + '/' + DOMAIN + '.active-lease.json'
+PREPARATION_LEASE_PATH = RUNTIME_DIRECTORY + '/' + DOMAIN + '.preparation-lease.json'
+START_RELEASE_PATH = RUNTIME_DIRECTORY + '/' + DOMAIN + '.start-release.json'
+LEGACY_STATE_LOCK_PATH = (
+    '/var/lib/libvirt/safeupload-t5/m2-t5-cp1011-r2/state/' +
+    DOMAIN + '.lifecycle.lock')
+LEGACY_USER_LOCK_PATH = (
+    '/home/victor/.local/state/safeupload/run-disks/' +
+    DOMAIN + '.lifecycle.lock')
+SCHEMA = 'T5RootLifecycleLeaseV2'
+PREPARATION_SCHEMA = 'T5RootLifecyclePreparationLeaseV1'
+START_RELEASE_SCHEMA = 'T5RootLifecycleStartReleaseV1'
+MAX_LEASE_BYTES = 32768
+MAX_PROCESS_DEPTH = 128
+TOKEN_RE = re.compile(r'[0-9a-f]{64}\Z')
+HASH_RE = TOKEN_RE
+
+
+class LifecycleError(RuntimeError):
+    pass
+
+
+def _strict_json(raw: bytes) -> dict[str, Any]:
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                raise LifecycleError('duplicate lifecycle lease key')
+            result[key] = value
+        return result
+    try:
+        value = json.loads(raw.decode('utf-8'), object_pairs_hook=unique)
+    except (UnicodeError, json.JSONDecodeError) as exc:
+        raise LifecycleError('lifecycle lease is malformed') from exc
+    if not isinstance(value, dict):
+        raise LifecycleError('lifecycle lease is not an object')
+    return value
+
+
+def _proc_stat(pid: int) -> tuple[int, int, str]:
+    if type(pid) is not int or pid <= 1:
+        raise LifecycleError('process identity is invalid')
+    raw = Path('/proc/%d/stat' % pid).read_text(encoding='ascii')
+    close = raw.rfind(')')
+    if close < 0:
+        raise LifecycleError('process stat record is malformed')
+    fields = raw[close + 1:].strip().split()
+    if len(fields) < 20:
+        raise LifecycleError('process stat record is truncated')
+    return int(fields[1]), int(fields[19]), fields[0]
+
+
+def _proc_uids(pid: int) -> tuple[int, int, int, int]:
+    raw = Path('/proc/%d/status' % pid).read_text(encoding='ascii')
+    for line in raw.splitlines():
+        if line.startswith('Uid:\t'):
+            values = tuple(int(value) for value in line.split()[1:5])
+            if len(values) == 4:
+                return values
+    raise LifecycleError('process UID identity is unavailable')
+
+
+def process_start_ticks(pid: int) -> int:
+    return _proc_stat(pid)[1]
+
+
+def _shared_lock_busy_probe(fd: int) -> bool:
+    """Observe a root LOCK_EX without taking an exclusive observer lock.
+
+    Local Linux permits flock on read-only descriptors.  This probe uses
+    LOCK_SH so multiple read-only observers do not exclude one another.
+    """
+    try:
+        fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
+    except BlockingIOError:
+        return True
+    else:
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        return False
+
+
+def _is_descendant(pid: int, ancestor_pid: int, ancestor_start_ticks: int) -> bool:
+    current = pid
+    seen: set[int] = set()
+    for _ in range(MAX_PROCESS_DEPTH):
+        if current <= 1 or current in seen:
+            return False
+        seen.add(current)
+        ppid, start_ticks, state = _proc_stat(current)
+        if state == 'Z':
+            return False
+        if current == ancestor_pid:
+            return (start_ticks == ancestor_start_ticks and
+                    _proc_uids(current)[1] == 0)
+        current = ppid
+    return False
+
+
+def _verify_directory(fd: int) -> os.stat_result:
+    row = os.fstat(fd)
+    if (not stat.S_ISDIR(row.st_mode) or row.st_uid != 0 or row.st_gid != 0
+            or stat.S_IMODE(row.st_mode) != 0o711):
+        raise LifecycleError('root lifecycle runtime directory metadata differs')
+    return row
+
+
+def _read_fd(fd: int) -> tuple[dict[str, Any], bytes, os.stat_result]:
+    before = os.fstat(fd)
+    if (not stat.S_ISREG(before.st_mode) or before.st_uid != 0 or
+            before.st_gid != 0 or stat.S_IMODE(before.st_mode) != 0o444 or
+            before.st_nlink != 1 or before.st_size <= 0 or
+            before.st_size > MAX_LEASE_BYTES):
+        raise LifecycleError('active lease metadata differs from immutable root record')
+    raw = os.pread(fd, MAX_LEASE_BYTES + 1, 0)
+    after = os.fstat(fd)
+    if (len(raw) != before.st_size or len(raw) > MAX_LEASE_BYTES or
+            (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns,
+             before.st_ctime_ns) !=
+            (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns,
+             after.st_ctime_ns)):
+        raise LifecycleError('active lease changed during read')
+    return _strict_json(raw), raw, before
+
+
+def _validate_lease(row: dict[str, Any]) -> None:
+    required = {
+        'Schema', 'Status', 'Domain', 'UUID', 'URI', 'RunTag', 'Token',
+        'SupervisorPID', 'SupervisorStartTicks', 'RequesterUID', 'LockPath',
+        'LockDevice', 'LockInode', 'SupervisorLockFD', 'PreparedReceiptSHA256',
+        'PrivateStateBindingReceiptSHA256', 'PreparationLeaseSHA256', 'StartedUnixNS',
+        'Disposition',
+    }
+    if set(row) != required:
+        raise LifecycleError('active lease schema has missing or unknown fields')
+    if (row['Schema'] != SCHEMA or row['Status'] != 'ACTIVE' or
+            row['Domain'] != DOMAIN or row['UUID'] != DOMAIN_UUID or
+            row['URI'] != URI or row['RequesterUID'] != 1000 or
+            row['LockPath'] != LOCK_PATH or
+            row['Disposition'] != 'ROOT_SUPERVISOR_PRIVATE_EXCLUSIVE_LOCK'):
+        raise LifecycleError('active lease differs from exact selected-T5 capability')
+    if (not isinstance(row['RunTag'], str) or
+            re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}', row['RunTag']) is None or
+            not isinstance(row['Token'], str) or TOKEN_RE.fullmatch(row['Token']) is None):
+        raise LifecycleError('active lease run identity is malformed')
+    for name in ('SupervisorPID', 'SupervisorStartTicks', 'LockDevice', 'LockInode',
+                 'SupervisorLockFD', 'StartedUnixNS'):
+        if type(row[name]) is not int or row[name] <= 0:
+            raise LifecycleError('active lease process/lock identity is malformed')
+    for name in ('PreparedReceiptSHA256', 'PrivateStateBindingReceiptSHA256'):
+        value = row[name]
+        if not isinstance(value, str) or re.fullmatch(r'[0-9a-f]{64}', value) is None:
+            raise LifecycleError('active lease receipt binding is malformed')
+    if not isinstance(row['PreparationLeaseSHA256'], str) or \
+            re.fullmatch(r'[0-9a-f]{64}', row['PreparationLeaseSHA256']) is None:
+        raise LifecycleError('preparation lease binding is malformed')
+
+
+def _validate_preparation_lease(row: dict[str, Any]) -> None:
+    required = {
+        'Schema', 'Status', 'Domain', 'UUID', 'URI', 'RunTag', 'Token',
+        'SupervisorPID', 'SupervisorStartTicks', 'RequesterUID', 'LockPath',
+        'LockDevice', 'LockInode', 'SupervisorLockFD', 'RequestSHA256',
+        'StartedUnixNS', 'Disposition',
+    }
+    if (not isinstance(row, dict) or set(row) != required
+            or row['Schema'] != PREPARATION_SCHEMA or row['Status'] != 'PREPARING'
+            or row['Domain'] != DOMAIN or row['UUID'] != DOMAIN_UUID
+            or row['URI'] != URI or row['RequesterUID'] != 1000
+            or row['LockPath'] != LOCK_PATH
+            or row['Disposition'] != 'ROOT_SUPERVISOR_PREPARATION_LOCK'):
+        raise LifecycleError('preparation lease differs from the exact selected-T5 capability')
+    if (not isinstance(row['RunTag'], str)
+            or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}', row['RunTag']) is None
+            or not isinstance(row['Token'], str) or TOKEN_RE.fullmatch(row['Token']) is None
+            or not isinstance(row['RequestSHA256'], str)
+            or re.fullmatch(r'[0-9a-f]{64}', row['RequestSHA256']) is None):
+        raise LifecycleError('preparation lease run/request identity is malformed')
+    for name in ('SupervisorPID', 'SupervisorStartTicks', 'LockDevice', 'LockInode',
+                 'SupervisorLockFD', 'StartedUnixNS'):
+        if type(row[name]) is not int or row[name] <= 0:
+            raise LifecycleError('preparation lease process/lock identity is malformed')
+
+
+def _validate_start_release(row: dict[str, Any]) -> None:
+    required = {
+        'Schema', 'Status', 'Domain', 'UUID', 'URI', 'RunTag', 'Token',
+        'SupervisorPID', 'SupervisorStartTicks', 'LockPath', 'LockDevice',
+        'LockInode', 'ActiveLeaseSHA256', 'PreparedReceiptSHA256',
+        'PrivateStateBindingReceiptSHA256', 'RunXMLSHA256',
+        'PrivateIdentitySHA256', 'RunDiskPath', 'PublishedUnixNS',
+        'Disposition',
+    }
+    if (not isinstance(row, dict) or set(row) != required
+            or row['Schema'] != START_RELEASE_SCHEMA
+            or row['Status'] != 'PRESTART_VERIFIED'
+            or row['Domain'] != DOMAIN or row['UUID'] != DOMAIN_UUID
+            or row['URI'] != URI or row['LockPath'] != LOCK_PATH
+            or row['Disposition'] != 'ROOT_SUPERVISOR_TYPED_PRESTART_AUTHORIZATION'):
+        raise LifecycleError('start release does not match its exact typed schema')
+    if (not isinstance(row['RunTag'], str)
+            or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}', row['RunTag']) is None
+            or not isinstance(row['Token'], str) or TOKEN_RE.fullmatch(row['Token']) is None):
+        raise LifecycleError('start release run identity is malformed')
+    for key in ('SupervisorPID', 'SupervisorStartTicks', 'LockDevice',
+                'LockInode', 'PublishedUnixNS'):
+        if type(row[key]) is not int or row[key] <= 0:
+            raise LifecycleError('start release process/lock identity is malformed')
+    for key in ('ActiveLeaseSHA256', 'PreparedReceiptSHA256',
+                'PrivateStateBindingReceiptSHA256', 'RunXMLSHA256',
+                'PrivateIdentitySHA256'):
+        if not isinstance(row[key], str) or re.fullmatch(r'[0-9a-f]{64}', row[key]) is None:
+            raise LifecycleError('start release receipt pin is malformed')
+    prefix = '/var/lib/libvirt/images/safeupload-t5/m2-t5-cp1011-r2/run/'
+    name = DOMAIN + '.safeupload-run-' + row['RunTag'] + '.qcow2'
+    if row['RunDiskPath'] != prefix + name:
+        raise LifecycleError('start release disk path is not the fixed selected-T5 run overlay')
+
+
+def _validate_release_binding(release: dict[str, Any], active: dict[str, Any],
+                              active_raw: bytes) -> None:
+    _validate_start_release(release)
+    if (release['ActiveLeaseSHA256'] != hashlib.sha256(active_raw).hexdigest()
+            or release['RunTag'] != active['RunTag']
+            or release['Token'] != active['Token']
+            or release['SupervisorPID'] != active['SupervisorPID']
+            or release['SupervisorStartTicks'] != active['SupervisorStartTicks']
+            or release['LockDevice'] != active['LockDevice']
+            or release['LockInode'] != active['LockInode']
+            or release['PreparedReceiptSHA256'] != active['PreparedReceiptSHA256']
+            or release['PrivateStateBindingReceiptSHA256'] !=
+               active['PrivateStateBindingReceiptSHA256']):
+        raise LifecycleError('start release does not bind the exact current active lease')
+
+
+def _create_immutable_record(runtime_fd: int, name: str,
+                             row: dict[str, Any]) -> tuple[int, str, os.stat_result]:
+    raw = json.dumps(row, sort_keys=True, separators=(',', ':')).encode('utf-8') + b'\n'
+    if len(raw) > MAX_LEASE_BYTES:
+        raise LifecycleError('lifecycle lease exceeds fixed size bound')
+    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC |
+                 os.O_NOFOLLOW, 0o444, dir_fd=runtime_fd)
+    try:
+        os.fchown(fd, 0, 0)
+        os.fchmod(fd, 0o444)
+        view = memoryview(raw)
+        while view:
+            count = os.write(fd, view)
+            if count <= 0:
+                raise LifecycleError('lifecycle lease write made no progress')
+            view = view[count:]
+        os.fsync(fd)
+        written = os.fstat(fd)
+        path_stat = os.stat(name, dir_fd=runtime_fd, follow_symlinks=False)
+        if (not stat.S_ISREG(written.st_mode) or written.st_uid != 0 or
+                written.st_gid != 0 or stat.S_IMODE(written.st_mode) != 0o444 or
+                written.st_nlink != 1 or written.st_size != len(raw) or
+                (written.st_dev, written.st_ino) != (path_stat.st_dev, path_stat.st_ino)):
+            raise LifecycleError('immutable lifecycle lease metadata changed during creation')
+        os.fsync(runtime_fd)
+        return fd, hashlib.sha256(raw).hexdigest(), written
+    except BaseException:
+        os.close(fd)
+        raise
+
+
+def _verify_lock_path(runtime_fd: int, row: dict[str, Any]) -> os.stat_result:
+    lock_fd = os.open(os.path.basename(LOCK_PATH), os.O_RDONLY | os.O_CLOEXEC |
+                      os.O_NOFOLLOW, dir_fd=runtime_fd)
+    try:
+        fd_stat = os.fstat(lock_fd)
+        by_path = os.stat(os.path.basename(LOCK_PATH), dir_fd=runtime_fd,
+                          follow_symlinks=False)
+        if (not stat.S_ISREG(fd_stat.st_mode) or fd_stat.st_uid != 0 or
+                fd_stat.st_gid != 0 or stat.S_IMODE(fd_stat.st_mode) != 0o444 or
+                fd_stat.st_nlink != 1 or
+                (fd_stat.st_dev, fd_stat.st_ino) !=
+                (row['LockDevice'], row['LockInode']) or
+                (by_path.st_dev, by_path.st_ino) !=
+                (fd_stat.st_dev, fd_stat.st_ino)):
+            raise LifecycleError('active lease does not bind the exact root lock inode')
+        # Contention is only a secondary liveness check. The root-created
+        # lease's PID/start-time and root supervisor protocol bind the holder;
+        # this unprivileged observation alone never grants authority.
+        try:
+            fcntl.flock(lock_fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
+        except BlockingIOError:
+            pass
+        else:
+            fcntl.flock(lock_fd, fcntl.LOCK_UN)
+            raise LifecycleError('root supervisor lock is not currently exclusive')
+        _verify_exclusive_lock_holder(row['SupervisorPID'], row['SupervisorLockFD'],
+                                      fd_stat.st_ino)
+        return fd_stat
+    finally:
+        os.close(lock_fd)
+
+
+def _verify_exclusive_lock_holder(pid: int, fd: int, inode: int) -> None:
+    """Bind lease to the root process that actually owns the exclusive flock."""
+    try:
+        if os.readlink('/proc/%d/fd/%d' % (pid, fd)) != LOCK_PATH:
+            raise LifecycleError('lease supervisor descriptor does not name the canonical lock')
+        info = Path('/proc/%d/fdinfo/%d' % (pid, fd)).read_text(encoding='ascii')
+    except OSError as exc:
+        raise LifecycleError('root supervisor lock descriptor is not observable') from exc
+    rows = []
+    for line in info.splitlines():
+        match = re.fullmatch(
+            r'lock:\s+\d+:\s+FLOCK\s+ADVISORY\s+WRITE\s+\d+\s+'
+            r'[0-9a-fA-F]+:[0-9a-fA-F]+:(\d+)\s+0\s+EOF', line)
+        if match:
+            rows.append(int(match.group(1)))
+    if rows != [inode]:
+        raise LifecycleError('lease supervisor does not hold the exact exclusive lock inode')
+
+
+def _check_no_legacy_locks(fs: Any = os) -> None:
+    for path in (LEGACY_STATE_LOCK_PATH, LEGACY_USER_LOCK_PATH):
+        try:
+            fs.lstat(path)
+        except FileNotFoundError:
+            continue
+        raise LifecycleError('legacy split lifecycle lock exists: ' + path)
+
+
+def validate_active_lease_fd(lease_fd: int, *, expected_tag: str | None = None,
+                             pid: int | None = None, euid: int | None = None) -> dict[str, Any]:
+    """Check the immutable lease and process ancestry without receiving lock FD."""
+    pid = os.getpid() if pid is None else pid
+    euid = os.geteuid() if euid is None else euid
+    runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                         os.O_CLOEXEC | os.O_NOFOLLOW)
+    try:
+        _verify_directory(runtime_fd)
+        row, active_raw, lease_stat = _read_fd(lease_fd)
+        _validate_lease(row)
+        preparation_fd = os.open(os.path.basename(PREPARATION_LEASE_PATH),
+                                 os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                                 dir_fd=runtime_fd)
+        try:
+            preparation, preparation_raw, preparation_stat = _read_fd(preparation_fd)
+            _validate_preparation_lease(preparation)
+        finally:
+            os.close(preparation_fd)
+        if fcntl.fcntl(lease_fd, fcntl.F_GETFL) & os.O_ACCMODE != os.O_RDONLY:
+            raise LifecycleError('runner lease descriptor is not read-only')
+        if (hashlib.sha256(preparation_raw).hexdigest() != row['PreparationLeaseSHA256']
+                or preparation['Token'] != row['Token']
+                or preparation['RunTag'] != row['RunTag']
+                or preparation['SupervisorPID'] != row['SupervisorPID']
+                or preparation['SupervisorStartTicks'] != row['SupervisorStartTicks']
+                or preparation['LockDevice'] != row['LockDevice']
+                or preparation['LockInode'] != row['LockInode']):
+            raise LifecycleError('active lease does not bind the exact immutable preparation lease')
+        if expected_tag is not None and row['RunTag'] != expected_tag:
+            raise LifecycleError('active lease run tag differs')
+        fd_link = os.readlink('/proc/%d/fd/%d' % (pid, lease_fd))
+        if fd_link != ACTIVE_LEASE_PATH:
+            raise LifecycleError('passed lease descriptor is not the active fixed lease path')
+        current = os.stat(os.path.basename(ACTIVE_LEASE_PATH), dir_fd=runtime_fd,
+                          follow_symlinks=False)
+        if (current.st_dev, current.st_ino) != (lease_stat.st_dev, lease_stat.st_ino):
+            raise LifecycleError('active lease path no longer names the passed lease inode')
+        names = set(os.listdir(runtime_fd))
+        required_names = {os.path.basename(LOCK_PATH),
+                          os.path.basename(ACTIVE_LEASE_PATH),
+                          os.path.basename(PREPARATION_LEASE_PATH)}
+        if names not in (required_names,
+                         required_names | {os.path.basename(START_RELEASE_PATH)}):
+            raise LifecycleError('lifecycle runtime directory has unexpected entries')
+        if os.path.basename(START_RELEASE_PATH) in names:
+            release_fd = os.open(os.path.basename(START_RELEASE_PATH),
+                                 os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                                 dir_fd=runtime_fd)
+            try:
+                release, _release_raw, _release_stat = _read_fd(release_fd)
+                _validate_release_binding(release, row, active_raw)
+            finally:
+                os.close(release_fd)
+        _verify_lock_path(runtime_fd, row)
+        _supervisor_ppid, supervisor_start, supervisor_state = _proc_stat(row['SupervisorPID'])
+        if (supervisor_state == 'Z' or supervisor_start != row['SupervisorStartTicks'] or
+                _proc_uids(row['SupervisorPID']) != (0, 0, 0, 0)):
+            raise LifecycleError('active lease supervisor is absent or no longer root')
+        if euid != row['RequesterUID']:
+            raise LifecycleError('runner effective UID differs from the fixed requester')
+        ppid, _, state = _proc_stat(pid)
+        if state == 'Z' or not _is_descendant(ppid, row['SupervisorPID'],
+                                              row['SupervisorStartTicks']):
+            raise LifecycleError('runner is not a live descendant of the root supervisor')
+        return row
+    finally:
+        os.close(runtime_fd)
+
+
+def polkit_decision(subject_pid: int, subject_uid: int,
+                   action: str = '', domain_uuid: str | None = None,
+                   pool_name: str | None = None,
+                   volume_name: str | None = None) -> str:
+    """Return an explicit policy decision for a selected-T5 lifecycle window.
+
+    The root lock is only a serialization primitive. It grants no authority.
+    During a preparing/active window every non-root libvirt API operation is
+    denied except an active descendant of this exact root supervisor. A lock
+    that is busy before its immutable preparation record has been published is
+    denied as well, closing the acquisition/publication interval.
+    """
+    if (type(subject_pid) is not int or subject_pid <= 1 or type(subject_uid) is not int
+            or not isinstance(action, str) or len(action) > 256
+            or (domain_uuid is not None and not isinstance(domain_uuid, str))
+            or (pool_name is not None and not isinstance(pool_name, str))
+            or (volume_name is not None and not isinstance(volume_name, str))):
+        raise LifecycleError('polkit subject identity is malformed')
+
+    # The selected domain is exclusively supervisor-owned even between runs.
+    # During a run the general active-lease path below also denies mutations
+    # against every other guest and storage object.  Object details are passed
+    # by libvirt's documented polkit interface; a missing domain UUID on a
+    # domain mutation is denied rather than treated as an unrelated guest.
+    if action.startswith('org.libvirt.api.domain.'):
+        if not domain_uuid or domain_uuid == 'undefined':
+            if not _is_read_only_libvirt_action(action):
+                return 'DENY'
+        elif domain_uuid.lower() == DOMAIN_UUID:
+            if not _is_read_only_libvirt_action(action):
+                return 'DENY'
+
+    if action.startswith(('org.libvirt.api.storage-pool.',
+                          'org.libvirt.api.storage-vol.')):
+        if not _is_read_only_libvirt_action(action):
+            if not pool_name or pool_name == 'undefined':
+                return 'DENY'
+            if (pool_name == RUN_DISK_POOL_NAME
+                    or re.fullmatch(
+                        r't5-copy-[A-Za-z0-9][A-Za-z0-9_.-]{2,29}-'
+                        r'(?:run-nvram|run-tpm|recovery-nvram|recovery-tpm)',
+                        pool_name) is not None
+                    or volume_name in {
+                        'win10-debug3.base-20261009.qcow2',
+                        'win10-debug2.flat-20261009.qcow2',
+                    }):
+                return 'DENY'
+        if (action.startswith('org.libvirt.api.storage-vol.')
+                and not _is_read_only_libvirt_action(action)
+                and (not volume_name or volume_name == 'undefined')):
+            return 'DENY'
+    try:
+        runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                             os.O_CLOEXEC | os.O_NOFOLLOW)
+    except FileNotFoundError:
+        return 'NO_LEASE'
+    try:
+        _verify_directory(runtime_fd)
+        names = set(os.listdir(runtime_fd))
+        expected = {os.path.basename(LOCK_PATH)}
+        if names not in (expected,
+                         expected | {os.path.basename(PREPARATION_LEASE_PATH)},
+                         expected | {os.path.basename(PREPARATION_LEASE_PATH),
+                                     os.path.basename(ACTIVE_LEASE_PATH)},
+                         expected | {os.path.basename(PREPARATION_LEASE_PATH),
+                                     os.path.basename(ACTIVE_LEASE_PATH),
+                                     os.path.basename(START_RELEASE_PATH)}):
+            return 'DENY'
+        lock_fd = os.open(os.path.basename(LOCK_PATH), os.O_RDONLY | os.O_CLOEXEC |
+                          os.O_NOFOLLOW, dir_fd=runtime_fd)
+        try:
+            lock_stat = os.fstat(lock_fd)
+            if (not stat.S_ISREG(lock_stat.st_mode) or lock_stat.st_uid != 0 or
+                    lock_stat.st_gid != 0 or stat.S_IMODE(lock_stat.st_mode) != 0o444 or
+                    lock_stat.st_nlink != 1):
+                return 'DENY'
+            # Use a shared observer probe so read-only observers do not
+            # exclude one another. It conflicts with the supervisor's
+            # exclusive lease.
+            lock_busy = _shared_lock_busy_probe(lock_fd)
+            if (os.stat(os.path.basename(LOCK_PATH), dir_fd=runtime_fd,
+                        follow_symlinks=False).st_dev,
+                    os.stat(os.path.basename(LOCK_PATH), dir_fd=runtime_fd,
+                            follow_symlinks=False).st_ino) != (
+                    lock_stat.st_dev, lock_stat.st_ino):
+                return 'DENY'
+            if names == expected:
+                # A busy lock with no record is a crash/acquisition window,
+                # not an unauthenticated permission to race the supervisor.
+                return 'DENY' if lock_busy else 'NO_LEASE'
+            prep_fd = os.open(os.path.basename(PREPARATION_LEASE_PATH),
+                              os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                              dir_fd=runtime_fd)
+            try:
+                prep_row, prep_raw, prep_stat = _read_fd(prep_fd)
+                _validate_preparation_lease(prep_row)
+            finally:
+                os.close(prep_fd)
+            _verify_lock_path(runtime_fd, prep_row)
+            if not lock_busy:
+                return 'DENY'
+            if names == expected | {os.path.basename(PREPARATION_LEASE_PATH)}:
+                # Preparation is root-only. No user libvirt operation can
+                # observe or mutate selected state until ACTIVE is published.
+                return 'DENY'
+            active_fd = os.open(os.path.basename(ACTIVE_LEASE_PATH),
+                                os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                                dir_fd=runtime_fd)
+            try:
+                active, active_raw, active_stat = _read_fd(active_fd)
+                _validate_lease(active)
+                by_path = os.stat(os.path.basename(ACTIVE_LEASE_PATH),
+                                  dir_fd=runtime_fd, follow_symlinks=False)
+                if ((active_stat.st_dev, active_stat.st_ino) !=
+                        (by_path.st_dev, by_path.st_ino)
+                        or hashlib.sha256(prep_raw).hexdigest() !=
+                           active['PreparationLeaseSHA256']
+                        or active['Token'] != prep_row['Token']
+                        or active['RunTag'] != prep_row['RunTag']
+                        or active['SupervisorPID'] != prep_row['SupervisorPID']
+                        or active['SupervisorStartTicks'] != prep_row['SupervisorStartTicks']
+                        or active['LockDevice'] != prep_row['LockDevice']
+                        or active['LockInode'] != prep_row['LockInode']):
+                    return 'DENY'
+                if (prep_stat.st_dev, prep_stat.st_ino) == (
+                        active_stat.st_dev, active_stat.st_ino):
+                    return 'DENY'
+                has_release = os.path.basename(START_RELEASE_PATH) in names
+                if has_release:
+                    release_fd = os.open(os.path.basename(START_RELEASE_PATH),
+                                         os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                                         dir_fd=runtime_fd)
+                    try:
+                        release, _release_raw, release_stat = _read_fd(release_fd)
+                        release_path = os.stat(os.path.basename(START_RELEASE_PATH),
+                                               dir_fd=runtime_fd,
+                                               follow_symlinks=False)
+                        if ((release_stat.st_dev, release_stat.st_ino) !=
+                                (release_path.st_dev, release_path.st_ino)):
+                            return 'DENY'
+                        _validate_release_binding(release, active, active_raw)
+                    finally:
+                        os.close(release_fd)
+                supervisor_pid = active['SupervisorPID']
+                _parent, supervisor_start, state = _proc_stat(supervisor_pid)
+                if (state == 'Z' or supervisor_start != active['SupervisorStartTicks']
+                        or _proc_uids(supervisor_pid) != (0, 0, 0, 0)):
+                    return 'DENY'
+                if (subject_uid == 1000
+                        and _proc_uids(subject_pid)[0] == subject_uid
+                        and _is_descendant(subject_pid, supervisor_pid, supervisor_start)):
+                    # A runner may inspect state during the lease. It never
+                    # receives a libvirt write permission: XML changes,
+                    # storage mutations, start and stop are performed by the
+                    # root supervisor after independent checks. Keeping this
+                    # decision object-aware at the polkit layer is important;
+                    # a start-release receipt alone must not authorize a
+                    # second, caller-issued mutation.
+                    if _is_read_only_libvirt_action(action):
+                        return 'ALLOW_SUPERVISED_READ_ONLY'
+                return 'DENY'
+            finally:
+                os.close(active_fd)
+        finally:
+            os.close(lock_fd)
+    except (OSError, LifecycleError):
+        return 'DENY'
+    finally:
+        os.close(runtime_fd)
+
+
+def _is_read_only_libvirt_action(action: str) -> bool:
+    """Allow only metadata/read operations to the supervised UID 1000 child.
+
+    Libvirt's unix.manage action is intentionally not on this list. The
+    selected guest and its backing storage are operated by the root
+    supervisor; a supervised child can query state but cannot mutate any
+    domain, pool, volume, or device while the lease is present.
+    """
+    if not isinstance(action, str) or not action.startswith('org.libvirt.api.'):
+        return False
+    permission = action.rsplit('.', 1)[-1]
+    return permission in {
+        'getattr', 'read', 'search-storage-pools', 'search-storage-vols',
+        'search-all-storage-pools', 'search-all-storage-vols',
+        'get-storage-pool', 'get-storage-volume', 'list-all',
+        'list-all-domains', 'get-connect', 'get-xml', 'get-info',
+    }
+
+
+def validate_active_lease_path() -> dict[str, Any]:
+    """Root-hook check for the active selected-T5 start window."""
+    runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                         os.O_CLOEXEC | os.O_NOFOLLOW)
+    active_fd = prep_fd = -1
+    try:
+        _verify_directory(runtime_fd)
+        if set(os.listdir(runtime_fd)) != {
+                os.path.basename(LOCK_PATH), os.path.basename(PREPARATION_LEASE_PATH),
+                os.path.basename(ACTIVE_LEASE_PATH), os.path.basename(START_RELEASE_PATH)}:
+            raise LifecycleError('root start hook requires the exact prestart-authorized lifecycle record set')
+        active_fd = os.open(os.path.basename(ACTIVE_LEASE_PATH),
+                            os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                            dir_fd=runtime_fd)
+        active, active_raw, active_stat = _read_fd(active_fd)
+        _validate_lease(active)
+        active_path = os.stat(os.path.basename(ACTIVE_LEASE_PATH), dir_fd=runtime_fd,
+                              follow_symlinks=False)
+        if (active_stat.st_dev, active_stat.st_ino) != (
+                active_path.st_dev, active_path.st_ino):
+            raise LifecycleError('active lease path changed during root-hook verification')
+        prep_fd = os.open(os.path.basename(PREPARATION_LEASE_PATH),
+                          os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                          dir_fd=runtime_fd)
+        preparation, prep_raw, _prep_stat = _read_fd(prep_fd)
+        _validate_preparation_lease(preparation)
+        if (hashlib.sha256(prep_raw).hexdigest() != active['PreparationLeaseSHA256']
+                or preparation['Token'] != active['Token']
+                or preparation['RunTag'] != active['RunTag']
+                or preparation['SupervisorPID'] != active['SupervisorPID']
+                or preparation['SupervisorStartTicks'] != active['SupervisorStartTicks']
+                or preparation['LockDevice'] != active['LockDevice']
+                or preparation['LockInode'] != active['LockInode']):
+            raise LifecycleError('active lease does not bind the exact preparation identity')
+        release_fd = os.open(os.path.basename(START_RELEASE_PATH),
+                             os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                             dir_fd=runtime_fd)
+        try:
+            release, _release_raw, release_stat = _read_fd(release_fd)
+            release_path = os.stat(os.path.basename(START_RELEASE_PATH),
+                                   dir_fd=runtime_fd, follow_symlinks=False)
+            if (release_stat.st_dev, release_stat.st_ino) != (
+                    release_path.st_dev, release_path.st_ino):
+                raise LifecycleError('root start authorization path changed')
+            _validate_release_binding(release, active, active_raw)
+        finally:
+            os.close(release_fd)
+        _verify_lock_path(runtime_fd, active)
+        _parent, start, state = _proc_stat(active['SupervisorPID'])
+        if (state == 'Z' or start != active['SupervisorStartTicks']
+                or _proc_uids(active['SupervisorPID']) != (0, 0, 0, 0)):
+            raise LifecycleError('root start-hook supervisor identity is stale')
+        return {'Status': 'ACTIVE_RUN_WINDOW', 'Domain': DOMAIN, 'UUID': DOMAIN_UUID,
+                'RunTag': active['RunTag'], 'Token': active['Token'],
+                'SupervisorPID': active['SupervisorPID'],
+                'LockPath': LOCK_PATH, 'LockDevice': active['LockDevice'],
+                'LockInode': active['LockInode'],
+                'PreparedReceiptSHA256': active['PreparedReceiptSHA256'],
+                'PrivateStateBindingReceiptSHA256': active['PrivateStateBindingReceiptSHA256'],
+                'PreparationLeaseSHA256': active['PreparationLeaseSHA256'],
+                'ActiveLeaseSHA256': hashlib.sha256(active_raw).hexdigest()}
+    finally:
+        if prep_fd >= 0:
+            os.close(prep_fd)
+        if active_fd >= 0:
+            os.close(active_fd)
+        os.close(runtime_fd)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(add_help=False)
+    sub = parser.add_subparsers(dest='command', required=True)
+    check = sub.add_parser('validate-child', add_help=False)
+    check.add_argument('--lease-fd', type=int, required=True)
+    check.add_argument('--tag', required=True)
+    polkit = sub.add_parser('polkit-decision', add_help=False)
+    polkit.add_argument('--pid', type=int, required=True)
+    polkit.add_argument('--uid', type=int, required=True)
+    polkit.add_argument('--action', required=True)
+    polkit.add_argument('--domain-uuid', required=True)
+    polkit.add_argument('--pool-name', required=True)
+    polkit.add_argument('--volume-name', required=True)
+    start = sub.add_parser('verify-start', add_help=False)
+    start.add_argument('--domain', required=True)
+    ns = parser.parse_args(argv)
+    try:
+        if ns.command == 'polkit-decision':
+            decision = polkit_decision(
+                ns.pid, ns.uid, ns.action,
+                None if ns.domain_uuid == 'undefined' else ns.domain_uuid,
+                None if ns.pool_name == 'undefined' else ns.pool_name,
+                None if ns.volume_name == 'undefined' else ns.volume_name)
+            print(decision)
+            return 0 if decision in ('NO_LEASE', 'ALLOW_SUPERVISED_READ_ONLY') else 1
+        if ns.command == 'verify-start':
+            if ns.domain != DOMAIN or os.getuid() != 0 or os.geteuid() != 0:
+                raise LifecycleError('start-hook verification requires root and the exact selected domain')
+            row = validate_active_lease_path()
+            print(json.dumps(row, sort_keys=True, separators=(',', ':')))
+            return 0
+        if ns.command == 'validate-child' and ns.lease_fd >= 0:
+            row = validate_active_lease_fd(ns.lease_fd, expected_tag=ns.tag)
+            print(json.dumps({'Status': 'ACTIVE_CHILD_LEASE_VALID', 'Domain': DOMAIN,
+                              'UUID': DOMAIN_UUID, 'RunTag': row['RunTag'],
+                              'SupervisorPID': row['SupervisorPID'],
+                              'LockPath': row['LockPath'], 'LockDevice': row['LockDevice'],
+                              'LockInode': row['LockInode']},
+                             sort_keys=True, separators=(',', ':')))
+            return 0
+        raise LifecycleError('only fixed read-only lifecycle checks are supported')
+    except BaseException as exc:
+        print('T5 lifecycle lease denied: ' + str(exc), file=sys.stderr)
+        return 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
+
+
+def validate_root_lock(lock_fd: int, *, pid: int | None = None) -> dict[str, Any]:
+    """Prove the supervisor itself holds the exact exclusive root lock."""
+    pid = os.getpid() if pid is None else pid
+    row = os.fstat(lock_fd)
+    if (not stat.S_ISREG(row.st_mode) or row.st_uid != 0 or row.st_gid != 0 or
+            stat.S_IMODE(row.st_mode) != 0o444 or row.st_nlink != 1):
+        raise LifecycleError('root lifecycle lock descriptor metadata differs')
+    runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                         os.O_CLOEXEC | os.O_NOFOLLOW)
+    try:
+        _verify_directory(runtime_fd)
+        by_path = os.stat(os.path.basename(LOCK_PATH), dir_fd=runtime_fd,
+                          follow_symlinks=False)
+        if (row.st_dev, row.st_ino) != (by_path.st_dev, by_path.st_ino):
+            raise LifecycleError('root lifecycle lock path was replaced')
+        fd_link = os.readlink('/proc/%d/fd/%d' % (pid, lock_fd))
+        if fd_link != LOCK_PATH:
+            raise LifecycleError('root lock descriptor does not name the canonical path')
+        info = Path('/proc/%d/fdinfo/%d' % (pid, lock_fd)).read_text(encoding='ascii')
+        pattern = re.compile(
+            r'lock:\s+\d+:\s+FLOCK\s+ADVISORY\s+WRITE\s+\d+\s+'
+            r'[0-9a-fA-F]+:[0-9a-fA-F]+:(\d+)\s+0\s+EOF')
+        inodes = [int(match.group(1)) for line in info.splitlines()
+                  if (match := pattern.fullmatch(line))]
+        if inodes != [row.st_ino]:
+            raise LifecycleError('supervisor does not hold the exact exclusive flock')
+        return {'Path': LOCK_PATH, 'Device': row.st_dev, 'Inode': row.st_ino,
+                'FD': lock_fd, 'PID': pid}
+    finally:
+        os.close(runtime_fd)
+
+
+def _ensure_runtime_directory() -> int:
+    parent = os.open('/run', os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                     os.O_NOFOLLOW)
+    try:
+        parent_stat = os.fstat(parent)
+        if (parent_stat.st_uid != 0 or parent_stat.st_gid != 0 or
+                stat.S_IMODE(parent_stat.st_mode) & 0o022):
+            raise LifecycleError('/run is not a root-owned protected directory')
+        name = os.path.basename(RUNTIME_DIRECTORY)
+        try:
+            os.mkdir(name, 0o711, dir_fd=parent)
+            os.fsync(parent)
+        except FileExistsError:
+            pass
+        runtime_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC |
+                             os.O_NOFOLLOW, dir_fd=parent)
+        _verify_directory(runtime_fd)
+        return runtime_fd
+    finally:
+        os.close(parent)
+
+
+@dataclass
+class HeldLifecycleLease:
+    lock_fd: int
+    lock_identity: dict[str, Any]
+    preparation_fd: int
+    preparation_sha256: str
+    preparation_row: dict[str, Any]
+    preparation_device: int
+    preparation_inode: int
+    lease_fd: int | None = None
+    lease_sha256: str | None = None
+    lease_row: dict[str, Any] | None = None
+    lease_device: int | None = None
+    lease_inode: int | None = None
+    start_release_fd: int | None = None
+    start_release_sha256: str | None = None
+    start_release_row: dict[str, Any] | None = None
+    start_release_device: int | None = None
+    start_release_inode: int | None = None
+    closed: bool = False
+
+    @property
+    def active(self) -> bool:
+        return self.lease_fd is not None and self.lease_row is not None
+
+    @property
+    def start_released(self) -> bool:
+        return self.start_release_fd is not None and self.start_release_row is not None
+
+    def capability_fields(self) -> dict[str, Any]:
+        """Expose the root-only lock descriptor to the in-process copy gate."""
+        self.verify_held()
+        return dict(self.lock_identity)
+
+    def verify_held(self) -> None:
+        if self.closed:
+            raise LifecycleError('root lifecycle lease has already closed')
+        current = validate_root_lock(self.lock_fd)
+        if (current['Device'], current['Inode']) != (
+                self.lock_identity['Device'], self.lock_identity['Inode']):
+            raise LifecycleError('held lifecycle lock identity changed')
+        prep_row, prep_raw, prep_stat = _read_fd(self.preparation_fd)
+        _validate_preparation_lease(prep_row)
+        if (prep_row != self.preparation_row or
+                hashlib.sha256(prep_raw).hexdigest() != self.preparation_sha256 or
+                (prep_stat.st_dev, prep_stat.st_ino) !=
+                (self.preparation_device, self.preparation_inode)):
+            raise LifecycleError('root preparation lease changed during the run')
+        runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                             os.O_CLOEXEC | os.O_NOFOLLOW)
+        try:
+            _verify_directory(runtime_fd)
+            expected = {os.path.basename(LOCK_PATH),
+                        os.path.basename(PREPARATION_LEASE_PATH)}
+            if self.active:
+                expected.add(os.path.basename(ACTIVE_LEASE_PATH))
+            if self.start_released:
+                expected.add(os.path.basename(START_RELEASE_PATH))
+            if set(os.listdir(runtime_fd)) != expected:
+                raise LifecycleError('unexpected lifecycle runtime entry during held lease')
+            prep_path = os.stat(os.path.basename(PREPARATION_LEASE_PATH),
+                                dir_fd=runtime_fd, follow_symlinks=False)
+            if (prep_path.st_dev, prep_path.st_ino) != (
+                    self.preparation_device, self.preparation_inode):
+                raise LifecycleError('preparation lease path was replaced')
+            if self.active:
+                assert self.lease_fd is not None and self.lease_row is not None
+                row, raw, lease_stat = _read_fd(self.lease_fd)
+                _validate_lease(row)
+                lease_path = os.stat(os.path.basename(ACTIVE_LEASE_PATH),
+                                     dir_fd=runtime_fd, follow_symlinks=False)
+                if (hashlib.sha256(raw).hexdigest() != self.lease_sha256 or
+                        row != self.lease_row or
+                        (lease_stat.st_dev, lease_stat.st_ino) !=
+                        (self.lease_device, self.lease_inode) or
+                        (lease_path.st_dev, lease_path.st_ino) !=
+                        (self.lease_device, self.lease_inode)):
+                    raise LifecycleError('root active lease changed during the run')
+            if self.start_released:
+                assert self.start_release_fd is not None and self.start_release_row is not None
+                release, raw, release_stat = _read_fd(self.start_release_fd)
+                _validate_start_release(release)
+                assert self.lease_fd is not None
+                active_now, active_raw, _active_stat = _read_fd(self.lease_fd)
+                _validate_lease(active_now)
+                _validate_release_binding(release, active_now, active_raw)
+                release_path = os.stat(os.path.basename(START_RELEASE_PATH),
+                                       dir_fd=runtime_fd, follow_symlinks=False)
+                if (release != self.start_release_row
+                        or hashlib.sha256(raw).hexdigest() != self.start_release_sha256
+                        or (release_stat.st_dev, release_stat.st_ino) !=
+                           (self.start_release_device, self.start_release_inode)
+                        or (release_path.st_dev, release_path.st_ino) !=
+                           (self.start_release_device, self.start_release_inode)):
+                    raise LifecycleError('root prestart authorization changed during the run')
+        finally:
+            os.close(runtime_fd)
+
+    def publish_active_lease(self, *, prepared_receipt_sha256: str,
+                             private_binding_receipt_sha256: str,
+                             clock: Any = time.time_ns) -> None:
+        if self.closed or self.active:
+            raise LifecycleError('active lifecycle lease is already published or closed')
+        self.verify_held()
+        for value in (prepared_receipt_sha256, private_binding_receipt_sha256):
+            if re.fullmatch(r'[0-9a-f]{64}', value) is None:
+                raise LifecycleError('prepared and private-binding receipts are not exact hashes')
+        runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                             os.O_CLOEXEC | os.O_NOFOLLOW)
+        fd = -1
+        try:
+            _verify_directory(runtime_fd)
+            if set(os.listdir(runtime_fd)) != {
+                    os.path.basename(LOCK_PATH),
+                    os.path.basename(PREPARATION_LEASE_PATH)}:
+                raise LifecycleError('runtime lease set differs before active publication')
+            lock_stat = os.fstat(self.lock_fd)
+            prep_path = os.stat(os.path.basename(PREPARATION_LEASE_PATH),
+                                dir_fd=runtime_fd, follow_symlinks=False)
+            if ((lock_stat.st_dev, lock_stat.st_ino) !=
+                    (self.lock_identity['Device'], self.lock_identity['Inode']) or
+                    (prep_path.st_dev, prep_path.st_ino) !=
+                    (self.preparation_device, self.preparation_inode)):
+                raise LifecycleError('lock or preparation lease identity changed before active publication')
+            row = {
+                'Schema': SCHEMA, 'Status': 'ACTIVE', 'Domain': DOMAIN,
+                'UUID': DOMAIN_UUID, 'URI': URI,
+                'RunTag': self.preparation_row['RunTag'],
+                'Token': self.preparation_row['Token'],
+                'SupervisorPID': self.preparation_row['SupervisorPID'],
+                'SupervisorStartTicks': self.preparation_row['SupervisorStartTicks'],
+                'RequesterUID': self.preparation_row['RequesterUID'],
+                'LockPath': LOCK_PATH, 'LockDevice': lock_stat.st_dev,
+                'LockInode': lock_stat.st_ino,
+                'SupervisorLockFD': self.lock_identity['FD'],
+                'PreparedReceiptSHA256': prepared_receipt_sha256,
+                'PrivateStateBindingReceiptSHA256': private_binding_receipt_sha256,
+                'PreparationLeaseSHA256': self.preparation_sha256,
+                'StartedUnixNS': clock(),
+                'Disposition': 'ROOT_SUPERVISOR_PRIVATE_EXCLUSIVE_LOCK',
+            }
+            _validate_lease(row)
+            fd, digest, record_stat = _create_immutable_record(
+                runtime_fd, os.path.basename(ACTIVE_LEASE_PATH), row)
+            self.lease_fd = os.open(os.path.basename(ACTIVE_LEASE_PATH),
+                                    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                                    dir_fd=runtime_fd)
+            os.close(fd)
+            fd = -1
+            self.lease_sha256 = digest
+            self.lease_row = row
+            self.lease_device = record_stat.st_dev
+            self.lease_inode = record_stat.st_ino
+            self.verify_held()
+        except BaseException:
+            if fd >= 0:
+                os.close(fd)
+            raise
+        finally:
+            os.close(runtime_fd)
+
+    def child_lease_fd(self) -> int:
+        self.verify_held()
+        if not self.active or self.lease_fd is None:
+            raise LifecycleError('active child lease has not been published')
+        return self.lease_fd
+
+    def publish_start_release(self, *, run_xml_sha256: str,
+                              private_identity_sha256: str,
+                              run_disk_path: str,
+                              clock: Any = time.time_ns) -> str:
+        if self.closed or not self.active or self.start_released:
+            raise LifecycleError('start authorization requires one active unreleased lease')
+        self.verify_held()
+        for value in (run_xml_sha256, private_identity_sha256):
+            if not isinstance(value, str) or HASH_RE.fullmatch(value) is None:
+                raise LifecycleError('prestart evidence hash is malformed')
+        assert self.lease_fd is not None and self.lease_row is not None
+        active, active_raw, active_stat = _read_fd(self.lease_fd)
+        if active != self.lease_row:
+            raise LifecycleError('active lease changed before start authorization')
+        row = {
+            'Schema': START_RELEASE_SCHEMA, 'Status': 'PRESTART_VERIFIED',
+            'Domain': DOMAIN, 'UUID': DOMAIN_UUID, 'URI': URI,
+            'RunTag': active['RunTag'], 'Token': active['Token'],
+            'SupervisorPID': active['SupervisorPID'],
+            'SupervisorStartTicks': active['SupervisorStartTicks'],
+            'LockPath': LOCK_PATH, 'LockDevice': active['LockDevice'],
+            'LockInode': active['LockInode'],
+            'ActiveLeaseSHA256': hashlib.sha256(active_raw).hexdigest(),
+            'PreparedReceiptSHA256': active['PreparedReceiptSHA256'],
+            'PrivateStateBindingReceiptSHA256':
+                active['PrivateStateBindingReceiptSHA256'],
+            'RunXMLSHA256': run_xml_sha256,
+            'PrivateIdentitySHA256': private_identity_sha256,
+            'RunDiskPath': run_disk_path, 'PublishedUnixNS': clock(),
+            'Disposition': 'ROOT_SUPERVISOR_TYPED_PRESTART_AUTHORIZATION',
+        }
+        _validate_start_release(row)
+        _validate_release_binding(row, active, active_raw)
+        runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                             os.O_CLOEXEC | os.O_NOFOLLOW)
+        write_fd = -1
+        try:
+            _verify_directory(runtime_fd)
+            expected = {os.path.basename(LOCK_PATH),
+                        os.path.basename(PREPARATION_LEASE_PATH),
+                        os.path.basename(ACTIVE_LEASE_PATH)}
+            if set(os.listdir(runtime_fd)) != expected:
+                raise LifecycleError('runtime layout differs before start authorization')
+            lock_stat = os.fstat(self.lock_fd)
+            active_path = os.stat(os.path.basename(ACTIVE_LEASE_PATH),
+                                  dir_fd=runtime_fd, follow_symlinks=False)
+            if ((lock_stat.st_dev, lock_stat.st_ino) !=
+                    (self.lock_identity['Device'], self.lock_identity['Inode'])
+                    or (active_path.st_dev, active_path.st_ino) !=
+                       (active_stat.st_dev, active_stat.st_ino)):
+                raise LifecycleError('lifecycle inode changed before start authorization')
+            write_fd, digest, release_stat = _create_immutable_record(
+                runtime_fd, os.path.basename(START_RELEASE_PATH), row)
+            os.close(write_fd)
+            write_fd = -1
+            self.start_release_fd = os.open(os.path.basename(START_RELEASE_PATH),
+                                            os.O_RDONLY | os.O_CLOEXEC |
+                                            os.O_NOFOLLOW, dir_fd=runtime_fd)
+            opened = os.fstat(self.start_release_fd)
+            if (opened.st_dev, opened.st_ino) != (release_stat.st_dev, release_stat.st_ino):
+                raise LifecycleError('start authorization path changed after publication')
+            self.start_release_sha256 = digest
+            self.start_release_row = row
+            self.start_release_device = release_stat.st_dev
+            self.start_release_inode = release_stat.st_ino
+            self.verify_held()
+            return digest
+        except BaseException:
+            if write_fd >= 0:
+                os.close(write_fd)
+            raise
+        finally:
+            os.close(runtime_fd)
+
+    def close_success(self) -> None:
+        """Remove the lease only after caller has completed all restoration checks."""
+        self.verify_held()
+        runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                             os.O_CLOEXEC | os.O_NOFOLLOW)
+        try:
+            _verify_directory(runtime_fd)
+            expected = {os.path.basename(LOCK_PATH),
+                        os.path.basename(PREPARATION_LEASE_PATH)}
+            if self.active:
+                expected.add(os.path.basename(ACTIVE_LEASE_PATH))
+            if self.start_released:
+                expected.add(os.path.basename(START_RELEASE_PATH))
+            if set(os.listdir(runtime_fd)) != expected:
+                raise LifecycleError('unexpected lifecycle runtime entry before lease close')
+            if self.active:
+                assert self.lease_fd is not None
+                current = os.stat(os.path.basename(ACTIVE_LEASE_PATH), dir_fd=runtime_fd,
+                                  follow_symlinks=False)
+                lease_stat = os.fstat(self.lease_fd)
+                if (current.st_dev, current.st_ino) != (lease_stat.st_dev, lease_stat.st_ino):
+                    raise LifecycleError('active lease path changed before successful close')
+                os.unlink(os.path.basename(ACTIVE_LEASE_PATH), dir_fd=runtime_fd)
+            if self.start_released:
+                assert self.start_release_fd is not None
+                current_release = os.stat(os.path.basename(START_RELEASE_PATH),
+                                          dir_fd=runtime_fd, follow_symlinks=False)
+                release_stat = os.fstat(self.start_release_fd)
+                if (current_release.st_dev, current_release.st_ino) != (
+                        release_stat.st_dev, release_stat.st_ino):
+                    raise LifecycleError('start authorization path changed before successful close')
+                os.unlink(os.path.basename(START_RELEASE_PATH), dir_fd=runtime_fd)
+            prep_current = os.stat(os.path.basename(PREPARATION_LEASE_PATH),
+                                   dir_fd=runtime_fd, follow_symlinks=False)
+            if (prep_current.st_dev, prep_current.st_ino) != (
+                    self.preparation_device, self.preparation_inode):
+                raise LifecycleError('preparation lease path changed before successful close')
+            os.unlink(os.path.basename(PREPARATION_LEASE_PATH), dir_fd=runtime_fd)
+            os.fsync(runtime_fd)
+        finally:
+            os.close(runtime_fd)
+        if self.lease_fd is not None:
+            os.close(self.lease_fd)
+        if self.start_release_fd is not None:
+            os.close(self.start_release_fd)
+        os.close(self.preparation_fd)
+        os.close(self.lock_fd)
+        self.closed = True
+
+    def retain_failure(self) -> None:
+        """Keep both active path and lock inode after any incomplete run."""
+        if not self.closed:
+            # The process is terminating after a failure. Closing FDs releases
+            # the flock, but the immutable ACTIVE lease remains as a durable
+            # denial marker until explicit root recovery.
+            if self.lease_fd is not None:
+                os.close(self.lease_fd)
+            if self.start_release_fd is not None:
+                os.close(self.start_release_fd)
+            os.close(self.preparation_fd)
+            os.close(self.lock_fd)
+            self.closed = True
+
+
+@dataclass
+class HeldLifecycleLock:
+    lock_fd: int
+    lock_identity: dict[str, Any]
+    closed: bool = False
+
+    def capability_fields(self) -> dict[str, Any]:
+        if self.closed:
+            raise LifecycleError('root lifecycle lock has already closed')
+        self.verify_held()
+        return {'Path': LOCK_PATH, 'PID': os.getpid(), 'FD': self.lock_fd,
+                'Device': self.lock_identity['Device'],
+                'Inode': self.lock_identity['Inode']}
+
+    def verify_held(self) -> None:
+        if self.closed:
+            raise LifecycleError('root lifecycle lock has already closed')
+        current = validate_root_lock(self.lock_fd)
+        if (current['Device'], current['Inode']) != (
+                self.lock_identity['Device'], self.lock_identity['Inode']):
+            raise LifecycleError('held root lifecycle lock identity changed')
+
+    def publish_lease(self, *, run_tag: str, prepared_receipt_sha256: str,
+                      private_binding_receipt_sha256: str,
+                      request_sha256: str | None = None,
+                      clock: Any = time.time_ns) -> HeldLifecycleLease:
+        """Compatibility helper for offline controls; production publishes
+        the PREPARING lease before any libvirt/native operation, then ACTIVE
+        only after the exact private-state binding exists.
+        """
+        prepared = self.publish_preparation_lease(
+            run_tag=run_tag,
+            request_sha256=(request_sha256 or hashlib.sha256(
+                (run_tag + '\0' + prepared_receipt_sha256 + '\0' +
+                 private_binding_receipt_sha256).encode('ascii')).hexdigest()),
+            clock=clock)
+        prepared.publish_active_lease(
+            prepared_receipt_sha256=prepared_receipt_sha256,
+            private_binding_receipt_sha256=private_binding_receipt_sha256,
+            clock=clock)
+        return prepared
+
+    def publish_preparation_lease(self, *, run_tag: str,
+                                  request_sha256: str,
+                                  clock: Any = time.time_ns) -> HeldLifecycleLease:
+        if self.closed:
+            raise LifecycleError('cannot publish a lease for a closed root lock')
+        self.verify_held()
+        if re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]{2,29}', run_tag) is None:
+            raise LifecycleError('run tag syntax differs from fixed T5 syntax')
+        if re.fullmatch(r'[0-9a-f]{64}', request_sha256) is None:
+            raise LifecycleError('fixed request identity is not an exact SHA-256 value')
+        runtime_fd = os.open(RUNTIME_DIRECTORY, os.O_RDONLY | os.O_DIRECTORY |
+                             os.O_CLOEXEC | os.O_NOFOLLOW)
+        preparation_fd = -1
+        try:
+            _verify_directory(runtime_fd)
+            if set(os.listdir(runtime_fd)) != {os.path.basename(LOCK_PATH)}:
+                raise LifecycleError('stale lease or unexpected runtime entry blocks lease publication')
+            lock_stat = os.fstat(self.lock_fd)
+            by_path = os.stat(os.path.basename(LOCK_PATH), dir_fd=runtime_fd,
+                              follow_symlinks=False)
+            if (lock_stat.st_dev, lock_stat.st_ino) != (by_path.st_dev, by_path.st_ino):
+                raise LifecycleError('root lock path changed before lease publication')
+            pid = os.getpid()
+            row = {
+                'Schema': PREPARATION_SCHEMA, 'Status': 'PREPARING', 'Domain': DOMAIN,
+                'UUID': DOMAIN_UUID, 'URI': URI, 'RunTag': run_tag,
+                'Token': secrets.token_hex(32), 'SupervisorPID': pid,
+                'SupervisorStartTicks': process_start_ticks(pid),
+                'RequesterUID': 1000, 'LockPath': LOCK_PATH,
+                'LockDevice': lock_stat.st_dev, 'LockInode': lock_stat.st_ino,
+                'SupervisorLockFD': self.lock_fd,
+                'RequestSHA256': request_sha256,
+                'StartedUnixNS': clock(),
+                'Disposition': 'ROOT_SUPERVISOR_PREPARATION_LOCK',
+            }
+            _validate_preparation_lease(row)
+            write_fd, preparation_sha, preparation_stat = _create_immutable_record(
+                runtime_fd, os.path.basename(PREPARATION_LEASE_PATH), row)
+            os.close(write_fd)
+            write_fd = -1
+            preparation_fd = os.open(os.path.basename(PREPARATION_LEASE_PATH),
+                                     os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW,
+                                     dir_fd=runtime_fd)
+            opened = os.fstat(preparation_fd)
+            if (opened.st_dev, opened.st_ino) != (
+                    preparation_stat.st_dev, preparation_stat.st_ino):
+                raise LifecycleError('preparation lease path changed after publication')
+            validate_root_lock(self.lock_fd, pid=pid)
+            result = HeldLifecycleLease(
+                lock_fd=self.lock_fd, lock_identity=self.lock_identity,
+                preparation_fd=preparation_fd,
+                preparation_sha256=preparation_sha,
+                preparation_row=row,
+                preparation_device=preparation_stat.st_dev,
+                preparation_inode=preparation_stat.st_ino)
+            result.verify_held()
+            self.closed = True  # private lock ownership transfers to the lease
+            return result
+        except BaseException:
+            if preparation_fd >= 0:
+                os.close(preparation_fd)
+            if 'write_fd' in locals() and write_fd >= 0:
+                os.close(write_fd)
+            raise
+        finally:
+            os.close(runtime_fd)
+
+    def close_without_lease(self) -> None:
+        if not self.closed:
+            os.close(self.lock_fd)
+            self.closed = True
+
+    def close(self) -> None:
+        self.close_without_lease()
+
+
+def acquire_root_lock(*, expected_uid: int = 0,
+                      pid: int | None = None) -> HeldLifecycleLock:
+    """Create/hold the single boot-lifetime root lock; do not publish a lease."""
+    pid = os.getpid() if pid is None else pid
+    if expected_uid != 0 or os.getuid() != 0 or os.geteuid() != 0:
+        raise LifecycleError('only the fixed root supervisor may acquire the lifecycle lease')
+    _check_no_legacy_locks()
+    runtime_fd = _ensure_runtime_directory()
+    lock_fd = -1
+    try:
+        names = set(os.listdir(runtime_fd))
+        if names - {os.path.basename(LOCK_PATH)}:
+            raise LifecycleError('stale lease or unexpected runtime entry blocks a new lifecycle')
+        lock_name = os.path.basename(LOCK_PATH)
+        try:
+            fd = os.open(lock_name, os.O_RDWR | os.O_CREAT | os.O_EXCL |
+                         os.O_CLOEXEC | os.O_NOFOLLOW, 0o444, dir_fd=runtime_fd)
+            try:
+                os.fchown(fd, 0, 0)
+                os.fchmod(fd, 0o444)
+                os.fsync(fd)
+            except BaseException:
+                os.close(fd)
+                raise
+            os.fsync(runtime_fd)
+            lock_fd = fd
+        except FileExistsError:
+            lock_fd = os.open(lock_name, os.O_RDWR | os.O_CLOEXEC |
+                              os.O_NOFOLLOW, dir_fd=runtime_fd)
+        lock_stat = os.fstat(lock_fd)
+        path_stat = os.stat(lock_name, dir_fd=runtime_fd, follow_symlinks=False)
+        if (not stat.S_ISREG(lock_stat.st_mode) or lock_stat.st_uid != 0 or
+                lock_stat.st_gid != 0 or stat.S_IMODE(lock_stat.st_mode) != 0o444 or
+                lock_stat.st_nlink != 1 or
+                (lock_stat.st_dev, lock_stat.st_ino) !=
+                (path_stat.st_dev, path_stat.st_ino)):
+            raise LifecycleError('canonical root lifecycle lock has unsafe identity/metadata')
+        try:
+            fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as exc:
+            raise LifecycleError('another selected-T5 lifecycle holds the canonical lock') from exc
+        lock_identity = {'Path': LOCK_PATH, 'Device': lock_stat.st_dev,
+                         'Inode': lock_stat.st_ino, 'FD': lock_fd, 'PID': pid}
+        validate_root_lock(lock_fd, pid=pid)
+        return HeldLifecycleLock(lock_fd, lock_identity)
+    except BaseException:
+        if lock_fd >= 0:
+            os.close(lock_fd)
+        raise
+    finally:
+        os.close(runtime_fd)
+
===== driver/scripts/t5/T5WritableStatePolkit.rules (R4 -> R2 A2) =====
--- output/review-candidates/m2-t5-root-invocation-1011-r4-root-a1/src/driver/scripts/t5/T5WritableStatePolkit.rules
+++ output/review-candidates/m2-t5-lifecycle-recovery-transaction-r2-luna-a1/src/driver/scripts/t5/T5WritableStatePolkit.rules
@@ -0,0 +1,37 @@
+/*
+ * No-apply installation template for selected T5 lifecycle isolation.
+ * Policy for ordinary local users is delegated to the fixed, root-owned
+ * lifecycle checker. Root remains the explicit trusted-administrator boundary.
+ */
+polkit.addRule(function (action, subject) {
+    if (action.id.indexOf("org.libvirt.api.") !== 0 &&
+        action.id.indexOf("org.libvirt.unix.") !== 0) {
+        return polkit.Result.NOT_HANDLED;
+    }
+    if (subject.user === "root") {
+        return polkit.Result.NOT_HANDLED;
+    }
+    if (typeof subject.pid !== "number" || typeof subject.uid !== "number") {
+        return polkit.Result.NO;
+    }
+    try {
+        var result = polkit.spawn([
+            "/usr/bin/python3.14", "-I", "-S", "-B",
+            "/usr/local/libexec/safeupload-t5-copy-r2/T5WritableStateLifecycle.py",
+            "polkit-decision", "--pid", String(subject.pid),
+            "--uid", String(subject.uid), "--action", String(action.id),
+            "--domain-uuid", String(action.lookup("domain_uuid")),
+            "--pool-name", String(action.lookup("pool_name")),
+            "--volume-name", String(action.lookup("vol_name"))
+        ]).replace(/\s+$/, "");
+        if (result === "NO_LEASE") {
+            return polkit.Result.NOT_HANDLED;
+        }
+        if (result === "ALLOW_SUPERVISED_READ_ONLY") {
+            return polkit.Result.YES;
+        }
+        return polkit.Result.NO;
+    } catch (e) {
+        return polkit.Result.NO;
+    }
+});
