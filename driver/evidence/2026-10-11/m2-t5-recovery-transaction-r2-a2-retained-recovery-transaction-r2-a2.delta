+def _canonical_file_sha(fs: Any, path: str, *, mode: str) -> str:
+    raw, _ = fs.read_regular(path, expected_uid=0, expected_gid=0,
+                             expected_mode=mode, max_bytes=MAX_TRUST_BYTES)
+    return _sha(raw)
