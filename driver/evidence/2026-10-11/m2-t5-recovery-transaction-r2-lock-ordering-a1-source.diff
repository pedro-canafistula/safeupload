+def _competing_lock_probe(module, runtime_dir: str, lock_path: str,
+                          expected_uid: int, expected_gid: int,
+                          directory_mode: int) -> str:
+    """Use a separate process to prove the same inode excludes a competitor."""
+    read_fd, write_fd = os.pipe()
+    pid = os.fork()
+    if pid == 0:
+        os.close(read_fd)
+        try:
+            fd, _row = module._acquire_canonical_lock_at(
+                runtime_dir, lock_path, expected_uid=expected_uid,
+                expected_gid=expected_gid, directory_mode=directory_mode,
+                lock_mode=0o600)
+        except module.InstallError:
+            result = b'BLOCKED'
+        except BaseException as exc:
+            result = ('ERROR:' + type(exc).__name__).encode('ascii')
+        else:
+            os.close(fd)
+            result = b'ACQUIRED'
+        os.write(write_fd, result + b'\n')
+        os.close(write_fd)
+        os._exit(0)
+    os.close(write_fd)
+    result = os.read(read_fd, 128).strip().decode('ascii')
+    os.close(read_fd)
+    _pid, status = os.waitpid(pid, 0)
+    if status != 0:
+        raise AssertionError('lock competitor child exited abnormally')
+    return result
