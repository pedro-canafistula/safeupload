<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PublishAot is not a performance choice, it is a deployment one.

    The target VM has no .NET runtime and is not going to get one: it is a
    machine that only ever receives signed artifacts. A framework-dependent
    build dies in the loader there with no output at all - the same failure
    the C inspector had when it depended on VCRUNTIME140D.dll, which cost
    an afternoon to diagnose because a process that dies before main()
    prints nothing.

    AOT produces one native .exe whose only imports are Windows system
    DLLs (kernel32, advapi32, ole32, bcrypt and the in-box Universal CRT).
    fltlib.dll is loaded on demand by DllImport and lives in System32 on
    any Windows with the Filter Manager.

    Building this requires the MSVC linker, and the linker invocation
    itself calls vswhere.exe - which is NOT on PATH by default even when
    Visual Studio is installed. Publish-SafeUpload.ps1 puts it there. From
    a shell, prepend:

      %ProgramFiles(x86)%\Microsoft Visual Studio\Installer
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>false</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SafeUpload.Protocol\SafeUpload.Protocol.csproj" />
  </ItemGroup>

</Project>
